<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vanilla Vehicles Expanded's boats (D'thorga Vehicles 0.132.0; docs/development/vehicle-standard.md, VS10). Not yet tested in game.

    - The Trawler is a working fishing boat, and a trawler carries a galley for a crew who live aboard (general knowledge of fishing vessels; a
      Danish-built trawler's deckhouse with "galley with provision room", Fiskerforum's review, secondary). It keeps D'thorga Framework's boat
      loadout and adds the land vehicles' fridge bay, water tank bay and outlet panel, and a galley bay with a galley from the factory (the
      owner's card of 28 Nov 2026: "Bays only, unless some have a kitchenette in real life? Which if so, they get that by default"). Each
      appended last, so a saved trawler keeps its parts where they were. The Dinghy, an open boat, keeps the plain boat loadout.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutBoat">
    <defName>PhobosVehicleLoadout_Boat_VVETrawler</defName>
    <label>trawler</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Trawler</li>
      </vehicleDefs>
    </selector>
    <partRoles>
      <li>
        <role>FridgeBay</role>
        <add>
          <key>PhobosFridgeBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>fridge bay</label>
          <health>20</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>WaterTankBay</role>
        <add>
          <key>PhobosWaterTankBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>water tank bay</label>
          <health>25</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>OutletPanel</role>
        <add>
          <key>PhobosOutletPanel</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>outlet panel</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.08</hitWeight>
          <hitWeightCE>3</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <!-- The galley's place, for the galley it leaves the factory with. Health and hit weights authored, a little more than a fridge bay's. -->
        <role>GalleyBay</role>
        <add>
          <key>PhobosGalleyBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>galley</label>
          <health>30</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
    </partRoles>
    <factoryFittings>
      <li>PhobosFitting_Galley</li>
    </factoryFittings>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
