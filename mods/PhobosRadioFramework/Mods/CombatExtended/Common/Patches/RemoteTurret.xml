<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The remote gun turret under Combat Extended (Radio 0.19.0; docs/development/autonomous-vehicles.md, the base turret). Loaded only with
       Combat Extended (LoadFolders.xml), so it names Combat Extended's operations and Defs freely. As Combat Extended converts the game's own
       mini-turret (its Patches/Core/ThingDefs_Buildings/Buildings_Security.xml and ThingDefs_Misc/Weapons_Guns.xml, read for the shape):
       the building takes Combat Extended's turret class, here our subclass that keeps the radio's firing rule, and drops the steel belt;
       the gun fires Combat Extended's .50 BMG from a 200-round magazine. Figures [A] authored, Combat Extended's .50 BMG its own. -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="PhobosRadio_RemoteTurret"]/thingClass</xpath>
    <value>
      <thingClass>Phobos.Radio.CombatExtended.Building_PhobosRemoteTurretCE</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="PhobosRadio_RemoteTurret"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="PhobosRadio_RemoteTurret"]/description</xpath>
    <value>
      <description>A .50 heavy machine gun on a powered mount with a camera sight, on an armoured pedestal. Nobody sits at it: it fires while a colonist at a radio station watches through its camera, and that colonist can aim it. Connect it to a radio station with coax. Colonists reload it with .50 BMG rounds, and it holds fire without power.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="PhobosRadio_RemoteTurret"]/statBases</xpath>
    <value>
      <!-- A camera sight on a stabilised mount aims better than the game's mini-turret's dumb brain (Combat Extended's 0.25) [A]. -->
      <AimingAccuracy>0.5</AimingAccuracy>
      <Bulk>60</Bulk>
    </value>
  </Operation>

  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>PhobosRadio_RemoteTurretGun</defName>
    <statBases>
      <RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
      <SightsEfficiency>1.5</SightsEfficiency>
      <ShotSpread>0.04</ShotSpread>
      <SwayFactor>0.65</SwayFactor>
      <Mass>40</Mass>
    </statBases>
    <Properties>
      <recoilAmount>1.6</recoilAmount>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_50BMG_FMJ</defaultProjectile>
      <warmupTime>1.2</warmupTime>
      <range>75</range>
      <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
      <burstShotCount>10</burstShotCount>
      <soundCast>Shot_Minigun</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <muzzleFlashScale>9</muzzleFlashScale>
      <recoilPattern>Mounted</recoilPattern>
    </Properties>
    <AmmoUser>
      <magazineSize>200</magazineSize>
      <reloadTime>9.2</reloadTime>
      <ammoSet>AmmoSet_50BMG</ammoSet>
    </AmmoUser>
    <FireModes>
      <aiAimMode>AimedShot</aiAimMode>
      <noSnapshot>true</noSnapshot>
    </FireModes>
  </Operation>
</Patch>
