<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- QSL cards in play, part 1 (Radio 0.66.0; docs/development/radio-qsl-in-play.md, the owner's cards of 28 Nov 2026): a card you can
       hold, the game's own book, so colonists read it with the game's reading job and keep it on a shelf. Made only by the bureau, never
       sold or given as a reward (it carries its logbook card). Figures authored. -->
  <ThingDef>
    <defName>PhobosRadio_QslCard</defName>
    <label>QSL card</label>
    <description>A card from another station, confirming a contact by radio. Radio operators like to read them.</description>
    <thingClass>Phobos.Radio.QslCardBook</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <rotatable>True</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <tickerType>Rare</tickerType>
    <alwaysHaulable>true</alwaysHaulable>
    <useHitPoints>true</useHitPoints>
    <drawGUIOverlay>true</drawGUIOverlay>
    <tradeability>None</tradeability>
    <neverMultiSelect>true</neverMultiSelect>
    <stackLimit>1</stackLimit>
    <graphicData>
      <texPath>Phobos/Radio/Things/QslCard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.6</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.01</Mass>
      <Flammability>1</Flammability>
      <Beauty>1</Beauty>
      <MarketValue>1</MarketValue>
    </statBases>
    <thingCategories>
      <li>Books</li>
    </thingCategories>
    <inspectorTabs>
      <li>ITab_Book</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Book">
        <openGraphic>
          <texPath>Phobos/Radio/Things/QslCard_Open</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.5</drawSize>
        </openGraphic>
        <verticalGraphic>
          <texPath>Phobos/Radio/Things/QslCard_Vertical</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.5</drawSize>
          <addTopAltitudeBias>true</addTopAltitudeBias>
        </verticalGraphic>
        <doers>
          <li Class="BookOutcomeProperties_JoyFactorModifier" />
          <li Class="Phobos.Radio.BookOutcomeProperties_QslMemory">
            <thought>PhobosRadio_ReadQslCard</thought>
            <farTiles>50</farTiles>
          </li>
        </doers>
      </li>
    </comps>
  </ThingDef>

  <ThoughtDef>
    <defName>PhobosRadio_ReadQslCard</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>read a QSL card</label>
        <description>I read a card from a station we reached by radio. Someone out there heard us.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <li>
        <label>read a QSL card from far away</label>
        <description>A card from a station far across the world. Our voice carried all that way.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Part 2 (Radio 0.68.0): the QSL wall, the game's own bookcase holding QSL cards (the owner's words: "make it like how the bookshelf
       operates"), drawn as a cork board with the cards' own fronts in its six slots; and an award's framed certificate, art admired from a
       distance, posted by the bureau. Costs, beauty and work authored. -->
  <ThingDef ParentName="BookcaseBase">
    <defName>PhobosRadio_QslWall</defName>
    <label>QSL wall</label>
    <description>A cork board in a wooden frame for the QSL cards your stations have received, six to a board, each showing its own picture. Colonists take a card down to read it, as from a bookcase, and the cards make the room a little more beautiful. A room with a radio station and a QSL wall is a ham shack.</description>
    <thingClass>Phobos.Radio.Building_QslWall</thingClass>
    <graphicData>
      <texPath>Phobos/Radio/Things/QslWall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1.33)</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>5</Mass>
      <WorkToBuild>600</WorkToBuild>
      <Beauty>2</Beauty>
    </statBases>
    <building>
      <maxItemsInCell>3</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>PhobosRadio_QslCard</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <thingDefs>
            <li>PhobosRadio_QslCard</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <designationCategory>PhobosRadio_Architect</designationCategory>
    <uiOrder>2140</uiOrder>
    <researchPrerequisites>
      <li>PhobosRadio_LocalRadio</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>PhobosRadio_QslCertificate</defName>
    <label>radio award certificate</label>
    <description>A framed certificate for one of your station's radio awards. Colonists admire it as art.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Phobos/Radio/Things/QslCertificate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <tradeability>None</tradeability>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>2</Mass>
      <Beauty>15</Beauty>
      <WorkToBuild>1</WorkToBuild>
    </statBases>
    <comps>
      <li Class="CompProperties_Art">
        <compClass>Phobos.Radio.CompQslCertificate</compClass>
        <nameMaker>NamerArtSculpture</nameMaker>
        <descriptionMaker>ArtDescription_Sculpture</descriptionMaker>
        <canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
      </li>
    </comps>
  </ThingDef>

  <!-- The ham shack (Radio 0.68.0; the owner's card: a room role with a work bonus): a room with a radio station and a QSL wall. Radio work
       there goes the rules' hamShackWorkFactor faster; radio operators enjoy a decent one. Mood authored. -->
  <RoomRoleDef>
    <defName>PhobosRadio_HamShack</defName>
    <label>ham shack</label>
    <workerClass>Phobos.Radio.Services.RoomRoleWorker_HamShack</workerClass>
    <relatedStats>
      <li>Beauty</li>
      <li>Impressiveness</li>
    </relatedStats>
  </RoomRoleDef>

  <ThoughtDef>
    <defName>PhobosRadio_HamShackMood</defName>
    <workerClass>Phobos.Radio.Services.ThoughtWorker_PhobosHamShack</workerClass>
    <stages>
      <li>
        <label>a fine ham shack</label>
        <description>Our radio room has its cards on the wall and its station ready. A good place to talk to the world.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
