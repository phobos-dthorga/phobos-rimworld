<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Framework's vehicle systems part (design: docs/development/vehicle-systems-design.md). Its own assembly in
       Mods/VehicleFramework/<version>, which LoadFolders.xml loads only while Vehicle Framework is active, so the Framework's core
       never references Vehicle Framework. RimWorld 1.7 only (owner, 8 November 2026): one target, net10.0 with Harmony 3. Vehicle
       Framework's assemblies (MIT) are referenced from the installed mod and never copied; it ships only a 1.6 build, which the 1.7
       game loads, and Directory.Build.targets points there. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.VehicleSystems</RootNamespace>
    <AssemblyName>PhobosFramework.Vehicles</AssemblyName>
    <ModFolder>PhobosFramework</ModFolder>
    <TieInFolder>Mods/VehicleFramework/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.40.3</Version>
    <!-- Vehicle Framework targets .NET Framework 4.8; the game loads it whatever it declares. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Vehicles">
      <HintPath>$(VehicleFrameworkAssemblies)\Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VehicleFrameworkAssemblies)\SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
