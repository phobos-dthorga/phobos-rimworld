<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The base station: a powered 2 x 2 building on the comms-console pattern. Its built-in whip sits at
       desk height under whatever roof the room has, which is why a mountain shack needs a surface antenna
       on coax (next version). Twenty-five watts, authored. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PhobosRadio_BaseStation</defName>
    <!-- Drawn each frame too, for its transmit lamp and meter needle (Radio 0.6.0). -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <label>radio base station</label>
    <description>A transceiver, a power supply and a short whip on the desk. Works both VHF and UHF, so any hand-held can reach it. Walls and rock between it and a colonist cut the signal; an antenna outside on coax does far better. Transmitting draws extra power and warms the room.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Phobos/Radio/Things/BaseStation</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(1.8,0.5,1.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <!-- Turned as it is placed (Radio 0.20.2, the owner's report of 26 Nov 2026): its picture is a plan view, so the game turns it whole,
         and its lamp and needle turn with it; an operator reaches it from any side. -->
    <rotatable>true</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Flammability>0.6</Flammability>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>PhobosRadio_Architect</designationCategory>
    <uiOrder>2110</uiOrder>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>60</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Phobos.Radio.CompProperties_Radio">
        <isStation>true</isStation>
        <bands>
          <li>PhobosRadio_VHF</li>
          <li>PhobosRadio_UHF</li>
        </bands>
        <mode>PhobosRadio_VoiceFM</mode>
        <transmitPowerWatts>25</transmitPowerWatts>
        <!-- One channel, shared by up to five radios taking turns (Radio 0.7.0); a second transceiver adds one. -->
        <channels>1</channels>
        <noiseFigureDb>6</noiseFigureDb>
        <antennaGainDbi>0</antennaGainDbi>
        <antennaHeightMetres>2</antennaHeightMetres>
        <!-- Its gentle squelch once as it comes into use (Radio 0.34.1, S165, the owner's pick of 27 Nov 2026: try 203 an octave down). The
             radio terminal has none: a computer, not a desk set (agent's choice). -->
        <engageSound>PhobosRadio_SquelchStation</engageSound>
      </li>
      <!-- RV6 (Radio 0.6.0): the transmit lamp at the meter face's top corner, the needle from its foot; measured from the picture. -->
      <li Class="Phobos.Radio.CompProperties_RadioMarks">
        <marks>
          <li><kind>TransmitLamp</kind><offset>(0.555,0,0.570)</offset><size>0.04</size></li>
          <li><kind>Needle</kind><offset>(0.621,0,0.445)</offset><length>0.13</length></li>
        </marks>
      </li>
      <li Class="Phobos.Radio.CompProperties_FeedlinePort">
        <pipeNet>PhobosRadio_FeedlineNet</pipeNet>
      </li>
      <li Class="Phobos.Framework.Upgrades.CompProperties_PhobosBuildingUpgrades" />
    </comps>
    <inspectorTabs>
      <li>Phobos.Radio.UI.ITab_RadioNet</li>
      <!-- Shown only while the setting "Show the waterfall on the radio desk" is on (Radio 0.6.0, off by default). -->
      <li>Phobos.Radio.UI.ITab_RadioWaterfall</li>
    </inspectorTabs>
    <placeWorkers>
      <li>Phobos.Radio.UI.PlaceWorker_AntennaSiting</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>PhobosRadio_LocalRadio</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>
  <!-- The radio terminal (Radio 0.5.0; docs/development/radio-stations.md): a computer driving a software-defined radio. Its own
       figures, authored: 10 W (the Australian Foundation licence's limit), a quiet 2 dB receiver, a weak stub antenna at 1 m
       (the owner's card of 24 Nov 2026: "A weak stub that works"), and its computer's own noise, which the setting "Radio
       terminals make radio noise" can switch off. A linear amplifier in its coax raises what it sends. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PhobosRadio_RadioTerminal</defName>
    <label>radio terminal</label>
    <description>A computer driving a software-defined radio: ten watts of its own, but a very quiet receiver, so it hears faint hand-helds the desk would miss. Its little stub antenna works, poorly; it does far better with coax to a whip or mast outside, ideally through a linear amplifier. The computer itself makes electrical noise, so keep antennas a few metres from it. Works both VHF and UHF.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Phobos/Radio/Things/RadioTerminal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,2)</drawSize>
      <shadowData>
        <volume>(2.8,0.5,1.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <!-- Turned as it is placed (Radio 0.20.2), as the base station. -->
    <rotatable>true</rotatable>
    <size>(3,2)</size>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2600</WorkToBuild>
      <Flammability>0.6</Flammability>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>PhobosRadio_Architect</designationCategory>
    <uiOrder>2111</uiOrder>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>150</basePowerConsumption>
        <!-- Its computer running while powered (Radio 0.16.0, S149): the game's own powered-ambient sound, started and ended by the
             power comp, so no code of ours runs for it. -->
        <soundAmbientPowered>PhobosRadio_TerminalHum</soundAmbientPowered>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Phobos.Radio.CompProperties_Radio">
        <isStation>true</isStation>
        <!-- A software radio: its Waterfall tab always shows. -->
        <waterfallBuiltIn>true</waterfallBuiltIn>
        <bands>
          <li>PhobosRadio_VHF</li>
          <li>PhobosRadio_UHF</li>
        </bands>
        <mode>PhobosRadio_VoiceFM</mode>
        <transmitPowerWatts>10</transmitPowerWatts>
        <!-- A software radio listens on many channels at once: four (Radio 0.7.0; authored). -->
        <channels>4</channels>
        <!-- Authored: a quiet front end with a preamplifier; unverified against a source. -->
        <noiseFigureDb>2</noiseFigureDb>
        <!-- The stub: short for its wavelength, so below a quarter-wave whip; approximate. -->
        <antennaGainDbi>-5</antennaGainDbi>
        <antennaHeightMetres>1</antennaHeightMetres>
      </li>
      <li Class="Phobos.Radio.CompProperties_FeedlinePort">
        <pipeNet>PhobosRadio_FeedlineNet</pipeNet>
      </li>
    </comps>
    <modExtensions>
      <!-- Its computer's noise, authored: -75 dBm at 1 m, out to 8 cells, fading like every source. -->
      <li Class="Phobos.Radio.RadioNoiseExtension">
        <noiseDbmAt1m>-75</noiseDbmAt1m>
        <radiusCells>8</radiusCells>
        <noiseWhen>PowerOn</noiseWhen>
        <computerNoise>true</computerNoise>
      </li>
    </modExtensions>
    <inspectorTabs>
      <li>Phobos.Radio.UI.ITab_RadioNet</li>
      <!-- The waterfall (Radio 0.6.0): the band as a software radio shows it. -->
      <li>Phobos.Radio.UI.ITab_RadioWaterfall</li>
    </inspectorTabs>
    <placeWorkers>
      <li>Phobos.Radio.UI.PlaceWorker_AntennaSiting</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>PhobosRadio_SoftwareRadio</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
