<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- A prompt radiation dose for the missile mod's nuclear and antimatter weapons that had none (Patches 0.47.0;
       docs/development/radiation-bursts.md; owner, 27 Nov 2026). D'thorga Framework's burst: the dose in the open is graysAtEdge out to
       edgeRadius, then falls by the inverse square and air's attenuation over airLength cells. Every figure is authored. -->

  <!-- The Mini-Nuke: its blast's edge, 27 cells. About 7 Gy at 50 cells in the open, 1 at 100. A day or three of fallout, 0.3 Gy an hour in the open at the first hour (about 1 Gy over
       the first day). -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/IRBM.MissileWarheadDef[defName="IRBM_Warhead_Tactical_MiniNuke"]</xpath>
    <value>
      <li Class="Phobos.Framework.Health.PhobosRadiationBurst">
        <kind>Nuclear</kind>
        <edgeRadius>27</edgeRadius>
        <graysAtEdge>30</graysAtEdge>
        <airLength>100</airLength>
        <falloutDays>1~3</falloutDays>
        <falloutGraysPerHour>0.3</falloutGraysPerHour>
      </li>
    </value>
  </Operation>

  <!-- The antimatter warhead: annihilation's gamma rays, no fallout. About 3.3 Gy at 50 cells in the open. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/IRBM.MissileWarheadDef[defName="IRBM_Warhead_Tactical_Antigrain"]</xpath>
    <value>
      <li Class="Phobos.Framework.Health.PhobosRadiationBurst">
        <kind>Antimatter</kind>
        <edgeRadius>25</edgeRadius>
        <graysAtEdge>20</graysAtEdge>
        <airLength>60</airLength>
      </li>
    </value>
  </Operation>

  <!-- The Gamma-Ray Burst: one dose over every struck map, through built roofs, cut only by rock. Its people are left out of the
       missile mod's 300 rounds of decay damage; its plants still wither. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/IRBM.MissileWarheadDef[defName="IRBM_Warhead_Strategic_GammaRay"]</xpath>
    <value>
      <li Class="Phobos.Framework.Health.PhobosRadiationBurst">
        <kind>Nuclear</kind>
        <wholeMap>true</wholeMap>
        <graysAtEdge>50</graysAtEdge>
        <buildingsShield>false</buildingsShield>
      </li>
    </value>
  </Operation>

  <!-- The missile mod's antigrain trap, as the game's own antigrain things. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="IRBM_TrapIED_Antigrain_NonRemovable"]</xpath>
    <value>
      <li Class="Phobos.Framework.Health.PhobosRadiationBurst">
        <kind>Antimatter</kind>
        <edgeRadius>15</edgeRadius>
        <graysAtEdge>10</graysAtEdge>
        <airLength>40</airLength>
      </li>
    </value>
  </Operation>
</Patch>
