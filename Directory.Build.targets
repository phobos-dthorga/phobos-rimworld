<Project>
  <!-- Imported after every project under src/. Everything that depends on the target framework lives here once, so a
       project file only names its mod folder, its tie-in folder if any, and whether it patches with Harmony
       (docs/development/building.md). RimWorld 1.7 only (owner, 8 November 2026): every project builds net10.0 against the
       1.7 reference and ships in mods/<Mod>/1.7/Assemblies. -->
  <PropertyGroup>
    <GameVersion>1.7</GameVersion>
    <!-- Other mods' assemblies are referenced from the installed Workshop items and never copied (THIRD_PARTY_NOTICES.md).
         Override the root with -p:WorkshopRoot=... or the environment variable of that name, or each folder below. -->
    <WorkshopRoot Condition="'$(WorkshopRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</WorkshopRoot>
    <!-- Vanilla Expanded Framework and Dubs Bad Hygiene ship a folder per game version. -->
    <VefAssemblies Condition="'$(VefAssemblies)' == ''">$(WorkshopRoot)\2023507013\$(GameVersion)\Assemblies</VefAssemblies>
    <DbhAssemblies Condition="'$(DbhAssemblies)' == ''">$(WorkshopRoot)\836308268\$(GameVersion)\Assemblies</DbhAssemblies>
    <RimefellerAssemblies Condition="'$(RimefellerAssemblies)' == ''">$(WorkshopRoot)\1321849735\$(GameVersion)\Assemblies</RimefellerAssemblies>
    <!-- VFE Factory and Vehicle Framework ship only 1.6 (checked 4 November 2026); the game loads that on 1.7 and so do we. -->
    <VfeFactoryAssemblies Condition="'$(VfeFactoryAssemblies)' == ''">$(WorkshopRoot)\3686924415\1.6\Assemblies</VfeFactoryAssemblies>
    <VehicleFrameworkAssemblies Condition="'$(VehicleFrameworkAssemblies)' == ''">$(WorkshopRoot)\3014915404\1.6\Assemblies</VehicleFrameworkAssemblies>
    <!-- Useful Marks ships 1.5, 1.6 and 1.7 builds (checked 7 November 2026); D'thorga Medical's tie-in compiles against the 1.7 one. -->
    <UsefulMarksAssemblies Condition="'$(UsefulMarksAssemblies)' == ''">$(WorkshopRoot)\3506573327\$(GameVersion)\Assemblies</UsefulMarksAssemblies>
    <!-- InterRim Ballistic Missile ships only 1.6 (checked 7 November 2026); the game loads that on 1.7 and so do we. -->
    <IrbmAssemblies Condition="'$(IrbmAssemblies)' == ''">$(WorkshopRoot)\3682304832\1.6\Assemblies</IrbmAssemblies>
    <!-- Where the built assembly lands: mods/<ModFolder>/<TieInFolder/><GameVersion>/Assemblies/. OutDir, not OutputPath:
         by the time this file is imported the SDK has already turned OutputPath into OutDir, and OutDir is what the
         build writes to. -->
    <OutDir Condition="'$(ModFolder)' != ''">$(MSBuildThisFileDirectory)mods/$(ModFolder)/$(TieInFolder)$(GameVersion)/Assemblies/</OutDir>
    <!-- TargetDir and TargetPath were derived from the old OutDir already; a project that references this one asks for TargetPath. -->
    <TargetDir Condition="'$(ModFolder)' != ''">$(OutDir)</TargetDir>
    <TargetPath Condition="'$(ModFolder)' != ''">$(TargetDir)$(TargetFileName)</TargetPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <!-- A referenced project's DLL ships only in its own mod, never beside another mod's, and that holds for the references it brings
       with it too: setting Private=false on a ProjectReference covers only that reference, so a transitive copy of
       PhobosFramework.dll shipped in Medical Equipment's Dubs Bad Hygiene folder until 7 November 2026. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>
  <!-- The game's reference assemblies: Krafs.Rimworld.Ref publishes one per game build. -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4998-unstable" />
  </ItemGroup>
  <!-- Players get Harmony 3 from the Harmony mod on 1.7; compile against it only, so 0Harmony.dll never ships. A project
       opts in with <UsesHarmony>true</UsesHarmony>. -->
  <ItemGroup Condition="'$(UsesHarmony)' == 'true'">
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.4" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- The shared patch helper, compiled into every project that patches (internal, so copies never clash). Existing mods move to it
       when next touched (AGENTS.md). -->
  <ItemGroup Condition="'$(UsesHarmony)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src/Shared/HarmonyPatchApplier.cs" Link="Shared/HarmonyPatchApplier.cs" />
  </ItemGroup>
</Project>
