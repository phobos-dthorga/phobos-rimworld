<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The starting values the design says to tune in play. One Def; the first loaded wins. Every figure here is authored
       unless the comment beside it names a source. Player preferences (the toggles, the display mode) are mod settings. -->
  <Phobos.BurnsAndSmoke.Defs.PhobosBurnRulesDef>
    <defName>PhobosBurns_Rules</defName>
    <label>burn rules</label>

    <!-- A pawn with burns, on fire, carrying one of our conditions, or standing in smoke is recomputed this often. -->
    <recomputeIntervalTicks>300</recomputeIntervalTicks>

    <burnLoadVisibleTbsa>0.05</burnLoadVisibleTbsa>
    <!-- 15 to 20% burned is the threshold for fluid resuscitation (the Parkland formula); approximate. -->
    <shockStartTbsa>0.15</shockStartTbsa>
    <!-- A part burned off is its whole skin burned while the stump is fresh; once tended it fades over this many days (authored). -->
    <burnedOffHealDays>15</burnedOffHealDays>
    <!-- Past the start threshold the shock target is at least this, so the compensated stage always shows (authored). -->
    <shockThresholdFloor>0.1</shockThresholdFloor>

    <!-- Revised Baux score (Osler and colleagues, 2010): age + percent burned + 17 with an inhalation injury. The two marks are
         authored from one small cohort (Al Khobar, 2014 to 2020); Roberts and colleagues (2012) put 50% mortality near 110 in a
         burns service. The Rim has no burn unit. See the design record. -->
    <bauxNoDeathScore>36</bauxNoDeathScore>
    <bauxNoSurvivorScore>110</bauxNoSurvivorScore>
    <inhalationBauxPoints>17</inhalationBauxPoints>
    <inhalationCarbonMonoxideThreshold>0.2</inhalationCarbonMonoxideThreshold>
    <shockRisePerDay>1</shockRisePerDay>
    <shockFallPerDay>0.35</shockFallPerDay>
    <!-- Treatment takes slices off the untreated target: tended burns, bed rest, and fluids in proportion to the tend quality of
         the shock's own tending (the game's: doctor's skill times medicine potency, none 0.3, herbal 0.6, industrial 1,
         glitterworld 1.6 capped at 1.3). With burns tended and bed rest: no medicine leaves 55% of the target, herbal 44%,
         industrial 30%, glitterworld 20%. Authored (owner's choice, 4 Nov 2026: playable without a burn ward). -->
    <tendedShockRelief>0.2</tendedShockRelief>
    <bedRestShockRelief>0.15</bedRestShockRelief>
    <fluidsShockReliefPerQuality>0.35</fluidsShockReliefPerQuality>
    <fluidsQualityCap>1.3</fluidsQualityCap>
    <shockTreatmentFloor>0.1</shockTreatmentFloor>

    <airwayBaseChance>0.15</airwayBaseChance>
    <airwayReferenceDamage>10</airwayReferenceDamage>

    <!-- Carbon monoxide: an hour in a full room takes the blood to 30%. The half-lives live on the condition's comp
         (5.3 hours roofed, from the ~320 minute room-air figure; 3 hours in open air, authored). -->
    <coUptakePerHourAtFullGas>0.3</coUptakePerHourAtFullGas>
    <coCap>0.8</coCap>

    <lungInjuryPerHourAtFullSmoke>0.15</lungInjuryPerHourAtFullSmoke>
    <!-- Combat Extended's own figure per 50-tick check, reused for our acute condition when CE's is not running. -->
    <acuteSmokePerCheck>0.045</acuteSmokePerCheck>
  </Phobos.BurnsAndSmoke.Defs.PhobosBurnRulesDef>
</Defs>
