<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The V-22 Osprey, our first aircraft (docs/development/vehicle-osprey.md, row MV3; first slice, D'thorga Vehicles 0.69.0).
    Its figures are the record's: real kilograms and kilowatts, marked there [S] sourced, [P] published, [I] inferred, [A] authored.
    This slice flies on Vehicle Framework's own launcher (a VTOL take-off and landing, and travel between places); our own flight
    over the map, its upgrades, guns, the nacelle and rotor renderer and armour by class come in later slices. Not yet tested in game.

    Footprint 5 x 9 (owner's scale of 18 Nov 2026, the Mi-38's): cells x -2 to 2, z -4 (tail) to 4 (nose). The picture is 19 x 21
    cells; the wings and nacelles reach far past the footprint, so their parts are laid on its outer columns, one outer part to a cell
    (vehicle-armour.md): the cockpit across the nose rows, the cabin down the middle, wings and nacelles on the outer columns beside
    the wing, the main gear in the sponsons, the tail across the last row. Agent placement, for the owner to revise.
    Part keys are saved by position: append only, never reorder.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_Osprey</defName>
    <label>V-22 Osprey</label>
    <description>Bell Boeing V-22 Osprey: a tiltrotor that takes off and lands like a helicopter and flies between places like an aeroplane, twice as fast as any helicopter. Two pilots fly it; a crew chief works the ramp; 24 can ride in the cabin. It carries 5,600 kg, lifting the lighter loads straight up and the heavy ones from a short roll. Thirsty, unarmoured as built, and best used to deliver and leave.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Osprey/Osprey</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(19, 21)</drawSize>
      <!-- The pick's own grey and orange, measured by the export (Osprey.transform.json). -->
      <color>(225, 224, 235)</color>
      <colorTwo>(226, 147, 92)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_Osprey_Blueprint</buildDef>
    <size>(5, 9)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Air</vehicleType>
    <statBases>
      <!-- Read only for collisions since D'thorga Vehicles 0.78.0: every part carries its own armour by class, which overrides these
           (vehicle-armour.md). Heat stays the whole aircraft's. -->
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.8</Flammability>
      <MarketValue>18000</MarketValue>
    </statBases>
    <vehicleStats>
      <!-- 1,950: the Hind's 1,100 for 8,500 kg empty, scaled to the Osprey's 15,032 kg [I]. -->
      <Mass>1950</Mass>
      <!-- 17.5: the Hind's 10 for 270 km/h [S] scaled to the Osprey's 463 to 493 km/h [P]. -->
      <FlightSpeed>17.5</FlightSpeed>
      <!-- Taxiing on its wheels [A]. -->
      <MoveSpeed>4</MoveSpeed>
      <!-- Real kilograms: the short take-off maximum less empty weight and full fuel [I] (owner, 18 Nov 2026). -->
      <CargoCapacity>5600</CargoCapacity>
      <RepairRate>0.4</RepairRate>
      <AccelerationRate>0.03</AccelerationRate>
    </vehicleStats>
    <race>
      <baseBodySize>10</baseBodySize>
    </race>
    <properties>
      <visibilityWeight>8</visibilityWeight>
      <roles>
        <li>
          <key>pilot</key>
          <label>pilot</label>
          <!-- Two pilots, both needed, as the real crew (owner, 18 Nov 2026). -->
          <slots>2</slots>
          <slotsToOperate>2</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(-1, 4)</li>
              <li>(1, 4)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>crewChief</key>
          <label>crew chief</label>
          <!-- Works the ramp and, with a ramp gun fitted, the gun [S]: the gun's node makes the seat needed to work it. -->
          <slots>1</slots>
          <hitbox>
            <cells>
              <li>(0, -3)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>passenger</key>
          <label>passenger</label>
          <slots>24</slots>
          <hitbox>
            <cells>
              <li>(-1, 1)</li>
              <li>(0, 1)</li>
              <li>(1, 1)</li>
              <li>(-1, -1)</li>
              <li>(0, -1)</li>
              <li>(1, -1)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
