    <graphicData>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(5, 5)</drawSize>
      <color>(141, 165, 106)</color>
      <colorTwo>(255, 227, 115)</colorTwo>
    </graphicData>
    <fillPercent>0.8</fillPercent>
    <size>(4, 4)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.24</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.34</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.4</Flammability>
    </statBases>
    <vehicleStats>
      <MoveSpeed>7</MoveSpeed>
      <CargoCapacity>0</CargoCapacity>
      <RepairRate>0.5</RepairRate>
    </vehicleStats>
    <race>
      <baseBodySize>6</baseBodySize>
    </race>
    <properties>
      <diagonalRotation>false</diagonalRotation>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <visibilityWeight>5</visibilityWeight>
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles />
    </properties>
    <components>
    <li>
      <key>Chassis</key>
      <label>rear frame</label>
      <health>180</health>
      <depth>External</depth>
      <hitWeight>3</hitWeight>
      <hitbox>
        <cells>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Pivot</key>
      <label>articulation pivot</label>
      <health>90</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, 2)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>RearWheels</key>
      <label>rear dual wheels</label>
      <health>120</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, 0)</li>
          <li>(-1, 1)</li>
          <li>(2, 0)</li>
          <li>(2, 1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Linkage</key>
      <label>three-point linkage and drawbar</label>
      <health>70</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, -1)</li>
          <li>(0, -1)</li>
          <li>(1, -1)</li>
          <li>(2, -1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Lights</key>
      <label>rear lights</label>
      <health>10</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, -1)</li>
          <li>(2, -1)</li>
        </cells>
      </hitbox>
    </li>
    </components>
    <modExtensions>
      <!-- Towed only by its own front half's pivot; its own hitch carries the implements and pulls a cart (a line of tows). -->
      <li Class="Phobos.VehicleSystems.PhobosCouplingsExtension">
        <towedBy>PhobosCoupling_ArticulatedPivot</towedBy>
        <hitch>
          <li>PhobosCoupling_Drawbar</li>
          <li>PhobosCoupling_PickUpHitch</li>
          <li>PhobosCoupling_ThreePoint</li>
        </hitch>
      </li>
    </modExtensions>
    <comps>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosHitch" />
    </comps>
