    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_Osprey_Blueprint</defName>
    <label>V-22 Osprey</label>
    <description>Bell Boeing V-22 Osprey: a tiltrotor transport for two pilots, a crew chief and 24 passengers.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Osprey/Osprey</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(19, 21)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <!-- 60,000 [A]: the Cherokee's 52,000 and the Mi-38's 90,000. -->
      <WorkToBuild>60000</WorkToBuild>
      <Flammability>0.8</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_Osprey</li>
    </researchPrerequisites>
    <size>(5, 9)</size>
    <!-- The shell only [A]: plasteel stands for its composite airframe. Its engines, gearboxes, rotor blades, flight computers,
         actuators, tanks, landing gear and electrics are in Bill_Osprey.xml, filled at start-up (docs/development/parts-bills.md). D'thorga
         Vehicles 0.87.0: the fly-by-wire's 6 advanced components went to the flight computers, 80 plasteel to the rotor blades and 16
         components to the gearboxes and actuators (owner, 19 Nov 2026). -->
    <costList>
      <Steel>900</Steel>
      <Plasteel>170</Plasteel>
      <ComponentIndustrial>24</ComponentIndustrial>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_Osprey</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <!-- Two Rolls-Royce T406 turboshafts: 4,392 kW each at maximum continuous [S], a take-off rating 1.044 times that [S] for 10 minutes
       [A]; a turboshaft's idle fuel of 0.2, as built for the class. ratedKilowatts is the whole aircraft's; the count of working
       engines is read from its Engine1 and Engine2 parts. Its rpm is authored. Full fuel 5,210 kg: 6,513 L [P] at 0.80 kg a litre [A]. -->
  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_T406</defName>
    <label>twin T406 turboshafts</label>
    <engine>
      <kind>Turboshaft</kind>
      <ratedRpm>15000</ratedRpm>
      <ratedKilowatts>8784</ratedKilowatts>
      <idleFuelShare>0.2</idleFuelShare>
      <turbine>
        <idleSpeedPercent>60</idleSpeedPercent>
        <ratings>
          <li><name>maxContinuous</name><label>maximum continuous</label><share>1</share><speedPercent>100</speedPercent><temperatureLimit>775</temperatureLimit></li>
          <li><name>takeoff</name><label>take-off</label><share>1.044</share><speedPercent>102</speedPercent><temperatureLimit>815</temperatureLimit><minutes>10</minutes></li>
        </ratings>
      </turbine>
    </engine>
    <transmission>
      <kind>None</kind>
    </transmission>
    <mass>
      <emptyKilograms>15032</emptyKilograms>
      <fuelKilogramsFull>5210</fuelKilogramsFull>
    </mass>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>

  <!-- Hover power at its heaviest (25,855 kg, sea level, 15 C): 1.055 of maximum continuous, fitted so the engine model gives the guide's
       hover ceiling of 1,646 m at 21,319 kg [P] (the record's one fitted figure). On Vehicle Framework's launcher, as the stock
       helicopters are: rotors turning while drafted, cruising between places. Forward flight at 0.6 of maximum continuous [A]. -->
  <Phobos.VehicleSystems.PhobosVehicleFlightProfileDef>
    <defName>PhobosFlightProfile_Osprey</defName>
    <label>tiltrotor</label>
    <cabinBleed>0.005</cabinBleed>
    <hoverPowerAtMaxGross>1.055</hoverPowerAtMaxGross>
    <liftCheckAtLaunch>true</liftCheckAtLaunch>
    <reader Class="Phobos.VehicleSystems.PhaseReader_Members">
      <rules>
        <li><phase>WorldFlight</phase><comp>CompVehicleLauncher</comp><member>inFlight</member><equals>True</equals></li>
        <li><phase>Taxi</phase><member>Drafted</member><equals>True</equals></li>
      </rules>
    </reader>
    <phases>
      <li><phase>Taxi</phase><label>rotors turning</label><demand>0.2</demand><moving>false</moving></li>
      <li><phase>WorldFlight</phase><label>cruising as an aeroplane</label><demand>0.6</demand></li>
    </phases>
  </Phobos.VehicleSystems.PhobosVehicleFlightProfileDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_Osprey</defName>
    <label>tiltrotor</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Phobos_Osprey</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_T406</def>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_Osprey</flightProfile>
    <!-- Its design cruise height and ceiling [P, A]; an unpressurised cabin, with its own oxygen line of 3,050 m (10,000 ft, where its
         crew wear masks [S]); lift as a propeller aircraft between places. -->
    <cruise>
      <designMetres>4600</designMetres>
      <ceilingMetres>7620</ceilingMetres>
      <lift>Propeller</lift>
      <oxygenLineMetres>3050</oxygenLineMetres>
      <pressurised>false</pressurised>
    </cruise>
    <!-- Its fit (the record's table): full instruments and navigation, the fly-by-wire autopilot, missile warning [S], crew oxygen [S].
         Terrain-following radar and the infrared jammer are upgrades in a later slice. Air track authored on the Mi-38's scale. -->
    <avionics>
      <navigation>Full</navigation>
      <autopilot>true</autopilot>
      <warning>true</warning>
      <oxygen>true</oxygen>
      <cruisesHigh>true</cruisesHigh>
      <airTrack>
        <speed>17.5</speed>
        <cruiseMetres>4600</cruiseMetres>
        <lowCruiseMetres>3050</lowCruiseMetres>
        <size>3</size>
      </airTrack>
    </avionics>
    <!-- One cargo hook: 10,000 lb, 4,536 kg [P, the guide]; with the cargo hook fitting fitted, as on every helicopter. Its second hook, an
         upgrade, raises it to 6,804 kg. -->
    <sling>
      <ratedKilograms>4536</ratedKilograms>
    </sling>
    <!-- Its upgrades' draws (D'thorga Vehicles 0.72.0): each only while its node is fitted and the engines run (the engines' condition
         was missing until 0.82.0, fault-read D5: they drew from a parked aircraft's battery). The jammer's 40 A is authored; the radar's is
         the avionics rule's radar figure. -->
    <loads>
      <li>
        <name>infraredJammer</name>
        <label>infrared jammer</label>
        <description>The two jammer turrets, ready to blind a missile the warning receiver hears.</description>
        <amps>40</amps>
        <available Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_InfraredJammer</stat>
          <value>0</value>
        </available>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>terrainRadar</name>
        <label>terrain-following radar</label>
        <description>The radar in the nose, sweeping the ground ahead.</description>
        <amps>20</amps>
        <available Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_TerrainRadar</stat>
          <value>0</value>
        </available>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <!-- The belly gun's station (0.82.0, fault-read D4). Aircraft carry no turret drive load (Framework 0.117.2: nobody cranks a Hind's
             gun), so nothing could stop the belly gun for want of power. This one is fitted only while a powered weapon is aboard, which on
             the Osprey is the belly gun alone (the ramp guns are swung by hand), and draws only while the gun has a target, as every weapon
             no seat works does. With no power and nobody aboard the gun stops. 25 A authored: a small remote turret's drive and sight. -->
        <name>turretDrive</name>
        <label>belly gun station</label>
        <description>The belly gun's drive and sight, drawing while it tracks a target. Without power the gun stops.</description>
        <amps>25</amps>
        <shedOrder>7</shedOrder>
        <available Class="Phobos.VehicleSystems.When_HasPoweredWeapon" />
        <when Class="Phobos.VehicleSystems.When_PoweredWeaponManned" />
      </li>
    </loads>
    <!-- The aircraft loadout puts its generator, battery, starter, avionics bay, ferry tank tie-downs and cabin oxygen panel on the engine's
         cells. Here "Engine" is the left nacelle, so all of them sat out on the left wingtip, and fire there hit them while the right nacelle
         carried none (fault-read A2, 19 Nov 2026; D'thorga Vehicles 0.84.0). They go in the forward cabin's cells instead [A]: the
         batteries, avionics and cabin fittings are in the real fuselage [I]; where the real generators and starter sit was not checked, and
         one place for all keeps both nacelles alike. -->
    <cellsOfRemap>
      <li>
        <from>Engine</from>
        <to>Cabin</to>
      </li>
    </cellsOfRemap>
    <partRoles>
      <li>
        <!-- The hook mount: 60 health, inner, under the forward cabin's floor (the record's parts table). -->
        <role>HookMount</role>
        <add>
          <key>PhobosHookMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>hook mount</label>
          <health>60</health>
          <cellsOf>Cabin</cellsOf>
        </add>
      </li>
      <li>
        <role>Engine1</role>
        <find>
          <li><key>LeftEngine</key></li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li><key>RightEngine</key></li>
        </find>
      </li>
      <li>
        <!-- D'thorga Vehicles 0.87.0: the interconnect shaft is costed as a drive shaft, not a gearbox. A part's first role sets what it
             costs to replace, so this comes before the rotor drive, which still holds the shaft: its condition still limits the rotors. -->
        <role>DriveShaft</role>
        <find>
          <li><key>InterconnectShaft</key></li>
        </find>
      </li>
      <li>
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>ProprotorGearbox</li>
              <li>InterconnectShaft</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <!-- D'thorga Vehicles 0.87.0: each of the three channels is a flight computer, replaced whole. -->
        <role>FlightControl</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>FlightControl</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicPump</role>
        <find>
          <li><key>Hydraulics</key></li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li><key>Hydraulics</key></li>
        </find>
      </li>
      <li>
        <role>Cabin</role>
        <find>
          <li><key>ForwardCabin</key></li>
        </find>
      </li>
      <li>
        <!-- The three undercarriage legs, which a rolling or hard landing wears (0.82.0, fault-read D7: with none bound, the wear fell on a
             random outer part, the cockpit or a wing as often as the gear). -->
        <role>LandingGear</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>NoseGear</li>
              <li>MainGear</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
