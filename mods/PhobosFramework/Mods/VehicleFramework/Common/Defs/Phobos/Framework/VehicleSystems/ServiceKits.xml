<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Consumables as items (S4 of docs/development/vehicle-crosslinks.md; owner, 10 Nov 2026: agreed). The parts bench makes them
       from exactly what each service took before, so nothing costs more; what changes is that a service needs the kit aboard, so a caravan
       carries kits and the colony keeps a stock. A save from before them keeps paying in raw materials until the player switches it off
       (GameComponent_PhobosServiceKits). Work, skill, mass and value are authored; value is near the materials' own. Each kit has a picture
       of its own, picked by the owner on 11 Nov 2026 (batch A; the records sit beside the textures in Textures/Phobos/Vehicles/Parts). -->

  <ThingDef Name="PhobosServiceKitBase" ParentName="ResourceBase" Abstract="True">
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <thingCategories>
      <li>PhobosCategory_VehicleParts</li>
    </thingCategories>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <workSkill>Crafting</workSkill>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
      <recipeUsers>
        <li>PhobosVehicles_PartsBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="PhobosServiceKitBase">
    <defName>PhobosVehicles_TyreSet</defName>
    <label>tyre set</label>
    <description>A vehicle's worth of tyres or track pads, with their beads, valves and fixings, ready to fit. A mechanic renews a vehicle's worn tyres or tracks with one loaded aboard.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/TyreSet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>120</MarketValue>
      <Mass>20</Mass>
      <Flammability>1</Flammability>
      <WorkToMake>1500</WorkToMake>
    </statBases>
    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Chemfuel>10</Chemfuel>
    </costList>
  </ThingDef>

  <ThingDef ParentName="PhobosServiceKitBase">
    <defName>PhobosVehicles_BrakePadSet</defName>
    <label>brake pad set</label>
    <description>Brake pads and shoes for every wheel of a vehicle. A mechanic fits new brakes with one loaded aboard.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/BrakePadSet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>20</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>40</MarketValue>
      <Mass>4</Mass>
      <Flammability>0.2</Flammability>
      <WorkToMake>600</WorkToMake>
    </statBases>
    <costList>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>

  <ThingDef ParentName="PhobosServiceKitBase">
    <!-- Framework 0.123.0 (cross-links round two T4): a clutch wears with take-offs and is renewed with this. Its own picture since Framework 0.210.2
         (paid redraw, the owner's pick of 21 Nov 2026); it borrowed the drivetrain kit's before. Materials, work, mass and value authored. -->
    <defName>PhobosVehicles_ClutchKit</defName>
    <label>clutch kit</label>
    <description>A clutch plate, pressure plate and release bearing for one vehicle. A mechanic fits a new clutch with one loaded aboard.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/ClutchKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>45</MarketValue>
      <Mass>8</Mass>
      <Flammability>0.3</Flammability>
      <WorkToMake>900</WorkToMake>
    </statBases>
    <costList>
      <Steel>8</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>

  <ThingDef ParentName="PhobosServiceKitBase">
    <defName>PhobosVehicles_ServiceKit</defName>
    <label>engine service kit</label>
    <description>Oil, filters and seals for one engine service. A mechanic services an engine with one loaded aboard.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/EngineServiceKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>20</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>60</MarketValue>
      <Mass>6</Mass>
      <Flammability>1</Flammability>
      <WorkToMake>800</WorkToMake>
    </statBases>
    <costList>
      <Chemfuel>9</Chemfuel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>

  <ThingDef ParentName="PhobosServiceKitBase">
    <defName>PhobosVehicles_DriveBelt</defName>
    <label>drive belt</label>
    <description>A rubber drive belt that turns an engine's water pump and alternator. A spare one in the cargo puts a vehicle back on the road when its belt snaps far from home.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/DriveBelt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>15</MarketValue>
      <Mass>1</Mass>
      <Flammability>1</Flammability>
      <WorkToMake>400</WorkToMake>
    </statBases>
    <costList>
      <Chemfuel>4</Chemfuel>
    </costList>
  </ThingDef>

  <!-- Framework 0.178.0 (owner, 19 Nov 2026): the hot-section overhaul's own kit, made from exactly what the overhaul took before, as the
       other kits were. Worth near its materials; work, skill and mass authored. -->
  <ThingDef ParentName="PhobosServiceKitBase">
    <defName>PhobosVehicles_HotSectionKit</defName>
    <label>hot-section kit</label>
    <description>A combustion liner, a few spare turbine blades and seals for overhauling one gas turbine's hot section. A mechanic overhauls a worn hot section with one loaded aboard, by a tuning rig.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/HotSectionKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>190</MarketValue>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
      <WorkToMake>1500</WorkToMake>
    </statBases>
    <costList>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>PhobosResearch_Turbines</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
</Defs>
