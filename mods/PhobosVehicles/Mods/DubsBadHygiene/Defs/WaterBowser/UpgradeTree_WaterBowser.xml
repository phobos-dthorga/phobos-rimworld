<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The water bowser's upgrades (D'thorga Vehicles 0.55.0). Figures and costs authored. Node keys are saved in the game: never rename or remove one. The icons
       are the tanker's for the same things (an insulated tank, a hose reel). Each shows on the body (the vehicle's node looks, 16 Nov 2026). Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef DBHLite="true">
    <defName>Phobos_WaterBowser_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>PhobosBowserLagging</key>
      <label>Lagged tank</label>
      <displayLabel>true</displayLabel>
      <description>Insulation round the tank: the water takes four times as long to reach the outside temperature, so it freezes later on a cold night.</description>
      <icon>Phobos/Vehicles/BulkTanker/Upgrades/InsulatedLiquidTank</icon>
      <work>2000</work>
      <gridCoordinate>(2, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>60</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosBowserSecondHose</key>
      <label>Second hose</label>
      <displayLabel>true</displayLabel>
      <description>A second hose and a bigger pump outlet: the pump moves half as much again.</description>
      <icon>Phobos/Vehicles/BulkTanker/Upgrades/HoseReel</icon>
      <work>1200</work>
      <gridCoordinate>(7, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_PumpRate</def>
              <value>200</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <!-- D'thorga Vehicles 0.88.0: its hose comes from its parts bill (Bill_WaterBowser.xml): the coupling and nozzle are what is left. -->
      <ingredients>
        <Steel>10</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Vehicles 0.118.0 (the owner's cards of 25 Nov 2026): a trailer has no engine, so without this its pump pushes nothing out.
           Its motor comes from the parts bill; nothing visible on the body, so no overlay; the picture is the Ullage's electric pump's.
           Materials and work authored. -->
      <key>PhobosTrailerElectricPump</key>
      <label>Electric pump</label>
      <displayLabel>true</displayLabel>
      <description>An electric motor on the pump, so the trailer can pump its load out. It runs off the grid through a conduit touching the trailer where it is parked, off a power point it has set out, or off the battery of the vehicle towing it. Without it, the trailer can only be filled, or emptied by a pump beside it.</description>
      <icon>Phobos/VehicleSystems/Fittings/DeepCycleBattery</icon>
      <work>1500</work>
      <gridCoordinate>(12, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_ElectricPump</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
