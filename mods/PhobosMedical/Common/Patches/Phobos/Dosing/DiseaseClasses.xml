<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Each disease's class (D'thorga Medical 0.33.0; docs/development/medical-care-round-two.md). Every patch acts only when its
       disease exists, so another mod's disease costs nothing when that mod is absent. Another mod classes its own diseases the same
       way. A disease left unclassed takes any drug for fighting disease. -->
  <!-- bacterial -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[defName="Plague"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/HediffDef[defName="Plague"]</xpath>
      <value>
        <li Class="Phobos.Dosing.Defs.PhobosDiseaseClassExtension">
          <diseaseClass>PhobosDisease_Bacterial</diseaseClass>
        </li>
      </value>
    </match>
  </Operation>
