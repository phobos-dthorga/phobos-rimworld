<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Radio Framework's tie-in with InterRim Ballistic Missile (Radio 0.74.0; docs/development/radar-and-air-defence.md, the owner's
       card of 28 Nov 2026): our radars see its missiles in flight, and an enemy missile our radars see is detected for its own window too.
       Its own assembly in Mods/IRBM/1.7, which LoadFolders.xml loads only while InterRim Ballistic Missile is active. RimWorld 1.7 only.
       IRBM's assembly is referenced from the installed mod, never copied. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Radio.Irbm</RootNamespace>
    <AssemblyName>PhobosRadio.Irbm</AssemblyName>
    <ModFolder>PhobosRadioFramework</ModFolder>
    <TieInFolder>Mods/IRBM/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.74.0</Version>
    <!-- IRBM targets .NET Framework 4.8, and the game loads it whatever it declares, so the mismatch only matters to the compiler's check. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosRadio/PhobosRadio.csproj" Private="false" />
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="IRBM">
      <HintPath>$(IrbmAssemblies)\IRBM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
