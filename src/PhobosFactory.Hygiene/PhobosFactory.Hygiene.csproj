<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Factory Additions' Dubs Bad Hygiene tie-in, in its own assembly so the core assembly never references an
       optional mod. LoadFolders.xml loads Mods/DubsBadHygiene (its XML) and Mods/DubsBadHygiene/<version> (its assembly)
       only while Dubs Bad Hygiene is active. Built for 1.7 only, like the core; building this also builds the core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Factory.Hygiene</RootNamespace>
    <AssemblyName>PhobosFactory.Hygiene</AssemblyName>
    <ModFolder>PhobosFactoryAdditions</ModFolder>
    <TieInFolder>Mods/DubsBadHygiene/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.12.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Referenced from the installed mods (one folder per game version) and never copied, as in PhobosFactory.csproj. -->
    <Reference Include="PipeSystem">
      <HintPath>$(VefAssemblies)\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BadHygiene">
      <HintPath>$(DbhAssemblies)\BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="../PhobosFactory/PhobosFactory.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- D'thorga Framework's plumbing reader, shared with the oxygen electrolyser; it ships only in the framework's own mod. -->
    <ProjectReference Include="../PhobosFramework.Hygiene/PhobosFramework.Hygiene.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
