<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Breathing held up by a ventilator through a tube. The code picks the stage: stage n adds n tenths of breathing, the fewest that
       reach the rules Def's floor (0.6). minSeverity only keeps the stages in the rising order the game needs. A ceiling of normal, as
       on oxygen. Lingers 600 ticks after the machine's last pass (250), authored. -->
  <HediffDef>
    <defName>PhobosMedical_Ventilated</defName>
    <label>on a ventilator</label>
    <labelNoun>mechanical ventilation</labelNoun>
    <description>A machine is breathing for this patient through a breathing tube. It holds failing breathing up to a safe level for as long as the machine runs, and stops soon after it does.</description>
    <hediffClass>Phobos.Medical.Comps.Hediff_PhobosVentilated</hediffClass>
    <defaultLabelColor>(0.55, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="Phobos.Framework.Health.HediffCompProperties_PhobosTreatment">
        <lingerTicks>600</lingerTicks>
      </li>
    </comps>
    <stages>
      <li/>
      <li><minSeverity>0.01</minSeverity><capMods><li><capacity>Breathing</capacity><offset>0.1</offset><setMax>1</setMax></li></capMods></li>
      <li><minSeverity>0.02</minSeverity><capMods><li><capacity>Breathing</capacity><offset>0.2</offset><setMax>1</setMax></li></capMods></li>
      <li><minSeverity>0.03</minSeverity><capMods><li><capacity>Breathing</capacity><offset>0.3</offset><setMax>1</setMax></li></capMods></li>
      <li><minSeverity>0.04</minSeverity><capMods><li><capacity>Breathing</capacity><offset>0.4</offset><setMax>1</setMax></li></capMods></li>
      <li><minSeverity>0.05</minSeverity><capMods><li><capacity>Breathing</capacity><offset>0.5</offset><setMax>1</setMax></li></capMods></li>
      <li><minSeverity>0.06</minSeverity><capMods><li><capacity>Breathing</capacity><offset>0.6</offset><setMax>1</setMax></li></capMods></li>
    </stages>
  </HediffDef>

  <!-- A breathing tube through the mouth and past the vocal cords. It takes the place of a swollen upper airway (the airway burn goes) and
       lets a ventilator breathe for the patient. It comes out after two days (authored: past the airway burn's 48 hours). -->
  <HediffDef>
    <defName>PhobosMedical_Intubated</defName>
    <label>intubated</label>
    <labelNoun>a breathing tube</labelNoun>
    <description>A tube through the mouth and past the vocal cords into the windpipe, so air gets past a swollen airway and a ventilator can breathe for the patient. They cannot speak while it is in. It comes out after a couple of days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.7, 0.9)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Talking</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="Phobos.Medical.Defs.PhobosOpenAirwayExtension" />
    </modExtensions>
  </HediffDef>
</Defs>
