<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The oxygen concentrator while it is powered. Agent-made with Stable Audio 3 Small SFX and picked by the owner (10 Nov 2026);
       levelled by scripts/art/export_sound.py 3 dB under the game's Hemopump_Ambience, whose volume, distance and voice limits this
       copies, as a concentrator sits beside sleeping patients. The record beside the sound file says how it was made. The volume
       extension lets D'thorga Framework's sound volume setting scale it. -->
  <SoundDef>
    <defName>PhobosMedical_ConcentratorHum</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>1</maxSimultaneous>
    <maxVoices>1</maxVoices>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/Medical/ConcentratorHum</clipPath>
          </li>
        </grains>
        <volumeRange>50</volumeRange>
        <distRange>5~20</distRange>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>

  <!-- Oxygen flowing from a cylinder's regulator to a patient: the bedside oxygen stand and the cylinder trolley while they treat someone.
       Agent-made with Stable Audio 3 Small SFX, taken from the agent's shortlist by the owner (10 Nov 2026), levelled 6 dB under the game's
       HissSmall, whose volume this copies. One regulator, so one sound (docs/development/sound-catalogue.md, S14). -->
  <SoundDef>
    <defName>PhobosMedical_OxygenRegulator</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/Medical/OxygenRegulator</clipPath>
          </li>
        </grains>
        <volumeRange>15</volumeRange>
        <distRange>5~15</distRange>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>
</Defs>
