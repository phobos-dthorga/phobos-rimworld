<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The drill rig's upgrades (docs/development/vehicle-drill-rig.md). Figures and costs authored. A bare rig drills at ten times a deep drill, the diamond bit at twenty (owner, 9 Nov 2026). Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_DrillRig_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>DiamondBit</key>
      <label>Diamond core bit</label>
      <displayLabel>true</displayLabel>
      <description>A slim bit that cuts a core of rock. The rig drills at twenty times a deep drill, on ore and on stone.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/DiamondBit</icon>
      <work>2500</work>
      <gridCoordinate>(2, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>DeepDrilling</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>RcHammer</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_DrillRate</def>
              <value>10</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Plasteel>30</Plasteel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_DiamondBit</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>RcHammer</key>
      <label>RC hammer</label>
      <displayLabel>true</displayLabel>
      <description>A reverse-circulation hammer, which blows its cuttings up inside the rods, on a bigger air line: eighteen times a deep drill on ore, and thirty once only stone is left.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/RcHammer</icon>
      <work>2500</work>
      <gridCoordinate>(7, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>DeepDrilling</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>DiamondBit</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_DrillRate</def>
              <value>8</value>
            </li>
            <li>
              <def>Phobos_BedrockFactor</def>
              <value>1.667</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_Hammer</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>TallMast</key>
      <label>Tall mast</label>
      <displayLabel>true</displayLabel>
      <description>A longer mast section. The string can be walked further from the hole, from about 2.6 cells to about 3.6, at some cost in stability.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/TallMast</icon>
      <work>3000</work>
      <gridCoordinate>(2, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>DeepDrilling</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_DrillReach</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_RigStability</def>
              <value>-0.15</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>ElectricPowerPack</key>
      <label>Electric power pack</label>
      <displayLabel>true</displayLabel>
      <description>A cable and a switchbox. Beside a powered grid the rig drills on the grid with its engine off, burning no fuel.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/ElectricPowerPack</icon>
      <work>2000</work>
      <gridCoordinate>(7, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_ElectricDrill</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <!-- D'thorga Vehicles 0.88.0: its electric motor and hydraulic pump come from its parts bill (Bill_DrillRig.xml): the frame and tank are what is left. -->
      <ingredients>
        <Steel>45</Steel>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_PowerPack</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>WorkLights</key>
      <label>Work lights</label>
      <displayLabel>true</displayLabel>
      <description>Lamp masts on the cab and rear. Without them, drilling at night goes at 80% of the rate.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/WorkLights</icon>
      <work>1000</work>
      <gridCoordinate>(12, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_WorkLights</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_WorkLights</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Armour kits without a picture of their own (D'thorga Vehicles 0.80.0; vehicle-militarised-service-vehicles.md, "The kits").
           Each raises named parts by class with Add (vehicle-armour.md; Combat Extended's figures in Mods/CombatExtended), and its real
           kilograms [A] load the engine as cargo would (owner, 19 Nov 2026), taking cargo room on the Talus only. Figures and costs authored.
           scripts/check-vehicle-armour.py holds each kit to its class on both scales. Not yet tested in game. -->
      <key>PhobosEngineGuards</key>
      <label>Engine and tank guards</label>
      <displayLabel>true</displayLabel>
      <description>Steel guards around the engine and the fuel tank, against rifle fire. A guarded tank still leaks and a guarded engine still burns once they are finally holed: it takes heavier fire to get there.</description>
      <upgradeExplanation>Engine and fuel tank: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 300 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EngineGuards</icon>
      <work>2500</work>
      <gridCoordinate>(29, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Engine</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>FuelTank</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>100</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRunFlatTyres</key>
      <label>Run-flat tyres</label>
      <displayLabel>true</displayLabel>
      <description>Steel-belted tyres with run-flat inserts, so the wheels shrug off shell fragments and pistol bullets.</description>
      <upgradeExplanation>Wheels: from skin to splinter armour, which stops shell fragments and pistol bullets.\nKit weight: 120 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RunFlatTyres</icon>
      <work>1500</work>
      <gridCoordinate>(34, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>FrontWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>RearWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>120</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>30</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosEmpHardening</key>
      <label>EMP hardening</label>
      <displayLabel>true</displayLabel>
      <description>Shielded wiring, filtered power and a spare engine control unit, so an electromagnetic pulse does the electrics less harm and stalls the engine less often, as it does on a military vehicle.</description>
      <upgradeExplanation>Electrics: an electromagnetic pulse harms them as it does a military vehicle's.\nKit weight: 60 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EmpHardening</icon>
      <work>2000</work>
      <gridCoordinate>(39, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_EmpHardening</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>60</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- The drawn armour kits (D'thorga Vehicles 0.86.0; vehicle-militarised-service-vehicles.md, "The kits"), with their
           pictures from paid edits of the picked body (owner's picks of 19 Nov 2026). Armour by class with Add, Combat Extended's
           figures in Mods/CombatExtended; real kilograms [A] load the engine as cargo would, taking cargo room on the Talus only.
           Figures and costs authored. Not yet tested in game. -->
      <key>PhobosArmouredCab</key>
      <label>Armoured cab</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel plates over the cab's roof and doors and a steel frame round a narrowed windscreen, so ordinary rifle bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 1,000 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/ArmouredCab</icon>
      <work>4000</work>
      <gridCoordinate>(39, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1000</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>250</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRamBar</key>
      <label>Ram bar</label>
      <displayLabel>true</displayLabel>
      <description>A heavy steel beam across the front, braced back to the chassis. Driving into an animal, a raider or a wall harms the truck half as much, and what it hits more.</description>
      <upgradeExplanation>Damage the truck takes from running into people and animals: half (0.50 to 0.25).\nFrom running into buildings: half (0.10 to 0.05).\nDamage it does to people and animals it runs into: half as much again (0.50 to 0.75); to buildings, 2.5 to 3.0.\nKit weight: 150 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RamBar</icon>
      <work>1500</work>
      <gridCoordinate>(29, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <statCategories>
            <li>
              <def>PawnCollisionRecoilMultiplier</def>
              <value>-0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionRecoilMultiplier</def>
              <value>-0.05</value>
              <type>Add</type>
            </li>
            <li>
              <def>PawnCollisionMultiplier</def>
              <value>0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionMultiplier</def>
              <value>0.5</value>
              <type>Add</type>
            </li>
          </statCategories>
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosBodyPlates</key>
      <label>Body plates</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel skirts along both sides, over the deck and chassis, so ordinary rifle bullets stop before they reach it. They show on the truck.</description>
      <upgradeExplanation>Deck and chassis: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 900 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/BodyPlates</icon>
      <work>4000</work>
      <gridCoordinate>(34, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Chassis</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>900</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>225</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosHeavyCabPlates</key>
      <label>Heavy cab plates</label>
      <displayLabel>true</displayLabel>
      <description>Thick steel slabs over the armoured cab and a steel visor over the windscreen with two vision slits, so armour-piercing rifle bullets and ordinary heavy machine-gun bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from rifle to armour-piercing rifle armour, which stops armour-piercing rifle bullets and ordinary heavy machine-gun bullets.\nKit weight: 850 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/HeavyCabPlates</icon>
      <work>5000</work>
      <gridCoordinate>(39, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_HeavyTruckArmour</li>
      </researchPrerequisites>
      <prerequisiteNodes>
        <li>PhobosArmouredCab</li>
      </prerequisiteNodes>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>850</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
