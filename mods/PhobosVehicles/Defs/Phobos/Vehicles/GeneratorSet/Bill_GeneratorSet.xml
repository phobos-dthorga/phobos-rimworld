<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What it is made of, by role (docs/development/parts-bills.md; D'thorga Vehicles 0.41.0). A diesel-electric truck of 6 tonnes on two axles: no gearbox; its traction motors are one electric drive, and its generator is in the shell.
       Its blueprint's cost list is its shell; each role is filled at start-up by an installed mod's part where it suits the
       vehicle's weight, and by ours otherwise. Counts authored, held for the owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_GeneratorSet</defName>
    <label>generator set parts</label>
    <target>Phobos_GeneratorSet_Blueprint</target>
    <parts>
      <Engine>1</Engine>
      <FuelTank>1</FuelTank>
      <Wheels>4</Wheels>
      <Suspension>2</Suspension>
      <TractionMotor>1</TractionMotor>
      <Battery>1</Battery>
      <Wiring>1</Wiring>
      <Radiator>1</Radiator>
      <Exhaust>1</Exhaust>
    </parts>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
