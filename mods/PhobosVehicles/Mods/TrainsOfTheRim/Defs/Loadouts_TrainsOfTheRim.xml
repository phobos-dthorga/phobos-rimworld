<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Trains of the Rim's steam locomotives get a boiler (docs/development/vehicle-steam-design.md; figures from
    docs/development/steam-and-diesel-electric-research.md). The fire is lit while one is drafted with fuel aboard; the mod's own
    fuel (wood or chemfuel) and rates stand. Not yet tested in game.

    - The Frisco 4-8-4 is the St. Louis-San Francisco 4500 class (secondary: Wikipedia): an 18,000 US gallon tender (68,000 L).
      Nos. 4500 to 4502 were built to burn oil, the rest coal (secondary); the mod's chemfuel and wood versions both get the same
      boiler. A big engine: firing and steam use set so it takes about 3 1/3 hours from cold to move and 8 to full pressure (inside
      the 6 to 10 hours quoted for big engines, secondary and anecdotal; authored).
    - The Tommy 0-6-0T follows the LB&SCR E2, the class Thomas was drawn from (secondary: Wikipedia): 1,090 imperial gallons of
      water in its side tanks (4,955 L). About 1 1/3 hours from cold to move and 2 3/4 to full pressure (inside the Great Central
      Railway's 3 to 7 hours to be ready for service, primary; authored).
    - Feed water lasts about 3 hours of hard work in the Frisco's tender (at 100 to 200 US gallons a mile, secondary: Union Pacific
      844's figures) and about 1 2/3 hours in the tank engine's tanks (at about 30 imperial gallons a mile, secondary: the LMS
      Society's monograph), our inference turned into the feedShare figures.
    - Their brake pipes are their brakes.
    - Water stops draw a tenth of the real figures (6,800 and 496 L) unless the player turns on realistic feed water (owner, 9 Nov
      2026). The Frisco has no fusible plug, as US rules never required one (we found no record either way for the 4500 class;
      authored), so with the boiler explosions setting on, letting its crown sheet run dry explodes the boiler. The tank engine
      follows British practice and carries a plug.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
    <defName>PhobosVehicleLoadout_TOTR_Steam</defName>
    <label>steam locomotive (4-8-4)</label>
    <kind>Steam</kind>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>TOTR_Steam_Locomotive_Frisco_Chemfuel</li>
        <li>TOTR_Steam_Locomotive_Frisco_Wood</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li>
        <def>PhobosVehicleSystem_Boiler</def>
        <set>
          <firingRate>0.17</firingRate>
          <steamUse>0.19</steamUse>
          <coolingRate>0.08</coolingRate>
          <feedShare>0.11</feedShare>
          <feedWaterLitres>68000</feedWaterLitres>
          <feedWaterLitresScaled>6800</feedWaterLitresScaled>
          <fusiblePlugFitted>0</fusiblePlugFitted>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_FusiblePlug</def></li>
      <li><def>PhobosVehicleSystem_Brakes</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Boiler</role>
        <find>
          <li>
            <key>Boiler</key>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <key>BrakePipe</key>
          </li>
        </find>
      </li>
    </partRoles>
    <loads>
      <li>
        <!-- Added in D'thorga Vehicles 0.9.1: the cab had no heater, so it only ever followed the weather. On a steam locomotive the
             firebox warms the footplate (general); it needs no current, so 0 amps. -->
        <name>cabHeater</name>
        <label>firebox warmth</label>
        <description>The firebox keeps the cab warm below 5 °C while the fire is lit and the locomotive is in steam.</description>
        <amps>0</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
    <defName>PhobosVehicleLoadout_TOTR_TankEngine</defName>
    <label>steam tank engine (0-6-0T)</label>
    <kind>Steam</kind>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>TOTR_Tank_Engine_Chemfuel</li>
        <li>TOTR_Tank_Engine_Wood</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li>
        <def>PhobosVehicleSystem_Boiler</def>
        <set>
          <firingRate>0.4</firingRate>
          <steamUse>0.45</steamUse>
          <coolingRate>0.08</coolingRate>
          <feedShare>0.2</feedShare>
          <feedWaterLitres>4955</feedWaterLitres>
          <feedWaterLitresScaled>496</feedWaterLitresScaled>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_FusiblePlug</def></li>
      <li><def>PhobosVehicleSystem_Brakes</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Boiler</role>
        <find>
          <li>
            <key>Boiler</key>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <key>BrakePipe</key>
          </li>
        </find>
      </li>
    </partRoles>
    <loads>
      <li>
        <!-- Added in D'thorga Vehicles 0.9.1: the cab had no heater, so it only ever followed the weather. On a steam locomotive the
             firebox warms the footplate (general); it needs no current, so 0 amps. -->
        <name>cabHeater</name>
        <label>firebox warmth</label>
        <description>The firebox keeps the cab warm below 5 °C while the fire is lit and the locomotive is in steam.</description>
        <amps>0</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <!--
    The Goat DE2 (TOTR_Diesel_Shunter_Locomotive), "a small 2 axle diesel electic locomotive" in the mod's words, with an Engine, a
    TractionMotor and a BrakePipe of its own (docs/development/vehicle-power-and-lift-design.md). Its figures follow the closest real
    machine found, the two-axle EffiShunter 300 (primary: CZ LOKO's product page): 328 kW, 113 kN starting tractive effort, 36 t.
    - 113 kN on 36 t is an adhesion of about 0.32 (our inference), used as the rails' grip.
    - Its continuous tractive effort is not published; the British Rail Class 08's starting pull is about 3.2 times its continuous
      (secondary: Wikipedia and the Keighley and Worth Valley Railway's data file), which gives 35 kN (our inference).
    - The engine's idle and rated speeds and the 0.8 generator-and-motor efficiency are the Framework's authored diesel-electric.
    - Real locomotives brake with air, so it gets the air brakes and an appended compressor, as the Big Rig does; no gearbox, clutch
      or tyres.
  -->
  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_GoatDE2</defName>
    <label>two-axle diesel-electric shunter</label>
    <engine>
      <kind>Piston</kind>
      <idleRpm>450</idleRpm>
      <launchRpm>450</launchRpm>
      <ratedRpm>1000</ratedRpm>
      <ratedKilowatts>328</ratedKilowatts>
    </engine>
    <transmission>
      <kind>DieselElectric</kind>
      <efficiency>0.8</efficiency>
      <maxTractiveEffortKilonewtons>113</maxTractiveEffortKilonewtons>
      <continuousTractiveEffortKilonewtons>35</continuousTractiveEffortKilonewtons>
    </transmission>
    <running>
      <drivenShare>1</drivenShare>
      <fixedRollingResistance>0.002</fixedRollingResistance>
      <fixedGrip>0.32</fixedGrip>
      <dragArea>8</dragArea>
    </running>
    <mass>
      <emptyKilograms>36000</emptyKilograms>
    </mass>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_TOTR_GoatDE2</defName>
    <label>diesel-electric shunter</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>TOTR_Diesel_Shunter_Locomotive</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
    <systems Inherit="False">
      <li>
        <def>PhobosVehicleSystem_Electrical</def>
        <set>
          <batteryAmpHours>100</batteryAmpHours>
          <alternatorAmps>100</alternatorAmps>
          <starterAmpHours>0.3</starterAmpHours>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_Cooling</def></li>
      <li><def>PhobosVehicleSystem_Lubrication</def></li>
      <li><def>PhobosVehicleSystem_Fuel</def></li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Brakes</def></li>
      <li><def>PhobosVehicleSystem_AirBrakes</def></li>
      <li><def>PhobosVehicleSystem_TractionMotors</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_GoatDE2</def>
    </drivetrain>
    <partRoles Inherit="False">
      <li>
        <role>Engine</role>
        <find>
          <li>
            <key>Engine</key>
          </li>
        </find>
      </li>
      <li>
        <role>Alternator</role>
        <find>
          <li>
            <keyContains>alternator</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosAlternator</key>
          <label>auxiliary generator</label>
          <health>25</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Battery</role>
        <find>
          <li>
            <keyContains>battery</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosBattery</key>
          <label>battery</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Starter</role>
        <find>
          <li>
            <keyContains>starter</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosStarter</key>
          <label>starter motor</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>OilPump</role>
        <find>
          <li>
            <keyContains>oilpump</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosOilPump</key>
          <label>oil pump</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Radiator</role>
        <find>
          <li>
            <keyContains>radiator</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosRadiator</key>
          <label>radiator</label>
          <health>30</health>
          <depth>External</depth>
          <hitWeight>0.5</hitWeight>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Wheels</role>
        <all>true</all>
        <find>
          <li>
            <tag>Wheel</tag>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <key>BrakePipe</key>
          </li>
        </find>
      </li>
      <li>
        <role>TractionMotor</role>
        <find>
          <li>
            <key>TractionMotor</key>
          </li>
        </find>
      </li>
      <li>
        <role>Compressor</role>
        <find>
          <li>
            <keyContains>compressor</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosAirCompressor</key>
          <label>air compressor</label>
          <health>25</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
    </partRoles>
      <!-- Automatic climate control (D'thorga Vehicles 0.10.0): a modern diesel-electric shunter has an automatic cab climate system (general). -->
    <cabin>
      <climateControl>true</climateControl>
    </cabin>
</Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
