<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Avionics (Framework 0.110.0; docs/development/vehicle-avionics.md, the fit, A1 and A2). What an aircraft carries is its loadout's avionics
    fit, which sets this system's parameters (takesAvionicsFit); the fit also sets what the avionics loads draw. Each capability reads as working
    when its part (the avionics role: the aircraft's own instrument panel, our Harrier avionics part, or an appended avionics bay) is healthy
    and the battery has charge; a full navigation set also needs the battery not to be shedding loads, as it is not kept on the battery.

    The real basis (sources in the record): flying without sight of the ground needs attitude and heading instruments (14 CFR 91.205, the FAA's
    Pilot's Handbook chapter 8), and a pilot without them in cloud or darkness loses control. Every figure here is authored: the stage
    thresholds, and navigation's 0.85 on speed and 1.15 on fuel for a wandering track. Only attitude and navigation have effects in this batch;
    the other capabilities of the fit draw their power and wait for their rules (autopilot, sights, radar, oxygen: later batches).
    Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Avionics</defName>
    <label>avionics</label>
    <description>The instruments and navigation set. Without working instruments the aircraft may not take off at night or in fog; without navigation it wanders off track and flies further for the same trip.</description>
    <takesAvionicsFit>true</takesAvionicsFit>
    <roles>
      <li>Avionics</li>
      <!-- Aircraft service-life upgrades (21 Nov 2026): the parts the autopilot, the night sight and the radar sit on, appended to every
           aircraft by its loadout (the Harrier's own nose radar part where it has one). -->
      <li>AutopilotMount</li>
      <li>SensorMount</li>
      <li>RadarMount</li>
    </roles>
    <parameters>
      <!-- Set from the loadout's avionics fit: 1 carried, 0 not. -->
      <attitude>1</attitude>
      <navigation>1</navigation>
      <navigationFull>0</navigationFull>
      <!-- The air-combat batch (Framework 0.119.0): the warning receiver, chaff and flare dispensers, crew oxygen, and whether the aircraft
           cruises where its crew needs oxygen (avionics A14, A16; air-defence tie-ins AD2). -->
      <warning>0</warning>
      <countermeasures>0</countermeasures>
      <oxygen>0</oxygen>
      <cruisesHigh>0</cruisesHigh>
      <!-- Aircraft service-life upgrades (21 Nov 2026): the capabilities a kit can add (a fitting's parameterFloors raises them for one aircraft),
           and what avionics A3, A10 and A11 read. -->
      <autopilot>0</autopilot>
      <sight>0</sight>
      <sightFull>0</sightFull>
      <nightSight>0</nightSight>
      <radar>0</radar>
    </parameters>
    <quantities>
      <li>
        <name>attitude</name>
        <description>The attitude, heading and airspeed instruments: what lets a crew fly without seeing the ground.</description>
        <label>flight instruments</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>attitude</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.2</to>
            <label>out</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseLaunch">
                <reason>PhobosVehicleSystems_RefuseLaunchBlind</reason>
                <warnOnlySetting>blindFlightWarnOnly</warnOnlySetting>
                <warning>PhobosVehicleSystems_MsgFlyingBlind</warning>
                <when Class="Phobos.VehicleSystems.When_PoorVisibility" />
              </li>
            </effects>
          </li>
          <li>
            <from>0.2</from>
            <to>0.6</to>
            <label>unreliable</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseLaunch">
                <reason>PhobosVehicleSystems_RefuseLaunchBlind</reason>
                <warnOnlySetting>blindFlightWarnOnly</warnOnlySetting>
                <warning>PhobosVehicleSystems_MsgFlyingBlind</warning>
                <when Class="Phobos.VehicleSystems.When_PoorVisibility" />
              </li>
            </effects>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <li>
        <name>navigation</name>
        <description>Compass and radio aids, enough to hold a course. Without them a flight wanders and burns more fuel.</description>
        <label>navigation</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>navigation</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>lost</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightSpeed</stat>
                <factor>0.85</factor>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_FlightFuel">
                <factor>1.15</factor>
              </li>
            </effects>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
            <effects>
              <!-- Basic navigation alone, at night or in fog: the track still wanders. A working full set flies straight in anything. A
                   working autopilot halves the wandering (avionics A3; aircraft service-life upgrades, 21 Nov 2026). -->
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightSpeed</stat>
                <factor>0.85</factor>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_PoorVisibility" />
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>navigationFull</quantity>
                      <value>0.6</value>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>autopilot</quantity>
                      <value>0.6</value>
                    </li>
                  </conditions>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_FlightFuel">
                <factor>1.15</factor>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_PoorVisibility" />
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>navigationFull</quantity>
                      <value>0.6</value>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>autopilot</quantity>
                      <value>0.6</value>
                    </li>
                  </conditions>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightSpeed</stat>
                <factor>0.925</factor>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_PoorVisibility" />
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>navigationFull</quantity>
                      <value>0.6</value>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_QuantityAbove">
                      <quantity>autopilot</quantity>
                      <value>0.59</value>
                    </li>
                  </conditions>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_FlightFuel">
                <factor>1.075</factor>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_PoorVisibility" />
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>navigationFull</quantity>
                      <value>0.6</value>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_QuantityAbove">
                      <quantity>autopilot</quantity>
                      <value>0.59</value>
                    </li>
                  </conditions>
                </when>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>navigationFull</name>
        <description>An inertial or Doppler navigation set and moving map, which holds a course at night and in fog. Not kept on the battery.</description>
        <label>full navigation</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>navigationFull</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_LoadShedding">
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
      </li>
      <!--
        The warning receiver (Framework 0.119.0; air-defence tie-ins AD2). It hears the radars searching for the aircraft, locking on and
        guiding a shot. Working, it tells the crew in time: they are told, and fire chaff and flares on its cue (A16). Out, the crew learns
        of a shot only when they see it. Kept on the battery (essential). Real basis: the AV-8B carries an AN/ALR-67 receiver and the Mi-24 a
        receiver of its own (secondary sources, docs/development/vehicle-avionics.md, section 4). The figures that use it are authored.
      -->
      <li>
        <name>warningReceiver</name>
        <description>The radar warning receiver: tells the crew when a radar is tracking them, locking on or guiding a shot.</description>
        <label>warning receiver</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>warning</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <!--
        Chaff and flare dispensers (Framework 0.119.0; avionics A16). The dispensers fire cartridges carried in the aircraft's cargo; with none
        aboard they do nothing. Kept on the battery. Real basis: the AV-8B's AN/ALE-39 and the Mi-24's ASO-2 (secondary sources, as above).
      -->
      <li>
        <name>countermeasures</name>
        <description>The chaff and flare dispensers. They fire the countermeasure cartridges loaded into their magazine.</description>
        <label>chaff and flare dispensers</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>countermeasures</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <!--
        Crew oxygen (Framework 0.119.0; avionics A14 with L3). The AV-8B was the first United States production combat aircraft with an
        on-board oxygen generator, which sieves engine bleed air (MiGFlug, a secondary source): so the set needs its part, its power and an
        engine giving bleed air. United States rules allow no more than 30 minutes above 12,500 ft cabin altitude without extra oxygen, and
        none above 14,000 ft (14 CFR 91.211, primary). An aircraft that cruises high (cruisesHigh) with its oxygen out flies its world legs
        low instead: slower, and thirstier in the thicker air. Factors authored. Hypoxia for a crew whose oxygen fails while already high is
        the player's setting, off by default.
      -->
      <li>
        <name>crewOxygen</name>
        <description>The crew's oxygen for a high cruise, made from engine bleed air.</description>
        <label>crew oxygen</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>oxygen</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Bleed" />
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
            <effects>
              <!-- Framework 0.141.0: where the cruising height between tiles governs the aircraft, the height flown sets its speed and fuel
                   (the oxygen line keeps it down), so these fixed figures stand only where it does not. -->
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightSpeed</stat>
                <factor>0.85</factor>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_ParameterBelow">
                      <parameter>cruisesHigh</parameter>
                      <value>0.5</value>
                      <invert>true</invert>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_CruiseHeight">
                      <invert>true</invert>
                    </li>
                  </conditions>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_FlightFuel">
                <factor>1.2</factor>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_ParameterBelow">
                      <parameter>cruisesHigh</parameter>
                      <value>0.5</value>
                      <invert>true</invert>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_CruiseHeight">
                      <invert>true</invert>
                    </li>
                  </conditions>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOxygenOut</message>
                <type>CautionInput</type>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_ParameterBelow">
                      <parameter>cruisesHigh</parameter>
                      <value>0.5</value>
                      <invert>true</invert>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_EngineRunning" />
                  </conditions>
                </when>
              </li>
            </effects>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
            <labelEngineOff>ready</labelEngineOff>
          </li>
        </stages>
      </li>
      <!-- Aircraft service-life upgrades (21 Nov 2026; avionics A3, A10, A11): the autopilot, the sight, the night sight and the radar, each
           carried by the aircraft's fit or a kit, read from its part and its power as the warning receiver is. Shed with the other loads. -->
      <li>
        <name>autopilot</name>
        <description>The autopilot: holds height and heading. It halves the risk of a rough landing and the wandering of a flight with only basic navigation.</description>
        <label>autopilot</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>autopilot</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>AutopilotMount</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <li>
        <name>sight</name>
        <description>The weapon sight: how the crew aims. A basic sight aims a little worse than a full one, and none at all much worse.</description>
        <label>weapon sight</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>sight</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <li>
        <name>sightFull</name>
        <description>A full sight: a head-up display or a laser rangefinder, aiming as well as the weapons allow.</description>
        <label>full sight</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>sightFull</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Avionics</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>false</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <li>
        <name>nightSight</name>
        <description>An infrared camera: lets the crew aim at night as well as by day.</description>
        <label>night sight</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>nightSight</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>SensorMount</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <li>
        <name>radar</name>
        <description>The radar: finds targets through rain, fog and snow, giving back half of what the weather takes from the aim.</description>
        <label>radar</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <parameter>radar</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>RadarMount</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.05, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.6</to>
            <label>out</label>
            <notable>true</notable>
          </li>
          <li>
            <from>0.6</from>
            <label>working</label>
          </li>
        </stages>
      </li>
    </quantities>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    Flight hydraulics (Framework 0.110.0, avionics A7). Boosted flight controls work through hydraulics: a helicopter whose hydraulics fail has
    heavy, stiff controls (Robinson R66 handbook, section 3; the FAA's Helicopter Flying Handbook, chapter 11), and the CH-47's flight controls
    work through two hydraulic systems (CH-47 technical manual). The fluid, the pump and the leaking lines are the hydraulics system's own
    (PhobosVehicleSystem_Hydraulics); this system reads them and, when pressure is low, halves the flight-control stat, which the flight
    controls system turns into slower flight or, if the controls are also damaged, a refused take-off. Pressure is read from the pump and the
    fluid, not the engine, so a parked aircraft does not show heavy controls. Figures authored. Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_FlightHydraulics</defName>
    <label>flight hydraulics</label>
    <description>The hydraulic boost on the flight controls. With the fluid low or the pump shot through, the controls are heavy and the aircraft handles badly.</description>
    <roles>
      <li>HydraulicPump</li>
    </roles>
    <parameters>
      <!-- Aircraft service-life upgrades (21 Nov 2026): 1 where the controls fall back to cables when the boost is gone (the A-10's manual
           reversion, the Su-25's manual elevator and rudder), set by the aircraft's loadout. 0: the boost is all there is. -->
      <manualReversion>0</manualReversion>
    </parameters>
    <quantities>
      <li>
        <name>flightHydraulics</name>
        <description>How much boost the flight controls have: the pump and the fluid together.</description>
        <label>control boost</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>HydraulicPump</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>hydraulicFluid</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant">
              <value>1</value>
            </fallback>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.4, 0.5)</li>
                <li>(0.7, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.4</to>
            <label>controls heavy</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightControl</stat>
                <factor>0.5</factor>
                <when Class="Phobos.VehicleSystems.When_ParameterBelow">
                  <parameter>manualReversion</parameter>
                  <value>0.5</value>
                </when>
              </li>
              <!-- With manual reversion the aircraft flies on its cables, heavily but home (aircraft service-life upgrades, 21 Nov 2026; the A-10A
                   flight manual, T.O. 1A-10A-1: "adequate for ... safe return to base and landing"). 0.7 is authored. -->
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightControl</stat>
                <factor>0.7</factor>
                <when Class="Phobos.VehicleSystems.When_ParameterBelow">
                  <parameter>manualReversion</parameter>
                  <value>0.5</value>
                  <invert>true</invert>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgControlsHeavy</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
          <li>
            <from>0.4</from>
            <label>boosted</label>
            <!-- Boost is the pump's health and the fluid, not the pressure, so a parked aircraft is not refused; with the engine off the
                 inspect line says "control boost ready", not "100% (boosted)" beside "hydraulic pressure 0%" (owner, 16 Nov 2026). -->
            <labelEngineOff>ready</labelEngineOff>
          </li>
        </stages>
      </li>
    </quantities>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
