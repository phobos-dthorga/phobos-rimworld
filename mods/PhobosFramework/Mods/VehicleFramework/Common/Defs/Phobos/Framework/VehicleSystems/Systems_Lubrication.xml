<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The lubrication system: the oil's level, temperature and pressure. Design: docs/development/vehicle-systems-design.md. Not yet
    tested in game.

    Sources and labels:
    - Engine oil runs at about 85 to 105 degrees C when warm and breaks down faster held above about 110 to 120. Secondary and low
      quality: enthusiasts' forums; to be replaced by an engine maker's manual. The 120 degree floor is authored.
    - Oil follows the coolant's temperature (authored rate), so a hot engine has hot oil. An engine with no coolant (a gas turbine,
      an air-cooled engine) has oil heated by its bearings and held down by its cooler: 55 degrees C idling to 95 at full load while it
      runs, the air once it is off (authored, no published figure checked; Framework 0.29.1, after the owner saw a running tank's oil
      at -15 degrees C).
    - Oil burned in running: 0.15 % of the sump an hour at full load (authored; real engines burn far less, but a service every
      few in-game weeks is the point).
    - Oil pressure here is the pump's ability, from the oil pump part's health and the oil level (authored curve); it does harm
      only while the engine runs.
    - A worn engine burns more oil (crosslink 3, Framework 0.68.0; docs/development/vehicle-crosslinks.md): worn rings and
      valve guides let oil past into the cylinders (secondary, approximate: engine makers' service literature as commonly cited; no
      figure checked). Twice the burn at 40% engine health and below, scaling back to the normal burn at full health (authored).
    The oil is topped up by the service (PhobosVehicleSystem_Service), which falls due as soon as the oil is below 60% while the
    player's "low oil calls for a service" setting is on (the owner's answer, 10 Nov 2026), so a worn engine is serviced sooner.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Lubrication</defName>
    <label>lubrication</label>
    <description>The engine's oil: its level, its temperature and the pump's pressure. Low oil or a damaged pump wears the engine while it runs; oil cooked too hot does too.</description>
    <roles>
      <li>Engine</li>
      <li>OilPump</li>
    </roles>
    <!-- Framework 0.320.0: every oiled engine brings the turbocharger's system, which runs only while one is built in or fitted. -->
    <comesWith>
      <li>PhobosVehicleSystem_Turbocharger</li>
    </comesWith>
    <parameters>
      <oilBurnPerHour>0.0015</oilBurnPerHour>
      <oilFollowRate>3</oilFollowRate>
      <!-- Crosslink 4 (Framework 0.69.0): fire on the body heats the oil of an engine with no coolant (a gas turbine, an air-cooled
           engine), 60 degrees an hour at full size (authored): against the oil's own pull toward its running heat that settles about
           20 degrees above it, so a jet that flew on fire lands with hot oil, a sign rather than a death. With coolant, the oil
           follows the coolant, which the fire heats (Systems_Cooling.xml). -->
      <fireHeat>60</fireHeat>
    </parameters>
    <quantities>
      <li>
        <name>oilLevel</name>
        <description>How full the sump is. A working engine burns a little, a damaged one more.</description>
        <telltale>Phobos/VehicleSystems/Dash/OilLevel</telltale>
        <showOnDashboard>true</showOnDashboard>
        <label>oil level</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.5</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOilLow</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>oilTemperature</name>
        <description>The oil's heat, which follows the coolant's. Cooking, it stops protecting the engine and the engine is damaged.</description>
        <telltale>Phobos/VehicleSystems/Dash/OilHot</telltale>
        <label>oil</label>
        <unit>Celsius</unit>
        <min>-60</min>
        <max>200</max>
        <startsAt>Ambient</startsAt>
        <stages>
          <li>
            <from>120</from>
            <label>cooking</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <perHour>0.5</perHour>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>oilPressure</name>
        <description>Oil reaching the bearings. It needs oil in the sump and a working pump.</description>
        <telltale>Phobos/VehicleSystems/Dash/OilPressure</telltale>
        <label>oil pressure</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>OilPump</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_EngineRpm">
            <!-- The pump turns with the engine: pressure is lower at idle (authored curve; a stopped engine reads as idle, so a
                 parked engine never shows low pressure on its own). -->
            <curve>
              <points>
                <li>(0, 0.75)</li>
                <li>(700, 0.75)</li>
                <li>(1500, 1)</li>
                <li>(6000, 1)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>oilLevel</quantity>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.3, 0.4)</li>
                <li>(0.6, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <!-- Nothing reaching the bearings: an engine seizes in about five hours, whatever its size (authored, 9 Nov 2026, after the owner's test; it used
                 to wear at the same 2 points an hour as low pressure, 25 hours for a 50-point engine with an empty sump). -->
            <to>0.15</to>
            <label>gone</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <sharePerHour>0.2</sharePerHour>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_SoundLoop">
                <sound>PhobosVehicleSystems_KnockDiesel</sound>
                <soundPetrol>PhobosVehicleSystems_KnockPetrol</soundPetrol>
                <whileEngineRunning>true</whileEngineRunning>
              </li>
              <!-- Framework 0.321.0: the knock seen as well as heard: dark puffs from a labouring engine, and sparks once it is seizing (worn
                   below a quarter). -->
              <li Class="Phobos.VehicleSystems.Effect_Fleck">
                <fleck>Smoke</fleck>
                <tint>RichSmoke</tint>
                <at>Exhaust</at>
                <perHour>60</perHour>
                <scale>0.7</scale>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Fleck">
                <fleck>MicroSparks</fleck>
                <at>Engine</at>
                <perHour>40</perHour>
                <scale>0.8</scale>
                <drift>false</drift>
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_EngineRunning" />
                    <li Class="Phobos.VehicleSystems.When_QuantityBelow">
                      <quantity>engineCondition</quantity>
                      <value>0.25</value>
                    </li>
                  </conditions>
                </when>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOilPressureGone</message>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_KeepFromWorkTrips">
                <!-- Framework 0.183.0 (VW8): an empty sump reads as no pressure even parked, so this keeps it in before it seizes. -->
                <reason>PhobosVehicleSystems_KeepOilGone</reason>
              </li>
            </effects>
          </li>
          <li>
            <from>0.15</from>
            <to>0.45</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <perHour>2</perHour>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOilPressureLow</message>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- Framework 0.321.0: what is left of the engine, read for its signs. Worn to 40% it burns oil (crosslink 3 doubles the burn there),
             and shows it: blue-grey smoke at the exhaust while it runs. -->
        <name>engineCondition</name>
        <label>engine</label>
        <description>What is left of the engine. Worn, it burns oil and smokes blue.</description>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <!-- Framework 0.346.0: its day is saved, so a save check can read how worn the engine was while it burned oil (row 28). -->
        <keepHistory>true</keepHistory>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartHealth">
            <role>Engine</role>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.4</to>
            <label>burning oil</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Fleck">
                <fleck>Smoke</fleck>
                <tint>OilSmoke</tint>
                <at>Exhaust</at>
                <perHour>25</perHour>
                <scale>0.6</scale>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>followCoolant</name>
        <quantity>oilTemperature</quantity>
        <kind>Toward</kind>
        <target Class="Phobos.VehicleSystems.Input_Quantity">
          <quantity>coolantTemperature</quantity>
          <fallback Class="Phobos.VehicleSystems.Input_OilWithoutCoolant" />
        </target>
        <factorParameter>oilFollowRate</factorParameter>
      </li>
      <li>
        <name>fire</name>
        <quantity>oilTemperature</quantity>
        <kind>Into</kind>
        <factorParameter>fireHeat</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_Fire" />
        </inputs>
        <when Class="Phobos.VehicleSystems.When_HasQuantity">
          <quantity>coolantTemperature</quantity>
          <invert>true</invert>
        </when>
      </li>
      <li>
        <name>burn</name>
        <quantity>oilLevel</quantity>
        <kind>From</kind>
        <factorParameter>oilBurnPerHour</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_EngineLoad" />
          <li Class="Phobos.VehicleSystems.Input_PartHealth">
            <!-- Crosslink 3: a worn engine burns more oil, twice as much at 40% health (see the comment at the top). -->
            <role>Engine</role>
            <curve>
              <points>
                <li>(0.4, 2)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
    </flows>
    <onEvents>
      <li>
        <!-- A cold start wears the engine a little (authored; small, because every draft is a start): until the oil is thin enough to
             reach the bearings at once. Read from the oil since crosslink 7 (Framework 0.70.0; before, the coolant), so it counts on
             air-cooled and turbine engines too, and a night or block heater spares it. -->
        <eventDef>IgnitionOn</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_DamagePart">
            <role>Engine</role>
            <amount>0.05</amount>
            <when Class="Phobos.VehicleSystems.When_QuantityBelow">
              <quantity>oilTemperature</quantity>
              <value>20</value>
            </when>
          </li>
          <!-- Framework 0.321.0: a cold start shows. Below 5 C it starts rich, a puff of black; below freezing the exhaust's water condenses
               white as well (authored thresholds). -->
          <li Class="Phobos.VehicleSystems.Effect_Fleck">
            <fleck>Smoke</fleck>
            <tint>RichSmoke</tint>
            <at>Exhaust</at>
            <burst>3</burst>
            <scale>0.7</scale>
            <when Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </when>
          </li>
          <li Class="Phobos.VehicleSystems.Effect_Fleck">
            <fleck>Smoke</fleck>
            <tint>Steam</tint>
            <at>Exhaust</at>
            <burst>4</burst>
            <scale>0.8</scale>
            <when Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>0</celsius>
            </when>
          </li>
        </effects>
      </li>
    </onEvents>
    <onPartHit>
      <li>
        <!-- Shares of the part's health (authored, 9 Nov 2026, after the owner's test: a wrecked pump and engine used to leave 60% of the oil, above the warning).
             A pump is mostly a pressure problem; an engine carries the sump. -->
        <role>OilPump</role>
        <quantity>oilLevel</quantity>
        <perShareLost>-0.25</perShareLost>
      </li>
      <li>
        <role>Engine</role>
        <quantity>oilLevel</quantity>
        <perShareLost>-0.6</perShareLost>
      </li>
      <li>
        <!-- The crack goes on leaking (Conditions.xml), as a holed radiator does. Authored. -->
        <role>Engine</role>
        <condition>PhobosVehicleCondition_CrackedSump</condition>
        <perShareLost>0.9</perShareLost>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
    </onPartHit>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    Fuel that thickens in deep cold, the way diesel gels. Off unless the player turns it on (settings), because chemfuel is the
    game's own fuel and nothing says it behaves like diesel: a gameplay choice, labelled so. No. 2 diesel gels near -8 degrees C
    (secondary: Wikipedia, "Gel point (petroleum)"; ASTM D975 is the authority). Warming the vehicle in a heated room fixes it.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Fuel</defName>
    <label>fuel system</label>
    <description>The fuel pump feeds the engine: a damaged one starves it of power, and a ruined one will not let it start. When the setting is on, fuel also thickens below about -8 °C and the engine will not start until the vehicle is warmer.</description>
    <roles>
      <li>FuelPump</li>
      <!-- Framework 0.123.0 (G11): the fuel tank, where a vehicle's own parts include one (Loadouts_Default.xml finds it by name). -->
      <li>FuelTank</li>
    </roles>
    <parameters>
      <!-- Framework 0.123.0 (cross-links round two F7, the fuel heater): how exposed the fuel is to gelling in the cold. 1 for every vehicle; the
           fuel heater fitting makes it 0, the block heater's pattern. -->
      <fuelGelExposure>1</fuelGelExposure>
    </parameters>
    <quantities>
      <li>
        <!-- Framework 0.55.0. The stages are authored: half a pump feeds a working engine poorly, and under a tenth it cannot feed one at all. -->
        <name>fuelFeed</name>
        <description>Fuel reaching the engine. Weak, the engine loses power and labours on hills and under load; with none it will not start.</description>
        <telltale>Phobos/VehicleSystems/Dash/Fuel</telltale>
        <label>fuel feed</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>FuelPump</role>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.1</to>
            <label>none</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseFuelPump</reason>
                <sound>PhobosVehicleSystems_FailedStartDiesel</sound>
                <soundPetrol>PhobosVehicleSystems_FailedStartPetrol</soundPetrol>
              </li>
            </effects>
          </li>
          <li>
            <from>0.1</from>
            <to>0.5</to>
            <label>weak</label>
            <notable>true</notable>
            <effects>
              <!-- Framework 0.130.0 (step S4): a weak pump starves the engine when it is asked for much, so it loses power; at a light
                   cruise it keeps up. Without the full drivetrain model, the same 0.75 on speed. -->
              <li Class="Phobos.VehicleSystems.Effect_EnginePower">
                <factor>0.75</factor>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>fuelGel</name>
        <description>How far the fuel has thickened in the cold. Gelled, the engine will not start.</description>
        <telltale>Phobos/VehicleSystems/Dash/Fuel</telltale>
        <label>fuel</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Setting">
            <setting>fuelGelling</setting>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <!-- Framework 0.123.0: the fuel heater fitting took it to 0. Since 0.334.0 the heater works through its load below instead. -->
            <parameter>fuelGelExposure</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Condition">
            <!-- Framework 0.334.0 (the fittings audit): a fuel heater keeps the fuel thin only while its load runs, from the alternator, the
                 grid or the battery; once it goes out to keep the start, the fuel can gel. Nothing without one fitted (no such load). -->
            <condition Class="Phobos.VehicleSystems.When_LoadActive">
              <load>fuelHeater</load>
              <invert>true</invert>
            </condition>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Ambient">
            <curve>
              <points>
                <li>(-20, 1)</li>
                <li>(-8, 0)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <from>0.5</from>
            <label>gelled</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseFuelGelled</reason>
                <sound>PhobosVehicleSystems_FailedStartDiesel</sound>
                <soundPetrol>PhobosVehicleSystems_FailedStartPetrol</soundPetrol>
                <!-- Framework 0.321.0: fuel cranked through without firing comes out as white smoke. -->
                <crankPuffs>3</crankPuffs>
                <crankTint>Steam</crankTint>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <onEvents>
      <li>
        <!-- T6 (cross-links round two; Framework 0.106.0): a tank run dry under a running engine. An electric fuel pump is cooled and
             lubricated by the fuel it moves, so running it dry overheats it (general service advice, secondary; the 5 % is authored).
             A tank drained on purpose while parked does not count (When_RanDry). -->
        <eventDef>OutOfFuel</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_DamagePart">
            <role>FuelPump</role>
            <share>0.05</share>
            <when Class="Phobos.VehicleSystems.When_RanDry" />
          </li>
          <li Class="Phobos.VehicleSystems.Effect_Message">
            <message>PhobosVehicleSystems_MsgRanDry</message>
            <when Class="Phobos.VehicleSystems.When_RanDry" />
          </li>
        </effects>
      </li>
      <li>
        <!-- The nozzle and the fuel going in, whoever refuels it (a pawn or a depot bay). -->
        <eventDef>Refueled</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_Sound">
            <sound>PhobosVehicleSystems_FuelNozzle</sound>
          </li>
        </effects>
      </li>
    </onEvents>
    <onPartHit>
      <li>
        <!-- Framework 0.123.0, cross-links round three G11: a shot or shrapnel through the tank leaves it leaking (Conditions.xml), as a holed
             radiator does, at 0.03 severity per hit point (authored, the battery's figure). Never on a tank whose author already made it leak
             with Vehicle Framework's own reaction, which would leak it twice. Not an animal's bite or Vehicle Framework's hand-brake scratch. -->
        <role>FuelTank</role>
        <condition>PhobosVehicleCondition_HoledTank</condition>
        <perHealthLost>0.03</perHealthLost>
        <unlessReactor>Vehicles.Reactor_FuelLeak</unlessReactor>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
    </onPartHit>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
