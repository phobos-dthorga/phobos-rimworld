<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Neither provider: our own three fallback parts, made at the machining table. Steel stays first: Vehicle Framework reads the first cost item for the destruction sound. Counts are authored. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="Phobos_Tanker_Blueprint"]/costList</xpath>
    <value>
      <costList>
              <Steel>280</Steel>
              <PhobosVehicles_EngineAssembly>1</PhobosVehicles_EngineAssembly>
              <PhobosVehicles_DrivetrainKit>1</PhobosVehicles_DrivetrainKit>
              <PhobosVehicles_ElectricalKit>1</PhobosVehicles_ElectricalKit>
              <ComponentIndustrial>8</ComponentIndustrial>
      </costList>
    </value>
  </Operation></Patch>
