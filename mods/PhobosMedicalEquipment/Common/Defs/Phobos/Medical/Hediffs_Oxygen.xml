<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The half-life is sourced: about 70 to 80 minutes on oxygen, against about 320 on room air (Weaver and colleagues, 2000, as
       cited in emergency medicine references; see docs/development/burns-and-smoke.md). The breathing figure is authored. The ceiling
       keeps a healthy pair of lungs from going past normal, and because a ceiling applies last, a closed airway stays closed. -->
  <HediffDef>
    <defName>PhobosMedical_OnOxygen</defName>
    <label>on oxygen</label>
    <labelNoun>oxygen treatment</labelNoun>
    <description>This patient is breathing supplied oxygen through a mask. It eases low breathing and clears carbon monoxide much faster. It does not repair damaged lungs, and it stops soon after they leave the bed.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="Phobos.Medical.Comps.HediffCompProperties_PhobosOnOxygen"/>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>0.2</offset>
            <setMax>1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="Phobos.Framework.Breathing.PhobosSuppliedOxygenExtension">
        <carbonMonoxideHalfLifeHours>1.25</carbonMonoxideHalfLifeHours>
      </li>
    </modExtensions>
  </HediffDef>
</Defs>
