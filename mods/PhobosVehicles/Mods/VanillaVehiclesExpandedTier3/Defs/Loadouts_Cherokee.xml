<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vanilla Vehicles Expanded - Tier 3's Cherokee (VVE_Cherokee), a tandem-rotor heavy transport helicopter in the CH-47 Chinook's
    mould: two turboshafts in pods either side of the rear pylon. Its own parts already include both (LeftTurboShaft and
    RightTurboShaft), so they are bound as the first and second engines and nothing is appended; its FrontEngine and RearEngine
    parts carry flight speed and control, and stay the engine role the shared systems read. It flies through Vehicle Framework's
    own launch, so the stock rotorcraft profile reads its phases (rotors turning when drafted, cruising in flight) and checks its
    lift before it launches. Its front and rear transmissions and rotor masts are its rotor drive (power and lift design, Framework
    0.12.0). Its drive limit, 0.9 of both engines' maximum continuous, is authored: no published figure for the CH-47's combining
    or rotor transmissions was found (8 Nov 2026), though a CH-47A/B Army document says the "transmission torque limit is reached
    before engine power limit" (seen only as a search excerpt). The turboshaft's ratings
    and limits are the Framework's authored helicopter turboshaft (Drivetrains.xml), whose one sourced figure is the CH-47's T55
    (secondary, low quality). Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Cherokee</defName>
    <label>tandem-rotor transport helicopter</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Cherokee</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AeroTurboshaft</def>
      <set>
        <transmissionLimit>0.9</transmissionLimit>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockRotorcraft</flightProfile>
    <!-- Sling loads (Vehicles 0.40.0): the CH-47F's centre hook, 26,000 lb (11,800 kg), from the US Army CH-47 fact sheet republished by the
         127th Wing (www.127wg.ang.af.mil, fact sheet 3694458). The Cherokee being VVE's tandem-rotor cargo helicopter, its hook is taken as the
         Chinook's. -->
    <sling>
      <ratedKilograms>11800</ratedKilograms>
      <!-- Yaroslav's Cherokee Sling gives the Cherokee its own airlift: while it is active, ours stands down here (agent default from the
           owner's rule of 11 Nov 2026 about other authors' vision), and every other helicopter keeps ours. -->
      <standDownIfActive>
        <li>yaroslav.cherokeesling</li>
      </standDownIfActive>
    </sling>
    <partRoles>
      <li>
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Transmission</li>
              <li>RotorMast</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <!-- A hook mount under the belly for the cargo hook fitting (sling loads): appended, so a hook is lost with its mount. Its health and
             place, between the rotor drives, are authored. -->
        <role>HookMount</role>
        <add>
          <key>PhobosHookMount</key>
          <label>hook mount</label>
          <health>40</health>
          <cellsOf>RotorDrive</cellsOf>
        </add>
      </li>
      <li>
        <!-- The cabin (Framework 0.101.0's litter kit): the Cherokee's own upholstery part, so the kit is fitted there and lost with it. -->
        <role>Cabin</role>
        <find>
          <li>
            <key>Upholstery</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <key>LeftTurboShaft</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <key>RightTurboShaft</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
