<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The lubrication system: the oil's level, temperature and pressure. Design: docs/development/vehicle-systems-design.md. Not yet
    tested in game.

    Sources and labels:
    - Engine oil runs at about 85 to 105 degrees C when warm and breaks down faster held above about 110 to 120. Secondary and low
      quality: enthusiasts' forums; to be replaced by an engine maker's manual. The 120 degree floor is authored.
    - Oil follows the coolant's temperature (authored rate), so a hot engine has hot oil. An engine with no coolant (a gas turbine,
      an air-cooled engine) has oil heated by its bearings and held down by its cooler: 55 degrees C idling to 95 at full load while it
      runs, the air once it is off (authored, no published figure checked; Framework 0.29.1, after the owner saw a running tank's oil
      at -15 degrees C).
    - Oil burned in running: 0.15 % of the sump an hour at full load (authored; real engines burn far less, but a service every
      few in-game weeks is the point).
    - Oil pressure here is the pump's ability, from the oil pump part's health and the oil level (authored curve); it does harm
      only while the engine runs.
    - A worn engine burns more oil (crosslink 3, Framework 0.68.0; docs/development/vehicle-system-crosslinks.md): worn rings and
      valve guides let oil past into the cylinders (secondary, approximate: engine makers' service literature as commonly cited; no
      figure checked). Twice the burn at 40% engine health and below, scaling back to the normal burn at full health (authored).
    The oil is topped up by the service (PhobosVehicleSystem_Service), which falls due as soon as the oil is below 60% while the
    player's "low oil calls for a service" setting is on (the owner's answer, 10 Nov 2026), so a worn engine is serviced sooner.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Lubrication</defName>
    <label>lubrication</label>
    <description>The engine's oil: its level, its temperature and the pump's pressure. Low oil or a damaged pump wears the engine while it runs; oil cooked too hot does too.</description>
    <roles>
      <li>Engine</li>
      <li>OilPump</li>
    </roles>
    <parameters>
      <oilBurnPerHour>0.0015</oilBurnPerHour>
      <oilFollowRate>3</oilFollowRate>
      <!-- Crosslink 4 (Framework 0.69.0): fire on the body heats the oil of an engine with no coolant (a gas turbine, an air-cooled
           engine), 60 degrees an hour at full size (authored): against the oil's own pull toward its running heat that settles about
           20 degrees above it, so a jet that flew on fire lands with hot oil, a sign rather than a death. With coolant, the oil
           follows the coolant, which the fire heats (Systems_Cooling.xml). -->
      <fireHeat>60</fireHeat>
    </parameters>
    <quantities>
      <li>
        <name>oilLevel</name>
        <telltale>Phobos/VehicleSystems/Dash/OilLevel</telltale>
        <showOnDashboard>true</showOnDashboard>
        <label>oil level</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.5</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOilLow</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>oilTemperature</name>
        <telltale>Phobos/VehicleSystems/Dash/OilHot</telltale>
        <label>oil</label>
        <unit>Celsius</unit>
        <min>-60</min>
        <max>200</max>
        <startsAt>Ambient</startsAt>
        <stages>
          <li>
            <from>120</from>
            <label>cooking</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <perHour>0.5</perHour>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>oilPressure</name>
        <telltale>Phobos/VehicleSystems/Dash/OilPressure</telltale>
        <label>oil pressure</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>OilPump</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_EngineRpm">
            <!-- The pump turns with the engine: pressure is lower at idle (authored curve; a stopped engine reads as idle, so a
                 parked engine never shows low pressure on its own). -->
            <curve>
              <points>
                <li>(0, 0.75)</li>
                <li>(700, 0.75)</li>
                <li>(1500, 1)</li>
                <li>(6000, 1)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>oilLevel</quantity>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.3, 0.4)</li>
                <li>(0.6, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <!-- Nothing reaching the bearings: an engine seizes in about five hours, whatever its size (authored, 9 Nov 2026, after the owner's test; it used
                 to wear at the same 2 points an hour as low pressure, 25 hours for a 50-point engine with an empty sump). -->
            <to>0.15</to>
            <label>gone</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <sharePerHour>0.2</sharePerHour>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOilPressureGone</message>
              </li>
            </effects>
          </li>
          <li>
            <from>0.15</from>
            <to>0.45</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <perHour>2</perHour>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgOilPressureLow</message>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>followCoolant</name>
        <quantity>oilTemperature</quantity>
        <kind>Toward</kind>
        <target Class="Phobos.VehicleSystems.Input_Quantity">
          <quantity>coolantTemperature</quantity>
          <fallback Class="Phobos.VehicleSystems.Input_OilWithoutCoolant" />
        </target>
        <factorParameter>oilFollowRate</factorParameter>
      </li>
      <li>
        <name>fire</name>
        <quantity>oilTemperature</quantity>
        <kind>Into</kind>
        <factorParameter>fireHeat</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_Fire" />
        </inputs>
        <when Class="Phobos.VehicleSystems.When_HasQuantity">
          <quantity>coolantTemperature</quantity>
          <invert>true</invert>
        </when>
      </li>
      <li>
        <name>burn</name>
        <quantity>oilLevel</quantity>
        <kind>From</kind>
        <factorParameter>oilBurnPerHour</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_EngineLoad" />
          <li Class="Phobos.VehicleSystems.Input_PartHealth">
            <!-- Crosslink 3: a worn engine burns more oil, twice as much at 40% health (see the comment at the top). -->
            <role>Engine</role>
            <curve>
              <points>
                <li>(0.4, 2)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
    </flows>
    <onPartHit>
      <li>
        <!-- Shares of the part's health (authored, 9 Nov 2026, after the owner's test: a wrecked pump and engine used to leave 60% of the oil, above the warning).
             A pump is mostly a pressure problem; an engine carries the sump. -->
        <role>OilPump</role>
        <quantity>oilLevel</quantity>
        <perShareLost>-0.25</perShareLost>
      </li>
      <li>
        <role>Engine</role>
        <quantity>oilLevel</quantity>
        <perShareLost>-0.6</perShareLost>
      </li>
      <li>
        <!-- The crack goes on leaking (Conditions.xml), as a holed radiator does. Authored. -->
        <role>Engine</role>
        <condition>PhobosVehicleCondition_CrackedSump</condition>
        <perShareLost>0.9</perShareLost>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
    </onPartHit>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    Fuel that thickens in deep cold, the way diesel gels. Off unless the player turns it on (settings), because chemfuel is the
    game's own fuel and nothing says it behaves like diesel: a gameplay choice, labelled so. No. 2 diesel gels near -8 degrees C
    (secondary: Wikipedia, "Gel point (petroleum)"; ASTM D975 is the authority). Warming the vehicle in a heated room fixes it.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Fuel</defName>
    <label>fuel system</label>
    <description>The fuel pump feeds the engine: a damaged one starves it of power, and a ruined one will not let it start. When the setting is on, fuel also thickens below about -8 °C and the engine will not start until the vehicle is warmer.</description>
    <roles>
      <li>FuelPump</li>
    </roles>
    <quantities>
      <li>
        <!-- Framework 0.55.0. The stages are authored: half a pump feeds a working engine poorly, and under a tenth it cannot feed one at all. -->
        <name>fuelFeed</name>
        <telltale>Phobos/VehicleSystems/Dash/Fuel</telltale>
        <label>fuel feed</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>FuelPump</role>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.1</to>
            <label>none</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseFuelPump</reason>
              </li>
            </effects>
          </li>
          <li>
            <from>0.1</from>
            <to>0.5</to>
            <label>weak</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>MoveSpeed</stat>
                <factor>0.75</factor>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>fuelGel</name>
        <telltale>Phobos/VehicleSystems/Dash/Fuel</telltale>
        <label>fuel</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Setting">
            <setting>fuelGelling</setting>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Ambient">
            <curve>
              <points>
                <li>(-20, 1)</li>
                <li>(-8, 0)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <from>0.5</from>
            <label>gelled</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseFuelGelled</reason>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
