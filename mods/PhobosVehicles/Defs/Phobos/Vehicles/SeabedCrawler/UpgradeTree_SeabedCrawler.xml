<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The Seabed Crawler's upgrades (docs/development/vehicle-seabed-crawler.md): each needs its own research and its own crafted part (owner, 10 Nov 2026). Only upgrades whose abilities exist are listed; the rest join as they are built. Figures authored. Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_SeabedCrawler_UpgradeTree</defName>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEnforceUpgradeResearch" />
    </modExtensions>
    <nodes>
      <li>
        <key>BottomingWheels</key>
        <label>bottoming wheels</label>
        <displayLabel>true</displayLabel>
        <description>Retractable wheels that let the boat rest on the bottom. Settled there, it uses half the air and charge and is a quarter as easy to find, but it cannot move until it lifts off.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/BottomingWheels</icon>
        <work>2500</work>
        <gridCoordinate>(3, 3)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <researchPrerequisites>
          <li>PhobosResearch_SeabedRunningGear</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_DiveBottoming</def>
                <value>1</value>
              </li>
            </vehicleStats>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_BottomingWheelSet>2</PhobosVehicles_BottomingWheelSet>
        </ingredients>
      </li>
      <li>
        <key>Scrubber</key>
        <label>air scrubber</label>
        <displayLabel>true</displayLabel>
        <description>Canisters that clean the air. The boat can stay under for six hours longer, and a crew that stays down past empty breathes stale air more slowly.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/Scrubber</icon>
        <work>2000</work>
        <gridCoordinate>(10, 3)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <researchPrerequisites>
          <li>PhobosResearch_AirPurification</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_DiveEndurance</def>
                <value>6</value>
              </li>
              <li>
                <def>Phobos_DiveStaleAirRate</def>
                <value>-0.4</value>
              </li>
            </vehicleStats>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_ScrubberRack>2</PhobosVehicles_ScrubberRack>
        </ingredients>
      </li>
      <li>
        <!-- The research vessel (owner, 10 Nov 2026): two scientist's seats, a new role that the upgrade adds and Vehicle Framework saves. Its factor matches the game's simple research bench (0.75); its grade takes any project that needs no particular bench. Removing it puts everyone aboard ashore first, as Vehicle Framework does for any role. -->
        <key>WetLab</key>
        <label>wet laboratory</label>
        <displayLabel>true</displayLabel>
        <description>A small laboratory with two scientist's seats. Seated scientists with an Intellectual skill of 7 or more carry on the colony's research: at three quarters of a simple research bench's speed while at rest, and half that under way. It takes on any project that needs no particular bench.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/Laboratory</icon>
        <work>2500</work>
        <gridCoordinate>(17, 3)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <researchPrerequisites>
          <li>PhobosResearch_MarineScience</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_FieldLabFactor</def>
                <value>0.75</value>
              </li>
              <li>
                <def>Phobos_FieldLabGrade</def>
                <value>1</value>
              </li>
            </vehicleStats>
          </li>
          <li Class="Vehicles.VehicleUpgrade">
            <roles>
              <li>
                <key>scientist</key>
                <label>scientist</label>
                <slots>2</slots>
                <hitbox>
                  <cells>
                    <li>(0, 1)</li>
                  </cells>
                </hitbox>
              </li>
            </roles>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_LaboratoryFittings>2</PhobosVehicles_LaboratoryFittings>
        </ingredients>
      </li>
      <li>
        <!-- The advanced laboratory: grade 2 stands in for a hi-tech research bench and its equipment; the factor rises to that bench's 1.0. Its research is aboard-only. -->
        <key>DeepLab</key>
        <label>advanced laboratory</label>
        <displayLabel>true</displayLabel>
        <description>An analyser bench for the wet laboratory. It can take on any project a hi-tech research bench can, and its scientists work at a hi-tech bench's speed.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/AdvancedLaboratory</icon>
        <work>3000</work>
        <gridCoordinate>(24, 3)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <prerequisiteNodes>
          <li>WetLab</li>
        </prerequisiteNodes>
        <researchPrerequisites>
          <li>PhobosResearch_AdvancedMarineScience</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_FieldLabFactor</def>
                <value>0.25</value>
              </li>
              <li>
                <def>Phobos_FieldLabGrade</def>
                <value>1</value>
              </li>
            </vehicleStats>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_AnalyserBench>1</PhobosVehicles_AnalyserBench>
        </ingredients>
      </li>
      <li>
        <!-- The listening array, first of the second row (sensors; the active sonar set goes beside it). Passive: it only hears, so it gives nothing away. Range authored. -->
        <key>Hydrophones</key>
        <label>listening array</label>
        <displayLabel>true</displayLabel>
        <description>Hydrophones along the hull. Anyone aboard who is awake can listen for hostile movement within 40 cells: things in the water across all of it, things on land within half of it, and other boats under the water by their noise. It hears half as far on the move, and makes no sound itself.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/Hydrophones</icon>
        <work>2000</work>
        <gridCoordinate>(3, 10)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <researchPrerequisites>
          <li>PhobosResearch_Hydrophones</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_ListeningRange</def>
                <value>40</value>
              </li>
            </vehicleStats>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_HydrophoneArray>1</PhobosVehicles_HydrophoneArray>
        </ingredients>
      </li>
      <li>
        <!-- The sonar set, beside the listening array. Active: every ping finds and gives away (docs/development/vehicle-seabed-crawler.md, "The sonar set as built"). Range authored. -->
        <key>ActiveSonar</key>
        <label>sonar set</label>
        <displayLabel>true</displayLabel>
        <description>A sonar transducer under the bow, worked from a screen inside. A ping finds everything hostile in the water within 60 cells, moving or still, and every boat under the water, though one resting on the bottom only from half as far. The ping is heard twice as far away, and a boat under the water is followed for a minute after it pings.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/Sonar</icon>
        <work>2000</work>
        <gridCoordinate>(10, 10)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <prerequisiteNodes>
          <li>Hydrophones</li>
        </prerequisiteNodes>
        <researchPrerequisites>
          <li>PhobosResearch_ActiveSonar</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_SonarRange</def>
                <value>60</value>
              </li>
            </vehicleStats>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_SonarTransducer>1</PhobosVehicles_SonarTransducer>
        </ingredients>
      </li>
      <li>
        <!-- Hull refits (owner, 11 Nov 2026: hulls 1, 3 and 4 of the pilot as variants on upgrade pathways). Vehicle Framework holds one body picture at a time, so the two refits exclude each other.
             Each swaps the picture through its RetextureDef (RetextureDefs_SeabedCrawler.xml) and changes figures that matter. -->
        <key>SensorRefit</key>
        <label>sensor refit</label>
        <displayLabel>true</displayLabel>
        <description>A smooth, faired sail rebuilt around the sensors. The listening array hears 20 cells further and a sonar ping reaches 30 cells further, but the narrower deck carries 200 less. Cannot be fitted with the laboratory refit.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/SensorRefit</icon>
        <work>4000</work>
        <gridCoordinate>(17, 10)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <prerequisiteNodes>
          <li>ActiveSonar</li>
        </prerequisiteNodes>
        <disableIfUpgradeNodeEnabled>LaboratoryRefit</disableIfUpgradeNodeEnabled>
        <researchPrerequisites>
          <li>PhobosResearch_SensorRefit</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_ListeningRange</def>
                <value>20</value>
              </li>
              <li>
                <def>Phobos_SonarRange</def>
                <value>30</value>
              </li>
              <li>
                <def>CargoCapacity</def>
                <value>-200</value>
              </li>
            </vehicleStats>
          </li>
          <li Class="Vehicles.VehicleUpgrade">
            <retextureDef>Phobos_SeabedCrawler_SensorRefit</retextureDef>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_SensorSail>1</PhobosVehicles_SensorSail>
        </ingredients>
      </li>
      <li>
        <!-- The laboratory refit: a hull section let in for the laboratory, so it follows the advanced laboratory. It edits the scientist role the wet laboratory added (editKey), which Vehicle
             Framework keeps on the role and drops again on refund; the advanced laboratory cannot be refunded while this is fitted, so the role is always there. -->
        <key>LaboratoryRefit</key>
        <label>laboratory refit</label>
        <displayLabel>true</displayLabel>
        <description>A hull section let in amidships for a longer laboratory. It seats a third scientist and its scientists work 15 per cent of a research bench faster, but the longer hull is slower. Cannot be fitted with the sensor refit.</description>
        <icon>Phobos/Vehicles/SeabedCrawler/Upgrades/LaboratoryRefit</icon>
        <work>5000</work>
        <gridCoordinate>(31, 3)</gridCoordinate>
        <drawSize>(80, 80)</drawSize>
        <prerequisiteNodes>
          <li>DeepLab</li>
        </prerequisiteNodes>
        <disableIfUpgradeNodeEnabled>SensorRefit</disableIfUpgradeNodeEnabled>
        <researchPrerequisites>
          <li>PhobosResearch_LaboratoryRefit</li>
        </researchPrerequisites>
        <upgrades>
          <li Class="Vehicles.StatUpgrade">
            <vehicleStats>
              <li>
                <def>Phobos_FieldLabFactor</def>
                <value>0.15</value>
              </li>
              <li>
                <def>MoveSpeed</def>
                <value>-0.5</value>
              </li>
            </vehicleStats>
          </li>
          <li Class="Vehicles.VehicleUpgrade">
            <retextureDef>Phobos_SeabedCrawler_LaboratoryRefit</retextureDef>
            <roles>
              <li>
                <key>scientist</key>
                <editKey>scientist</editKey>
                <slots>3</slots>
              </li>
            </roles>
          </li>
        </upgrades>
        <ingredients>
          <PhobosVehicles_LaboratoryHullSection>1</PhobosVehicles_LaboratoryHullSection>
        </ingredients>
      </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
