<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The drill rig's upgrades (docs/development/vehicle-drill-rig.md). Figures and costs authored. A bare rig drills at ten times a deep drill, the diamond bit at twenty (owner, 9 Nov 2026). Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_DrillRig_UpgradeTree</defName>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEnforceUpgradeResearch" />
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>DiamondBit</key>
      <label>diamond core bit</label>
      <displayLabel>true</displayLabel>
      <description>A slim bit that cuts a core of rock. The rig drills at twenty times a deep drill, on ore and on stone.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/DiamondBit</icon>
      <work>2500</work>
      <gridCoordinate>(3, 4)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>DeepDrilling</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>RcHammer</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_DrillRate</def>
              <value>10</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Plasteel>30</Plasteel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_DiamondBit</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>RcHammer</key>
      <label>RC hammer</label>
      <displayLabel>true</displayLabel>
      <description>A reverse-circulation hammer, which blows its cuttings up inside the rods, on a bigger air line: eighteen times a deep drill on ore, and thirty once only stone is left.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/RcHammer</icon>
      <work>2500</work>
      <gridCoordinate>(10, 4)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>DeepDrilling</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>DiamondBit</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_DrillRate</def>
              <value>8</value>
            </li>
            <li>
              <def>Phobos_BedrockFactor</def>
              <value>1.667</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_Hammer</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>TallMast</key>
      <label>tall mast</label>
      <displayLabel>true</displayLabel>
      <description>A longer mast section. The string can be walked further from the hole, from about 2.6 cells to about 3.6, at some cost in stability.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/TallMast</icon>
      <work>3000</work>
      <gridCoordinate>(17, 4)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>DeepDrilling</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_DrillReach</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_RigStability</def>
              <value>-0.15</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>ElectricPowerPack</key>
      <label>electric power pack</label>
      <displayLabel>true</displayLabel>
      <description>A cable and a switchbox. Beside a powered grid the rig drills on the grid with its engine off, burning no fuel.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/ElectricPowerPack</icon>
      <work>2000</work>
      <gridCoordinate>(3, 9)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_ElectricDrill</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>80</Steel>
        <ComponentIndustrial>6</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_PowerPack</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>WorkLights</key>
      <label>work lights</label>
      <displayLabel>true</displayLabel>
      <description>Lamp masts on the cab and rear. Without them, drilling at night goes at 80% of the rate.</description>
      <icon>Phobos/Vehicles/DrillRig/Upgrades/WorkLights</icon>
      <work>1000</work>
      <gridCoordinate>(10, 9)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_WorkLights</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_WorkLights</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
