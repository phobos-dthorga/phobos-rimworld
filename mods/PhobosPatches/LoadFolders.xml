<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- One folder per patched mod, loaded only while that mod is active; a tie-in's assembly sits in a version folder below it
       (RimWorld 1.7 only, owner, 8 November 2026). D'thorga Vehicle Patches and D'thorga Missile Patches were merged into this
       mod on 7 November 2026. -->
  <v1.7>
    <li>/</li>
    <li IfModActive="potemkinvillager.av8bharrier">Mods/HarrierVtol</li>
    <li IfModActive="potemkinvillager.av8bharrier">Mods/HarrierVtol/1.7</li>
    <li IfModActive="potemkinvillager.av8bharrier,potemkinvillager.mi24hindhelicopter,potemkinvillager.mongooseattackhelicopter">Mods/AircraftRearm/1.7</li>
    <li IfModActive="RimThunder.Core">Mods/RimThunder</li>
    <!-- Fires a vehicle cannot put out; remove when the framework handles them (docs/development/vehicle-framework-fires.md). -->
    <li IfModActive="SmashPhil.VehicleFramework">Mods/VehicleFramework</li>
    <li IfModActive="SmashPhil.VehicleFramework">Mods/VehicleFramework/1.7</li>
    <li IfModActiveAll="MK.SpaceshipTurretHull,CETeam.CombatExtended">Mods/SpaceshipTurretHull</li>
    <!-- Soldiers keep their guns (docs/development/soldiers-keep-their-guns.md), and the temporary guard against empty ammo set entries
         (docs/development/temporary-patches.md). -->
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended/1.7</li>
    <!-- Drone platforms kept topped up by haulers (docs/development/top-up-design.md). -->
    <li IfModActive="AOBA.Framework">Mods/Fortified</li>
    <li IfModActive="kazepsi.irbm">Mods/IRBM</li>
    <li IfModActive="kazepsi.irbm">Mods/IRBM/1.7</li>
    <li IfModActive="wowgag.RimPacts">Mods/RimPacts/1.7</li>
    <li IfModActive="ninagoblin.visitsettlements">Mods/VisitSettlements/1.7</li>
    <!-- Temporary: a save made during a scorpion raid loads with the raid's orders (docs/development/temporary-patches.md). -->
    <li IfModActive="OskarPotocki.VFE.Classical">Mods/Classical/1.7</li>
    <li IfModActiveAll="OskarPotocki.VanillaFactionsExpanded.Core,SmashPhil.VehicleFramework">Mods/Outposts</li>
    <li IfModActiveAll="OskarPotocki.VanillaFactionsExpanded.Core,SmashPhil.VehicleFramework">Mods/Outposts/1.7</li>
  </v1.7>
</loadFolders>
