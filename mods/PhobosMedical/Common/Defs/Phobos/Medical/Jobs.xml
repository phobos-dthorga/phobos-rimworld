<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- One job and one work giver for every hand-held patient device. Under Doctor, just below urgent tending (100) and above routine
       tending (90): a patient who can barely breathe comes before a cut that is already bandaged. Mechs are kept out. -->
  <JobDef>
    <defName>PhobosMedical_UseDevice</defName>
    <driverClass>Phobos.Medical.Jobs.JobDriver_PhobosUseDevice</driverClass>
    <reportString>using TargetA on TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- Just above the game's own rescue (60): a downed patient who needs oxygen goes to a free pressure chamber, if there is one,
       instead of the nearest bed. With none free, the game's rescue goes on as usual. -->
  <WorkGiverDef>
    <defName>PhobosMedical_DoctorTakeToChamber</defName>
    <label>take patients to a pressure chamber</label>
    <giverClass>Phobos.Medical.Jobs.WorkGiver_PhobosTakeToChamber</giverClass>
    <workType>Doctor</workType>
    <priorityInType>65</priorityInType>
    <verb>take to a pressure chamber</verb>
    <gerund>taking to a pressure chamber</gerund>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- Rinsing acid off at a safety shower: oneself, or a patient who can't walk (a doctor draws the water and brings it). -->
  <JobDef>
    <defName>PhobosMedical_Rinse</defName>
    <driverClass>Phobos.Medical.Jobs.JobDriver_PhobosRinse</driverClass>
    <reportString>rinsing off acid.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>PhobosMedical_RinsePatient</defName>
    <driverClass>Phobos.Medical.Jobs.JobDriver_PhobosRinsePatient</driverClass>
    <reportString>rinsing acid off TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>PhobosMedical_DoctorRinsePatient</defName>
    <label>rinse acid off patients</label>
    <giverClass>Phobos.Medical.Jobs.WorkGiver_PhobosRinsePatient</giverClass>
    <workType>Doctor</workType>
    <priorityInType>92</priorityInType>
    <verb>rinse acid off</verb>
    <gerund>rinsing acid off</gerund>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>PhobosMedical_DoctorUseDevice</defName>
    <label>use breathing devices</label>
    <giverClass>Phobos.Medical.Jobs.WorkGiver_PhobosUseDevice</giverClass>
    <workType>Doctor</workType>
    <priorityInType>95</priorityInType>
    <verb>use a breathing device on</verb>
    <gerund>using a breathing device on</gerund>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
</Defs>
