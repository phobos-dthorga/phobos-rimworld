      <texPath>Phobos/Vehicles/Parts/DrivetrainKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>5</stackLimit>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <MarketValue>380</MarketValue>
      <Mass>60</Mass>
      <Flammability>0.2</Flammability>
      <WorkToMake>5000</WorkToMake>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <workSkill>Crafting</workSkill>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <researchPrerequisite>Machining</researchPrerequisite>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <smeltProducts>
      <Steel>45</Steel>
    </smeltProducts>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>PhobosVehicles_ElectricalKit</defName>
    <label>electrical kit</label>
    <description>Alternator, batteries, wiring and a radiator for a heavy vehicle.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/ElectricalKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>5</stackLimit>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <MarketValue>340</MarketValue>
      <Mass>14</Mass>
      <Flammability>0.2</Flammability>
      <WorkToMake>5000</WorkToMake>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <costList>
      <Steel>25</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <workSkill>Crafting</workSkill>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <researchPrerequisite>Machining</researchPrerequisite>
      <recipeUsers>
        <li>TableMachining</li>
