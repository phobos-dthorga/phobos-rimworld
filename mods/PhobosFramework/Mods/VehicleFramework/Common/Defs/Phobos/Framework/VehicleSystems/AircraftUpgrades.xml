<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Stats an upgrade node raises to switch on a system of ours on one vehicle (Framework 0.150.0; the V-22 Osprey's tree first,
       docs/development/vehicle-osprey.md). A loadout's figures are the same for every vehicle of a kind; these are each vehicle's own.
       0 means not fitted. A node that raises one also lists Phobos.VehicleSystems.PhobosSystemsUpgrade, so the systems are built again. -->
  <Vehicles.VehicleStatDef>
    <defName>Phobos_SlingKilograms</defName>
    <label>cargo hook rating</label>
    <description>What the fitted cargo hooks may lift, in kilograms, when more than one hook's rating.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0} kg</formatString>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_InfraredJammer</defName>
    <label>infrared jammer</label>
    <description>A directional infrared countermeasure, cued by the missile warning receiver: it never runs out, and needs power.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <!-- Framework 0.316.0: chaff and flare dispensers fitted by a node, for an aircraft whose loadout carries them only that way (the C-27J's
         defensive aids). -->
    <defName>Phobos_Countermeasures</defName>
    <label>chaff and flare dispensers</label>
    <description>Dispensers that fire chaff and flares when the missile warning receiver hears a threat, from a magazine of cartridges that haulers keep topped up.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_TerrainRadar</defName>
    <label>terrain-following radar</label>
    <description>A radar that lets the aircraft fly low and blind, at night and in weather.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_InletBarrierLoss</defName>
    <label>inlet barrier power loss</label>
    <description>The share of engine power an inlet barrier filter costs, for the sand and dust it keeps out of the engines.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <maxValue>0.5</maxValue>
    <toStringStyle>PercentZero</toStringStyle>
    <operationType>None</operationType>
    <upgradeEffectType>Negative</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <!-- An armour or weapon kit's weight is carried mass (owner, 19 Nov 2026: "weight counts like cargo"): its node lowers cargo room by
         the same kilograms, and the engine model weighs it as cargo. -->
    <defName>Phobos_KitKilograms</defName>
    <label>kit weight</label>
    <description>The weight of fitted armour and weapon kits, carried as cargo would be.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0} kg</formatString>
    <operationType>None</operationType>
    <upgradeEffectType>Negative</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
      <li>Land</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <!-- Framework 0.319.0: an ammunition locker's room, for the vehicle's own rounds only (the owner's card of 26 Nov 2026). The cargo figure
         adds it while other cargo fits the load bed; once other cargo spills past the bed, it counts only the rounds aboard (AmmoLocker). -->
    <defName>Phobos_AmmoLockerKilograms</defName>
    <label>ammunition locker</label>
    <description>Room in an ammunition locker, for the rounds of the vehicle's own guns and smoke dischargers only.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0} kg</formatString>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Land</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <!-- Framework 0.197.0: grip on soft ground a node adds (a tractor's dual wheels), on top of the tyre fittings' factor: 0.25 is a quarter
         more grip on the softest ground, tapering to none on firm going (TreadRules.SoftGroundFactor). -->
    <defName>Phobos_SoftGroundGripBonus</defName>
    <label>soft ground grip</label>
    <description>How much more the wheels grip on soft ground, from fitted upgrades such as dual wheels.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Land</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <!-- Framework 0.329.0: litters a node brings for downed people, carried as the litter kit's are (the C-27J's 36 stretchers). The larger of
         this and the litter kit's count is used. -->
    <defName>Phobos_Litters</defName>
    <label>stretchers</label>
    <description>Stretchers for downed people, carried lying down and tended by anyone in the crew who can doctor.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
      <li>Land</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <!-- Framework 0.329.0: a roll-on fire-fighting tank's litres (the C-27J's 7,950 L [P1]), filled from open water by a colonist and emptied
         along a water drop pass (CompPhobosFireTank). -->
    <defName>Phobos_FireTankLitres</defName>
    <label>fire-fighting tank</label>
    <description>The water a roll-on fire-fighting tank holds, sprayed along a pass to put out fires beneath.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0} L</formatString>
    <operationType>None</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Air</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
</Defs>
