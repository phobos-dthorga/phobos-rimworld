<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- With Vanilla Chemfuel Expanded, chemfuel also pumps from and to its pipes, tried before stacks on the ground. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/Phobos.VehicleSystems.PhobosTankContentsDef[defName="PhobosTank_Chemfuel"]/ports/li[2]</xpath>
    <order>Prepend</order>
    <value>
      <li Class="Phobos.VehicleSystems.Pipes.Port_PipeNet">
        <net>VCHE_ChemfuelNet</net>
      </li>
    </value>
  </Operation>
</Patch>
