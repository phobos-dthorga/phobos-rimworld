  <!-- Roles only a build asks for (Framework 0.95.0): no part on a vehicle has them, so no repair reads them. They are the core's own
       Def type, which any built thing may use: the depot bay's fuel tank is one. Ours is materials, or one of our kits for the whole
       build. Figures authored. -->
  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_FuelTank</defName>
    <label>fuel tank</label>
    <roles>
      <li>FuelTank</li>
    </roles>
