<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What it is made of, by role (docs/development/parts-bills.md; D'thorga Vehicles 0.41.0). A 10-tonne truck on three axles: six tyres, a frame casting under the body, and the pump for its tipping rams.
       Its blueprint's cost list is its shell; each role is filled at start-up by an installed mod's part where it suits the
       vehicle's weight, and by ours otherwise. Counts authored, held for the owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_Tipper</defName>
    <label>tipper truck parts</label>
    <target>Phobos_Tipper_Blueprint</target>
    <parts>
      <Engine>1</Engine>
      <Transmission>1</Transmission>
      <FuelTank>1</FuelTank>
      <Wheels>6</Wheels>
      <Suspension>3</Suspension>
      <Alternator>1</Alternator>
      <Battery>1</Battery>
      <Wiring>1</Wiring>
      <Radiator>1</Radiator>
      <Exhaust>1</Exhaust>
      <HydraulicPump>1</HydraulicPump>
      <Frame>1</Frame>
    </parts>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
