      <label>wiring</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Lights</key>
      <label>lights</label>
      <health>10</health>
      <depth>External</depth>
