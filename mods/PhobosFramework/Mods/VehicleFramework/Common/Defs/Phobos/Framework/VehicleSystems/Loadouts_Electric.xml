<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Electric land vehicles (owner, 8 Nov 2026; Framework 0.20.0; docs/development/vehicle-electric-design.md): any land vehicle Vehicle
    Framework runs on electricity, matched by that and never by name. The traction battery and electric drive systems, the 12 V
    electrics charged by a DC-DC converter, the electric drivetrain (one fixed reduction), tyres and brakes, and the cab. No coolant,
    oil, gearbox or fuel-in-the-cold: an electric vehicle has none of them. Its night heater (Framework 0.104.0; owner, 12 Nov 2026) is
    its own: an electric heater that keeps the cab and the traction pack warm at a night camp from the pack's charge (Systems_Electric.xml,
    nightHeaterShare), never the combustion heater's chemfuel. Not yet tested in game.

    Figures: a 12 V, 45 Ah battery as the combustion loadouts (Wikipedia, "Automotive battery", secondary); a DC-DC converter of about
    1.5 kW, so 100 A at 12 V (general, approximate); the computers' and contactors' draw at switch-on 0.02 Ah (authored). Brake wear
    a third of a combustion vehicle's: most slowing is regenerative (authored; electric cars' brake pads are commonly reported to last
    two to three times as long, general).
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
    <defName>PhobosVehicleLoadout_LandElectric</defName>
    <label>electric land vehicle</label>
    <kind>Electric</kind>
    <priority>Effect</priority>
    <selector>
      <fuelled>Yes</fuelled>
      <electricPowered>Yes</electricPowered>
      <flies>No</flies>
      <vehicleTypes>
        <li>Land</li>
      </vehicleTypes>
    </selector>
    <drivetrain>
      <def>PhobosDrivetrain_Electric</def>
    </drivetrain>
    <systems>
      <li>
        <def>PhobosVehicleSystem_AuxiliaryElectrical</def>
        <set>
          <alternatorAmps>100</alternatorAmps>
          <starterAmpHours>0.02</starterAmpHours>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_TractionBattery</def></li>
      <li><def>PhobosVehicleSystem_ElectricDrive</def></li>
      <li><def>PhobosVehicleSystem_ElectricService</def></li>
      <li><def>PhobosVehicleSystem_RunningGear</def></li>
      <li>
        <def>PhobosVehicleSystem_Brakes</def>
        <set>
          <wearPerHourMoving>0.00017</wearPerHourMoving>
          <wearPerStop>0.00027</wearPerStop>
        </set>
      </li>
      <li>
        <!-- The cab's night heater flow warms the cab as on a combustion vehicle; its fuel figure is in units of chemfuel, and Vehicle
             Framework keeps an electric vehicle's charge as its fuel, so that burn is set to nothing here and the traction battery's own
             nightHeaterDraw pays for the night in charge (Framework 0.104.0). -->
        <def>PhobosVehicleSystem_Cabin</def>
        <set>
          <nightHeaterFuelPerHour>0</nightHeaterFuelPerHour>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_Driver</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Engine</role>
        <find>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
            <priority>Yes</priority>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
          </li>
          <li>
            <keyContains>motor</keyContains>
          </li>
          <li>
            <keyContains>engine</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>TractionBattery</role>
        <find>
          <li>
            <keyContains>traction</keyContains>
          </li>
          <li>
            <keyContains>batterypack</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosTractionBattery</key>
          <label>traction battery</label>
          <health>60</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Alternator</role>
        <find>
          <li>
            <keyContains>converter</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosDcDcConverter</key>
          <label>DC-DC converter</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Battery</role>
        <find>
          <li>
            <tag>Battery</tag>
          </li>
        </find>
        <add>
          <key>PhobosBattery</key>
          <label>12 V battery</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Wheels</role>
        <all>true</all>
        <find>
          <li>
            <tag>Wheel</tag>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>External</depth>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <keyContains>brake</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosBrakes</key>
          <label>brakes</label>
          <health>30</health>
          <cellsOf>Wheels</cellsOf>
          <!-- Framework 0.250.0: a brake at each wheel. -->
          <eachOf>Wheels</eachOf>
          <eachLabel>{PART} brake</eachLabel>
        </add>
      </li>
      <!-- Framework 0.359.0 (docs/development/vehicle-standard.md, VS2 and VS4; found by the standard's audit, batch 2): the radio bays every land vehicle has, which this loadout, written apart from the land base, lacked. -->
      <li>
        <role>VoiceRadioMount</role>
        <add>
          <key>PhobosVoiceRadioMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>voice radio bay</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.05</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>RepeaterMount</role>
        <add>
          <key>PhobosRepeaterMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>repeater bay</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.05</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>MorseKeyMount</role>
        <add>
          <key>PhobosMorseKeyMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>Morse key bay</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.05</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <!-- Framework 0.375.0 (the owner's card of 28 Nov 2026, "All but fuel/house batt", after the Busbar was found without them): the bays and
           mounts the land base gives every land vehicle, which this loadout, written apart from it, lacked. The same keys, health and hit
           weights, added last so a saved vehicle keeps every existing part's wear. No auxiliary fuel tank (there is no fuel) and no house battery
           tray (the traction battery already is one). -->
      <li>
        <role>LampMount</role>
        <add>
          <key>PhobosLampMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>lamp bracket</label>
          <health>15</health>
          <depth>External</depth>
          <hitWeight>0.15</hitWeight>
          <hitWeightCE>6</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>RecoveryMount</role>
        <add>
          <key>PhobosRecoveryMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>winch mount</label>
          <health>35</health>
          <depth>External</depth>
          <hitWeight>0.15</hitWeight>
          <hitWeightCE>6</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>RemoteKitMount</role>
        <add>
          <key>PhobosRemoteKitMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>control radio bay</label>
          <health>20</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>RouteKitMount</role>
        <add>
          <key>PhobosRouteKitMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>sensor bar</label>
          <health>15</health>
          <depth>External</depth>
          <hitWeight>0.15</hitWeight>
          <hitWeightCE>6</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>FridgeBay</role>
        <add>
          <key>PhobosFridgeBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>fridge bay</label>
          <health>20</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>WaterTankBay</role>
        <add>
          <key>PhobosWaterTankBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>water tank bay</label>
          <health>25</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>StereoSlot</role>
        <notOnMilitary>true</notOnMilitary>
        <add>
          <key>PhobosStereoSlot</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>stereo slot</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.05</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>CabLightMount</role>
        <add>
          <key>PhobosCabLightMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>cab light mount</label>
          <health>10</health>
          <depth>Internal</depth>
          <hitWeight>0.05</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>SolarMount</role>
        <add>
          <key>PhobosSolarMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>solar panel mount</label>
          <health>20</health>
          <depth>External</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>OutletPanel</role>
        <add>
          <key>PhobosOutletPanel</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>outlet panel</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.08</hitWeight>
          <hitWeightCE>3</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>RoofMount</role>
        <notOnMilitary>true</notOnMilitary>
        <add>
          <key>PhobosRoofMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>roof mount</label>
          <health>30</health>
          <depth>External</depth>
          <hitWeight>0.12</hitWeight>
          <hitWeightCE>5</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>SideRail</role>
        <notOnMilitary>true</notOnMilitary>
        <add>
          <key>PhobosSideRail</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>side rail</label>
          <health>25</health>
          <depth>External</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>5</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
    </partRoles>
    <loads>
      <li>
        <name>headlights</name>
        <label>headlights</label>
        <description>Switched on, the headlights light the ground ahead of the vehicle at night. With the engine off they run the battery down.</description>
        <amps>9</amps>
        <shedOrder>6</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <!-- Framework 0.104.0 (owner, 12 Nov 2026: "make this a rule"): switched on, the headlights burn at night whether or not the engine
             runs, so with the engine off they run the battery down and can flatten it. Off by default, so a parked fleet is not flat by
             morning (agent's choice: a light vehicle's 45 Ah battery feeds 9 A of headlights for about five hours). -->
        <defaultOn>false</defaultOn>
        <when Class="Phobos.VehicleSystems.When_Dark" />
        <!-- Framework 0.171.0 (owner, 19 Nov 2026: lights that switch themselves, a setting on by default). With it on, the headlights light at
             night while the vehicle is driven or its engine runs, and go out once it is parked with the engine off, so a parked fleet is not flat
             by morning. Agent's choice for the owner to revise. -->
        <autoOn Class="Phobos.VehicleSystems.When_Any">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_Moving" />
          </conditions>
        </autoOn>
        <autoDescription>they light by themselves in the dark while the vehicle is driven or its engine runs, and go out once it is parked with the engine off</autoDescription>
        <standbyLabel>waiting for dark</standbyLabel>
        <autoStandbyLabel>waiting for dark and a driver</autoStandbyLabel>
        <!-- Framework 0.104.0: an electric vehicle's beam, a cool LED white (authored); the same reach as the diesels'. -->
        <beam>
          <radius>6</radius>
          <ahead>5</ahead>
          <colour>(235,240,255,0)</colour>
        </beam>
        <!-- Framework 0.326.0 (vehicle effects, slice 3): the lamps seen on the vehicle, drawn with the Vehicle effects setting. Two headlamps,
             warm white, while the headlights burn; two tail lamps, dim red with the headlights and bright red while the vehicle slows (brake
             lamps, which light by day too). Places are shares of half the vehicle's length and width; sizes and colours authored. -->
        <lamps>
          <li><forward>0.95</forward><right>0.6</right><colour>(1, 0.92, 0.78, 0.85)</colour><size>0.55</size></li>
          <li><forward>0.95</forward><right>-0.6</right><colour>(1, 0.92, 0.78, 0.85)</colour><size>0.55</size></li>
          <li><forward>-0.97</forward><right>0.65</right><colour>(1, 0.1, 0.05, 0.45)</colour><size>0.4</size><brake>true</brake></li>
          <li><forward>-0.97</forward><right>-0.65</right><colour>(1, 0.1, 0.05, 0.45)</colour><size>0.4</size><brake>true</brake></li>
        </lamps>
      </li>
      <li>
        <name>cabHeater</name>
        <yieldsTo>climateControl</yieldsTo>
        <label>cab heater</label>
        <description>The cab heater runs below 5 °C while the vehicle is switched on. It draws on the traction battery, so it costs range.</description>
        <amps>12</amps>
        <shedOrder>3</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <!-- The electric night heater (Framework 0.104.0; owner, 12 Nov 2026). Same name, switch, icon and setting as the combustion one, so
             the player meets one night heater and the cold-weather family turns it on; it runs at a caravan's night camp, as that one does.
             It draws on the traction battery (Systems_Electric.xml), so a cold night costs range. -->
        <name>nightHeater</name>
        <label>night heater</label>
        <description>An electric heater that keeps the cab and the drive battery warm while the caravan camps for the night, so the battery gives its full power and takes charge well in the morning. It runs on the drive battery, so a cold night costs some range. Switch it on before you leave; it needs the night heater setting.</description>
        <amps>2</amps>
        <shedOrder>4</shedOrder>
        <toggle>true</toggle>
        <defaultOn>false</defaultOn>
        <iconPath>Phobos/VehicleSystems/NightHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <!-- At a caravan's night camp, or for someone asleep in the cab bunk on a map (Framework 0.216.0). -->
            <li Class="Phobos.VehicleSystems.When_Any">
              <conditions>
                <li Class="Phobos.VehicleSystems.When_CaravanResting" />
                <li Class="Phobos.VehicleSystems.When_BunkSleeper" />
                <!-- Framework 0.289.0: for a colonist warming up in a parked cab (people use parked vehicles, PV3). -->
                <li Class="Phobos.VehicleSystems.When_WarmingVisitor" />
              </conditions>
            </li>
            <li Class="Phobos.VehicleSystems.When_Setting">
              <setting>nightHeater</setting>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <name>instruments</name>
        <label>computers and instruments</label>
        <amps>6</amps>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <!-- Automatic climate control (Framework 0.22.0): only on vehicles fitted with it (When_ClimateControl), or every closed cab
             with the player's setting. It runs the heater and air conditioner itself to hold the cab near 21 degrees C, so the manual
             ones stand down while it runs. The draw is an average of the fans, blower and controls (authored). -->
        <name>climateControl</name>
        <label>climate control</label>
        <description>Holds the cab near 21 °C by itself while the engine runs, heating or cooling as needed. Switch it off to use the heater and air conditioner by hand.</description>
        <amps>8</amps>
        <shedOrder>2</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/ClimateControl</iconPath>
        <available Class="Phobos.VehicleSystems.When_ClimateControl" />
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>airConditioner</name>
        <yieldsTo>climateControl</yieldsTo>
        <label>air conditioner</label>
        <description>The air conditioner cools the cab above 26 °C while the vehicle is switched on. It draws on the traction battery, so it costs range.</description>
        <amps>10</amps>
        <shedOrder>1</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/AirConditioner</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientAbove">
              <celsius>26</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <!-- Framework 0.375.0: the work lamps' draw, as on the light land loadout (two 60 W LED floodlights on 12 V, 10 A, authored), now that this
             loadout has a lamp bracket: the lamps cost charge here as everywhere. -->
        <name>workLamps</name>
        <label>work lamps</label>
        <description>Floodlights that light the ground round the vehicle while it stands still at night, so work nearby goes on at the pace of daylight. They run off the battery when the vehicle is switched off.</description>
        <amps>10</amps>
        <shedOrder>5</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Fittings/WorkLamps</iconPath>
        <defaultOn>false</defaultOn>
        <available Class="Phobos.VehicleSystems.When_Any">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Granted">
              <ability>WorkLights</ability>
            </li>
            <li Class="Phobos.VehicleSystems.When_StatAbove">
              <stat>Phobos_WorkLights</stat>
              <value>0</value>
            </li>
          </conditions>
        </available>
        <autoOn Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Dark" />
            <li Class="Phobos.VehicleSystems.When_Moving">
              <invert>true</invert>
            </li>
            <li Class="Phobos.VehicleSystems.When_Any">
              <conditions>
                <li Class="Phobos.VehicleSystems.When_EngineRunning" />
                <li Class="Phobos.VehicleSystems.When_OnGrid" />
                <li Class="Phobos.VehicleSystems.When_QuantityAbove">
                  <quantity>charge</quantity>
                  <value>0.5</value>
                </li>
              </conditions>
            </li>
            <li Class="Phobos.VehicleSystems.When_PeopleNear">
              <radius>8</radius>
              <holdHours>1</holdHours>
            </li>
          </conditions>
        </autoOn>
        <autoDescription>they light by themselves in the dark while the vehicle stands still with your people near it, and go out an hour after the last one leaves. Switched off and with no power cable, they light only while the battery is more than half full</autoDescription>
        <standbyLabel>waiting for dark and a stop</standbyLabel>
        <autoStandbyLabel>waiting for dark, a stop and people near</autoStandbyLabel>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Dark" />
            <li Class="Phobos.VehicleSystems.When_Moving">
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <!-- Framework 0.375.0: the recovery winch's draw, as on the light land loadout (150 A averaged over a pull, authored), now that this loadout
             has a winch mount. Never shed; it stops only on a flat battery. -->
        <name>winch</name>
        <label>recovery winch</label>
        <description>The recovery winch's motor, drawing while it pulls. A long pull on a flat battery stops it.</description>
        <amps>150</amps>
        <shedOrder>0</shedOrder>
        <available Class="Phobos.VehicleSystems.When_FittingGrants">
          <ability>RecoveryWinch</ability>
        </available>
        <when Class="Phobos.VehicleSystems.When_Winching" />
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
