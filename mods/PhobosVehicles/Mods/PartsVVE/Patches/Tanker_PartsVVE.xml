<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vanilla Vehicles Expanded only: two engine blocks for the heavy truck. Steel stays first: Vehicle Framework reads the first cost item for the destruction sound. Counts are authored. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="Phobos_Tanker_Blueprint"]/costList</xpath>
    <value>
      <costList>
              <Steel>280</Steel>
              <VVE_EngineBlock>2</VVE_EngineBlock>
              <VVE_CarTransmission>1</VVE_CarTransmission>
              <VVE_CarFuelTank>1</VVE_CarFuelTank>
              <VVE_CarWheel>6</VVE_CarWheel>
              <VVE_CarSuspension>3</VVE_CarSuspension>
              <VVE_CarAlternator>1</VVE_CarAlternator>
              <VVE_CarBattery>1</VVE_CarBattery>
              <VVE_CarWiring>1</VVE_CarWiring>
              <VVE_CarRadiator>1</VVE_CarRadiator>
              <ComponentIndustrial>8</ComponentIndustrial>
      </costList>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="Phobos_Tanker_Blueprint"]/researchPrerequisites</xpath>
    <value>
      <li>VVE_BasicVehicles</li>
    </value>
  </Operation>
</Patch>
