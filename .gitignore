# Local tools, research, handoff originals, test saves and machine configuration.
/.local/
/.tools/
/work/
/artifacts/
/dist/
/saves/
/decompiled/
*.local.json
.env
.env.*
!.env.example
*.log
*.zip
*.rws
*.dmp
*.pfx
*.p12
*.key
*.pem
*.bak

# Art the mods don't ship stays off main (owner, 7 Nov 2026): reference drawings are kept on the art-references branch and drawn
# again by their scripts; full-size masters are on art-masters. See scripts/art/archive_branch.py.
assets/*/references/

# Build products are made locally; never commit assemblies, including built mod DLLs.
**/bin/
**/obj/
*.dll
*.exe
*.pdb
*.nupkg
*.deps.json
node_modules/
__pycache__/
*.pyc

# Editor clutter.
.vs/
.idea/
.vscode/
*.user
.DS_Store
Thumbs.db

# Claude Code session scratchpad, including nested git worktrees.
/.claude/
*.stackdump
