<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vehicle accessories, the camp (Framework 0.212.0; docs/development/vehicle-accessories.md, Y3, Y8, Y9 and B1; the owner's go of 22 Nov 2026):
    a roof tent on a vehicle's roof mount, an awning on its side rail, and swags carried in its cargo, set out beside it by the camp order and
    packed away again (CompPhobosCamp). The roof tent and the awning are fittings, made from kits as the power budget's are; the swag is a bed
    that packs, built like the game's own bedroll. Each weighs what its kit weighs, taken from the cargo capacity; none changes speed or fuel
    through drag (owner). Every cost, work, weight and figure is authored, agent defaults for the owner to revise, except where the record names
    the owner's choice: the swag's "slept under the stars" at +5 and the roof tent's memory at +4 (owner, 13 Nov 2026). Not yet tested in game.
    The pictures are ours, made locally with our house style model and picked by the owner (21 Nov 2026); each texture's record says how.
  -->

  <!-- ===== The kits ===== -->

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- A hard-shell roof tent of the usual two-person size: about 55 kg (the record's figure, authored). -->
    <defName>PhobosVehicleSystems_RoofTentKit</defName>
    <label>roof tent</label>
    <description>A two-person tent folded into a hard shell, with its ladder and mattress. Fitted to a vehicle's roof mount, it opens beside the parked vehicle when its camp is set up: a good bed for two, dry in rain.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/RoofTentKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>55</Mass>
      <WorkToMake>5000</WorkToMake>
      <MarketValue>260</MarketValue>
    </statBases>
    <costList>
      <Cloth>60</Cloth>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- A roll-out awning of about 2.5 m by 2 m on its own arms: 15 kg (the record's figure, authored). Canvas work, so the tailor makes it. -->
    <defName>PhobosVehicleSystems_AwningRoll</defName>
    <label>awning</label>
    <description>A canvas awning rolled in a bag, with folding arms and poles. Fitted to a vehicle's side rail, it rolls out over the ground along that side when its camp is set up, keeping rain and snow off whoever sits or sleeps beneath. It makes no room: the wind still blows through.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/AwningRoll</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>15</Mass>
      <WorkToMake>2500</WorkToMake>
      <MarketValue>90</MarketValue>
    </statBases>
    <costList>
      <Cloth>40</Cloth>
      <Steel>10</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements Inherit="False">
        <Crafting>3</Crafting>
      </skillRequirements>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <!-- ===== More tents (Framework 0.217.0; the owner, 22 Nov 2026): their kits ===== -->

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- Framework 0.217.0: a plain tarp with two short poles, pegs and guys, about 3 m by 2 m: 6 kg (authored). Canvas work, so the tailor makes it. -->
    <defName>PhobosVehicleSystems_SideFlyKit</defName>
    <label>side fly</label>
    <description>A canvas tarp in a bag, with two short poles, pegs and guy lines. Fitted to a vehicle's side rail, it is slung from the vehicle's side down to the ground at the rear when its camp is set up: a dry place for two swags. It is no room, and the wind blows through.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/SideFlyKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>6</Mass>
      <WorkToMake>1200</WorkToMake>
      <MarketValue>40</MarketValue>
    </statBases>
    <costList>
      <Cloth>20</Cloth>
      <Steel>4</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements Inherit="False">
        <Crafting>2</Crafting>
      </skillRequirements>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- Framework 0.217.0: zip-on walls and a flap for an awning, with their own poles: 18 kg (authored). -->
    <defName>PhobosVehicleSystems_AwningWallKit</defName>
    <label>awning walls</label>
    <description>Canvas walls and a door flap that zip onto an awning, with poles and pegs. With an awning, they make the walled awning: fitted to a vehicle's side rail, it stands beside the vehicle as a closed canvas room when its camp is set up, keeping out the wind and rain and holding a heater's warmth.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/AwningWallKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>18</Mass>
      <WorkToMake>3000</WorkToMake>
      <MarketValue>110</MarketValue>
    </statBases>
    <costList>
      <Cloth>60</Cloth>
      <Steel>10</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements Inherit="False">
        <Crafting>3</Crafting>
      </skillRequirements>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- Framework 0.217.0: a frame tent that fastens to a vehicle's back end, about 3 m square inside: 25 kg (authored). -->
    <defName>PhobosVehicleSystems_RearTentKit</defName>
    <label>rear tent</label>
    <description>A canvas frame tent in a long bag, made to be pitched against the back of a vehicle. Fitted to a vehicle's roof mount or side rail, it stands behind the vehicle as a closed canvas room with a door flap when its camp is set up: room for three swags, or two and a heater.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/RearTentKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>25</Mass>
      <WorkToMake>3500</WorkToMake>
      <MarketValue>140</MarketValue>
    </statBases>
    <costList>
      <Cloth>70</Cloth>
      <Steel>15</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements Inherit="False">
        <Crafting>3</Crafting>
      </skillRequirements>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- Framework 0.217.0: a camper trailer's fold-out tent with its two mattresses and floor: 90 kg (authored). -->
    <defName>PhobosVehicleSystems_CamperKit</defName>
    <label>fold-out camper</label>
    <description>A camper trailer's tent, folded flat on a hinged floor with two double mattresses. Fitted to a camper trailer's tent mount, it folds out beside the trailer as a closed canvas room with two double beds when its camp is set up. It takes the mount a roof tent would.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/CamperKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>90</Mass>
      <WorkToMake>8000</WorkToMake>
      <MarketValue>420</MarketValue>
    </statBases>
    <costList>
      <Cloth>120</Cloth>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements Inherit="False">
        <Crafting>5</Crafting>
      </skillRequirements>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="PhobosCampKitBase">
    <!-- Framework 0.217.0: a low frame tent that clamps to a flat deck's rails, with two mattresses: 30 kg (authored). -->
    <defName>PhobosVehicleSystems_DeckTentKit</defName>
    <label>deck tent</label>
    <description>A low canvas frame tent with clamps for a flat deck's rails, and two mattresses. Fitted to the roof mount of a vehicle with a flat deck, it stands on the deck itself: a small room to walk into, with two beds, up off the ground. It takes no ground beside the vehicle.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/DeckTentKit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>30</Mass>
      <WorkToMake>4000</WorkToMake>
      <MarketValue>170</MarketValue>
    </statBases>
    <costList>
      <Cloth>80</Cloth>
      <Steel>20</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements Inherit="False">
        <Crafting>3</Crafting>
      </skillRequirements>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <!-- ===== The fittings ===== -->

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_RoofTent</defName>
    <iconPath>Phobos/VehicleSystems/Camp/RoofTentKit</iconPath>
    <label>roof tent</label>
    <description>A two-person tent on the roof mount. When the vehicle's camp is set up it opens at the rear of the camp's side as a bed for two under its own canvas: rested as well as in a real bed, dry in rain. Waking in it lifts the spirits about as much as sleeping out of doors weighs on them. It takes the roof mount, so nothing else can ride there.</description>
    <roles><li>RoofMount</li></roles>
    <materials><PhobosVehicleSystems_RoofTentKit>1</PhobosVehicleSystems_RoofTentKit><Steel>5</Steel></materials>
    <givesBack><PhobosVehicleSystems_RoofTentKit>1</PhobosVehicleSystems_RoofTentKit></givesBack>
    <kilograms>55</kilograms>
    <work>2500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>RoofTent</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_Awning</defName>
    <iconPath>Phobos/VehicleSystems/Camp/AwningRoll</iconPath>
    <label>awning</label>
    <description>A canvas awning on the side rail. When the vehicle's camp is set up it rolls out over the two rows of ground along the camp's side, on poles: rain and snow do not fall beneath it, so people and things there stay dry. It is no room, and does not keep out the cold.</description>
    <roles><li>SideRail</li></roles>
    <materials><PhobosVehicleSystems_AwningRoll>1</PhobosVehicleSystems_AwningRoll><Steel>3</Steel></materials>
    <givesBack><PhobosVehicleSystems_AwningRoll>1</PhobosVehicleSystems_AwningRoll></givesBack>
    <kilograms>15</kilograms>
    <work>1500</work>
    <minSkill>2</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>Awning</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_SideFly</defName>
    <iconPath>Phobos/VehicleSystems/Camp/SideFlyKit</iconPath>
    <label>side fly</label>
    <description>A canvas tarp on the side rail. When the vehicle's camp is set up it is slung from the vehicle's side over three rows of ground at the rear of the camp's side: rain and snow do not fall beneath it. Lighter and cheaper than an awning, and shorter. It is no room.</description>
    <roles><li>SideRail</li></roles>
    <materials><PhobosVehicleSystems_SideFlyKit>1</PhobosVehicleSystems_SideFlyKit></materials>
    <givesBack><PhobosVehicleSystems_SideFlyKit>1</PhobosVehicleSystems_SideFlyKit></givesBack>
    <kilograms>6</kilograms>
    <work>800</work>
    <minSkill>1</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>SideFly</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_AwningRoom</defName>
    <iconPath>Phobos/VehicleSystems/Camp/AwningWallKit</iconPath>
    <label>walled awning</label>
    <description>An awning with zip-on walls, on the side rail. When the vehicle's camp is set up it stands along the camp's side as a closed canvas room, four cells out and as long as the vehicle, with a door flap: beds inside are indoors, and a camp heater keeps it warm. It takes the side rail, so not a plain awning or a side fly as well.</description>
    <roles><li>SideRail</li></roles>
    <materials><PhobosVehicleSystems_AwningRoll>1</PhobosVehicleSystems_AwningRoll><PhobosVehicleSystems_AwningWallKit>1</PhobosVehicleSystems_AwningWallKit><Steel>3</Steel></materials>
    <givesBack><PhobosVehicleSystems_AwningRoll>1</PhobosVehicleSystems_AwningRoll><PhobosVehicleSystems_AwningWallKit>1</PhobosVehicleSystems_AwningWallKit></givesBack>
    <kilograms>33</kilograms>
    <work>2500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>AwningRoom</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_RearTent</defName>
    <iconPath>Phobos/VehicleSystems/Camp/RearTentKit</iconPath>
    <label>rear tent</label>
    <description>A frame tent carried on the roof mount or the side rail. When the vehicle's camp is set up it stands behind the vehicle as a closed canvas room, a cell wider than the vehicle on each side and five deep, with a door flap at its far end. Nothing may stand behind the vehicle: unhitch a trailer first.</description>
    <roles><li>RoofMount</li><li>SideRail</li></roles>
    <materials><PhobosVehicleSystems_RearTentKit>1</PhobosVehicleSystems_RearTentKit><Steel>3</Steel></materials>
    <givesBack><PhobosVehicleSystems_RearTentKit>1</PhobosVehicleSystems_RearTentKit></givesBack>
    <kilograms>25</kilograms>
    <work>2000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>RearTent</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_FoldOutCamper</defName>
    <iconPath>Phobos/VehicleSystems/Camp/CamperKit</iconPath>
    <label>fold-out camper</label>
    <description>A camper trailer's own tent, on its tent mount. When the trailer's camp is set up it folds out beside the trailer as a closed canvas room, five cells out and six along, with two double beds and a walkway. It takes the tent mount, so not a roof tent or a rear tent there as well.</description>
    <roles><li>RoofMount</li></roles>
    <materials><PhobosVehicleSystems_CamperKit>1</PhobosVehicleSystems_CamperKit><Steel>10</Steel></materials>
    <givesBack><PhobosVehicleSystems_CamperKit>1</PhobosVehicleSystems_CamperKit></givesBack>
    <kilograms>90</kilograms>
    <work>4000</work>
    <minSkill>5</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>FoldOutCamper</li></grants>
    <!-- Only a trailer with a camp deck: the tent folds out from a flat deck. -->
    <loadouts><li>PhobosVehicleLoadout_TrailerCampDeck</li></loadouts>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_DeckTent</defName>
    <iconPath>Phobos/VehicleSystems/Camp/DeckTentKit</iconPath>
    <label>deck tent</label>
    <description>A tent that stands on the vehicle's own flat deck, on the roof mount. Right-click the vehicle with a colonist to go in: inside is a small room with two beds. Choose who sleeps there on the vehicle, and they walk in at bedtime by themselves. It takes no ground and needs no camp set up; its canvas keeps the wind and rain out and the air a little warmer than outside. The vehicle does not drive off while anyone is inside. It takes the roof mount, so not a roof tent or a rear tent there as well.</description>
    <roles><li>RoofMount</li></roles>
    <materials><PhobosVehicleSystems_DeckTentKit>1</PhobosVehicleSystems_DeckTentKit><Steel>5</Steel></materials>
    <givesBack><PhobosVehicleSystems_DeckTentKit>1</PhobosVehicleSystems_DeckTentKit></givesBack>
    <kilograms>30</kilograms>
    <work>2500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
    <grants><li>DeckTent</li></grants>
    <!-- Only a vehicle whose Def says it has a flat deck (PhobosFlatDeckExtension). -->
    <flatDeckOnly>true</flatDeckOnly>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <!-- Another faction's vehicles may carry the camp; at their own base, by the rules Def's chance, they stand with it out (CompPhobosCamp). -->
  <Phobos.VehicleSystems.PhobosVehicleFitSetDef>
    <defName>PhobosFitSet_Tourer</defName>
    <minTech>Medieval</minTech>
    <maxTech>Spacer</maxTech>
    <weight>1.5</weight>
    <fittings>
      <li>PhobosFitting_RoofTent</li>
      <li>PhobosFitting_Awning</li>
    </fittings>
  </Phobos.VehicleSystems.PhobosVehicleFitSetDef>

  <!-- ===== What the camp sets out ===== -->

  <ThingDef ParentName="BedWithQualityBase">
    <!-- Y8: the Australian canvas swag, a bedroll with its own mattress. Rest 1.0, comfort 0.75, 6 kg against the game's bedroll's 0.95, 0.68
         and 2.5 kg (the record's figures, authored). Built in the Architect as the game's bedroll is, so it packs and caravans use it. -->
    <defName>PhobosCamp_Swag</defName>
    <label>swag</label>
    <description>A canvas bedroll with its own foam mattress, a hood and short poles, rolled up tight for the road. It sleeps better than a plain bedroll and keeps the dew off, and caravans use it while travelling. Waking from a fair, mild night in one with nothing but sky overhead does wonders for the mood. Carried in a vehicle's cargo, it is laid out with the vehicle's camp and rolled up with it.</description>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/Swag</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>6</Mass>
      <BedRestEffectiveness>1</BedRestEffectiveness>
      <ImmunityGainSpeedFactor>1.05</ImmunityGainSpeedFactor>
      <Comfort>0.75</Comfort>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <size>(1,2)</size>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>70</costStuffCount>
    <building>
      <bed_showSleeperBody>false</bed_showSleeperBody>
      <bed_healPerDay>4</bed_healPerDay>
      <bed_caravansCanUse>true</bed_caravansCanUse>
      <destroySound>BuildingDestroyed_Soft_Medium</destroySound>
      <destroyShakeAmount>0</destroyShakeAmount>
    </building>
    <pathCost>14</pathCost>
    <passability>Standable</passability>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <uiOrder>2026</uiOrder>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosCampGearExtension">
        <work>150</work>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosBedMemoryExtension">
        <memory>PhobosSleptUnderTheStars</memory>
        <openSkyOnly>true</openSkyOnly>
        <fairWeatherOnly>true</fairWeatherOnly>
        <comfortableOnly>true</comfortableOnly>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <!-- B1, pitched: a two-person bed under its own canvas roof. Rest 1.0, comfort 0.8 (the record's figures, authored). Never built by hand: the
         vehicle's camp pitches and strikes it. It can be taken down by hand, for nothing back, so one left by a lost vehicle can be cleared. -->
    <defName>PhobosCamp_RoofTent</defName>
    <label>roof tent</label>
    <description>A vehicle's roof tent, unfolded beside it on its ladder: a mattress for two under canvas, up off the ground and out of the rain. The vehicle's camp folds it away again.</description>
    <thingClass>Phobos.VehicleSystems.Building_PhobosRoofTent</thingClass>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Camp/RoofTent</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <drawGUIOverlay>true</drawGUIOverlay>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>true</rotatable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>55</Mass>
      <MarketValue>260</MarketValue>
      <BedRestEffectiveness>1</BedRestEffectiveness>
      <ImmunityGainSpeedFactor>1.05</ImmunityGainSpeedFactor>
      <Comfort>0.8</Comfort>
      <Beauty>0</Beauty>
      <WorkToBuild>600</WorkToBuild>
    </statBases>
