<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The working trucks' research (docs/development/research-tree.md). Costs, positions and soft requirements are authored, gameplay choices to tune in play. Names are stable once a save can hold them. -->

  <ResearchProjectDef Abstract="True" Name="PhobosResearchTruckBase">
    <tab>PhobosDthorga</tab>
    <techLevel>Industrial</techLevel>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_Tipper</defName>
    <label>tipper hauler</label>
    <description>A truck with a body that lifts, to carry stone, ore and bulk loads and drop them where they are wanted.</description>
    <baseCost>1500</baseCost>
    <researchViewX>2</researchViewX>
    <researchViewY>1.2</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li>Electricity</li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded">VVE_BasicVehicles</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>Machining</li><li>Electricity</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_Tanker</defName>
    <label>bulk tanker</label>
    <description>A truck that carries liquids in bulk, with hoses and a pump to load and unload them.</description>
    <baseCost>2400</baseCost>
    <researchViewX>3</researchViewX>
    <researchViewY>1.2</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li>Electricity</li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded">VVE_BasicVehicles</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>Machining</li><li>Electricity</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_GeneratorSet</defName>
    <label>generator truck</label>
    <description>A diesel generator on a truck bed, to bring power to a camp or a job far from the grid.</description>
    <baseCost>2100</baseCost>
    <researchViewX>3</researchViewX>
    <researchViewY>2.0</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li>PhobosResearch_VehicleElectrics</li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded">VVE_BasicVehicles</li>
      <li MayRequire="vanillaexpanded.vfepower">VFE_IndustrialGenerators</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>Machining</li><li>Electricity</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_DrillRig</defName>
    <label>drill rig</label>
    <description>A mast and drill string on a truck. It goes to a deposit, sets up, and brings ore up far faster than a fixed deep drill.</description>
    <baseCost>3600</baseCost>
    <researchViewX>3</researchViewX>
    <researchViewY>0</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li>DeepDrilling</li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded">VVE_BasicVehicles</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>DeepDrilling</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_SurveyTruck</defName>
    <label>survey truck</label>
    <description>Instruments on a truck bed that find what lies under the ground, far faster than a fixed scanner.</description>
    <baseCost>2800</baseCost>
    <researchViewX>3</researchViewX>
    <researchViewY>0.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li>GroundPenetratingScanner</li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded">VVE_BasicVehicles</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>GroundPenetratingScanner</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <!-- The working trailers (Vehicles 0.61.0; research-gates-audit-2026-11-17.md, R1, R2 and R4, the owner's picks of 17 Nov 2026, costs as proposed).
       Until then every trailer opened with Vehicle parts. -->
  <!-- The service trucks' armour kits, first tier (D'thorga Vehicles 0.80.0; owner, 19 Nov 2026: research in two tiers;
       docs/development/vehicle-militarised-service-vehicles.md, "The kits"). After flak armour, which teaches the same ballistic steel and
       fabric. Its kits so far: engine and tank guards, run-flat tyres and EMP hardening. -->
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_TruckArmour</defName>
    <label>truck armour</label>
    <description>Steel guards, run-flat tyres and shielded wiring for the service trucks, so a stray bullet or a pulse does not leave them stranded.</description>
    <baseCost>1800</baseCost>
    <researchViewX>4</researchViewX>
    <researchViewY>1.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li>FlakArmor</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_Trailers</defName>
    <label>towing and trailers</label>
    <description>Drawbars, couplings and running gear for trailers any vehicle with a hitch can tow: the flatbed and the water and fuel bowsers.</description>
    <baseCost>1000</baseCost>
    <researchViewX>1</researchViewX>
    <researchViewY>2.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_VehicleParts</li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded">VVE_BasicVehicles</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <!-- Until Vehicles 0.61.0 Vehicle parts opened these: a colony that had it keeps them, granted once. -->
        <replaces><li>PhobosResearch_VehicleParts</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_FieldKitchen</defName>
    <label>field kitchen</label>
    <description>A kitchen on a trailer that pitches its own tent: cook anything a stove can far from home, meals ten at a time, and in a resting caravan.</description>
    <baseCost>2000</baseCost>
    <researchViewX>2</researchViewX>
    <researchViewY>2.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Trailers</li>
      <li>Electricity</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <!-- Until Vehicles 0.61.0 Vehicle parts opened these: a colony that had it keeps them, granted once. -->
        <replaces><li>PhobosResearch_VehicleParts</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_FieldCatering</defName>
    <label>field catering at scale</label>
    <description>A second range and the biggest kettle for the field kitchen, to feed a large camp: two cooks at once, and meals twenty at a time.</description>
    <baseCost>1500</baseCost>
    <researchViewX>3</researchViewX>
    <researchViewY>2.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_FieldKitchen</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <!-- Until Vehicles 0.61.0 Vehicle parts opened these: a colony that had it keeps them, granted once. -->
        <replaces><li>PhobosResearch_VehicleParts</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <!-- The V-22 Osprey (docs/development/vehicle-osprey.md, "Cost and research"; decided as written by the owner, 18 Nov 2026): 6,000 after
       our turbines research [A]; the Cherokee's is 4,000. Each of its upgrades has its own small project from a later slice. -->
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_Osprey</defName>
    <label>tiltrotor aircraft</label>
    <description>Rotors on tilting nacelles: an aircraft that lifts off like a helicopter and crosses the world like an aeroplane. Unlocks the V-22 Osprey.</description>
    <baseCost>6000</baseCost>
    <researchViewX>4</researchViewX>
    <researchViewY>0</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Turbines</li>
    </prerequisites>
    <!-- Brand new: it replaces nothing an existing colony has already researched. -->
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <!-- The V-22 Osprey's upgrades, each its own small project (the record's "Cost and research", decided as written by the owner on
       18 Nov 2026; D'thorga Vehicles 0.72.0). Costs and places authored. -->
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreySecondHook</defName>
    <label>second cargo hook</label>
    <description>Two hooks under one aircraft, sharing one load. The V-22 Osprey can sling up to 6,804 kg.</description>
    <baseCost>1200</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>0</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreyArmourKit</defName>
    <label>Osprey armour kit</label>
    <description>Ballistic plates fitted inside the V-22 Osprey's cockpit and cabin, against rifle fire.</description>
    <baseCost>1500</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>0.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreyInfraredJammer</defName>
    <label>infrared jammer</label>
    <description>Directional lamps that blind heat-seeking missiles, cued by the aircraft's missile warning receiver.</description>
    <baseCost>2000</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>1.2</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreyTerrainRadar</defName>
    <label>terrain-following radar</label>
    <description>A radar that lets a low-flying aircraft hug the ground blind, at night and in weather.</description>
    <baseCost>2000</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>2.0</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreyInletBarrier</defName>
    <label>inlet barrier</label>
    <description>Filters over an aircraft's engine intakes that keep sand and dust out of the turbines.</description>
    <baseCost>800</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>2.6</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <!-- The guns (D'thorga Vehicles 0.74.0): one project for the ramp mount, either gun; the belly gun after the game's own multi-barrel
       weapons, the minigun's project. Costs and places authored. -->
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreyRampGun</defName>
    <label>ramp gun mount</label>
    <description>A swinging mount on the V-22 Osprey's open ramp for a 7.62 mm or a .50 machine gun, worked by the crew chief to cover a landing.</description>
    <baseCost>1000</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>3.2</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef ParentName="PhobosResearchTruckBase">
    <defName>PhobosResearch_OspreyBellyGun</defName>
    <label>belly gun</label>
    <description>A minigun in a turret that lowers from the V-22 Osprey's belly and fires all round by itself while it has power.</description>
    <baseCost>2000</baseCost>
    <researchViewX>5</researchViewX>
    <researchViewY>3.8</researchViewY>
    <prerequisites>
      <li>PhobosResearch_Osprey</li>
      <li>MultibarrelWeapons</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces />
      </li>
    </modExtensions>
  </ResearchProjectDef>
</Defs>
