  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- F3, with T4: heavier pads and bigger discs or drums. Wear at stops and on the move both 0.6 (authored). -->
    <defName>PhobosFitting_HeavyBrakes</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/HeavyBrakes</iconPath>
    <label>heavy-duty brakes</label>
    <description>Bigger discs and thicker pads, made for a laden truck. They take a load's stopping in their stride and wear more slowly.</description>
    <roles><li>Brakes</li></roles>
    <!-- Framework 0.250.0 (per-engine realism round two): a brake at each wheel, so they go on an axle as a pair, as tyres do; mismatched
         brakes on an axle pull a vehicle to one side. Materials and work are per wheel now: a two-axle vehicle takes 60 steel, 8 components
         and 12,000 work in all, against 50, 5 and 8,000 for the one part before (authored: four heavier calipers and discs). -->
    <matchedSet>true</matchedSet>
    <matchedPerAxle>true</matchedPerAxle>
    <materials><Steel>15</Steel><ComponentIndustrial>2</ComponentIndustrial></materials>
    <work>3000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <parameterFactors>
      <li><system>PhobosVehicleSystem_Brakes</system><parameter>wearPerStop</parameter><factor>0.6</factor><label>brake wear at each stop</label></li>
      <li><system>PhobosVehicleSystem_Brakes</system><parameter>wearPerHourMoving</parameter><factor>0.6</factor><label>brake wear on the move</label></li>
      <!-- Framework 0.251.0 (gap D2 of the elevation record, the descent figure the cross-links promised): bigger discs warm more slowly and
           shed their heat faster, and thicker pads wear less on a descent (authored). -->
      <li><system>PhobosVehicleSystem_Brakes</system><parameter>brakeHeatFactor</parameter><factor>0.75</factor><label>brake heat on a descent</label></li>
      <li><system>PhobosVehicleSystem_Brakes</system><parameter>brakeCoolRate</parameter><factor>1.3</factor><label>brake cooling</label></li>
      <li><system>PhobosVehicleSystem_Brakes</system><parameter>descentWearPerKwHour</parameter><factor>0.6</factor><label>brake wear on a descent</label></li>
    </parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.251.0, descents (the owner's choice of 23 Nov 2026, the cross-links' F6): a valve in the exhaust that closes on the
         overrun, so the engine pumps against it and holds the vehicle back, about half the engine's rated power at rated speed ("about half
         the retarding power of engine brakes", the Wyoming report). Diesels only. An engine with a compression brake already holds more, so
         it adds nothing there. Its own picture since Framework 0.273.1 (the owner's pick of 23 Nov 2026, night 12's try 11); the
         turbocharger's before. Materials, work and skill authored. -->
