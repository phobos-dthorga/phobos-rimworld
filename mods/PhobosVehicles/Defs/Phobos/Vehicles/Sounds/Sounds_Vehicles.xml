<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Our vehicles' own voices (docs/development/sound-catalogue.md, phase 1). Agent-made with Stable Audio 3 Small SFX, taken from
       the agent's shortlist by the owner (10 and 11 Nov 2026), levelled by scripts/art/export_sound.py against the game sound each
       comment names; the records beside the sound files say how. The engine loops follow the engine: D'thorga Framework sets
       PhobosEnginePitch (a pitch multiplier from rpm) and PhobosEngineLoad (0 to 1), and these mappings fade the idling loop out and
       the labouring one in, as the game's own wind turbine maps its output. Doors list their takes; the game picks one at random. -->

  <!-- Tanker: against the game's ChemfuelFiredGenerator_Ambience (engine), Metal_Drop (door), HissSmall (air brakes). -->
  <SoundDef>
    <defName>PhobosVehicles_TankerEngineStart</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/Vehicles/Tanker/EngineStart</clipPath>
          </li>
        </grains>
        <volumeRange>13</volumeRange>
        <distRange>10~30</distRange>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>

  <SoundDef>
    <defName>PhobosVehicles_TankerEngineIdle</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/Vehicles/Tanker/EngineIdle</clipPath>
          </li>
        </grains>
        <volumeRange>13</volumeRange>
        <distRange>10~30</distRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_External">
              <inParamName>PhobosEnginePitch</inParamName>
              <defaultValue>1</defaultValue>
            </inParam>
            <outParam Class="SoundParamTarget_Pitch" />
            <paramUpdateMode>Constant</paramUpdateMode>
            <curve>
              <points>
                  <li>(0,0)</li>
                  <li>(3,3)</li>
              </points>
            </curve>
          </li>
          <li>
            <inParam Class="SoundParamSource_External">
              <inParamName>PhobosEngineLoad</inParamName>
              <defaultValue>0</defaultValue>
            </inParam>
            <outParam Class="SoundParamTarget_Volume" />
            <paramUpdateMode>Constant</paramUpdateMode>
            <curve>
              <points>
                  <li>(0,1)</li>
                  <li>(1,0.35)</li>
              </points>
            </curve>
          </li>
        </paramMappings>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>

