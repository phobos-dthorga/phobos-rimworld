<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vehicles' visual effects (D'thorga Framework 0.321.0; docs/development/vehicle-effects.md; the owner's cards of 26 Nov 2026). The colours of
    smoke follow what burns: blue-grey for oil, black for more fuel than air, white for water (secondary: engine makers' and mechanics'
    diagnostic guides as commonly cited; no figure checked). Every rate, size and colour value is authored, a look to tune by eye. The first
    loaded instance wins; another mod may patch it in XML. Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleFxRulesDef>
    <defName>PhobosVehicleFxRules</defName>
    <oilSmoke>(0.55, 0.64, 0.85, 0.75)</oilSmoke>
    <richSmoke>(0.12, 0.12, 0.12, 0.8)</richSmoke>
    <steam>(1, 1, 1, 0.55)</steam>
    <brakeSmoke>(0.85, 0.85, 0.85, 0.6)</brakeSmoke>
    <acrid>(0.6, 0.55, 0.45, 0.7)</acrid>
    <fuel>(0.15, 0.12, 0.08, 0.7)</fuel>
    <tyreSmoke>(0.9, 0.9, 0.9, 0.7)</tyreSmoke>
    <debris>(0.35, 0.3, 0.25, 0.9)</debris>
    <!-- The Light setting draws this share of what moving vehicles throw up. -->
    <lightShare>0.4</lightShare>
  </Phobos.VehicleSystems.PhobosVehicleFxRulesDef>
</Defs>
