<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What a fluids kit leaves: a drip for about half a day (authored). The care itself is the burn shock's tend, set by the fluids service. -->
  <HediffDef>
    <defName>PhobosMedical_OnDrip</defName>
    <label>on a drip</label>
    <labelNoun>a drip</labelNoun>
    <description>A bag of fluid is running into a vein, replacing the fluid lost through burns. Its effect shows on the burn shock as care.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.8, 0.95)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2</severityPerDay>
      </li>
    </comps>
    <stages>
      <li/>
    </stages>
  </HediffDef>
</Defs>
