<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    What replacing a destroyed part costs, by the role the part plays (vehicle health slice 3, docs/development/vehicle-health-design.md;
    Framework 0.36.0). The owner's decisions of 9 Nov 2026: engines and transmissions cost the whole part by default, everything else
    a share of its materials, both settable in the mod settings; our parts always exist, and another mod's are accepted only where they
    make sense. Every figure and the mass classes are authored, held for the owner's review. The first Def that fits a part wins.

    The substitutes are named per role so each is only offered where it suits: a light engine does not go in a tank, and a piston
    engine never replaces a turbine.

    Framework 0.95.0 (owner, 11 Nov 2026): the same table now fills a vehicle's parts bill when it is built
    (docs/development/parts-bills.md), so a build and a repair agree on which part suits a vehicle. With that, Vanilla Vehicles
    Expanded's parts follow what its own heavy vehicles do, in place of the 6-tonne cap of 9 Nov: one engine block under 6 tonnes, two
    to 15, three above (its Wisent takes three); its transmission, wheels and suspension up to 15 tonnes; its electrics, radiator, fuel
    tank and exhaust on anything. All authored, held for the owner's review. The order of a role's substitutes is the order of
    preference for a build: RimThunder's part, then Vanilla Vehicles Expanded's.
  -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_PistonEngine</defName>
    <label>piston engine</label>
    <description>Makes the vehicle's power. Damaged, it runs hotter and burns more oil.</description>
    <roles>
      <li>Engine</li>
      <li>Engine1</li>
      <li>Engine2</li>
      <li>Engine3</li>
      <li>Engine4</li>
    </roles>
    <turbine>No</turbine>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_EngineAssembly</item>
    <!-- Framework 0.95.0: we make one engine where RimThunder makes three classes, so a heavier vehicle takes more of ours, at the same
         weights (420, 840 and 1,260 silver beside RimThunder's 400, 800 and 1,350). A build and a repair both read this. Authored. -->
    <itemCountBySize>
      <li><minKilograms>4000</minKilograms><count>2</count></li>
      <li><minKilograms>15000</minKilograms><count>3</count></li>
    </itemCountBySize>
    <work>4000</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>EngineLight</thing><maxKilograms>4000</maxKilograms></li>
      <li MayRequire="rimthunder.core"><thing>EngineMedium</thing><minKilograms>4000</minKilograms><maxKilograms>15000</maxKilograms></li>
      <li MayRequire="rimthunder.core"><thing>EngineHeavy</thing><minKilograms>15000</minKilograms></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_EngineBlock</thing><maxKilograms>6000</maxKilograms></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_EngineBlock</thing><count>2</count><minKilograms>6000</minKilograms><maxKilograms>15000</maxKilograms></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_EngineBlock</thing><count>3</count><minKilograms>15000</minKilograms></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_TurbineEngine</defName>
    <label>gas turbine</label>
    <description>The gas turbine that makes its power. Run over its limits, its hot section wears and it can be damaged.</description>
    <roles>
      <li>Engine</li>
      <li>Engine1</li>
      <li>Engine2</li>
      <li>Engine3</li>
      <li>Engine4</li>
    </roles>
    <turbine>Yes</turbine>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_TurbineAssembly</item>
    <work>5000</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>EngineTurbine</thing></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Transmission</defName>
    <label>transmission</label>
    <description>Carries the engine's power to the wheels. Damaged, it runs hotter.</description>
    <roles>
      <li>Transmission</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_Transmission</item>
    <work>3000</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>ComponentTransmission</thing></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarTransmission</thing><maxKilograms>15000</maxKilograms></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Wheels</defName>
    <label>running gear</label>
    <description>The tyres or tracks it runs on. Rough ground knocks them about, and worn tread can fail.</description>
    <roles>
      <li>Wheels</li>
    </roles>
    <!-- For a build, ours is the drivetrain kit for the whole vehicle (Framework 0.95.0); a repair still charges the materials below. -->
    <item>PhobosVehicles_DrivetrainKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <!-- Framework 0.179.0 (owner, 20 Nov 2026): the heaviest take two kits, as they take more engines; today only the four-axle drill rig. -->
    <itemCountBySize>
      <li><minKilograms>15000</minKilograms><count>2</count></li>
    </itemCountBySize>
    <materials>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </materials>
    <work>800</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>ComponentWheelTire</thing></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarWheel</thing><maxKilograms>15000</maxKilograms></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Radiator</defName>
    <label>radiator</label>
    <description>Sheds the engine's heat to the air. Damaged, the engine runs hotter.</description>
    <roles>
      <li>Radiator</li>
    </roles>
    <!-- For a build, ours is the electrical kit for the whole vehicle (Framework 0.95.0); a repair still charges the materials below. -->
    <item>PhobosVehicles_ElectricalKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <materials>
      <Steel>20</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </materials>
    <substitutes>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarRadiator</thing></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.320.0 (docs/development/vehicle-turbocharger.md): a turbocharger shot or worn to nothing is replaced, at about a third of
       the fitting's own materials (authored, the same share as the other small parts). Never in a build's bill: the part is there only
       while a turbocharger is built in or fitted. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Turbocharger</defName>
    <label>turbocharger</label>
    <description>Forces more air into the engine for more power. Worn, it smokes and burns oil; failed, the engine loses what it gave.</description>
    <roles>
      <li>Turbocharger</li>
    </roles>
    <materials>
      <Steel>30</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </materials>
    <work>2000</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Battery</defName>
    <label>battery</label>
    <description>Holds the power to start the engine, and to run the lights and heaters with it off.</description>
    <roles>
      <li>Battery</li>
    </roles>
    <!-- For a build, ours is the electrical kit for the whole vehicle (Framework 0.95.0); a repair still charges the materials below. -->
    <item>PhobosVehicles_ElectricalKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <materials>
      <Steel>10</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </materials>
    <work>800</work>
    <substitutes>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarBattery</thing></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Alternator</defName>
    <label>alternator</label>
    <description>Charges the battery while the engine runs.</description>
    <roles>
      <li>Alternator</li>
    </roles>
    <!-- For a build, ours is the electrical kit for the whole vehicle (Framework 0.95.0); a repair still charges the materials below. -->
    <item>PhobosVehicles_ElectricalKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <materials>
      <Steel>10</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </materials>
    <work>800</work>
    <substitutes>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarAlternator</thing></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_SmallMechanical</defName>
    <label>small mechanical part</label>
    <!-- What each of these parts does, for its tooltip (Framework 0.96.0). -->
    <roleNotes>
      <li><role>Starter</role><text>Turns the engine over to start it. Broken, the engine cannot be started with the key.</text></li>
      <li><role>OilPump</role><text>Sends oil to the engine's bearings.</text></li>
      <li><role>FuelPump</role><text>Feeds fuel to the engine. Weak, the vehicle is slower; dead, it will not start.</text></li>
      <li><role>WaterPump</role><text>Moves coolant between the engine, the radiator and the cab heater. Without it the engine overheats and the heater goes cold.</text></li>
      <li><role>Brakes</role><text>Stop and hold the vehicle. Wrecked, it cannot be driven.</text></li>
      <li><role>Clutch</role><text>Joins the engine to the gearbox.</text></li>
      <li><role>Compressor</role><text>Pumps the air its brakes need. Without it the brakes stay on.</text></li>
      <li><role>HydraulicPump</role><text>Pressurises the oil that moves its rams and motors.</text></li>
      <li><role>HydraulicLines</role><text>Carry hydraulic oil to the working gear.</text></li>
      <li><role>SteeringPump</role><text>Takes the weight off the steering. Without it a heavy vehicle crawls.</text></li>
    </roleNotes>
    <roles>
      <li>Starter</li>
      <li>OilPump</li>
      <li>FuelPump</li>
      <li>WaterPump</li>
      <li>Brakes</li>
      <li>Clutch</li>
      <li>Compressor</li>
      <li>HydraulicPump</li>
      <li>HydraulicLines</li>
      <li>SteeringPump</li>
    </roles>
    <materials>
      <Steel>12</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </materials>
    <work>800</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.73.0: a drive belt is rubber, and the game has none, so chemfuel stands for it as it does for tyres (owner, 8 Nov 2026).
       Cheap and quick to fit, so a snapped belt strands a vehicle only when nobody carries a spare. Authored. Since 0.74.0 (S4) it is a
       drive belt item made at the parts bench, whole, at the whole-part share; a colony that still accepts raw materials pays its
       4 chemfuel instead. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_DriveBelt</defName>
    <label>drive belt</label>
    <description>Turns the water pump and the alternator from the engine. Snapped, the engine overheats and the battery stops charging.</description>
    <roles>
      <li>Belt</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_DriveBelt</item>
    <kit>true</kit>
    <work>300</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.178.0 (owner, 19 Nov 2026: the Osprey's part choices): a rotor drive part is a reduction gearbox, replaced whole, on
       every helicopter whose gearbox, transmission or rotor mast plays the role (ours and the tie-ins'). It had cost 30 steel and 4
       components, less than a car battery and alternator. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_RotorDrive</defName>
    <label>rotor drive</label>
    <description>The gearbox that carries the engines' power to a rotor. Damaged, it takes less power, and the aircraft lifts less.</description>
    <roles>
      <li>RotorDrive</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_ReductionGearbox</item>
    <work>2500</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.178.0: a shaft between gearboxes, such as a tiltrotor's interconnect shaft: what the rotor drive used to cost. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_DriveShaft</defName>
    <label>drive shaft</label>
    <description>A shaft joining two gearboxes, so one engine can turn both rotors if the other stops.</description>
    <roles>
      <li>DriveShaft</li>
    </roles>
    <materials>
      <Steel>30</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </materials>
    <work>2000</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.178.0: an aircraft's flight-control channels and its avionics bay are flight computers, replaced whole. The avionics bay
       is every aircraft's, appended where it has none (Loadouts_Default.xml), so its replacement changes on every aircraft. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_FlightComputer</defName>
    <label>flight computer</label>
    <roleNotes>
      <li><role>FlightControl</role><text>One channel of the fly-by-wire controls. Control is lost only when every channel is.</text></li>
      <li><role>Avionics</role><text>The instruments, navigation and autopilot. Damaged, they fail one by one.</text></li>
    </roleNotes>
    <roles>
      <li>FlightControl</li>
      <li>Avionics</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_FlightComputer</item>
    <work>1500</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.178.0: a hydraulic ram (a tipper's body, a drill rig's mast, a survey truck's boom, a tiltrotor's nacelle tilt and ramp).
       Framework 0.179.0 (owner, 20 Nov 2026): also other mods' aircraft's servos and our tipper's rams, as parts a repair reads; and, as with
       a drive belt, a colony that still accepts raw materials pays what an actuator is made of in place of the actuator. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Actuator</defName>
    <label>hydraulic actuator</label>
    <description>A hydraulic ram that lifts, tilts or steers a heavy part of the machine.</description>
    <roles>
      <li>Actuator</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_HydraulicActuator</item>
    <kit>true</kit>
    <work>1200</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.179.0 (owner, 20 Nov 2026: make it): an electric machine, replaced whole: a traction motor, a generator set's main
       generator, or an electric motor an upgrade or fitting is built round. Before the electric drive below, so it fills the traction
       motor; a heavier vehicle's motor is two of ours, as its engine is more of ours. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_ElectricMotor</defName>
    <label>electric motor</label>
    <roleNotes>
      <li><role>TractionMotor</role><text>The electric motors that turn its wheels.</text></li>
      <li><role>Generator</role><text>The generator the engine turns to make its power.</text></li>
      <li><role>ElectricMotor</role><text>The electric motor that drives it.</text></li>
    </roleNotes>
    <roles>
      <li>TractionMotor</li>
      <li>Generator</li>
      <li>ElectricMotor</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_ElectricMotor</item>
    <itemCountBySize>
      <li><minKilograms>15000</minKilograms><count>2</count></li>
    </itemCountBySize>
    <work>2000</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Framework 0.178.0: an aircraft's undercarriage leg, its shock strut and wheel, where it had been costed as a truck's running gear. Chemfuel
       stands for the tyre's rubber, as in our tyre sets. Materials authored. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_LandingGear</defName>
    <label>landing gear</label>
    <description>An undercarriage leg: its shock strut, wheel and tyre. Hard and rolling landings wear it.</description>
    <roles>
      <li>LandingGear</li>
    </roles>
    <materials>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Chemfuel>10</Chemfuel>
    </materials>
    <work>1500</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_ElectricDrive</defName>
    <label>traction battery</label>
    <!-- Framework 0.179.0: its traction motor is now the electric motor's, above; the battery stays materials (it was "electric drive"). -->
    <description>The battery it drives on.</description>
    <roles>
      <li>TractionBattery</li>
    </roles>
    <materials>
      <Steel>40</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </materials>
    <work>3000</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Boiler</defName>
    <label>boiler</label>
    <description>Raises the steam that drives it. Damaged, it raises less.</description>
    <roles>
      <li>Boiler</li>
    </roles>
    <materials>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </materials>
    <work>4000</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <!-- Roles only a build asks for (Framework 0.95.0): no part on a vehicle has them, so no repair reads them. They are the core's own
       Def type, which any built thing may use: the depot bay's fuel tank is one. Ours is materials, or one of our kits for the whole
       build. Figures authored. -->
  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_FuelTank</defName>
    <label>fuel tank</label>
    <roles>
      <li>FuelTank</li>
    </roles>
    <materials>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </materials>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>ComponentFuelTank</thing></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarFuelTank</thing></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_Suspension</defName>
    <label>suspension</label>
    <roles>
      <li>Suspension</li>
    </roles>
    <item>PhobosVehicles_DrivetrainKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <!-- As the running gear's (Framework 0.179.0): whichever role asks first, the kit count is the same. -->
    <itemCountBySize>
      <li><minKilograms>15000</minKilograms><count>2</count></li>
    </itemCountBySize>
    <substitutes>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarSuspension</thing><maxKilograms>15000</maxKilograms></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_Wiring</defName>
    <label>wiring</label>
    <roles>
      <li>Wiring</li>
    </roles>
    <item>PhobosVehicles_ElectricalKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <substitutes>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarWiring</thing></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <!-- Framework 0.179.0 (the second pass): a towed thing's lighting, its lamps' loom and plug, in place of the electrical kit (alternator,
       batteries, wiring and radiator) a trailer had been charged for lights it powers from the truck. Figures authored. -->
  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_Lighting</defName>
    <label>lighting harness</label>
    <roles>
      <li>Lighting</li>
    </roles>
    <materials>
      <Steel>5</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </materials>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_Exhaust</defName>
    <label>exhaust</label>
    <roles>
      <li>Exhaust</li>
    </roles>
    <materials>
      <Steel>40</Steel>
    </materials>
    <substitutes>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarExhaust</thing></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_Frame</defName>
    <label>frame casting</label>
    <roles>
      <li>Frame</li>
    </roles>
    <materials>
      <Steel>60</Steel>
    </materials>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>ComponentHeavyCasting</thing></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <!-- Materials and job gear from other mods (Framework 0.95.0; owner, 11 Nov 2026: reach to materials mods and job-specific gear).
       Each was read with the owner's patches applied before use, and is here because the real part is made of it
       (docs/development/parts-bills.md lists what was read and left out, and why). Figures authored. -->
  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_Hose</defName>
    <label>hose set</label>
    <roles>
      <li>Hose</li>
    </roles>
    <!-- Rubber: the game has none, so chemfuel stands for it, as it does in our drive belts and in other mods' tyres. -->
    <materials>
      <Chemfuel>20</Chemfuel>
    </materials>
    <substitutes>
      <!-- Rimefeller's synthylene is a made polymer: the honest thing for a hose where it exists. -->
      <li MayRequire="dubwise.rimefeller"><thing>Synthylene</thing><count>20</count></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_OxygenStore</defName>
    <label>oxygen store</label>
    <roles>
      <li>OxygenStore</li>
    </roles>
    <!-- Flasks, charged by the boat's own air plant. -->
    <materials>
      <Steel>20</Steel>
    </materials>
    <substitutes>
      <!-- Vanilla Gravship Expanded's oxygen comes in small canisters (150 to a stack): a first charge for the flasks. -->
      <li MayRequire="vanillaexpanded.gravship"><thing>VGE_OxygenCanister</thing><count>30</count></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <!-- Framework 0.178.0: rotor blades, a build's role only (no part of a vehicle is its blades alone). Plasteel stands for the composite
       blades are made of; Rimefeller's composite is the honest thing where it exists, at the same worth (45 at 8 beside 40 plasteel at 9). -->
  <Phobos.Framework.Bills.PhobosRoleSupplyDef>
    <defName>PhobosPartSupply_RotorBlades</defName>
    <label>rotor blades</label>
    <roles>
      <li>RotorBlades</li>
    </roles>
    <materials>
      <Plasteel>40</Plasteel>
    </materials>
    <substitutes>
      <li MayRequire="dubwise.rimefeller"><thing>FiberComposite</thing><count>45</count></li>
    </substitutes>
  </Phobos.Framework.Bills.PhobosRoleSupplyDef>

  <!-- Every part with no role of its own, most of a vehicle's armour and hull: by its size. Before the player's share. -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Default</defName>
    <label>hull or fitting</label>
    <isDefault>true</isDefault>
    <steelPerHealth>0.5</steelPerHealth>
    <componentsPerHealth>0.02</componentsPerHealth>
    <work>1500</work>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
</Defs>
