      </li>
    </soundOneShotsOnEvent>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <!-- A 1,500 tank burning 200 a day (owner, 18 Nov 2026): 4.3 L a unit of the real 6,513 L [A]; about 790 range by Vehicle
             Framework's formula, 1.9 times the Mi-38's, as the real ranges are 1.85 times [I]. -->
        <fuelConsumptionRate>200</fuelConsumptionRate>
        <fuelCapacity>1500</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_VehicleLauncher">
        <!-- Vehicle Framework's own VTOL take-off: straight up for 300 ticks (the record's take-off and landing time), then a climb
             away; landing the reverse. The curves are ours, authored: the picture rises up the screen as it climbs, and its shadow
             fades. Our own flight over the map replaces this on the map in a later slice. -->
        <launchProtocol Class="Vehicles.VTOLTakeoff">
          <launchProperties Class="Vehicles.VerticalProtocolProperties">
            <maxTicksVertical>300</maxTicksVertical>
            <maxTicks>180</maxTicks>
            <zPositionVerticalCurve>
              <points>
                <li>(0, 0)</li>
                <li>(0.3, 0.6)</li>
                <li>(1, 4)</li>
              </points>
            </zPositionVerticalCurve>
            <shadowAlphaVerticalCurve>
              <points>
                <li>(0, 0.9)</li>
                <li>(1, 0.6)</li>
              </points>
            </shadowAlphaVerticalCurve>
            <zPositionCurve>
              <points>
                <li>(0, 0)</li>
                <li>(0.4, 8)</li>
                <li>(1, 40)</li>
              </points>
            </zPositionCurve>
            <shadowAlphaCurve>
              <points>
                <li>(0, 0.6)</li>
                <li>(1, 0)</li>
              </points>
            </shadowAlphaCurve>
          </launchProperties>
          <landingProperties Class="Vehicles.VerticalProtocolProperties">
            <maxTicks>180</maxTicks>
            <maxTicksVertical>300</maxTicksVertical>
            <zPositionCurve>
              <points>
                <li>(0, 36)</li>
                <li>(0.6, 8)</li>
                <li>(1, 0)</li>
              </points>
            </zPositionCurve>
            <shadowAlphaCurve>
              <points>
                <li>(0, 0)</li>
                <li>(1, 0.6)</li>
              </points>
            </shadowAlphaCurve>
            <zPositionVerticalCurve>
              <points>
                <li>(0, 4)</li>
                <li>(0.7, 0.6)</li>
                <li>(1, 0)</li>
              </points>
            </zPositionVerticalCurve>
            <shadowAlphaVerticalCurve>
              <points>
                <li>(0, 0.6)</li>
                <li>(1, 0.9)</li>
              </points>
            </shadowAlphaVerticalCurve>
          </landingProperties>
        </launchProtocol>
      </li>
      <!-- It carries no gun as built, but its tree fits three, and Vehicle Framework's turret upgrade needs this comp to hold them: without
           it every gun node threw and added nothing (fault-read D1, 19 Nov 2026; D'thorga Vehicles 0.82.0). -->
      <li Class="Vehicles.CompProperties_VehicleTurrets" />
      <!-- Its upgrades (D'thorga Vehicles 0.72.0): UpgradeTree_Osprey.xml. -->
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_Osprey_UpgradeTree</def>
      </li>
      <!-- Its rotors and tilting nacelles (D'thorga Vehicles 0.70.0, Framework 0.146.0): D'thorga Framework's tiltrotor renderer draws the
           nacelle at 0, 30, 60 or 90 degrees in its paint, with the inlet barrier's set once that upgrade is fitted and damage below 60%
           health; each rotor still or spinning, foreshortened as it tips and moved forward. Upright on the map; tipping forward through the
           climb away and back on the approach. Places in cells from the body's centre, measured off the art by
           assets/phobos-vehicles/export_osprey.py (Osprey.layout.json); the right side is the left turned over. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTiltrotor">
        <nacellePath>Phobos/Vehicles/Osprey/Osprey_Nacelle</nacellePath>
        <variants>
          <li>
            <node>InletBarrier</node>
            <suffix>Barrier</suffix>
          </li>
        </variants>
        <rotorPath>Phobos/Vehicles/Osprey/Osprey_Rotor</rotorPath>
        <rotorSpinPath>Phobos/Vehicles/Osprey/Osprey_RotorSpin</rotorSpinPath>
        <!-- 11.61 m [S] at 1.175 cells a metre is 13.6 cells; its picture is 14 cells square. -->
        <rotorDrawCells>14</rotorDrawCells>
        <sides>
          <li>
            <part>LeftNacelle</part>
            <hub>(-8.277, 2.211)</hub>
            <pivot>(-8.255, -0.509)</pivot>
            <damageSide>Left</damageSide>
            <bladeStart>0</bladeStart>
          </li>
          <li>
            <part>RightNacelle</part>
            <hub>(8.254, 2.157)</hub>
            <pivot>(8.257, -0.509)</pivot>
            <mirrored>true</mirrored>
            <damageSide>Right</damageSide>
            <bladeStart>60</bladeStart>
          </li>
        </sides>
      </li>
      <!-- Damage pictures while a part is below 60% health: the bulk tanker's marks cut to each part's outline by
           assets/phobos-vehicles/derive_osprey_parts.py (19 Nov 2026). The nacelles' come with the renderer. Agent placements. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosDamageLooks">
        <looks>
          <li>
            <part>Cockpit</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/Osprey/Osprey_DamageCockpit</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(19, 21)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>ForwardCabin</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/Osprey/Osprey_DamageForwardCabin</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(19, 21)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>AftCabin</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/Osprey/Osprey_DamageAftCabin</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(19, 21)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>LeftWing</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/Osprey/Osprey_DamageLeftWing</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(19, 21)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>RightWing</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/Osprey/Osprey_DamageRightWing</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(19, 21)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>Tail</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/Osprey/Osprey_DamageTail</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(19, 21)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
        </looks>
      </li>
      <!--
        The walk-in cabin (D'thorga Framework's vehicle cabins; owner, 22 Nov 2026; docs/development/vehicle-cabins.md): the V-22's cabin, nose
        first, the ramp at the back. Three cells across (a seat each side and the aisle) and thirteen long, a gameplay size for the real
        cabin's 24 troop seats along both walls [P]. It follows the cabin's fittings: the litter kit gives 6 seats and 8 litters (the real
        stretcher fit is 9 litters and 6 seats [P], its litters stacked three high, which a flat map cannot show); a ferry tank fills the front
        with tanks and leaves 8 seats [S], as the real ferry fit does; both together leave 6 litters behind the tanks (authored).
      -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosVehicleCabin">
        <layouts>
          <li>
            <whenFitted>
              <li>PhobosFitting_LitterKit</li>
              <li>PhobosFitting_FerryTank</li>
            </whenFitted>
            <rows>
              <li>TTT</li>
              <li>TTT</li>
              <li>TTT</li>
              <li>TTT</li>
              <li>TTT</li>
              <li>TTT</li>
              <li>L.L</li>
              <li>l.l</li>
              <li>L.L</li>
              <li>l.l</li>
              <li>L.L</li>
              <li>l.l</li>
              <li>.E.</li>
            </rows>
          </li>
          <li>
            <whenFitted>
