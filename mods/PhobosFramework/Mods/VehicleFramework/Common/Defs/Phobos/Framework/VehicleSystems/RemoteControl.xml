<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The remote control of vehicles (D'thorga Framework 0.278.0; docs/development/autonomous-vehicles.md, step 3). A vehicle a station drives
    keeps driving for this long after its link is lost, in case it comes back, then does what the player chose for it: hold, come back or
    carry on. The first loaded instance wins; another mod may patch it in XML. Every figure is authored, for the owner to revise. Not yet
    tested in game.
  -->
  <Phobos.VehicleSystems.PhobosRemoteControlRulesDef>
    <defName>PhobosRemoteControlRules</defName>
    <!-- Ten seconds at normal speed. -->
    <lostLinkDelayTicks>600</lostLinkDelayTicks>
    <!-- A vehicle coming back stops on a ring this many cells round its station. -->
    <comeBackRing>5</comeBackRing>
    <!-- Keeping to radio cover (Framework 0.279.0): a step wholly where the link would fail is worth about eight cells of detour. -->
    <uncoveredCellCost>8</uncoveredCellCost>
    <!-- The route level (Framework 0.281.0; step 7a): at most four followers (the owner, 18 Nov 2026); the rest authored. -->
    <maxFollowers>4</maxFollowers>
    <followGapCells>2</followGapCells>
    <followNearCells>2</followNearCells>
    <followSlackCells>4</followSlackCells>
    <standRingCells>4</standRingCells>
    <loopArriveCells>3</loopArriveCells>
    <!-- An hour of the game's at each stop, for colonists to load or unload it. -->
    <loopDwellTicks>2500</loopDwellTicks>
  </Phobos.VehicleSystems.PhobosRemoteControlRulesDef>
</Defs>
