<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The tipper's upgrades (docs/development/vehicle-tipper-hauler.md). Figures and costs authored. Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_Tipper_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>HighSides</key>
      <label>Greedy boards</label>
      <displayLabel>true</displayLabel>
      <description>Taller side boards, which drivers call greedy boards: 600 kg more of anything.</description>
      <icon>Phobos/Vehicles/Tipper/Upgrades/HighSides</icon>
      <work>1500</work>
      <gridCoordinate>(2, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>600</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>RockBody</key>
      <label>Rock body</label>
      <displayLabel>true</displayLabel>
      <description>A short, steep body with a thick floor. It carries the same, but sheds its load half as fast again.</description>
      <icon>Phobos/Vehicles/Tipper/Upgrades/RockBody</icon>
      <work>3000</work>
      <gridCoordinate>(7, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Machining</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>BulkBody</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_TipRate</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>BulkBody</key>
      <label>Bulk body</label>
      <displayLabel>true</displayLabel>
      <description>A long, shallow body: 3,600 kg before any greedy boards, for ore and steel, but it tips slower.</description>
      <icon>Phobos/Vehicles/Tipper/Upgrades/BulkBody</icon>
      <work>3000</work>
      <gridCoordinate>(12, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Machining</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>RockBody</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>1200</value>
            </li>
            <li>
              <def>Phobos_TipRate</def>
              <value>-0.5</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>150</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Owner, 12 Nov 2026: the loading grab, batch 3 signature (docs/development/vehicle-upgrades-round-two.md). Lift and cost authored;
           reach and pace are in the rules Def. No picture on the body yet: no crane picture exists for the tipper. -->
      <key>PhobosLoadingGrab</key>
      <label>Loading grab</label>
      <displayLabel>true</displayLabel>
      <description>A small hydraulic crane behind the cab with a two-jawed grab. With a driver aboard and the truck stopped, it lifts loose chunks and stacks lying within 4 cells into the cargo, up to 500 kg a lift, with no one else to carry them. The truck cannot tip while the grab is out.</description>
      <icon>Phobos/VehicleSystems/Stations/Grab</icon>
      <work>3000</work>
      <gridCoordinate>(7, 11)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Machining</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_GrabLift</def>
              <value>500</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <!-- D'thorga Vehicles 0.87.0: its ram is a hydraulic actuator, added by Bill_Tipper.xml; these are what is left beside it (was 120
           steel and 4 components). -->
      <ingredients>
        <Steel>90</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Armour kits without a picture of their own (D'thorga Vehicles 0.80.0; vehicle-militarised-service-vehicles.md, "The kits").
           Each raises named parts by class with Add (vehicle-armour.md; Combat Extended's figures in Mods/CombatExtended), and its real
           kilograms [A] load the engine as cargo would (owner, 19 Nov 2026), taking cargo room on the Talus only. Figures and costs authored.
           scripts/check-vehicle-armour.py holds each kit to its class on both scales. Not yet tested in game. -->
      <key>PhobosEngineGuards</key>
      <label>Engine and tank guards</label>
      <displayLabel>true</displayLabel>
      <description>Steel guards around the engine and the fuel tank, against rifle fire. A guarded tank still leaks and a guarded engine still burns once they are finally holed: it takes heavier fire to get there.</description>
      <upgradeExplanation>Engine and fuel tank: from skin to rifle armour, which stops ordinary rifle bullets.\nCargo room: 300 kg less.\nKit weight: 300 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EngineGuards</icon>
      <work>2500</work>
      <gridCoordinate>(2, 16)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Engine</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>FuelTank</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>-300</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>100</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRunFlatTyres</key>
      <label>Run-flat tyres</label>
      <displayLabel>true</displayLabel>
      <description>Steel-belted tyres with run-flat inserts, so the wheels shrug off shell fragments and pistol bullets.</description>
      <upgradeExplanation>Wheels: from skin to splinter armour, which stops shell fragments and pistol bullets.\nCargo room: 120 kg less.\nKit weight: 120 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RunFlatTyres</icon>
      <work>1500</work>
      <gridCoordinate>(7, 16)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>FrontWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>RearWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>-120</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>120</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>30</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosEmpHardening</key>
      <label>EMP hardening</label>
      <displayLabel>true</displayLabel>
      <description>Shielded wiring, filtered power and a spare engine control unit, so an electromagnetic pulse does the electrics less harm and stalls the engine less often, as it does on a military vehicle.</description>
      <upgradeExplanation>Electrics: an electromagnetic pulse harms them as it does a military vehicle's.\nCargo room: 60 kg less.\nKit weight: 60 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EmpHardening</icon>
      <work>2000</work>
      <gridCoordinate>(12, 16)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_EmpHardening</def>
              <value>1</value>
            </li>
            <li>
              <def>CargoCapacity</def>
              <value>-60</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>60</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- The drawn armour kits (D'thorga Vehicles 0.86.0; vehicle-militarised-service-vehicles.md, "The kits"), with their
           pictures from paid edits of the picked body (owner's picks of 19 Nov 2026). Armour by class with Add, Combat Extended's
           figures in Mods/CombatExtended; real kilograms [A] load the engine as cargo would, taking cargo room on the Talus only.
           Figures and costs authored. Not yet tested in game. -->
      <key>PhobosArmouredCab</key>
      <label>Armoured cab</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel plates over the cab's roof and doors and a steel frame round a narrowed windscreen, so ordinary rifle bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from skin to rifle armour, which stops ordinary rifle bullets.\nCargo room: 1,000 kg less.\nKit weight: 1,000 kg more, carried as cargo.\nWith the gathering run: may keep working while enemies are about (Gather what).</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/ArmouredCab</icon>
      <work>4000</work>
      <gridCoordinate>(2, 21)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>-1000</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1000</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>250</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRamBar</key>
      <label>Ram bar</label>
      <displayLabel>true</displayLabel>
      <description>A heavy steel beam across the front, braced back to the chassis. Driving into an animal, a raider or a wall harms the truck half as much, and what it hits more.</description>
      <upgradeExplanation>Damage the truck takes from running into people and animals: half (0.50 to 0.25).\nFrom running into buildings: half (0.10 to 0.05).\nDamage it does to people and animals it runs into: half as much again (0.50 to 0.75); to buildings, 2.5 to 3.0.\nCargo room: 150 kg less.\nKit weight: 150 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RamBar</icon>
      <work>1500</work>
      <gridCoordinate>(7, 21)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <statCategories>
            <li>
              <def>PawnCollisionRecoilMultiplier</def>
              <value>-0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionRecoilMultiplier</def>
              <value>-0.05</value>
              <type>Add</type>
            </li>
            <li>
              <def>PawnCollisionMultiplier</def>
              <value>0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionMultiplier</def>
              <value>0.5</value>
              <type>Add</type>
            </li>
          </statCategories>
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>-150</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosBodyPlates</key>
      <label>Body plates</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel skirts along both sides, over the tipping body, so ordinary rifle bullets stop before they reach it. They show on the truck.</description>
      <upgradeExplanation>Tipping body: from skin to rifle armour, which stops ordinary rifle bullets.\nCargo room: 1,100 kg less.\nKit weight: 1,100 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/BodyPlates</icon>
      <work>4000</work>
      <gridCoordinate>(12, 21)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>TipperBody</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>-1100</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1100</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>275</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosHeavyCabPlates</key>
      <label>Heavy cab plates</label>
      <displayLabel>true</displayLabel>
      <description>Thick steel slabs over the armoured cab and a steel visor over the windscreen with two vision slits, so armour-piercing rifle bullets and ordinary heavy machine-gun bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from rifle to armour-piercing rifle armour, which stops armour-piercing rifle bullets and ordinary heavy machine-gun bullets.\nCargo room: 850 kg less.\nKit weight: 850 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/HeavyCabPlates</icon>
      <work>5000</work>
      <gridCoordinate>(2, 26)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_HeavyTruckArmour</li>
      </researchPrerequisites>
      <prerequisiteNodes>
        <li>PhobosArmouredCab</li>
      </prerequisiteNodes>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>-850</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>850</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
