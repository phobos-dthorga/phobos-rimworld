<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Ushankas Biological Warfare (Ushanka.BiologicalWarfare, Workshop 3221550806): vaccines and antiserums from
    1.6/Defs/CombatDiseases/<Disease>.xml with the base cost lists in CombatDiseases/Bases/. Lab recipe x 4
    (ticks = lab work x 4 x 4). Vaccines and antiserums stack to 15, so the output cap is 11. The
    reproduction pills take one sample each and samples do not stack, so those bills make one at a time.
    Every figure is a port of the source recipe unless the comment or the README says
    it is authored. Loaded only while the source mod is active (LoadFolders.xml). Not yet tested in game.
  -->

  <PipeSystem.ProcessDef>
    <defName>PhobosFactory_SynthesizeFluVaccine</defName>
    <label>Synthesize a batch of flu vaccine</label>
    <labelOverride>Synthesize a batch of flu vaccine</labelOverride>
    <description>Synthesize a batch of flu vaccine (Ushankas Biological Warfare) from flu pathogen, neutroamine and penoxycyline.</description>
    <priorityInBillList>30</priorityInBillList>
    <spawnOnInteractionCell>true</spawnOnInteractionCell>
    <autoGrabFromHoppers>true</autoGrabFromHoppers>
    <autoInputSlots>
      <li>(-1,0,2)</li>
      <li>(0,0,2)</li>
      <li>(1,0,2)</li>
    </autoInputSlots>
    <ticks>41600</ticks>
    <ingredients>
      <li>
        <thing>Neutroamine</thing>
        <countNeeded>32</countNeeded>
      </li>
      <li>
        <thing>Penoxycyline</thing>
        <countNeeded>4</countNeeded>
      </li>
      <li>
        <thing>USH_FluPathogen</thing>
        <countNeeded>100</countNeeded>
      </li>
    </ingredients>
    <results>
      <li>
        <thing>USH_FluVaccine</thing>
        <count>4</count>
      </li>
    </results>
    <researchPrerequisites>
      <li>USH_FluVaccineRes</li>
      <li>VFE_ComplexFactories</li>
    </researchPrerequisites>
    <isFactoryProcess>true</isFactoryProcess>
    <autoExtract>true</autoExtract>
    <onlyGrabAndOutputToFactoryHoppers>true</onlyGrabAndOutputToFactoryHoppers>
    <sustainerWhenWorking>true</sustainerWhenWorking>
    <sustainerDef>VFEFactory_AutomatedDrugsSustainer</sustainerDef>
    <effecterWhenWorking>true</effecterWhenWorking>
    <effecterDef>VFEFactory_Cook</effecterDef>
    <maxOutputCount>11</maxOutputCount>
  </PipeSystem.ProcessDef>

