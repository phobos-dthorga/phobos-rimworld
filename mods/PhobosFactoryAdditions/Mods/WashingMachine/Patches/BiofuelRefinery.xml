<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Add the bills in this folder to VFEFactory_AutomatedBiofuelRefinery. Loaded only while the source mod is active. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEFactory_AutomatedBiofuelRefinery"]/comps/li[@Class="PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
    <value>
      <li>PhobosFactory_MakeDetergent</li>
      <li>PhobosFactory_MakeHeavyDutyDetergent</li>
    </value>
  </Operation>

</Patch>
