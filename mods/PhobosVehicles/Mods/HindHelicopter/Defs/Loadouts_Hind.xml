<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The Hind (Hind_Helicopter): two turboshafts, bound by their own parts (EngineStarboard as the first engine, EnginePort as the second),
    with the helicopter flight profile (docs/development/vehicle-turbine-design.md). With one engine out the other carries the load
    on its contingency rating and runs hot; a hover may then be beyond it. Not yet tested in game. Ratings and limits are the
    Framework's authored helicopter turboshaft (Drivetrains.xml).
    Its main gearbox (the VR-24) is appended (Framework 0.12.0). No published limit for it was found (8 Nov 2026), so the drive
    limit, 0.9 of both engines' maximum continuous, is authored.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_Hind</defName>
    <label>attack helicopter (twin turboshaft)</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Hind_Helicopter</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AeroTurboshaft</def>
      <set>
        <transmissionLimit>0.9</transmissionLimit>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_Helicopter</flightProfile>
    <!-- Avionics (Framework 0.110.0): the Mi-24's fit as the record gives it (agent defaults; secondary sources): full navigation, an
         autopilot, a full sight, a warning receiver and countermeasures. Its instruments go in an appended avionics bay (owner, 13 Nov 2026). -->
    <avionics>
      <navigation>Full</navigation>
      <autopilot>true</autopilot>
      <sight>Full</sight>
      <warning>true</warning>
      <countermeasures>true</countermeasures>
    </avionics>
    <!-- Sling loads (owner, 12 Nov 2026: the Hind and the Louie join the Cherokee): the Mi-24's external sling load, 2,400 kg. Approximate,
         from secondary sources (warriorlodge.com, "Russian Mil Mi-24"; militarymachine.com, "Mil Mi-24"), which give the airframe's
         figure; the hook's own rating was not found, and the usable load is the lower of the two. The Hind is a VTOL Vehicle aircraft,
         which flies on the map by itself: the sling takes the load as it sets off and sets it down once it has landed (Framework 0.102.0,
         OnMapFlight). The same sources give 8 troops or 4 stretchers, which the litter kit's four litters match. -->
    <sling>
      <ratedKilograms>2400</ratedKilograms>
    </sling>
    <partRoles>
      <li>
        <!-- The main rotor gearbox: neither mod gives the helicopter one, so it is appended among the engines (owner, 8 Nov 2026:
             rotor drives for every helicopter). -->
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Gearbox</li>
              <li>Transmission</li>
              <li>RotorMast</li>
            </keyContainsAny>
          </li>
        </find>
        <add>
          <key>PhobosMainGearbox</key>
          <label>main rotor gearbox</label>
          <health>40</health>
          <hitWeight>0.3</hitWeight>
          <cellsOf>Engine1</cellsOf>
        </add>
      </li>
      <li>
        <!-- A hook mount under the belly for the cargo hook fitting: appended, so a hook is lost with its mount. Its health and place, with the
             main rotor gearbox, are authored, as on the Cherokee and the Louie. -->
        <role>HookMount</role>
        <add>
          <key>PhobosHookMount</key>
          <label>hook mount</label>
          <health>40</health>
          <cellsOf>RotorDrive</cellsOf>
        </add>
      </li>
      <li>
        <!-- The cabin for the litter kit: the Hind has no cabin part of its own, and its troop cabin is in the fuselage (Body), so the kit is
             fitted there. -->
        <role>Cabin</role>
        <find>
          <li>
            <key>Body</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <keyContains>EngineStarboard</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <keyContains>EnginePort</keyContains>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
