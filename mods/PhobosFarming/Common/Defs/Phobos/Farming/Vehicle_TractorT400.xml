      <depth>External</depth>
      <hitWeight>3</hitWeight>
      <hitbox>
        <cells>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>65</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -1)</li>
          <li>(1, -1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
