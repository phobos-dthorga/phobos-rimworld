<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The live systems schematic (Framework 0.363.0; docs/development/vehicle-schematic.md, SC1 and SC5; the owner's answers of 28 Nov 2026:
    a first slice, the flow sheet first, for one kind of vehicle). Not yet tested in game.

    One page for every land vehicle with a piston engine: the light, medium, heavy and tracked loadouts and the vehicles built on them. A
    part a vehicle lacks is left out with its pipes, so a truck with no turbocharger draws its air straight from the filter to the engine.
    The layout is authored, in drawing units on a 720 by 360 page (x to the right, y down); rect is (x, y, width, height). It is a plain
    flow sheet, not a drawing of any real engine. Other modders add a page for their own kind in XML.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSchematicDef>
    <defName>PhobosVehicleSchematic_PistonLand</defName>
    <label>piston engine, land</label>
    <loadoutKinds>
      <li>CombustionLand</li>
      <li>CombustionHeavy</li>
      <li>CombustionTracked</li>
    </loadoutKinds>
    <engineKinds>
      <li>Piston</li>
    </engineKinds>
    <size>(720, 360)</size>
    <nodes>
      <li>
        <key>radiator</key>
        <label>radiator</label>
        <shape>Radiator</shape>
        <rect>(40, 60, 50, 170)</rect>
        <role>Radiator</role>
        <system>PhobosVehicleSystem_Cooling</system>
        <quantity>coolantLevel</quantity>
      </li>
      <li>
        <key>waterPump</key>
        <label>water pump</label>
        <shape>Pump</shape>
        <rect>(130, 225, 28, 28)</rect>
        <role>WaterPump</role>
        <system>PhobosVehicleSystem_Cooling</system>
      </li>
      <li>
        <key>alternator</key>
        <label>alternator</label>
        <rect>(128, 112, 40, 36)</rect>
        <role>Alternator</role>
        <system>PhobosVehicleSystem_Electrical</system>
      </li>
      <li>
        <key>belt</key>
        <label>belt</label>
        <rect>(128, 172, 40, 18)</rect>
        <role>Belt</role>
        <system>PhobosVehicleSystem_Service</system>
      </li>
      <li>
        <!-- Framework 0.375.0 (docs/development/vehicle-schematic.md, SC2; the owner's card of 28 Nov 2026, "The first cutaway"): drawn as
             one cylinder in section (scripts/art/draw_diesel_cutaway.py), each region tinted by a live reading. The block takes the engine's
             tone; the water jacket, oil, air, exhaust and fuel their medium's colour while what feeds them works; the moving steel stays
             steel. The intake meets the picture on the left, the exhaust on the right, both at y 86; the fuel at the right, y 196. -->
        <key>engine</key>
        <label>engine</label>
        <rect>(220, 60, 260, 150)</rect>
        <role>Engine</role>
        <system>PhobosVehicleSystem_Cooling</system>
        <quantity>coolantTemperature</quantity>
        <layers>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Casing</texPath></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Jacket</texPath><node>waterPump</node><tint>Flow</tint><medium>Coolant</medium></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Oil</texPath><node>oilPump</node><tint>Flow</tint><medium>Oil</medium></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Chamber</texPath><tint>Flow</tint><medium>Exhaust</medium></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Steel</texPath><tint>Fixed</tint><colour>(0.67, 0.69, 0.71, 1)</colour></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Intake</texPath><node>airFilter</node><tint>Flow</tint><medium>Air</medium></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Exhaust</texPath><tint>Flow</tint><medium>Exhaust</medium></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Diesel/Fuel</texPath><node>fuelPump</node><tint>Flow</tint><medium>Fuel</medium></li>
        </layers>
        <outline>Phobos/VehicleSystems/Schematic/Diesel/Outline</outline>
      </li>
      <li>
        <key>sump</key>
        <label>sump</label>
        <shape>Tank</shape>
        <rect>(240, 225, 220, 36)</rect>
        <system>PhobosVehicleSystem_Lubrication</system>
        <quantity>oilLevel</quantity>
        <holds>Oil</holds>
      </li>
      <li>
        <!-- Framework 0.365.0 (docs/development/vehicle-chip-detector.md, CD6). -->
        <key>chipDetector</key>
        <label>chip detector</label>
        <rect>(466, 232, 26, 22)</rect>
        <system>PhobosVehicleSystem_Lubrication</system>
        <quantity>oilMetal</quantity>
      </li>
      <li>
        <key>oilPump</key>
        <label>oil pump</label>
        <shape>Pump</shape>
        <rect>(290, 290, 28, 28)</rect>
        <role>OilPump</role>
        <system>PhobosVehicleSystem_Lubrication</system>
        <quantity>oilPressure</quantity>
      </li>
      <li>
        <key>turbo</key>
        <label>turbocharger</label>
        <rect>(520, 70, 70, 40)</rect>
        <role>Turbocharger</role>
        <system>PhobosVehicleSystem_Turbocharger</system>
        <quantity>turboBoost</quantity>
      </li>
      <li>
        <key>airFilter</key>
        <label>air filter</label>
        <shape>Filter</shape>
        <rect>(630, 130, 60, 44)</rect>
        <system>PhobosVehicleSystem_Service</system>
        <quantity>airFilter</quantity>
      </li>
      <li>
        <key>fuelTank</key>
        <label>fuel tank</label>
        <shape>Tank</shape>
        <rect>(600, 280, 90, 46)</rect>
        <role>FuelTank</role>
        <system>PhobosVehicleSystem_Fuel</system>
        <fuelLevel>true</fuelLevel>
        <holds>Fuel</holds>
      </li>
      <li>
        <!-- Framework 0.365.0 (docs/development/vehicle-fuel-filter.md, FF7). -->
        <key>fuelFilter</key>
        <label>fuel filter</label>
        <shape>Filter</shape>
        <rect>(560, 294, 28, 24)</rect>
        <system>PhobosVehicleSystem_Fuel</system>
        <quantity>fuelFilter</quantity>
      </li>
      <li>
        <key>fuelPump</key>
        <label>fuel pump</label>
        <shape>Pump</shape>
        <rect>(520, 292, 28, 28)</rect>
        <role>FuelPump</role>
        <system>PhobosVehicleSystem_Fuel</system>
        <quantity>fuelFeed</quantity>
      </li>
      <li>
        <key>battery</key>
        <label>battery</label>
        <shape>Tank</shape>
        <rect>(40, 280, 80, 46)</rect>
        <role>Battery</role>
        <system>PhobosVehicleSystem_Electrical</system>
        <quantity>charge</quantity>
        <holds>Electric</holds>
      </li>
      <li>
        <key>starter</key>
        <label>starter</label>
        <rect>(170, 292, 40, 28)</rect>
        <role>Starter</role>
        <system>PhobosVehicleSystem_Electrical</system>
        <quantity>starter</quantity>
      </li>
    </nodes>
    <pipes>
      <!-- Coolant: out of the engine's head to the radiator, back through the water pump, into the block. -->
      <li>
        <medium>Coolant</medium>
        <points><li>(220, 160)</li><li>(90, 160)</li></points>
        <from>engine</from>
        <to>radiator</to>
        <drivenBy>waterPump</drivenBy>
      </li>
      <li>
        <medium>Coolant</medium>
        <points><li>(65, 230)</li><li>(65, 239)</li><li>(130, 239)</li></points>
        <from>radiator</from>
        <to>waterPump</to>
        <drivenBy>waterPump</drivenBy>
      </li>
      <li>
        <medium>Coolant</medium>
        <points><li>(158, 239)</li><li>(200, 239)</li><li>(200, 190)</li><li>(220, 190)</li></points>
        <from>waterPump</from>
        <to>engine</to>
      </li>
      <!-- Oil: from the sump through its pump to the bearings, and to the turbocharger's where it has one. -->
      <li>
        <medium>Oil</medium>
        <points><li>(304, 261)</li><li>(304, 290)</li></points>
        <from>sump</from>
        <to>oilPump</to>
        <drivenBy>oilPump</drivenBy>
      </li>
      <li>
        <medium>Oil</medium>
        <points><li>(290, 304)</li><li>(228, 304)</li><li>(228, 210)</li></points>
        <from>oilPump</from>
        <to>engine</to>
      </li>
      <li>
        <medium>Oil</medium>
        <points><li>(318, 304)</li><li>(498, 304)</li><li>(498, 90)</li><li>(520, 90)</li></points>
        <from>oilPump</from>
        <to>turbo</to>
      </li>
      <!-- Air: through the filter, the turbocharger's compressor where it has one, over the top into the intake on the left (since 0.375.0). -->
      <li>
        <medium>Air</medium>
        <points><li>(660, 130)</li><li>(660, 100)</li><li>(590, 100)</li></points>
        <from>airFilter</from>
        <to>turbo</to>
      </li>
      <li>
        <medium>Air</medium>
        <points><li>(555, 70)</li><li>(555, 40)</li><li>(200, 40)</li><li>(200, 86)</li><li>(220, 86)</li></points>
        <from>turbo</from>
        <to>engine</to>
      </li>
      <li>
        <medium>Air</medium>
        <points><li>(660, 130)</li><li>(660, 40)</li><li>(200, 40)</li><li>(200, 86)</li><li>(220, 86)</li></points>
        <from>airFilter</from>
        <to>engine</to>
        <onlyWithout>turbo</onlyWithout>
      </li>
      <!-- Exhaust: out on the right, through the turbocharger's turbine where it has one, then out. -->
      <li>
        <medium>Exhaust</medium>
        <points><li>(480, 86)</li><li>(520, 86)</li></points>
        <from>engine</from>
        <to>turbo</to>
      </li>
      <li>
        <medium>Exhaust</medium>
        <points><li>(590, 80)</li><li>(610, 80)</li><li>(610, 24)</li></points>
        <from>turbo</from>
      </li>
      <li>
        <medium>Exhaust</medium>
        <points><li>(480, 86)</li><li>(512, 86)</li></points>
        <from>engine</from>
        <onlyWithout>turbo</onlyWithout>
      </li>
      <!-- Fuel: from the tank through its pump to the injectors. -->
      <li>
        <medium>Fuel</medium>
        <points><li>(600, 306)</li><li>(588, 306)</li></points>
        <from>fuelTank</from>
        <to>fuelFilter</to>
        <drivenBy>fuelPump</drivenBy>
      </li>
      <li>
        <medium>Fuel</medium>
        <points><li>(560, 306)</li><li>(548, 306)</li></points>
        <from>fuelFilter</from>
        <to>fuelPump</to>
        <drivenBy>fuelPump</drivenBy>
      </li>
      <li>
        <medium>Fuel</medium>
        <points><li>(520, 306)</li><li>(510, 306)</li><li>(510, 196)</li><li>(480, 196)</li></points>
        <from>fuelPump</from>
        <to>engine</to>
      </li>
      <!-- Power: the belt turns the alternator, which charges the battery; the battery's lead to the starter carries only a start. -->
      <li>
        <medium>Electric</medium>
        <points><li>(128, 130)</li><li>(110, 130)</li><li>(110, 280)</li></points>
        <from>alternator</from>
        <to>battery</to>
        <drivenBy>belt</drivenBy>
      </li>
      <li>
        <medium>Electric</medium>
        <points><li>(120, 306)</li><li>(170, 306)</li></points>
        <from>battery</from>
        <to>starter</to>
        <flow>Never</flow>
      </li>
    </pipes>
  </Phobos.VehicleSystems.PhobosVehicleSchematicDef>

  <!--
    Framework 0.373.0 (docs/development/vehicle-schematic.md; the owner's card of 28 Nov 2026, "The aircraft page"): one page for every
    aircraft with gas turbines, turboshaft or turbofan, from a single engine to four. A tab per engine where there is more than one: the
    parts marked perEngine show that engine's own (its fuel pump, oil pump, sump, chip detector, hot section), the rest the aircraft's. The
    engine is drawn as a plain row of compressor, hot section and turbine, not a drawing of any real engine; since Framework 0.378.0 the three
    are tiles of one turboshaft section (scripts/art/draw_turboshaft_cutaway.py), its gas path in bands coloured by the gas's heat there
    (SC8), the fuel meeting the burners' nozzle and the oil the rear bearing. Since Framework 0.382.0 each
    engine's tab shows its own turbine temperature, from its own hot section (the record's F1); compressor fouling stays one figure. The
    inlet barrier shows only where it is fitted, the intake separator only where the aircraft has one, the gearbox only on aircraft with a
    rotor drive (helicopters, and the tiltrotor and turboprops our loadouts give one). Layout authored, on a 720 by 340 page.
  -->
  <!-- Framework 0.382.0: the parts and pipes every gas-turbine aircraft shares; the turboshaft and turbofan pages below each add their own
       three engine tiles (compressor, hot section, turbine), the same keys in the same places, so the pipes meet both. -->
  <Phobos.VehicleSystems.PhobosVehicleSchematicDef Name="PhobosVehicleSchematicTurbineAircraftBase" Abstract="True">
    <loadoutKinds>
      <li>Aircraft</li>
    </loadoutKinds>
    <size>(720, 340)</size>
    <nodes>
      <li>
        <key>intake</key>
        <label>air intake</label>
        <rect>(40, 125, 70, 50)</rect>
        <system>PhobosVehicleSystem_CompressorWash</system>
      </li>
      <li>
        <key>barrier</key>
        <label>inlet barrier</label>
        <shape>Filter</shape>
        <rect>(180, 135, 34, 30)</rect>
        <system>PhobosVehicleSystem_CompressorWash</system>
        <quantity>barrierClog</quantity>
        <shownWhen Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_InletBarrierLoss</stat>
          <value>0</value>
        </shownWhen>
      </li>
      <li>
        <key>separator</key>
        <label>separator</label>
        <rect>(180, 135, 34, 30)</rect>
        <system>PhobosVehicleSystem_CompressorWash</system>
        <shownWhen Class="Phobos.VehicleSystems.When_IntakeSeparator" />
      </li>
      <li>
        <key>gearbox</key>
        <label>gearbox</label>
        <rect>(580, 130, 80, 40)</rect>
        <role>RotorDrive</role>
        <system>PhobosVehicleSystem_RotorDrive</system>
      </li>
      <li>
        <key>gearboxChip</key>
        <label>chip</label>
        <rect>(668, 139, 24, 22)</rect>
        <role>RotorDrive</role>
        <system>PhobosVehicleSystem_RotorDrive</system>
        <quantity>gearboxMetal</quantity>
      </li>
      <li>
        <key>fuelTank</key>
        <label>fuel tanks</label>
        <shape>Tank</shape>
        <rect>(30, 250, 90, 50)</rect>
        <system>PhobosVehicleSystem_EngineFuel</system>
        <fuelLevel>true</fuelLevel>
        <holds>Fuel</holds>
      </li>
      <li>
        <key>fuelFilter</key>
        <label>fuel filter</label>
        <shape>Filter</shape>
        <rect>(150, 262, 30, 26)</rect>
        <system>PhobosVehicleSystem_EngineFuel</system>
        <quantity>fuelFilter</quantity>
      </li>
      <li>
        <key>fuelPump</key>
        <label>fuel pump</label>
        <shape>Pump</shape>
        <rect>(210, 261, 28, 28)</rect>
        <role>FuelPump</role>
        <perEngine>true</perEngine>
        <system>PhobosVehicleSystem_EngineFuel</system>
        <quantity>fuelFeed</quantity>
      </li>
      <li>
        <key>oilPump</key>
        <label>oil pump</label>
        <shape>Pump</shape>
        <rect>(470, 264, 28, 28)</rect>
        <role>OilPump</role>
        <perEngine>true</perEngine>
        <system>PhobosVehicleSystem_EngineOil</system>
        <quantity>oilPressure</quantity>
      </li>
      <li>
        <key>sump</key>
        <label>sump</label>
        <shape>Tank</shape>
        <rect>(510, 262, 110, 34)</rect>
        <perEngine>true</perEngine>
        <system>PhobosVehicleSystem_EngineOil</system>
        <quantity>oilLevel</quantity>
        <holds>Oil</holds>
      </li>
      <li>
        <key>chipDetector</key>
        <label>chip detector</label>
        <rect>(630, 268, 26, 22)</rect>
        <perEngine>true</perEngine>
        <system>PhobosVehicleSystem_EngineOil</system>
        <quantity>oilMetal</quantity>
      </li>
      <li>
        <key>starter</key>
        <label>starter</label>
        <rect>(40, 30, 60, 36)</rect>
        <role>Starter</role>
        <system>PhobosVehicleSystem_Electrical</system>
        <quantity>starter</quantity>
      </li>
      <li>
        <key>battery</key>
        <label>battery</label>
        <shape>Tank</shape>
        <rect>(160, 24, 80, 46)</rect>
        <role>Battery</role>
        <system>PhobosVehicleSystem_Electrical</system>
        <quantity>charge</quantity>
        <holds>Electric</holds>
      </li>
      <li>
        <key>generator</key>
        <label>generator</label>
        <rect>(300, 30, 70, 36)</rect>
        <role>Alternator</role>
        <system>PhobosVehicleSystem_Electrical</system>
      </li>
    </nodes>
    <pipes>
      <!-- Air: in at the intake, past the barrier or the separator where there is one, into the compressor. -->
      <li>
        <medium>Air</medium>
        <points><li>(110, 150)</li><li>(300, 150)</li></points>
        <from>intake</from>
        <to>compressor</to>
      </li>
      <!-- Exhaust: out of the turbine and away. -->
      <li>
        <medium>Exhaust</medium>
        <points><li>(520, 110)</li><li>(520, 40)</li></points>
        <from>turbine</from>
      </li>
      <!-- Fuel: from the tanks through the filter and this engine's pump to its burners. -->
      <li>
        <medium>Fuel</medium>
        <points><li>(120, 275)</li><li>(150, 275)</li></points>
        <from>fuelTank</from>
        <to>fuelFilter</to>
        <drivenBy>fuelPump</drivenBy>
      </li>
      <li>
        <medium>Fuel</medium>
        <points><li>(180, 275)</li><li>(210, 275)</li></points>
        <from>fuelFilter</from>
        <to>fuelPump</to>
        <drivenBy>fuelPump</drivenBy>
      </li>
      <li>
        <medium>Fuel</medium>
        <points><li>(224, 261)</li><li>(224, 215)</li><li>(398, 215)</li><li>(398, 190)</li></points>
        <from>fuelPump</from>
        <to>hotSection</to>
      </li>
      <!-- Oil: from this engine's sump through its pump to the bearings. -->
      <li>
        <medium>Oil</medium>
        <points><li>(510, 278)</li><li>(498, 278)</li></points>
        <from>sump</from>
        <to>oilPump</to>
        <drivenBy>oilPump</drivenBy>
      </li>
      <li>
        <medium>Oil</medium>
        <points><li>(484, 264)</li><li>(484, 190)</li></points>
        <from>oilPump</from>
        <to>turbine</to>
      </li>
      <!-- Power: the generator charges the battery; the battery's lead to the starter carries only a start. -->
      <li>
        <medium>Electric</medium>
        <points><li>(300, 48)</li><li>(240, 48)</li></points>
        <from>generator</from>
        <to>battery</to>
      </li>
      <li>
        <medium>Electric</medium>
        <points><li>(160, 48)</li><li>(100, 48)</li></points>
        <from>battery</from>
        <to>starter</to>
        <flow>Never</flow>
      </li>
    </pipes>
  </Phobos.VehicleSystems.PhobosVehicleSchematicDef>

  <!-- Framework 0.382.0: turboshafts (helicopters, the tiltrotor, turboprops), drawn by scripts/art/draw_turboshaft_cutaway.py. -->
  <Phobos.VehicleSystems.PhobosVehicleSchematicDef ParentName="PhobosVehicleSchematicTurbineAircraftBase">
    <defName>PhobosVehicleSchematic_TurbineAircraft</defName>
    <label>turboshaft, aircraft</label>
    <engineKinds>
      <li>Turboshaft</li>
    </engineKinds>
    <nodes>
      <li>
        <key>compressor</key>
        <label>compressor</label>
        <rect>(300, 110, 80, 80)</rect>
        <role>Engine</role>
        <perEngine>true</perEngine>
        <system>PhobosVehicleSystem_CompressorWash</system>
        <quantity>compressorFouling</quantity>
        <layers>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Casing</texPath></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Heat01</texPath><tint>Heat</tint><position>0.05</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Heat02</texPath><tint>Heat</tint><position>0.15</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Heat03</texPath><tint>Heat</tint><position>0.25</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Heat04</texPath><tint>Heat</tint><position>0.35</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Heat05</texPath><tint>Heat</tint><position>0.45</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Steel</texPath><tint>Fixed</tint><colour>(0.67, 0.69, 0.71, 1)</colour></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Comp/Oil</texPath><node>oilPump</node><tint>Flow</tint><medium>Oil</medium></li>
        </layers>
        <outline>Phobos/VehicleSystems/Schematic/Gas/Comp/Outline</outline>
      </li>
      <li>
        <key>hotSection</key>
        <label>hot section</label>
        <rect>(380, 110, 100, 80)</rect>
        <role>Engine</role>
        <perEngine>true</perEngine>
        <system>PhobosVehicleSystem_Turbine</system>
        <quantity>hotSectionLife</quantity>
        <layers>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Casing</texPath></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Heat04</texPath><tint>Heat</tint><position>0.35</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Heat05</texPath><tint>Heat</tint><position>0.45</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Heat06</texPath><tint>Heat</tint><position>0.55</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Heat07</texPath><tint>Heat</tint><position>0.65</position></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Steel</texPath><tint>Fixed</tint><colour>(0.67, 0.69, 0.71, 1)</colour></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Fuel</texPath><node>fuelPump</node><tint>Flow</tint><medium>Fuel</medium></li>
          <li><texPath>Phobos/VehicleSystems/Schematic/Gas/Hot/Oil</texPath><node>oilPump</node><tint>Flow</tint><medium>Oil</medium></li>
        </layers>
        <outline>Phobos/VehicleSystems/Schematic/Gas/Hot/Outline</outline>
      </li>
