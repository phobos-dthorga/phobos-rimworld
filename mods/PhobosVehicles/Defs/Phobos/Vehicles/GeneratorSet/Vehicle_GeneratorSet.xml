<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The generator set: a light self-propelled diesel-electric truck that parks, runs out a cable and feeds the grid (docs/development/vehicle-generator-set.md). Every figure is
    authored and untuned. Part keys are saved by position: append only, never reorder. Cells run x from -1 to 1 and z from -3 to 4 (3 x 8 since Vehicles 0.51.0, owner
    13 Nov 2026: brought in line with the Talus tipper; it was 2 x 6). Its pictures were generated for it on 12 Nov 2026 (assets/phobos-vehicles/requests/night-2026-11-12-record.md). Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_GeneratorSet</defName>
    <label>Busbar generator set</label>
    <description>Busbar B1: a medium truck whose engine turns a generator rather than the wheels: electric motors drive the back axle, and when it is parked and set up, the generator feeds your grid instead. Drive it to wherever you need power, set it up, and it burns fuel in step with what the grid draws. It cannot move while set up.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(4, 9)</drawSize>
      <color>(162, 156, 123)</color>
      <colorTwo>(195, 110, 36)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_GeneratorSet_Blueprint</buildDef>
    <size>(3, 8)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <!-- Read only for collisions since D'thorga Vehicles 0.76.0: every part carries its own armour by class, which overrides these
           (vehicle-armour.md). Heat stays the whole truck's. -->
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.5</Flammability>
      <MarketValue>2900</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>347</Mass>
      <MoveSpeed>12</MoveSpeed>
      <CargoCapacity>40</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.03</AccelerationRate>
      <Phobos_GeneratorOutput>2000</Phobos_GeneratorOutput>
      <Phobos_RigControl>1</Phobos_RigControl>
      <Phobos_RigStability>1</Phobos_RigStability>
    </vehicleStats>
    <race>
      <baseBodySize>6.5</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>5</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(-1, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
      <!-- Armour by class (D'thorga Vehicles 0.76.0; owner, 19 Nov 2026; docs/development/vehicle-armour.md): every part is Skin, as no
           source states that a civilian truck stops a bullet. Combat Extended's figures for the same class are in
           Mods/CombatExtended/Patches. One outer part to a cell (owner): the chassis is outer only where nothing else covers it, and the
           lights and the parts changed with them sit inside. Parts are saved by place: append only, never reorder. -->
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>110</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitWeight>3</hitWeight>
      <hitbox>
        <cells>
          <li>(0, 4)</li>
          <li>(0, 2)</li>
          <li>(-1, 1)</li>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
          <li>(-1, 0)</li>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
          <li>(0, -1)</li>
          <li>(0, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>40</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
