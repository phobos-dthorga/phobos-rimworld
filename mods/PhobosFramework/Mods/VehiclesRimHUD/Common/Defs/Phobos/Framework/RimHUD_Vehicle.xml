<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    A value for RimHUD's pawn display (Jaxe's RimHUD), loaded only with both Vehicle Framework and RimHUD (LoadFolders.xml): which
    vehicle a person is aboard and in what role, with fuel, cab and what the vehicle waits for in the tooltip. Players add it to
    their layout in RimHUD's own layout editor. The Def type and fields follow RimHUD's wiki (api version 1, read 8 Nov 2026); the
    class is in D'thorga Framework's vehicle systems assembly and references nothing of RimHUD's. Not yet tested in game.
  -->
  <RimHUD.CustomValueDef>
    <defName>PhobosVehicleSystems_HudVehicle</defName>
    <label>Vehicle (D'thorga Framework)</label>
    <textStyle>Small</textStyle>
    <defClass>Phobos.VehicleSystems.RimHudVehicleValue</defClass>
    <apiVersion>1</apiVersion>
  </RimHUD.CustomValueDef>
</Defs>
