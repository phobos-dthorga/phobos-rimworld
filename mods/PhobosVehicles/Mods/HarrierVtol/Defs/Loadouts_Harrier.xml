<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The Harrier VTOL Attack Aircraft (potemkinvillager.av8bharrier): a Pegasus turbofan with water injection, the fixed-wing jet's
    flight profile and the hover check on vertical landings (docs/development/vehicle-turbine-design.md). Not yet tested in game.

    Sources and labels:
    - Lift ratings at sea level: 64.3 kN maximum continuous at 91% rpm, 95.9 kN for 15 s wet at 107% rpm (secondary: All-Aero on the
      Pegasus; Wikipedia, "Rolls-Royce Pegasus", sources them to the US Navy's AV-8B standard aircraft characteristics of October
      1986). These are the Pegasus 11-21's (F402-RR-406), the early AV-8B's engine; the later 11-61 (F402-RR-408) gives up to
      106 kN (secondary: Wikipedia, citing Rolls-Royce) and, Rolls-Royce says, up to 15 per cent more thrust at high ambient
      temperatures (primary: Rolls-Royce's Pegasus page). We keep the 11-21's figures, for which a full lift ladder is published. The short-lift dry rating (86.3 kN, 90% of wet) has no source found and is authored.
    - Water injection: up to 227 kg, used at about 2.65 kg a second (secondary: All-Aero on the Pegasus).
    - Temperature limits (800, 900, 950 degrees C) are authored placeholders; the record found none published.
    - Empty mass about 6,340 kg (secondary: Pima Air and Space Museum, via docs/development/vehicle-patches.md). Full internal fuel
      3,400 kg is authored.
  -->
  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_Pegasus</defName>
    <label>vectored-thrust turbofan</label>
    <engine>
      <kind>Turbofan</kind>
      <ratedRpm>10000</ratedRpm>
      <!-- Framework 0.132.0: the Framework's jet figure (authored), so the generator's few kilowatts are the small share of the engine's
           work they really are. It sizes the ledger's shares and nothing else: the thrust comes from the ratings. -->
      <kilowattsPerTonne>1500</kilowattsPerTonne>
      <!-- The Framework's jet figure since 0.132.0, the first version to read it (authored from civil turbofans' published idle fuel
           flows; none was found for the Pegasus). -->
      <idleFuelShare>0.05</idleFuelShare>
      <turbine>
        <idleSpeedPercent>60</idleSpeedPercent>
        <ratings>
          <li><name>maxContinuous</name><label>maximum continuous</label><share>1</share><speedPercent>91</speedPercent><temperatureLimit>800</temperatureLimit><thrustKilonewtons>64.3</thrustKilonewtons></li>
          <li><name>shortLiftDry</name><label>short lift, dry</label><share>1.34</share><speedPercent>103</speedPercent><temperatureLimit>900</temperatureLimit><minutes>2.5</minutes><thrustKilonewtons>86.3</thrustKilonewtons></li>
          <li><name>wet</name><label>short lift, wet</label><share>1.49</share><speedPercent>107</speedPercent><temperatureLimit>950</temperatureLimit><minutes>0.25</minutes><thrustKilonewtons>95.9</thrustKilonewtons><wet>true</wet></li>
        </ratings>
        <waterInjection>
          <tankKilograms>227</tankKilograms>
          <kilogramsPerSecond>2.65</kilogramsPerSecond>
        </waterInjection>
      </turbine>
    </engine>
    <transmission>
      <kind>None</kind>
    </transmission>
    <mass>
      <emptyKilograms>6340</emptyKilograms>
      <fuelKilogramsFull>3400</fuelKilogramsFull>
    </mass>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_Harrier</defName>
    <label>jump jet</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Harrier_Jet</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_WaterInjection</def></li>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_Pegasus</def>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_FixedWingJet</flightProfile>
    <!-- A Harrier saved before it started as the day-attack AV-8B keeps its night sight and radar, given once, free, when the save loads. -->
    <fittedOnOlderSaves>
      <li>PhobosFitting_NightSight</li>
      <li>PhobosFitting_Radar</li>
    </fittedOnOlderSaves>
    <!-- The cruising height between tiles (Framework 0.141.0; docs/development/vehicle-flight-over-the-map.md). Built to cruise at 7,000 m
         (authored: the height at which the rule gives back avionics A14's fixed low-flight figures, 0.85 and 1.2, at the 3,810 m oxygen line).
         Service ceiling 50,000 ft, 15,240 m (secondary: Pima Air and Space Museum's AV-8B Harrier II+ specifications, pimaair.org; the same
         figure on globalmilitary.net); the rule reads anything above 11,000 m as 11,000. A jet: flown low it is slower and thirstier. -->
    <cruise>
      <designMetres>7000</designMetres>
      <ceilingMetres>15240</ceilingMetres>
      <lift>Jet</lift>
    </cruise>
    <!-- Avionics (Framework 0.110.0): the AV-8B's fit as the record gives it (agent defaults; secondary sources: an inertial navigation set and
         moving map, angle-rate bombing and a head-up display, the Night Attack Harrier's infrared sensor, a radar warning receiver, chaff and
         flares, and crew oxygen). About 46 A in all, against the flat 15 A before. Its instruments sit on D'thorga Patches' avionics part. -->
    <avionics>
      <navigation>Full</navigation>
      <autopilot>true</autopilot>
      <!-- As the day-attack AV-8B (aircraft service-life upgrades; owner, 21 Nov 2026: the Harrier starts early too). Its night sight came
           with the Night Attack Harrier (1989) and its radar with the Harrier II Plus (1993) (from memory, not checked against a source): D'thorga
           Framework's night sight and radar kits. A Harrier saved before keeps both, fitted free (fittedOnOlderSaves). -->
      <radar>false</radar>
      <sight>Full</sight>
      <nightSight>false</nightSight>
      <warning>true</warning>
      <countermeasures>true</countermeasures>
      <!-- The dispensers' magazine (Framework 0.180.0): 60 cartridges, one AN/ALE-39 set's capacity. Secondary: Military Periscope and
           cmano-db give the ALE-39's 60 cartridges and name the AV-8B among its aircraft; the AV-8B's own load was not found, so this is
           the set's figure, not a confirmed Harrier load. One of our cartridges stands for one real one. -->
      <countermeasureCartridges>60</countermeasureCartridges>
      <oxygen>true</oxygen>
      <!-- Avionics A14 (Framework 0.119.0): the AV-8B cruises where its crew needs oxygen, from its on-board generator. -->
      <cruisesHigh>true</cruisesHigh>
      <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>18</speed>
        <cruiseMetres>7500</cruiseMetres>
        <lowCruiseMetres>1500</lowCruiseMetres>
        <size>1.4</size>
      </airTrack>
    </avionics>
    <partRoles>
      <li>
        <!-- Avionics A7: the flight controls' hydraulics, on D'thorga Patches' hydraulics part. -->
        <role>HydraulicPump</role>
        <find>
          <li>
            <key>PhobosHydraulics</key>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li>
            <key>PhobosHydraulics</key>
          </li>
        </find>
      </li>
    </partRoles>
      <!-- Automatic climate control (D'thorga Vehicles 0.10.0): the AV-8B's environmental control system holds the cockpit's temperature by itself (general). -->
    <cabin>
      <climateControl>true</climateControl>
    </cabin>
</Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
