  <!-- A Unimog-class 4x4 (agent's choice; secondary and approximate): 130 kW at 2,200 rpm on portal axles, every wheel driven. Gears and drag authored; the torque curve is the heavy diesel's. -->
  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_MediumDiesel</defName>
    <label>medium diesel drivetrain</label>
    <engine>
      <kind>Piston</kind>
      <idleRpm>700</idleRpm>
      <launchRpm>1100</launchRpm>
      <ratedRpm>2200</ratedRpm>
      <ratedKilowatts>130</ratedKilowatts>
      <torqueCurve><points><li>(0, 0)</li><li>(0.25, 0.6)</li><li>(0.5, 0.95)</li><li>(0.65, 1)</li><li>(0.85, 0.95)</li><li>(1, 0.85)</li><li>(1.1, 0)</li></points></torqueCurve>
      <indicatedEfficiency>0.40</indicatedEfficiency>
    </engine>
    <transmission>
      <kind>Automatic</kind>
      <gears><li>6.0</li><li>3.4</li><li>2.0</li><li>1.3</li><li>1.0</li></gears>
      <finalDrive>6.0</finalDrive>
      <upshiftRpm>1900</upshiftRpm>
      <downshiftRpm>1100</downshiftRpm>
      <efficiency>0.88</efficiency>
    </transmission>
    <running>
      <wheelRadius>0.55</wheelRadius>
      <drivenShare>1</drivenShare>
      <dragArea>3.5</dragArea>
    </running>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
</Defs>
