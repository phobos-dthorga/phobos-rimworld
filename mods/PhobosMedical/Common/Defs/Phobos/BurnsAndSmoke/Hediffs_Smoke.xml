<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Carbon monoxide: the share of the blood that carries it instead of oxygen. It clears with a half-life of about 320 minutes
       on room air (Weaver and colleagues, 2000, as cited in emergency medicine references), faster in open air (authored).
       Stage figures are authored around the usual clinical picture: headache from about 10%, confusion and collapse from 30 to
       40%, death past 50%. -->
  <HediffDef>
    <defName>PhobosBurns_CarbonMonoxide</defName>
    <label>carbon monoxide poisoning</label>
    <labelNoun>carbon monoxide poisoning</labelNoun>
    <description>Carbon monoxide from a fire in a closed space has taken the place of oxygen in the blood. It is invisible and has no smell, a filter mask does nothing against it, and it keeps building while the patient breathes it. It clears slowly once they are in clean air, faster outdoors. Confusion, collapse and death follow as it rises.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.25, 0.25)</defaultLabelColor>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <makesSickThought>true</makesSickThought>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="Phobos.BurnsAndSmoke.Comps.HediffCompProperties_PhobosHalfLife">
        <halfLifeHoursRoofed>5.3</halfLifeHoursRoofed>
        <halfLifeHoursOutdoors>3</halfLifeHoursOutdoors>
        <removeBelow>0.01</removeBelow>
      </li>
      <li Class="Phobos.BurnsAndSmoke.Comps.HediffCompProperties_PhobosBurnTooltip">
        <kind>CarbonMonoxide</kind>
      </li>
    </comps>
    <stages>
      <li>
        <label>trace</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.10</minSeverity>
        <label>headache</label>
        <painOffset>0.05</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.20</minSeverity>
        <label>dizzy</label>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.30</minSeverity>
        <label>confused</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.40</minSeverity>
        <label>collapsed</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.55</minSeverity>
        <label>dying</label>
        <lifeThreatening>true</lifeThreatening>
        <deathMtbDays>0.5</deathMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="Phobos.Framework.Breathing.PhobosOxygenResponsiveExtension">
        <minSeverity>0.1</minSeverity>
      </li>
    </modExtensions>
  </HediffDef>

  <!-- Lasting lung injury from smoke: irritants scar the lower airway (Walker and colleagues, Critical Care 2015). It is
       tendable; tending speeds the recovery. Past half severity it invites pneumonia. All figures authored. -->
  <HediffDef>
    <defName>PhobosBurns_LungInjury</defName>
    <label>smoke-damaged lungs</label>
    <labelNoun>smoke-damaged lungs</labelNoun>
    <description>Hot, chemical smoke has scorched the lower airways. Breathing is harder for days, and badly damaged lungs invite pneumonia. Tending helps the lungs recover; rest helps too.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.5, 0.4)</defaultLabelColor>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-0.12</severityPerDayTended>
        <labelTendedWell>tended</labelTendedWell>
        <labelTendedWellInner>tended</labelTendedWellInner>
        <labelSolidTendedWell>tended</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.04</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
      <li Class="Phobos.BurnsAndSmoke.Comps.HediffCompProperties_PhobosBurnTooltip">
        <kind>LungInjury</kind>
      </li>
    </comps>
    <stages>
      <li>
        <label>slight</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.05</minSeverity>
        <label>mild</label>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>moderate</label>
        <restFallFactor>1.2</restFallFactor>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.50</minSeverity>
        <label>severe</label>
        <lifeThreatening>true</lifeThreatening>
        <restFallFactor>1.3</restFallFactor>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.45</offset>
          </li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>PhobosBurns_Pneumonia</hediff>
            <mtbDays>4</mtbDays>
          </li>
        </hediffGivers>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>critical</label>
        <lifeThreatening>true</lifeThreatening>
        <restFallFactor>1.4</restFallFactor>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.35</setMax>
          </li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>PhobosBurns_Pneumonia</hediff>
            <mtbDays>2</mtbDays>
          </li>
        </hediffGivers>
      </li>
    </stages>
    <modExtensions>
      <li Class="Phobos.Framework.Breathing.PhobosOxygenResponsiveExtension">
        <minSeverity>0.05</minSeverity>
      </li>
    </modExtensions>
  </HediffDef>

  <!-- Pneumonia from smoke-damaged lungs, shaped like the game's wound infection: it runs against immunity, tending helps.
       Figures copied in form from the game's WoundInfection (Core, Hediffs_Local_Infections.xml) and authored. -->
  <HediffDef ParentName="InfectionBase">
    <defName>PhobosBurns_Pneumonia</defName>
    <label>pneumonia</label>
    <labelNoun>pneumonia</labelNoun>
    <description>Infection has taken hold in smoke-damaged lungs. Without treatment it fills them and kills; tending and the body's own immunity fight it off.</description>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
        <severityPerDayTended>-0.45</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.7</severityPerDayNotImmune>
        <immunityPerDaySick>0.55</immunityPerDaySick>
        <severityPerDayImmune>-0.6</severityPerDayImmune>
        <immunityPerDayNotSick>-0.4</immunityPerDayNotSick>
      </li>
      <li Class="HediffCompProperties_Discoverable">
        <sendLetterWhenDiscovered>true</sendLetterWhenDiscovered>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.05</painOffset>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.33</minSeverity>
        <label>major</label>
        <painOffset>0.08</painOffset>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.78</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.6</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="Phobos.Framework.Breathing.PhobosOxygenResponsiveExtension">
        <minSeverity>0</minSeverity>
      </li>
    </modExtensions>
  </HediffDef>

  <!-- The acute smoke condition, used only while Combat Extended's is not running: the same shape as CE's SmokeInhalation
       (read 4 Nov 2026), clearing on its own. -->
  <HediffDef>
    <defName>PhobosBurns_SmokeInhalation</defName>
    <label>acute smoke inhalation</label>
    <labelNoun>acute smoke inhalation</labelNoun>
    <description>Thick smoke breathed in: coughing, dizziness and a struggling heart. It clears within a day or so in clean air.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.58, 0.35, 0.35)</defaultLabelColor>
    <maxSeverity>1</maxSeverity>
    <lethalSeverity>1</lethalSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <makesSickThought>true</makesSickThought>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.05</minSeverity>
        <label>initial</label>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>minor</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>moderate</label>
        <vomitMtbDays>2</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>serious</label>
        <lifeThreatening>true</lifeThreatening>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.6</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="Phobos.Medical.Defs.PhobosBedsideTreatableExtension">
        <!-- Smoke tightens the airways; a nebuliser's bronchodilator eases it (D'thorga Medical 0.7.0). -->
        <tags>
          <li>Bronchospasm</li>
        </tags>
        <minSeverity>0.1</minSeverity>
      </li>
      <li Class="Phobos.Framework.Breathing.PhobosOxygenResponsiveExtension">
        <minSeverity>0.1</minSeverity>
      </li>
    </modExtensions>
  </HediffDef>
</Defs>
