<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Medical's Useful Marks tie-in: the triage tag as a mark in Useful Marks' row by a pawn's name. Its own assembly, so the
       core never references an optional mod; LoadFolders.xml loads Mods/UsefulMarks/<version> only while Useful Marks is active.
       Useful Marks' UsefulColonistBar.dll (by Andromeda) is referenced from the installed mod and never copied. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Triage.UsefulMarks</RootNamespace>
    <AssemblyName>PhobosMedical.UsefulMarks</AssemblyName>
    <ModFolder>PhobosMedical</ModFolder>
    <TieInFolder>Mods/UsefulMarks/</TieInFolder>
    <Version>0.16.0</Version>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosMedical/PhobosMedical.csproj" />
    <Reference Include="UsefulColonistBar">
      <HintPath>$(UsefulMarksAssemblies)\UsefulColonistBar.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
