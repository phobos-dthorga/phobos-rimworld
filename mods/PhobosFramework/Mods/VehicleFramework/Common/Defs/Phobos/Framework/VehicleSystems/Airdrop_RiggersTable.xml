  <!-- A spent platform and 40 steel (new crushable pads and worn fittings), 5,000 work (about 2 hours). -->
  <RecipeDef ParentName="PhobosRiggerRecipeBase">
    <defName>Phobos_RefurbishDropPlatform</defName>
    <label>refurbish drop platform</label>
    <description>Straighten a spent drop platform, fit new crushable pads and straps, and repack its three parachutes, making a heavy-drop rig again.</description>
    <jobString>Refurbishing a drop platform.</jobString>
    <workAmount>5000</workAmount>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Phobos_SpentDropPlatform</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Phobos_SpentDropPlatform</li>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Phobos_HeavyDropRig>1</Phobos_HeavyDropRig>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
  </RecipeDef>
</Defs>
