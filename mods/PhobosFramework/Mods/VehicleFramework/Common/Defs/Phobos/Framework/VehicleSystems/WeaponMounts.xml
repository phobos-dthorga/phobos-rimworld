<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Weapons tied to their mounts (Framework 0.115.0; owner, 16 Nov 2026; docs/development/vehicle-knocked-out-systems.md, T1, T9, T10).
    A weapon stops while its mount is at or under a tenth of its health (the owner's figure) and works again once repaired. It uses
    Vehicle Framework's own part requirement, so it acts on every faction's vehicles. An author's own requirement always stands.
    The first loaded instance wins; another mod may patch it in XML.
  -->
  <Phobos.VehicleSystems.PhobosWeaponMountsDef>
    <defName>PhobosWeaponMounts</defName>
    <enabled>true</enabled>
    <stopsAtOrBelow>0.1</stopsAtOrBelow>
    <!-- A vehicle's own parts to use as the mount, the first found wins: RimThunder's and others' turret part, and the pylons D'thorga
         Patches gives the Harrier. Matched by key, as a hint: nothing else marks a part as a weapon's mount. -->
    <authorMountKeys>
      <li>MainTurret</li>
      <li>PhobosPylons</li>
    </authorMountKeys>
    <!-- Authored: about the health of the vehicles' other working parts of that size (a gearbox 40 to 45, an engine 75). -->
    <turretRingHealth>60</turretRingHealth>
    <pylonHealth>40</pylonHealth>
    <turretRingLabel>turret ring</turretRingLabel>
    <pylonLabel>weapon pylons</pylonLabel>
  </Phobos.VehicleSystems.PhobosWeaponMountsDef>
</Defs>
