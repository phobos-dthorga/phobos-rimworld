<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Every vehicle caravan carries the vehicle systems' caravan comp: why a vehicle will not move, and the caravan jump-start
       (docs/development/vehicle-world-map-design.md). Vehicle Framework's VehicleCaravan Def already has a comps list. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/WorldObjectDef[defName="VehicleCaravan"]/comps</xpath>
    <value>
      <li>
        <compClass>Phobos.VehicleSystems.WorldObjectComp_PhobosVehicleCaravan</compClass>
      </li>
    </value>
  </Operation>
  <!-- What a helicopter carries on its sling, said on the world map (Framework 0.99.0): on an aircraft in flight and on a convoy. Vehicle
       Framework's AerialVehicle Def has no comps list of its own, so one is added first unless another mod already has. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WorldObjectDef[defName="AerialVehicle"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/WorldObjectDef[defName="AerialVehicle"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/WorldObjectDef[defName="VehicleCaravan" or defName="AerialVehicle"]/comps</xpath>
    <value>
      <li>
        <compClass>Phobos.VehicleSystems.WorldObjectComp_PhobosSling</compClass>
      </li>
    </value>
  </Operation>
  <!-- The Dashboard and Systems tabs on the world map (owner, 8 Nov 2026; Framework 0.23.0): on a vehicle caravan and an aircraft in
       flight, beside Vehicle Framework's own. Both Defs already have an inspectorTabs list. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/WorldObjectDef[defName="VehicleCaravan" or defName="AerialVehicle"]/inspectorTabs</xpath>
    <value>
      <li>Phobos.VehicleSystems.WITab_PhobosVehicleHealth</li>
      <li>Phobos.VehicleSystems.WITab_PhobosVehicleDashboard</li>
      <li>Phobos.VehicleSystems.WITab_PhobosVehicleSystems</li>
    </value>
  </Operation>
</Patch>
