<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The bulk tanker: a heavy truck whose tank is an upgrade, a liquid tanker or a gas tanker by the player's choice
    (docs/development/utility-vehicles-design.md). Footprint 3 x 10, drawn 4 x 11, the size of the biggest truck on the owner's list, RimThunder's PLS (3 x 10). At 2 x 6 it looked tiny, and the owner finds even Vanilla Vehicles Expanded's 3 x 6 Big Rig small (9 Nov 2026). Health, cost, mass and speed are authored and
    untuned. Part keys are saved by position: append only, never reorder. Cells run x from -1 to 1 and z from -4 to 5, read off the picked art. Not yet
    tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_Tanker</defName>
    <label>bulk tanker</label>
    <description>A heavy truck with a bare deck, ready for whichever tank you fit: a liquid tank for fuel, water and paste, or a pressure vessel for gases. Park it beside what you want to fill or empty, set it up, and run the pump. It cannot move while it is set up, and it carries nothing until a tank is fitted.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(4, 11)</drawSize>
      <color>(162, 156, 123)</color>
      <colorTwo>(195, 110, 36)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_Tanker_Blueprint</buildDef>
    <size>(3, 10)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.26</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.5</Flammability>
      <MarketValue>3200</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>340</Mass>
      <MoveSpeed>12</MoveSpeed>
      <CargoCapacity>60</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
      <Phobos_PumpRate>600</Phobos_PumpRate>
      <Phobos_TankIntegrity>1</Phobos_TankIntegrity>
      <Phobos_RigControl>1</Phobos_RigControl>
    </vehicleStats>
    <race>
      <baseBodySize>7</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>7</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 3)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>passenger</key>
          <label>passenger</label>
          <slots>1</slots>
          <hitbox>
            <cells>
              <li>(1, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>170</health>
      <depth>External</depth>
      <hitWeight>3</hitWeight>
      <hitbox>
        <from>(-1, -4)</from>
        <to>(1, 5)</to>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>50</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Engine</key>
      <label>engine</label>
      <health>60</health>
      <depth>Internal</depth>
      <priorityStatEfficiency>true</priorityStatEfficiency>
      <hitbox>
        <cells>
          <li>(-1, 5)</li>
          <li>(0, 5)</li>
          <li>(1, 5)</li>
          <li>(-1, 4)</li>
          <li>(0, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
        <li>Phobos_PumpRate</li>
      </categories>
    </li>
    <li>
      <key>Transmission</key>
      <label>transmission</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(-1, 2)</li>
          <li>(0, 2)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FrontWheels</key>
      <label>front axle and wheels</label>
      <health>35</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>RearWheels</key>
      <label>rear axles and wheels</label>
      <health>50</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, -2)</li>
          <li>(1, -2)</li>
          <li>(-1, -3)</li>
          <li>(1, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FuelTank</key>
      <label>truck fuel tank</label>
      <health>35</health>
      <depth>Internal</depth>
      <reactors>
        <li Class="Vehicles.Reactor_FuelLeak" />
      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>TankShell</key>
      <label>tank shell</label>
      <health>90</health>
      <depth>External</depth>
      <reactors>
        <li Class="Phobos.VehicleSystems.Reactor_PhobosTankShell" />
      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 1)</li>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
          <li>(-1, 0)</li>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
          <li>(-1, -1)</li>
          <li>(0, -1)</li>
          <li>(1, -1)</li>
          <li>(-1, -2)</li>
          <li>(0, -2)</li>
          <li>(1, -2)</li>
          <li>(-1, -3)</li>
          <li>(0, -3)</li>
          <li>(1, -3)</li>
          <li>(-1, -4)</li>
          <li>(0, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_TankIntegrity</li>
      </categories>
    </li>
    <li>
      <key>TankFittings</key>
      <label>tank fittings</label>
      <health>40</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, -4)</li>
          <li>(0, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_TankIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Pump</key>
      <label>pump and power take-off</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_PumpRate</li>
      </categories>
    </li>
    <li>
      <key>HoseReel</key>
      <label>hose reel and couplings</label>
      <health>30</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_PumpRate</li>
      </categories>
    </li>
    <li>
      <key>Manifold</key>
      <label>manifold and valves</label>
      <health>30</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 0)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>Wiring</key>
      <label>wiring</label>
      <health>25</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 0)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>Lights</key>
      <label>lights</label>
      <health>15</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 5)</li>
          <li>(0, 5)</li>
          <li>(1, 5)</li>
          <li>(-1, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
    </li>
    </components>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>9000</emptyKilograms>
        <ratedKilowatts>224</ratedKilowatts>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>28</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>120</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_Tanker_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTank">
        <fittings>
        <li>
          <node>LiquidTank</node>
          <phase>Liquid</phase>
          <hoursToOutside>6</hoursToOutside>
          <spoilRate>1</spoilRate>
          <loadWeight>1</loadWeight>
          <maxCompartments>3</maxCompartments>
        </li>
        <li>
          <node>InsulatedLiquidTank</node>
          <phase>Liquid</phase>
          <hoursToOutside>24</hoursToOutside>
          <spoilRate>0.5</spoilRate>
          <loadWeight>0.9</loadWeight>
          <maxCompartments>3</maxCompartments>
        </li>
        <li>
          <node>HighVolumeLiquidTank</node>
          <phase>Liquid</phase>
          <hoursToOutside>6</hoursToOutside>
          <spoilRate>1</spoilRate>
          <loadWeight>1.15</loadWeight>
          <maxCompartments>3</maxCompartments>
        </li>
        <li>
          <node>PressureVessel</node>
          <phase>Gas</phase>
          <hoursToOutside>6</hoursToOutside>
          <spoilRate>1</spoilRate>
          <loadWeight>0.8</loadWeight>
        </li>
        <li>
          <node>LightPressureVessel</node>
          <phase>Gas</phase>
          <hoursToOutside>6</hoursToOutside>
          <spoilRate>1</spoilRate>
          <loadWeight>0.5</loadWeight>
        </li>
        <li>
          <node>HeavyWallVessel</node>
          <phase>Gas</phase>
          <hoursToOutside>6</hoursToOutside>
          <spoilRate>1</spoilRate>
          <loadWeight>0.85</loadWeight>
        </li>
        </fittings>
        <compartmentNodes>
          <li>
            <node>TwoCompartments</node>
            <compartments>2</compartments>
          </li>
          <li>
            <node>ThreeCompartments</node>
            <compartments>3</compartments>
          </li>
        </compartmentNodes>
        <damageOverlays>
          <li>
            <part>Chassis</part>
            <scope>Vehicle</scope>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_DamageBody</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 11)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>TankShell</part>
            <scope>Liquid</scope>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_DamageTank</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 11)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>TankShell</part>
            <scope>Gas</scope>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_DamageVessel</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 11)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
        </damageOverlays>
        <hosesOut>
          <graphicData>
            <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_HoseOut</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </hosesOut>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_Tanker_Blueprint</defName>
    <label>bulk tanker</label>
    <description>A heavy truck with a bare deck, ready for whichever tank you fit. Its tank is added afterwards as an upgrade.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4, 11)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>Machining</li>
      <li>Electricity</li>
    </researchPrerequisites>
    <size>(3, 10)</size>
    <costList>
      <Steel>280</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <thingToSpawn>Phobos_Tanker</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_BulkTanker</defName>
    <label>bulk tanker</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Phobos_Tanker</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_TankLoad</def></li>
      <li><def>PhobosVehicleSystem_AirBrakes</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Compressor</role>
        <find>
          <li>
            <keyContains>compressor</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosAirCompressor</key>
          <label>air compressor</label>
          <health>25</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
