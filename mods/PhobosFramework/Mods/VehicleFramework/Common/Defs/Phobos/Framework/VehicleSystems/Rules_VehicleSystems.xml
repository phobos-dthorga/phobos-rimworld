<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The vehicle systems service's own constants (agent defaults, not tuned). Physics lives in the system Defs; player preferences
       are mod settings. The first loaded instance wins, so another mod may patch these in XML. -->
  <Phobos.VehicleSystems.PhobosVehicleRulesDef>
    <defName>PhobosVehicleRules</defName>
    <maxCatchUpHours>24</maxCatchUpHours>
    <stepHours>0.025</stepHours>
    <replacedPartHealth>0.25</replacedPartHealth>
    <!-- Framework 0.73.0 (docs/development/vehicle-crosslinks-round-two.md, S1, S2 and T1; owner, 10 Nov 2026). All authored. -->
    <replacedPartHealthAtRig>0.6</replacedPartHealthAtRig>
    <rigReplaceWorkFactor>0.7</rigReplaceWorkFactor>
    <!-- Fitting and tuning by weight (Framework 0.91.0, authored): the listed costs hold at 5 tonnes; materials grow as the square root of the
         weight and time as its fourth root, held between half and three times. -->
    <fitCostReferenceKilograms>5000</fitCostReferenceKilograms>
    <fitMaterialWeightExponent>0.5</fitMaterialWeightExponent>
    <fitWorkWeightExponent>0.25</fitWorkWeightExponent>
    <fitWeightFactorMin>0.5</fitWeightFactorMin>
    <fitWeightFactorMax>3</fitWeightFactorMax>
    <!-- Sling loads (Framework 0.92.0, authored): a hook lifts 1% less for each degree above 15 °C, at most 30% less (the direction from the FAA
         Helicopter Flying Handbook: air density falls with temperature); hooking a load up is about 0.6 hours for a builder of normal speed. -->
    <slingDerateFromCelsius>15</slingDerateFromCelsius>
    <slingLossPerDegree>0.01</slingLossPerDegree>
    <slingMaxLoss>0.3</slingMaxLoss>
    <slingHookUpWork>1500</slingHookUpWork>
    <slingReachCells>25</slingReachCells>
    <!-- Sling slice 2 (Framework 0.101.0, all authored): no lift above 150% wind on the game's own readout, nor in a storm with lightning; a
         slung flight at 0.7 of the helicopter's speed and 1.3 times its fuel per tile (an external load's drag); a dropped load unharmed up
         to 2 m, every part ruined from 40 m; a release in cruise falls 30 m, a load in a crash 15 m; people riding in it take 6 blunt damage
         for each tenth of the share lost; a wreck's map is 100 cells across. -->
    <slingMaxWind>1.5</slingMaxWind>
    <slingSpeedFactor>0.7</slingSpeedFactor>
    <slingFuelPerTileFactor>1.3</slingFuelPerTileFactor>
    <slingDropSafeMetres>2</slingDropSafeMetres>
    <slingDropRuinMetres>40</slingDropRuinMetres>
    <slingReleaseMetres>30</slingReleaseMetres>
    <slingCrashDropMetres>15</slingCrashDropMetres>
    <slingDropPersonDamage>6</slingDropPersonDamage>
    <slingWreckMapSize>100</slingWreckMapSize>
    <!-- The hitch (Framework 0.101.0, authored): a trailer within 8 cells; coupling is about a third of an hour for a worker of normal speed;
         the hitch stands 0.3 cells behind a vehicle's rear edge unless its Def names its own point. -->
    <hitchReachCells>8</hitchReachCells>
    <hitchUpWork>900</hitchUpWork>
    <hitchGapCells>0.3</hitchGapCells>
    <!-- Batch 3 signatures (Framework 0.101.0, all authored): the generator set's service lead takes 300 W off the top (a heavy battery
         charger and its losses); the tipper's loading grab reaches 4 cells from the truck and a lift takes 20 game seconds (what a lift
         carries is the grab node's stat). -->
    <serviceLeadWatts>300</serviceLeadWatts>
    <grabReachCells>4</grabReachCells>
    <grabSecondsPerLift>20</grabSecondsPerLift>
    <diagnoseWork>1500</diagnoseWork>
    <hydraulicWorkFloor>0.2</hydraulicWorkFloor>
    <fieldFixWork>600</fieldFixWork>
    <dangerClockHours>72</dangerClockHours>
    <budgetMsPerTick>0.05</budgetMsPerTick>
    <budgetMsSingleCall>0.5</budgetMsSingleCall>
    <enemyFitSetChance>0.25</enemyFitSetChance>
    <repairStallTicks>2500</repairStallTicks>
    <repairStepGapTicks>600</repairStepGapTicks>
    <repairPauseTicks>60000</repairPauseTicks>
    <fieldFixSupplies>
      <ComponentIndustrial>1</ComponentIndustrial>
    </fieldFixSupplies>
    <messageCooldownHours>6</messageCooldownHours>
    <letterCooldownHours>48</letterCooldownHours>
    <nightStartsHour>19</nightStartsHour>
    <nightEndsHour>6</nightEndsHour>
    <shorePowerReach>1</shorePowerReach>
    <!-- Claiming another faction's vehicle (owner, 11 Nov 2026: unattended, nobody aboard). All authored. -->
    <claimBaseHours>0.5</claimBaseHours>
    <claimHoursPerCell>0.08</claimHoursPerCell>
    <claimMaxHours>6</claimMaxHours>
    <claimGuardCells>12</claimGuardCells>
    <claimGoodwillLoss>30</claimGoodwillLoss>
  </Phobos.VehicleSystems.PhobosVehicleRulesDef>

  <!-- The service: supplies loaded into the vehicle's cargo (hauling), then the work at the vehicle (construction). -->
  <JobDef>
    <defName>PhobosVehicleSystems_LoadServiceSupplies</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosLoadServiceSupplies</driverClass>
    <reportString>loading service supplies into TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>PhobosVehicleSystems_ServiceVehicle</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosServiceVehicle</driverClass>
    <reportString>servicing TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <!-- A jump-start, ordered from the flat vehicle's menu: leads from a donor vehicle near it. -->
  <JobDef>
    <defName>PhobosVehicleSystems_JumpStart</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosJumpStart</driverClass>
    <reportString>jump-starting TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>PhobosVehicleSystems_LoadServiceSupplies</defName>
    <label>load service supplies into vehicles</label>
    <giverClass>Phobos.VehicleSystems.WorkGiver_PhobosLoadServiceSupplies</giverClass>
    <workType>Hauling</workType>
    <verb>load supplies into</verb>
    <gerund>loading supplies into</gerund>
    <priorityInType>25</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- A repair that needs supplies: a new part, a serious condition put right, or a leak patched (vehicle health, slice 3). -->
  <JobDef>
    <defName>PhobosVehicleSystems_RepairWithSupplies</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosRepairWithSupplies</driverClass>
    <reportString>repairing TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>PhobosVehicleSystems_RepairWithSupplies</defName>
    <label>fit vehicle parts</label>
    <giverClass>Phobos.VehicleSystems.WorkGiver_PhobosRepairWithSupplies</giverClass>
    <workType>Construction</workType>
    <verb>repair</verb>
    <gerund>repairing</gerund>
    <priorityInType>61</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- Sling loads (Framework 0.92.0): a colonist hooks a load up for the helicopter waiting on it. Any colonist who hauls; no skill. -->
  <JobDef>
    <defName>PhobosVehicleSystems_SlingHookUp</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosSlingHookUp</driverClass>
    <reportString>hooking up TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>PhobosVehicleSystems_SlingHookUp</defName>
    <label>hook up sling loads</label>
    <giverClass>Phobos.VehicleSystems.WorkGiver_PhobosSlingHookUp</giverClass>
    <workType>Hauling</workType>
    <verb>hook up</verb>
    <gerund>hooking up</gerund>
    <priorityInType>60</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- The hitch (Framework 0.101.0): a colonist couples a trailer to the vehicle waiting on it. Any colonist who hauls; no skill. -->
  <JobDef>
    <defName>PhobosVehicleSystems_HitchUp</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosHitchUp</driverClass>
    <reportString>coupling TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>PhobosVehicleSystems_HitchUp</defName>
    <label>couple trailers</label>
    <giverClass>Phobos.VehicleSystems.WorkGiver_PhobosHitchUp</giverClass>
    <workType>Hauling</workType>
    <verb>couple</verb>
    <gerund>coupling</gerund>
    <priorityInType>59</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- A diagnosis at a tuning rig (Framework 0.73.0, S1): a mechanic's work at the vehicle, then a report. -->
  <JobDef>
    <defName>PhobosVehicleSystems_Diagnose</defName>
    <driverClass>Phobos.VehicleSystems.JobDriver_PhobosDiagnose</driverClass>
    <reportString>diagnosing TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <WorkGiverDef>
    <defName>PhobosVehicleSystems_Diagnose</defName>
    <label>diagnose vehicles</label>
    <giverClass>Phobos.VehicleSystems.WorkGiver_PhobosDiagnose</giverClass>
    <workType>Construction</workType>
    <verb>diagnose</verb>
    <gerund>diagnosing</gerund>
    <priorityInType>59</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>PhobosVehicleSystems_ServiceVehicle</defName>
    <label>service vehicles</label>
    <giverClass>Phobos.VehicleSystems.WorkGiver_PhobosServiceVehicle</giverClass>
    <workType>Construction</workType>
    <verb>service</verb>
    <gerund>servicing</gerund>
    <priorityInType>60</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>
</Defs>
