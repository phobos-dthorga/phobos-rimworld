<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What it is made of, by role (docs/development/parts-bills.md; D'thorga Vehicles 0.41.0). A light truck of 4.5 tonnes on two axles: four tyres. Its uranium is the sensor head's source and stays in the shell.
       Its blueprint's cost list is its shell; each role is filled at start-up by an installed mod's part where it suits the
       vehicle's weight, and by ours otherwise. Counts authored, held for the owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_SurveyTruck</defName>
    <label>survey truck parts</label>
    <target>Phobos_SurveyTruck_Blueprint</target>
    <parts>
      <Engine>1</Engine>
      <Transmission>1</Transmission>
      <FuelTank>1</FuelTank>
      <Wheels>4</Wheels>
      <Suspension>2</Suspension>
      <Alternator>1</Alternator>
      <Battery>1</Battery>
      <Wiring>1</Wiring>
      <Radiator>1</Radiator>
      <Exhaust>1</Exhaust>
      <HydraulicPump>1</HydraulicPump>
    </parts>
    <!-- Upgrade nodes that fit a real part (D'thorga Vehicles 0.41.0): the node's own ingredients in its tree are what is left beside
         the part. The other nodes are plate and fittings and stay as written. Node keys are only read here, never changed. -->
    <nodes>
      <li>
        <key>SurveyBattery</key>
        <parts>
          <Battery>2</Battery>
        </parts>
      </li>
    </nodes>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
