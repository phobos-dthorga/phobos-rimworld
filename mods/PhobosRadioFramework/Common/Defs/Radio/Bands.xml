<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Bands. Edges follow the amateur allocations the design quotes; the centre frequency is what every
       loss is computed at. obstructionFactor below 1 copes better indoors, which is UHF's real advantage
       in buildings (authored starting values; tune in play). -->

  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_VHF</defName>
    <label>VHF (2 m)</label>
    <description>144 to 148 MHz. Line of sight; cheap, light and reliable outdoors, but blocked by terrain and heavy walls.</description>
    <lowMHz>144</lowMHz>
    <highMHz>148</highMHz>
    <obstructionFactor>1.0</obstructionFactor>
  </Phobos.Radio.BandDef>

  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_UHF</defName>
    <label>UHF (70 cm)</label>
    <description>430 to 450 MHz. Shorter line of sight than VHF, but copes better inside buildings and mountain bases.</description>
    <lowMHz>430</lowMHz>
    <highMHz>450</highMHz>
    <obstructionFactor>0.75</obstructionFactor>
  </Phobos.Radio.BandDef>

  <!-- The aviation bands (Radio 0.49.0; the owner's card of 27 Nov 2026, "Add the aviation bands"; docs/development/vehicle-standard.md,
       batch 1). Aircraft talk on them; a station needs the aviation transceiver upgrade, and an antenna that works them (the mast's
       aviation antennas), before it can hear an aircraft. Edges: the civil air band 117.975 to 137 MHz, ICAO Annex 10 Volume V (as its
       frequency handbook, Doc 9718, quotes it); military UHF 225 to 399.975 MHz, the range of the AN/ARC-164 airborne set (Wikipedia and
       BAE Systems' data sheet). The obstruction factors are authored: VHF's for the air band, between VHF's and 70 cm's for military UHF. -->
  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_Airband</defName>
    <label>air band (VHF)</label>
    <description>117.975 to 137 MHz. Aircraft talk to the ground and each other here, by AM voice. A station needs an aviation transceiver and aviation antennas to join in.</description>
    <lowMHz>117.975</lowMHz>
    <highMHz>137</highMHz>
    <obstructionFactor>1.0</obstructionFactor>
    <upgradeFigure>aviationBands</upgradeFigure>
  </Phobos.Radio.BandDef>

  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_MilitaryUHF</defName>
    <label>military UHF</label>
    <description>225 to 400 MHz. Military aircraft talk here, by AM voice. A station needs an aviation transceiver and aviation antennas to join in.</description>
    <lowMHz>225</lowMHz>
    <highMHz>399.975</highMHz>
    <obstructionFactor>0.85</obstructionFactor>
    <upgradeFigure>aviationBands</upgradeFigure>
  </Phobos.Radio.BandDef>

  <!-- The marine band (Radio 0.57.0; the owner's answer of 28 Nov 2026 on the Decisions page, "Add the marine band"; docs/development/vehicle-standard.md).
       Boats talk on it; a station needs the marine transceiver upgrade, and the mast's marine antenna, before it can hear a boat, as for the
       aviation bands. Edges: the maritime mobile VHF channels of the ITU Radio Regulations' Appendix 18, 156.000 MHz (channel 0) to 162.025
       MHz (AIS 2; ITU-R Report M.2231; the US Coast Guard's channel table). The obstruction factor is authored: VHF's, as for the air band. -->
  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_Marine</defName>
    <label>marine VHF</label>
    <description>156 to 162 MHz. Boats talk to the shore and each other here, by FM voice. A station needs a marine transceiver and a marine antenna to join in.</description>
    <lowMHz>156</lowMHz>
    <highMHz>162.025</highMHz>
    <obstructionFactor>1.0</obstructionFactor>
    <upgradeFigure>marineBand</upgradeFigure>
  </Phobos.Radio.BandDef>

  <!-- HF's first two bands (Radio 0.62.0; docs/development/radio-hf.md, the owner's card of 28 Nov 2026: 40 m and 20 m first). Between
       tiles they go by HF's own path (the ground wave now; skywave next), at the frequencies the HF tables were made at, 7.1 and 14.2 MHz.
       Edges as commonly allocated, 7.000 to 7.200 and 14.000 to 14.350 MHz; not checked here against the ITU Radio Regulations
       (unverified). HF passes walls more easily than VHF: an obstruction factor of 0.5, authored. -->
  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_HF40</defName>
    <label>HF (40 m)</label>
    <description>7.0 to 7.2 MHz. Along the ground tens of kilometres from an upright antenna; by the sky, regional by day and far by night.</description>
    <lowMHz>7.0</lowMHz>
    <highMHz>7.2</highMHz>
    <centreMHz>7.1</centreMHz>
    <obstructionFactor>0.5</obstructionFactor>
    <path>Hf</path>
  </Phobos.Radio.BandDef>

  <Phobos.Radio.BandDef>
    <defName>PhobosRadio_HF20</defName>
    <label>HF (20 m)</label>
    <description>14.0 to 14.35 MHz. Along the ground a little less than 40 m; by the sky, the day band, far across the world.</description>
    <lowMHz>14.0</lowMHz>
    <highMHz>14.35</highMHz>
    <centreMHz>14.2</centreMHz>
    <obstructionFactor>0.5</obstructionFactor>
    <path>Hf</path>
  </Phobos.Radio.BandDef>
</Defs>
