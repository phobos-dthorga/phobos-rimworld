<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A carbon monoxide and smoke alarm, the second set's third piece (owner's order, 7 Nov 2026). A small ceiling fixture: it takes no floor
       space and can sit over furniture. It warns once when a gas passes its level and wakes the room's sleepers (owner's choice). Separate
       from the hydrogen detector planned with the vents (owner: two alarms, as in Ostranauts). Power, cost and work authored; placeholder art. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PhobosMedical_GasAlarm</defName>
    <label>carbon monoxide and smoke alarm</label>
    <description>A small alarm fixed to the ceiling. When smoke or carbon monoxide in the room passes a dangerous level it sounds, wakes anyone asleep in the room and warns you which room it is. Carbon monoxide has no smell or colour, so this is the only warning you get. It stays on until the air clears. Switch it off to silence it.</description>
    <graphicData>
      <texPath>Phobos/Medical/Things/GasAlarm</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.6,0.6)</drawSize>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <tickerType>Rare</tickerType>
    <clearBuildingArea>false</clearBuildingArea>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Mass>0.5</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>5</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <building>
      <isEdifice>false</isEdifice>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <designationCategory>Misc</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>PhobosCategory_MedicalEquipment</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>5</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Phobos.Medical.Comps.CompProperties_PhobosGasAlarm" />
    </comps>
  </ThingDef>
</Defs>
