  <Vehicles.VehicleDef ParentName="PhobosFarming_TractorT60Base">
    <defName>Phobos_TractorT60Standard</defName>
    <label>Thane T60 tractor</label>
    <description>Thane T60: a small farm tractor. It carries a plough or a cultivator on its three-point linkage and pulls a seed drill or a cart on its drawbar, and drives a paddock row by row with its implement working. Light and cheap to run, but it has little to spare for heavy ground.</description>
    <graphicData>
      <texPath>Phobos/Farming/TractorT60/TractorT60</texPath>
      <color>(141, 165, 106)</color>
      <colorTwo>(255, 227, 115)</colorTwo>
    </graphicData>
    <buildDef>Phobos_TractorT60_Blueprint</buildDef>
    <statBases>
      <!-- Authored [A]: below its parts bill, so building one to sell never pays (docs/development/farming-machines.md, AG6). -->
      <MarketValue>1500</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>330</Mass>
    </vehicleStats>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>4000</emptyKilograms>
        <ratedKilowatts>60</ratedKilowatts>
      </li>
    </modExtensions>
      <comps>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_TractorT60_UpgradeTree</def>
      </li>
      <!-- Its upgrades' pictures (D'thorga Framework's node looks): parts drawn alone and fitted onto the body (export_farming.py). -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>weights</key>
            <looks>
              <li>
                <node>PhobosTractorFrontWeights</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Farming/TractorT60/TractorT60_Weights</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <shaderType>CutoutComplexPattern</shaderType>
                    <drawSize>(4, 6)</drawSize>
                    <layer>1</layer>
