<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Medical's Dubs Bad Hygiene tie-in: the electrolyser's and safety shower's water, and (0.8.0) washing that decontaminates,
       with one Harmony prefix on the washing machine. Its own assembly, so the core never references an
       optional mod; LoadFolders.xml loads Mods/DubsBadHygiene and its version folder only while Dubs Bad Hygiene is active. It reads the
       plumbing through D'thorga Framework's shared reader. Every referenced DLL ships only in its own mod (Private=false). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Medical.Hygiene</RootNamespace>
    <AssemblyName>PhobosMedical.Hygiene</AssemblyName>
    <ModFolder>PhobosMedical</ModFolder>
    <TieInFolder>Mods/DubsBadHygiene/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.8.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BadHygiene">
      <HintPath>$(DbhAssemblies)\BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="../PhobosMedical/PhobosMedical.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="../PhobosFramework.Hygiene/PhobosFramework.Hygiene.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
