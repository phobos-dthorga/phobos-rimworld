  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_SmallMechanical</defName>
    <label>small mechanical part</label>
    <roles>
      <li>Starter</li>
      <li>OilPump</li>
      <li>FuelPump</li>
      <li>WaterPump</li>
      <li>Brakes</li>
      <li>Clutch</li>
