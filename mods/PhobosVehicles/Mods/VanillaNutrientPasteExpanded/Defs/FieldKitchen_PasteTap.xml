<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The Billy's paste tap (D'thorga Vehicles 0.116.0; docs/development/vehicle-nutrient-paste.md, NP4; the owner's choices of 23 Nov 2026: fed from
    "All choices!", a paste tank nearby and the Billy's own). Set out in the kitchen tent with the paste kitchen upgrade. The game's own paste dispenser
    (D'thorga Framework's Building_PhobosPasteTap), so colonists and prisoners eat from it as from one; it serves from its own store of 150 meals of
    paste (the Billy's own paste tank; authored), which an Ullage or paste bowser of ours set up on Unload within its hose's reach fills, ingredients
    and all. It packs up with the Billy, paste and all, and spoils by the paste's own days at the tent's warmth. Hand-pumped: it needs no power.
    The bigger paste tank upgrade makes it hold 400 (authored) and gives it its larger picture, so no paste is stranded in a swapped piece (the
    owner's pick, 23 Nov 2026: "Both", spread across the variants and their upgrades: try 1 the standard tap, try 2 the bigger). Since Vehicles 0.129.3
    (Framework 0.347.0) the tap is made as soon as the upgrade is bought, its paste shows on the Billy's panel, a paste line beneath the tent or the
    packed trailer fills it, and a caravan eats from it on the road. Not yet tested in game.
  -->
  <ThingDef ParentName="PhobosBillyPieceBase">
    <defName>Phobos_BillyPasteTap</defName>
    <label>paste tap</label>
    <description>A hand-pumped tap on a small insulated tank of nutrient paste. Colonists help themselves to a paste meal from it, as from a dispenser, while it holds paste. A tanker or bowser of paste set to pump out nearby fills it, and so does a paste line reaching the tent, or the trailer while it is packed; the paste keeps what it was made from. It packs up with the kitchen, paste and all.</description>
    <thingClass>Phobos.VehicleSystems.Building_PhobosPasteTap</thingClass>
    <graphicData>
      <texPath>Phobos/Vehicles/FieldKitchen/BillyPasteTap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <size>(1, 1)</size>
    <tickerType>Rare</tickerType>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -1)</interactionCellOffset>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <building>
      <isMealSource>true</isMealSource>
      <nutritionCostPerDispense>0.3</nutritionCostPerDispense>
      <soundDispense>DispensePaste</soundDispense>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>false</transmitsPower>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosReservoir">
        <contents>PhobosTank_NutrientPaste</contents>
        <capacity>150</capacity>
        <node>PhobosBillyBiggerPasteTank</node>
        <capacityWithNode>400</capacityWithNode>
        <!-- An insulated store: half the plain tank's rate, so 8 days at the tent's warmth (the owner's figure for an insulated tank). -->
        <spoilRate>0.5</spoilRate>
      </li>
    </comps>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosNodeGraphicExtension">
        <node>PhobosBillyBiggerPasteTank</node>
        <graphicData>
          <texPath>Phobos/Vehicles/FieldKitchen/BillyPasteTapLarge</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(1, 1)</drawSize>
        </graphicData>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
