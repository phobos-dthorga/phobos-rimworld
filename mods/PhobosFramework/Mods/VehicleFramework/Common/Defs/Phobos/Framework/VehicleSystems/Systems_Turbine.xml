<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Gas turbines (docs/development/vehicle-turbine-design.md): turbine temperature from the model, hot-section life used above the
    continuous limit, engines out, and starting from the electrical system. Not yet tested in game.

    Sources and labels:
    - Over-temperature damages the hot section; eroded compressor blades, worn seals and growing tip clearances lower a turbine's
      performance over time; a weak battery may not spin a turbine fast enough to cool the combustion section, giving a hot start
      (secondary: Aviation Week, "Engine Limitations Are Not Mere Suggestions"). The life rate, the hot-start cost and the start
      thresholds are authored.
    - A ground start spins the core to about 25% and fuel goes in once it passes 15% (secondary: JSBSim FGTurbine); here a starting
      power below 25% cannot reach light-off (a hung start), and below 40% lights it hot (authored thresholds).
    - The hot-section overhaul's supplies are gameplay stand-ins: plasteel for the blades, components for the rest.
    - The temperature shown follows the model at once while the engine runs and, once it stops, cools with the metal's heat: about
      half the gap in a quarter hour, near the air in two (authored rate; Framework 0.29.1). Limits and wear read the model's figure.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Turbine</defName>
    <label>gas turbine</label>
    <description>The turbine's temperature, its hot-section life and its start. Run past its limits it wears fast and can be damaged; a weak battery gives a hot start or none; with one of two engines out the other has to work harder.</description>
    <roles>
      <li>Engine</li>
    </roles>
    <!-- Framework 0.300.0: every gas turbine has its compressor wash (below), whatever its loadout lists. -->
    <comesWith>
      <li>PhobosVehicleSystem_CompressorWash</li>
    </comesWith>
    <parameters>
      <temperatureFollowRate>60</temperatureFollowRate>
      <coolDownRate>2.5</coolDownRate>
    </parameters>
    <quantities>
      <li>
        <name>turbineTemperature</name>
        <description>How hot the turbine is running. It climbs with power and falls back as it cools.</description>
        <label>turbine</label>
        <unit>Celsius</unit>
        <min>-60</min>
        <max>1500</max>
        <startsAt>Ambient</startsAt>
      </li>
      <li>
        <name>turbineOverLimit</name>
        <description>The temperature it can hold all day. Below it there is no harm. Over it, the hot section wears faster.</description>
        <label>turbine temperature</label>
        <detailLabel>continuous limit</detailLabel>
        <unit>CelsiusOffset</unit>
        <min>-2000</min>
        <max>2000</max>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Turbine"><reading>OverContinuous</reading></li>
        </derivedFrom>
        <stages>
          <li>
            <from>0</from>
            <label>over its continuous limit</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgTurbineHot</message>
                <hotAirMessage>PhobosVehicleSystems_MsgTurbineHotHotAir</hotAirMessage>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>turbineOverTop</name>
        <description>The temperature it must never pass. Over it, the engine is damaged for as long as it stays there.</description>
        <label>turbine temperature</label>
        <detailLabel>highest limit</detailLabel>
        <unit>CelsiusOffset</unit>
        <min>-2000</min>
        <max>2000</max>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Turbine"><reading>OverTop</reading></li>
        </derivedFrom>
        <stages>
          <li>
            <from>0</from>
            <label>over every limit</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Engine</role>
                <perHour>4</perHour>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgTurbineOverTop</message>
                <hotAirMessage>PhobosVehicleSystems_MsgTurbineOverTopHotAir</hotAirMessage>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>hotSectionLife</name>
        <description>How much of the turbine's hottest parts is used up. Running over its limits spends it faster.</description>
        <!-- Framework 0.247.0 kept this per engine in code of its own; since 0.248.0 the systems engine keeps it per part (PartFigures):
             each engine by the work it does, and an overhaul does the most worn engine alone. -->
        <perPart>
          <engines>true</engines>
        </perPart>
        <wearTrend>true</wearTrend>
        <showOnDashboard>true</showOnDashboard>
        <label>hot-section life used</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>3</max>
        <startsAt>Empty</startsAt>
        <stages>
          <li>
            <from>1</from>
            <label>hot section worn</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Breakdown">
                <role>Engine</role>
                <!-- Framework 0.247.0: on a twin, the engine whose hot section is worn. -->
                <mostWornOf>hotSectionLife</mostWornOf>
                <mtbHours>150</mtbHours>
                <healthFraction>0.3</healthFraction>
                <message>PhobosVehicleSystems_MsgBreakdown</message>
                <when Class="Phobos.VehicleSystems.When_EngineRunning" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgHotSectionWorn</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>enginesOut</name>
        <description>How many engines have stopped.</description>
        <label>engines</label>
        <detailLabel>engines out</detailLabel>
        <unit>Plain</unit>
        <min>0</min>
        <max>4</max>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Turbine"><reading>EnginesOut</reading></li>
        </derivedFrom>
        <stages>
          <li>
            <from>1</from>
            <label>one engine out</label>
            <notable>true</notable>
            <!-- Framework 0.106.0 (avionics A9): limping home on the engines left, at 0.8 of the flight speed (authored; the Hind's own code
                 slows it the same on the map). Its generator's share goes with it (Input_AlternatorOutput since Framework 0.130.0). -->
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>FlightSpeed</stat>
                <factor>0.8</factor>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgEngineOut</message>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- The battery's starting power, as the electrical system works it out; a turbine needs more than a piston engine. -->
        <name>turbineStart</name>
        <description>What the battery can give to light the turbine. Too little, and it will not start.</description>
        <label>turbine start</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>startingPower</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant"><value>1</value></fallback>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.25</to>
            <label>too weak to light</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseHungStart</reason>
              </li>
            </effects>
          </li>
          <li>
            <!-- Framework 0.137.3 (the owner's rule of 12 Nov 2026, a warning before a vehicle is stranded): twice the no-light line, as the
                 piston engine's warning is twice its no-start line. Before, a turbine's only warning was the piston one at 0.1 to 0.2 starting
                 power, below the 0.25 it needs to light, so it came after the turbine was stranded (the Abrams, 17 Nov 2026). Below 0.4 a
                 start also lights the turbine hot (the IgnitionOn effects below). The threshold is authored. -->
            <from>0.25</from>
            <to>0.5</to>
            <label>barely enough to light</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgTurbineStartLow</message>
                <!-- Framework 0.383.1 (the owner's card of 28 Nov 2026, "Warn only on the way down"): not when a flat battery warms back up into
                     this stage by day, which the Abrams did twice a day. -->
                <when Class="Phobos.VehicleSystems.When_Falling" />
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>followModel</name>
        <quantity>turbineTemperature</quantity>
        <kind>Toward</kind>
        <target Class="Phobos.VehicleSystems.Input_Turbine"><reading>Temperature</reading></target>
        <factorParameter>temperatureFollowRate</factorParameter>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>coolDown</name>
        <quantity>turbineTemperature</quantity>
        <kind>Toward</kind>
        <target Class="Phobos.VehicleSystems.Input_Ambient" />
        <factorParameter>coolDownRate</factorParameter>
        <when Class="Phobos.VehicleSystems.When_EngineRunning"><invert>true</invert></when>
      </li>
      <li>
        <name>hotSectionWear</name>
        <quantity>hotSectionLife</quantity>
        <kind>Into</kind>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_Turbine"><reading>LifePerHour</reading></li>
        </inputs>
      </li>
    </flows>
    <onEvents>
      <li>
        <!-- A weak battery lights the turbine hot: life used, and a message. -->
        <eventDef>IgnitionOn</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_AddQuantity">
            <quantity>hotSectionLife</quantity>
            <amount>0.03</amount>
            <when Class="Phobos.VehicleSystems.When_QuantityBelow">
              <quantity>turbineStart</quantity>
              <value>0.4</value>
            </when>
          </li>
          <li Class="Phobos.VehicleSystems.Effect_Message">
            <message>PhobosVehicleSystems_MsgHotStart</message>
            <type>CautionInput</type>
            <when Class="Phobos.VehicleSystems.When_QuantityBelow">
              <quantity>turbineStart</quantity>
              <value>0.4</value>
            </when>
          </li>
          <!-- Framework 0.270.0 (S123, the owner's pick of 23 Nov 2026): the rough, coughing light-off is heard. -->
          <li Class="Phobos.VehicleSystems.Effect_Sound">
            <sound>PhobosVehicleSystems_TurbineHotStart</sound>
            <when Class="Phobos.VehicleSystems.When_QuantityBelow">
              <quantity>turbineStart</quantity>
              <value>0.4</value>
            </when>
          </li>
          <!-- Framework 0.321.0: and seen: a flash of flame at the jet pipe and a gout of black smoke. -->
          <li Class="Phobos.VehicleSystems.Effect_Fleck">
            <fleck>FireGlow</fleck>
            <at>Exhaust</at>
            <burst>2</burst>
            <scale>1.2</scale>
            <drift>false</drift>
            <when Class="Phobos.VehicleSystems.When_QuantityBelow">
              <quantity>turbineStart</quantity>
              <value>0.4</value>
            </when>
          </li>
          <li Class="Phobos.VehicleSystems.Effect_Fleck">
            <fleck>Smoke</fleck>
            <tint>RichSmoke</tint>
            <at>Exhaust</at>
            <burst>5</burst>
            <scale>1.1</scale>
            <when Class="Phobos.VehicleSystems.When_QuantityBelow">
              <quantity>turbineStart</quantity>
              <value>0.4</value>
            </when>
          </li>
        </effects>
      </li>
    </onEvents>
    <service>
      <label>a hot-section overhaul</label>
      <!-- Framework 0.124.0 (cross-links round two S3; owner, 17 Nov 2026): a turbine's hot section is overhauled in a hangar, so it waits for the
           vehicle to be parked by a working tuning rig. A worn hot section only breaks down more often, never refuses to start or fly, so an
           aircraft can always come home for it. -->
      <needsRig>true</needsRig>
      <dueQuantity>hotSectionLife</dueQuantity>
      <dueAbove>1</dueAbove>
      <restores>
        <li>
          <quantity>hotSectionLife</quantity>
          <value>0</value>
        </li>
      </restores>
      <!-- Framework 0.178.0: a hot-section kit; raw, what it is made of (owner, 19 Nov 2026). -->
      <supplies>
        <PhobosVehicles_HotSectionKit>1</PhobosVehicles_HotSectionKit>
      </supplies>
      <rawSupplies>
        <Plasteel>10</Plasteel>
        <ComponentIndustrial>3</ComponentIndustrial>
      </rawSupplies>
      <work>3000</work>
    </service>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    Water injection (the Harrier's Pegasus): up to 227 kg of water sprayed into the combustion chamber and turbine to cool the blades,
    used at about 35 imperial gallons a minute (2.65 kg/s) for at most about 90 s; without it the limits drop back to the dry
    ratings (secondary: All-Aero on the Pegasus; Wikipedia on its blade temperature limit). The tank's use is worked out by the turbine
    model while a wet rating is in use. The refill is a service (water from Dubs Bad Hygiene's plumbing when that mod is active,
    otherwise free, as the base game treats water: owner, 8 Nov 2026).
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_WaterInjection</defName>
    <label>water injection</label>
    <description>A tank of water the engine sprays in to cool its turbine for a short, hard hover. Once it runs out, the engine has only its dry ratings. A mechanic refills it.</description>
    <quantities>
      <li>
        <name>injectionWater</name>
        <description>Water sprayed into the engine for extra thrust. When it runs out, the extra is gone.</description>
        <label>injection water</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.05</to>
            <label>empty</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgInjectionWaterOut</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <service>
      <label>an injection water refill</label>
      <dueQuantity>injectionWater</dueQuantity>
      <dueBelow>0.5</dueBelow>
      <restores>
        <li>
          <quantity>injectionWater</quantity>
          <value>1</value>
        </li>
      </restores>
      <waterLitres>227</waterLitres>
      <work>400</work>
    </service>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    The compressor wash (Framework 0.300.0; docs/development/compressor-wash.md; the owner's cards of 26 Nov 2026). Dust, grit and salt drawn in
    with the air coat a gas turbine's compressor blades, so it moves less air: less power for the same fuel, and a hotter turbine for the same
    work. Ground crews rinse it with water to win the power back. Sources and labels:
    - Compressor fouling is the commonest cause of a gas turbine's lost performance, recovered in large part by washing (secondary: Meher-Homji
      and Bromley, "Gas turbine axial compressor fouling and washing", Texas A&M Turbomachinery Symposium, 2004). The 5% largest loss, the
      rate, and the 20 litres an engine are authored ballpark figures, not taken from any one engine's manual.
    - The rate is CompressorFoulingRule's (Rules_VehicleSystems.xml): faster on rough ground in step with the intake exposure the grit rule reads.
    - A wash is due at half fouled; nothing ever stops the engine, so an aircraft never washed is only weaker.
    The gas turbine brings this system with it (comesWith), so every loadout that names a gas turbine has it.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_CompressorWash</defName>
    <label>compressor wash</label>
    <description>Dust, grit and salt coat the turbine's compressor as it runs, faster on rough ground than on paving. A dirty compressor gives less power, so the engine runs hotter and burns more fuel. A mechanic washes it with water.</description>
    <quantities>
      <li>
        <name>compressorFouling</name>
        <description>How dirty the compressor is. The dirtier it is, the less power the turbine gives and the more fuel it burns.</description>
        <label>compressor dirt</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Empty</startsAt>
        <stages>
          <li>
            <from>0.5</from>
            <label>dirty</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgCompressorDirty</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- Framework 0.365.0 (docs/development/vehicle-inlet-separator.md, IS4 and IS5; the owner's answer of 28 Nov 2026): a fitted inlet
             barrier filter clogs with the dust it stops, its power cost rising to twice its fitted share when wholly clogged (IntakeSeparator,
             through the powertrain's demand). The compressor wash cleans it. Nothing without a barrier, or with "Intake separators" off. -->
        <name>barrierClog</name>
        <description>How clogged the inlet barrier filter is with the dust it keeps out. The more clogged, the more power it costs, up to twice its usual share. A compressor wash cleans it.</description>
        <label>inlet barrier</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Empty</startsAt>
        <stages>
          <li>
            <from>0.7</from>
            <label>clogged</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgBarrierClogged</message>
                <type>CautionInput</type>
                <when Class="Phobos.VehicleSystems.When_Setting"><setting>intakeSeparators</setting></when>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>fouling</name>
        <quantity>compressorFouling</quantity>
        <kind>Into</kind>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_CompressorFouling" />
        </inputs>
      </li>
      <li>
        <!-- Framework 0.365.0 (IS4): 0.02 an hour run over wholly rough ground (authored: a lamp after about 35 hours on dirt strips, fully
             clogged after 50), nothing on paving. -->
        <name>barrierClogging</name>
        <quantity>barrierClog</quantity>
        <kind>Into</kind>
        <factor>0.02</factor>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_BarrierDust" />
        </inputs>
      </li>
    </flows>
    <service>
      <label>a compressor wash</label>
      <dueQuantity>compressorFouling</dueQuantity>
      <dueAbove>0.5</dueAbove>
      <restores>
        <li>
          <quantity>compressorFouling</quantity>
          <value>0</value>
        </li>
        <li>
          <!-- Framework 0.365.0 (IS5): the wash rinses the inlet barrier too. -->
          <quantity>barrierClog</quantity>
          <value>0</value>
        </li>
      </restores>
      <!-- About 20 litres for each engine (authored ballpark), from plumbing under or beside the vehicle, free without Dubs Bad Hygiene. -->
      <waterLitres>20</waterLitres>
      <waterPerEngine>true</waterPerEngine>
      <work>600</work>
    </service>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
