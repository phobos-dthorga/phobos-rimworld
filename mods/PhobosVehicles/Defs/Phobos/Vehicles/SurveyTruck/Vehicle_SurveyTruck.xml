<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The survey truck: a light 4x4 that finds deep ore, and with an upgrade searches other lands (docs/development/vehicle-survey-truck.md). Every figure is authored and untuned; the uranium in its cost stands in for
    the sealed sources real logging tools carry (owner, 9 Nov 2026). Part keys are saved by position: append only, never reorder. Cells run x -1 to 1, z -3 to 3. Its body and boom were generated for it (assets/phobos-vehicles/requests/survey-truck-*.json). Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_SurveyTruck</defName>
    <label>survey truck</label>
    <description>A light four-wheel-drive truck with a folding sensor boom and a recorder. Park it, set it up, and a colonist can survey for deep ore under the map, as a ground-penetrating scanner does. Each find on a map makes the next take longer. Upgrades add long-range searching and a fast, power-hungry mode. It cannot move while set up.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(4, 8)</drawSize>
      <color>(162, 156, 123)</color>
      <colorTwo>(195, 110, 36)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_SurveyTruck_Blueprint</buildDef>
    <size>(3, 7)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.5</Flammability>
      <MarketValue>3000</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>375</Mass>
      <MoveSpeed>14</MoveSpeed>
      <CargoCapacity>30</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.03</AccelerationRate>
      <Phobos_ScanRate>1</Phobos_ScanRate>
      <Phobos_RigControl>1</Phobos_RigControl>
      <Phobos_RigStability>1</Phobos_RigStability>
    </vehicleStats>
    <race>
      <baseBodySize>4</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>4</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(-1, 3)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>passenger</key>
          <label>passenger</label>
          <slots>1</slots>
          <hitbox>
            <cells>
              <li>(1, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>130</health>
      <depth>External</depth>
      <hitWeight>3</hitWeight>
      <hitbox>
        <from>(-1, -3)</from>
        <to>(1, 3)</to>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>50</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Engine</key>
      <label>engine</label>
      <health>55</health>
      <depth>Internal</depth>
      <priorityStatEfficiency>true</priorityStatEfficiency>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>Transmission</key>
      <label>transmission</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(-1, 2)</li>
          <li>(0, 2)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FrontWheels</key>
      <label>front axle and wheels</label>
      <health>35</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, 2)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>RearWheels</key>
      <label>rear axle and wheels</label>
      <health>35</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, -2)</li>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FuelTank</key>
      <label>fuel tank</label>
      <health>35</health>
      <depth>Internal</depth>
      <reactors>
        <li Class="Vehicles.Reactor_FuelLeak" />
      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Radiator</key>
      <label>radiator</label>
      <health>30</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Alternator</key>
      <label>alternator</label>
      <health>30</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>BatteryBox</key>
      <label>battery box</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Console</key>
      <label>recorder and console</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(-1, 0)</li>
          <li>(0, 0)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_ScanRate</li>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>Wiring</key>
      <label>wiring</label>
      <health>25</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 0)</li>
          <li>(1, 1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>PowerDistribution</key>
      <label>power distribution</label>
      <health>30</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(-1, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>HydraulicPump</key>
      <label>hydraulic pump</label>
      <health>30</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigStability</li>
      </categories>
    </li>
    <li>
      <key>Outriggers</key>
      <label>outriggers</label>
      <health>45</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, -1)</li>
          <li>(1, -1)</li>
          <li>(-1, -3)</li>
          <li>(1, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigStability</li>
      </categories>
    </li>
    <li>
      <key>SensorBoom</key>
      <label>sensor boom</label>
      <health>50</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -1)</li>
          <li>(0, -2)</li>
          <li>(0, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_ScanRate</li>
      </categories>
    </li>
    <li>
      <key>SensorHead</key>
      <label>sensor head</label>
      <health>30</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_ScanRate</li>
      </categories>
    </li>
    <li>
      <key>Lights</key>
      <label>lights</label>
      <health>15</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(1, 3)</li>
          <li>(-1, -3)</li>
          <li>(1, -3)</li>
        </cells>
      </hitbox>
    </li>
    </components>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>4500</emptyKilograms>
        <ratedKilowatts>130</ratedKilowatts>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>20</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>120</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_SurveyTruck_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosSurveyTruck">
        <powerPointDef>Phobos_PowerPoint</powerPointDef>
        <powerPointLargeDef>Phobos_PowerPointLarge</powerPointLargeDef>
        <!-- The boom is its own picture and swings flat about the bracket on the deck: the game cannot lift a picture towards the camera. Pivot and reach measured off the art. -->
        <movingParts>
          <li>
            <key>boom</key>
            <label>sensor boom</label>
            <pivotX>0</pivotX>
            <pivotZ>-0.5</pivotZ>
            <reach>2.8</reach>
            <angle>90</angle>
            <seconds>2</seconds>
            <look>
              <graphicData>
                <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_Boom</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 8)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>1</layer>
              </graphicData>
            </look>
          </li>
        </movingParts>
        <!-- A tenth of the game's scanners' 3 and 6 days and 4 and 8 (owner's order of magnitude, 9 Nov 2026); the slowing per find is unchanged. -->
        <mtbDays>0.3</mtbDays>
        <guaranteedDays>0.6</guaranteedDays>
        <longRangeMtbDays>0.4</longRangeMtbDays>
        <longRangeGuaranteedDays>0.8</longRangeGuaranteedDays>
        <sensorWeights>
          <li><stat>Phobos_SensorGeophone</stat><ore>Steel</ore><factor>1.5</factor></li>
          <li MayRequire="vanillaexpanded.vchemfuele"><stat>Phobos_SensorGeophone</stat><ore>VCHE_Deepchem</ore><factor>1.5</factor></li>
          <li><stat>Phobos_SensorRadiometric</stat><ore>Uranium</ore><factor>3</factor></li>
        </sensorWeights>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_SurveyTruck_Blueprint</defName>
    <label>survey truck</label>
    <description>A light truck that finds deep ore wherever you can drive it.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4, 8)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>14000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>GroundPenetratingScanner</li>
    </researchPrerequisites>
    <size>(3, 7)</size>
    <costList>
      <PhobosVehicles_EngineAssembly>1</PhobosVehicles_EngineAssembly>
      <PhobosVehicles_Transmission>1</PhobosVehicles_Transmission>
      <PhobosVehicles_DrivetrainKit>1</PhobosVehicles_DrivetrainKit>
      <PhobosVehicles_ElectricalKit>1</PhobosVehicles_ElectricalKit>
      <Steel>220</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <Plasteel>10</Plasteel>
      <Uranium>10</Uranium>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_SurveyTruck</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_SurveyTruck</defName>
    <label>survey truck</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Phobos_SurveyTruck</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
    <drivetrain>
      <def>PhobosDrivetrain_MediumDiesel</def>
    </drivetrain>
    <loads>
      <li>
        <name>surveyConsole</name>
        <label>survey console</label>
        <description>The recorder and sensors, while a survey is running on the truck's own electrics.</description>
        <amps>30</amps>
        <when Class="Phobos.VehicleSystems.When_SurveyDrawing">
          <what>Console</what>
        </when>
      </li>
      <li>
        <name>surveyArray</name>
        <label>powered array</label>
        <description>Runs the survey three times as fast. It needs a powered grid beside the truck or the large battery.</description>
        <amps>150</amps>
        <toggle>true</toggle>
        <defaultOn>false</defaultOn>
        <iconPath>Phobos/VehicleSystems/Stations/SurveyArray</iconPath>
        <available Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_SurveyFastFactor</stat>
          <value>1</value>
        </available>
        <when Class="Phobos.VehicleSystems.When_SurveyDrawing">
          <what>Array</what>
        </when>
      </li>
      <li>
        <name>workLights</name>
        <label>work lights</label>
        <description>Lamps over the work, on at night while it is set up.</description>
        <amps>6</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <available Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_WorkLights</stat>
          <value>0</value>
        </available>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_SetUp" />
            <li Class="Phobos.VehicleSystems.When_Night" />
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
