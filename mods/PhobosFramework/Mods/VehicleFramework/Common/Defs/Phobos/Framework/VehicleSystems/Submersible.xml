<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The two figures a submersible's parts feed (docs/development/submarine-framework.md). Put them in a Sea vehicle's vehicleStats and in its parts'
       categories, beside a Phobos.VehicleSystems.CompProperties_PhobosSubmersible in its comps. Not yet tested in game. -->
  <Vehicles.VehicleStatDef>
    <defName>Phobos_DiveEndurance</defName>
    <label>time under</label>
    <description>How many hours of air and charge the boat can hold, sitting still. It goes three times as fast on the move, by default, and the surface refills it.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>FloatOne</toStringStyle>
    <formatString>{0} h</formatString>
    <operationType>Average</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_DiveControl</defName>
    <label>diving trim</label>
    <description>How well the ballast tanks and the hull hold the boat under control. Below a certain point it will not dive, and a boat already under comes up.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <formatString>{0}</formatString>
    <operationType>MinValue</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <!-- What a crew breathes if ordered to stay under with nothing left: carbon dioxide building up in a sealed hull. The stages and rates are authored for play and are not a dose-response model. -->
  <HediffDef>
    <defName>Phobos_StaleAir</defName>
    <label>stale air</label>
    <description>Too long breathing air that has been used up. It causes headaches, gasping and confusion, then unconsciousness, and it can kill. Fresh air clears it within hours.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.7, 0.9)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>1</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>stuffy</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>headache</label>
        <minSeverity>0.1</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>gasping</label>
        <minSeverity>0.3</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>confused</label>
        <minSeverity>0.55</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>passing out</label>
        <minSeverity>0.8</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
