<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What it is made of, by role (docs/development/parts-bills.md; D'thorga Vehicles 0.41.0). A 20-tonne rig on four axles: eight tyres, two frame castings under the mast, two batteries, its hydraulic pump and its compressor.
       Its blueprint's cost list is its shell; each role is filled at start-up by an installed mod's part where it suits the
       vehicle's weight, and by ours otherwise. Counts authored, held for the owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_DrillRig</defName>
    <label>drill rig parts</label>
    <target>Phobos_DrillRig_Blueprint</target>
    <parts>
      <Engine>1</Engine>
      <Transmission>1</Transmission>
      <FuelTank>1</FuelTank>
      <Wheels>8</Wheels>
      <Suspension>4</Suspension>
      <Alternator>1</Alternator>
      <Battery>2</Battery>
      <Wiring>1</Wiring>
      <Radiator>1</Radiator>
      <Exhaust>1</Exhaust>
      <HydraulicPump>1</HydraulicPump>
      <Compressor>1</Compressor>
      <Frame>2</Frame>
      <!-- Its hydraulic lines and flushing hose. -->
      <Hose>1</Hose>
      <!-- D'thorga Vehicles 0.87.0 (owner, 19 Nov 2026): the two rams that raise its mast; the shell gave up what they are made of. -->
      <Actuator>2</Actuator>
    </parts>
    <!-- Upgrade nodes that fit a real part (D'thorga Vehicles 0.88.0): the electric power pack is an electric motor driving a hydraulic pump;
         its node's own ingredients in its tree are the frame and tank beside them. -->
    <nodes>
      <li>
        <key>ElectricPowerPack</key>
        <parts>
          <ElectricMotor>1</ElectricMotor>
          <HydraulicPump>1</HydraulicPump>
        </parts>
      </li>
    </nodes>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
