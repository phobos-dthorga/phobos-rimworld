<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vanilla Vehicles Expanded's aircraft with more than one engine part or a rotor drive (docs/development/vehicle-power-and-lift-design.md).
    Not yet tested in game.

    - The Frog and the Toad are thrust-lifted pods with three and four thrusters of their own (FirstThruster and so on), bound as
      their engines: each one lost takes its share of lift, and a pod whose thrusters cannot lift it will not launch (the player's
      hover-limit setting). Their lift-to-weight at maximum gross weight is authored for these fictional craft: the Frog 1.5 (one
      thruster out, it just lifts when full), the Toad 1.4 (one out, it still lifts; two out, only lightened).
    - The Mosquito is a light four-seat helicopter: one turboshaft (an agent's choice: the mod does not say what drives it) and its
      own RotorMast as the rotor drive. Its drive limit, 0.9 of maximum continuous, is authored: the mod names no real helicopter.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Frog</defName>
    <avionics>
      <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>10</speed>
        <cruiseMetres>1500</cruiseMetres>
        <lowCruiseMetres>1500</lowCruiseMetres>
        <size>0.8</size>
      </airTrack>
    </avionics>
    <label>thrust-lifted pod (three thrusters)</label>
    <priority>Vehicle</priority>
    <!-- D'thorga Vehicles 0.112.0 (the fleet audit's follow-up, owner's yes of 23 Nov 2026): lopsided thrust and side tanks. Its three thrusters each cover the whole pod in the design, so their places are authored: two either side and the third on the centreline, which draws on both tanks. Yaw 0.25, authored: lift thrusters at the edge of a small pod. -->
    <engineOutYaw>0.25</engineOutYaw>
    <sideTanks>true</sideTanks>
    <engineArms>
      <li>-1</li>
      <li>1</li>
      <li>0</li>
    </engineArms>
    <selector>
      <vehicleDefs>
        <li>VVE_Frog</li>
      </vehicleDefs>
    </selector>
    <systems Inherit="False">
      <li>
        <!-- D'thorga Vehicles 0.132.1 (Framework 0.372.1, F7): the aircraft loadout's electrics, which this list replaces: 24 V, a 40 Ah
             battery, 300 A of generators and 1.5 Ah a start (Loadouts_Default.xml says where each comes from). -->
        <def>PhobosVehicleSystem_Electrical</def>
        <set>
          <batteryAmpHours>40</batteryAmpHours>
          <systemVolts>24</systemVolts>
          <alternatorAmps>300</alternatorAmps>
          <starterAmpHours>1.5</starterAmpHours>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
      <li><def>PhobosVehicleSystem_FlightControls</def></li>
      <li><def>PhobosVehicleSystem_Avionics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_Thrusters</def>
      <set>
        <liftToWeightAtMaxGross>1.5</liftToWeightAtMaxGross>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockThrustLift</flightProfile>
    <partRoles>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <key>FirstThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <key>SecondThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine3</role>
        <find>
          <li>
            <key>ThirdThruster</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Toad</defName>
    <avionics>
      <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>10</speed>
        <cruiseMetres>1500</cruiseMetres>
        <lowCruiseMetres>1500</lowCruiseMetres>
        <size>1.2</size>
      </airTrack>
    </avionics>
    <label>thrust-lifted assault pod (four thrusters)</label>
    <priority>Vehicle</priority>
    <!-- D'thorga Vehicles 0.112.0 (the fleet audit's follow-up, owner's yes of 23 Nov 2026): lopsided thrust and side tanks. Its four thrusters sit at its corners in the design (first and third left, second and fourth right), so their places are read from its parts. Yaw 0.25, authored. -->
    <engineOutYaw>0.25</engineOutYaw>
    <sideTanks>true</sideTanks>
    <selector>
      <vehicleDefs>
        <li>VVE_Toad</li>
      </vehicleDefs>
    </selector>
    <systems Inherit="False">
      <li>
        <!-- D'thorga Vehicles 0.132.1 (Framework 0.372.1, F7): the aircraft loadout's electrics, which this list replaces: 24 V, a 40 Ah
             battery, 300 A of generators and 1.5 Ah a start (Loadouts_Default.xml says where each comes from). -->
        <def>PhobosVehicleSystem_Electrical</def>
        <set>
          <batteryAmpHours>40</batteryAmpHours>
          <systemVolts>24</systemVolts>
          <alternatorAmps>300</alternatorAmps>
          <starterAmpHours>1.5</starterAmpHours>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
      <li><def>PhobosVehicleSystem_FlightControls</def></li>
      <li><def>PhobosVehicleSystem_Avionics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_Thrusters</def>
      <set>
        <liftToWeightAtMaxGross>1.4</liftToWeightAtMaxGross>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockThrustLift</flightProfile>
    <partRoles>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <key>FirstThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <key>SecondThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine3</role>
        <find>
          <li>
            <key>ThirdThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine4</role>
        <find>
          <li>
            <key>FourthThruster</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Mosquito</defName>
    <avionics>
      <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>9</speed>
        <cruiseMetres>600</cruiseMetres>
        <lowCruiseMetres>600</lowCruiseMetres>
        <size>1.0</size>
      </airTrack>
    </avionics>
    <label>light helicopter</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Mosquito</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AeroTurboshaft</def>
      <set>
        <transmissionLimit>0.9</transmissionLimit>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockRotorcraft</flightProfile>
    <partRoles>
      <li>
        <!-- D'thorga Vehicles 0.88.0 (owner, 20 Nov 2026): the servos are actuators, so a destroyed one is replaced with a hydraulic actuator; listed first, so a repair reads it, while the hydraulic roles below still drive the systems. -->
        <role>Actuator</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Servos</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <!-- Framework 0.110.0, avionics A7: the flight controls' hydraulic boost, on the aircraft's own servos. -->
        <role>HydraulicPump</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Servos</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Servos</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <!-- Framework 0.258.0 (the first bindings report): its transmission is the rotor drive's too. -->
            <keyContainsAny>
              <li>RotorMast</li>
              <li>Transmission</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <!--
    The Smuggler and the Warbird (Framework 0.110.0): until now both ran the generic aircraft loadout. They get loadouts of their own for their
    avionics and flight hydraulics (on their Servos part). Both still have the generic loadout's turbofan: a piston engine for an aircraft needs
    its own engine model, set aside (docs/development/vehicle-avionics.md, L5). Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Smuggler</defName>
    <avionics>
      <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>12</speed>
        <cruiseMetres>3000</cruiseMetres>
        <lowCruiseMetres>1500</lowCruiseMetres>
        <size>1.6</size>
      </airTrack>
    </avionics>
    <label>light cargo plane</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Smuggler</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <partRoles>
      <li>
        <!-- D'thorga Vehicles 0.88.0 (owner, 20 Nov 2026): the servos are actuators, so a destroyed one is replaced with a hydraulic actuator; listed first, so a repair reads it, while the hydraulic roles below still drive the systems. -->
        <role>Actuator</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
      <li>
        <!-- Avionics A7: the flight controls' hydraulic boost, on the aircraft's own servos. -->
        <role>HydraulicPump</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Warbird</defName>
    <label>fighter</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Warbird</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <!-- A fighter in the P-51's mould carries a gunsight (agent default). -->
    <avionics>
      <sight>Basic</sight>
          <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>14</speed>
        <cruiseMetres>4500</cruiseMetres>
        <lowCruiseMetres>1500</lowCruiseMetres>
        <size>1.3</size>
      </airTrack>
    </avionics>
    <partRoles>
      <li>
        <!-- D'thorga Vehicles 0.88.0 (owner, 20 Nov 2026): the servos are actuators, so a destroyed one is replaced with a hydraulic actuator; listed first, so a repair reads it, while the hydraulic roles below still drive the systems. -->
        <role>Actuator</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
      <li>
        <!-- Avionics A7: the flight controls' hydraulic boost, on the aircraft's own servos. -->
        <role>HydraulicPump</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
