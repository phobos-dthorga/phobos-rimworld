<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The vehicle systems' generic sounds (docs/development/sound-catalogue.md, S3 to S17). Agent-made with Stable Audio 3 Small SFX,
       taken from the agent's measured shortlist by the owner (10 Nov 2026), and levelled by scripts/art/export_sound.py against the game
       sound each comment names, whose volume each copies; the records beside the sound files say how. The volume extension puts them
       under D'thorga Framework's sounds volume setting. -->

  <!-- S3: a vehicle refuelled. Beside the game's Interact_Repair -3 dB. -->
  <SoundDef>
    <defName>PhobosVehicleSystems_FuelNozzle</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/VehicleSystems/FuelNozzle</clipPath>
          </li>
        </grains>
        <volumeRange>17</volumeRange>
        <distRange>5~25</distRange>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>

