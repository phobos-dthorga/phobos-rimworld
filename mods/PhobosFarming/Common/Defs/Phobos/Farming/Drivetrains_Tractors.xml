      <ratedKilowatts>130</ratedKilowatts>
      <torqueCurve><points><li>(0, 0)</li><li>(0.25, 0.65)</li><li>(0.5, 0.97)</li><li>(0.65, 1)</li><li>(0.85, 0.95)</li><li>(1, 0.86)</li><li>(1.1, 0)</li></points></torqueCurve>
      <indicatedEfficiency>0.40</indicatedEfficiency>
      <turbocharged>true</turbocharged>
    </engine>
    <transmission>
      <kind>Automatic</kind>
      <gears><li>7.0</li><li>5.0</li><li>3.6</li><li>2.6</li><li>1.9</li><li>1.4</li><li>1.15</li><li>1.0</li></gears>
      <finalDrive>17.6</finalDrive>
      <upshiftRpm>1900</upshiftRpm>
      <downshiftRpm>1150</downshiftRpm>
      <efficiency>0.85</efficiency>
    </transmission>
    <running>
      <wheelRadius>0.85</wheelRadius>
      <drivenShare>1</drivenShare>
      <dragArea>4.0</dragArea>
    </running>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>

  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_ThaneT400</defName>
