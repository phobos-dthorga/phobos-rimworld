<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Radios fitted to things that do not wear one (Radio 0.10.0; docs/development/autonomous-vehicles.md, step 2). A vehicle names a
       fitting, and the upgrade that puts it in place, through the Vehicle Framework tie-in's Phobos.Radio.Vehicles.VehicleRadioFitting
       extension; the tie-in gives every vehicle that names one this radio. Its figures are an agent default, all authored, for the
       owner to revise: a mobile data radio of about a car set's power, on VHF, with a whip on the cab roof about 3 m up. -->

  <Phobos.Radio.RadioFittingDef>
    <defName>PhobosRadio_FittingVehicleControl</defName>
    <label>vehicle control radio</label>
    <description>A data radio and a whip antenna on a vehicle's cab, for taking orders from a radio station while nobody drives it.</description>
    <radio>
      <bands>
        <li>PhobosRadio_VHF</li>
      </bands>
      <mode>PhobosRadio_ControlData</mode>
      <channelKind>PhobosRadio_KindVehicleControl</channelKind>
      <transmitPowerWatts>25</transmitPowerWatts>
      <noiseFigureDb>8</noiseFigureDb>
      <antennaGainDbi>0</antennaGainDbi>
      <antennaHeightMetres>3</antennaHeightMetres>
      <!-- Its gentle squelch as the vehicle comes into touch with a station (Radio 0.34.1, S164, the owner's pick of 27 Nov 2026). -->
      <engageSound>PhobosRadio_SquelchVehicle</engageSound>
    </radio>
  </Phobos.Radio.RadioFittingDef>
  <!-- The aviation radio (Radio 0.49.0; docs/development/vehicle-standard.md, VS2 and VS3; the owner's cards of 27 Nov 2026: aircraft
       come with a radio, on the real aviation bands). Every aircraft leaves the factory with one in its aviation radio bay. 10 W by AM on
       the civil air band and military UHF: the AN/ARC-164's 10 W (Wikipedia, BAE Systems' data sheet); civil VHF sets give 10 to 16 W
       (the KY 197A and KY 196A). Its blade antenna's height on the ground is authored. It stands by: its links are worked out and shown on
       the Comms system, and it asks no channel. -->
  <Phobos.Radio.RadioFittingDef>
    <defName>PhobosRadio_FittingAviation</defName>
    <label>aviation radio</label>
    <description>An aircraft's radio for the air band and military UHF, by AM voice, with a blade antenna on the fuselage.</description>
    <radio>
      <bands>
        <li>PhobosRadio_Airband</li>
        <li>PhobosRadio_MilitaryUHF</li>
      </bands>
      <mode>PhobosRadio_VoiceAM</mode>
      <transmitPowerWatts>10</transmitPowerWatts>
      <noiseFigureDb>8</noiseFigureDb>
      <antennaGainDbi>0</antennaGainDbi>
      <antennaHeightMetres>2</antennaHeightMetres>
      <engageSound>PhobosRadio_SquelchVehicle</engageSound>
    </radio>
  </Phobos.Radio.RadioFittingDef>
  <!-- The marine radio (Radio 0.57.0; the owner's answer of 28 Nov 2026, "Add the marine band"). Every boat leaves the factory with one in
       its voice radio bay. 25 W by FM on the marine band: a ship's VHF set is limited to 25 W (secondary: Wikipedia, "Marine VHF radio").
       Marine voice uses 25 kHz channels; our FM mode's 12.5 kHz stands in for them (a labelled simplification). Its whip's height above the
       water is authored. It stands by, as the aviation radio does: its links are worked out and shown on the Comms system, and it asks no
       channel. -->
  <Phobos.Radio.RadioFittingDef>
    <defName>PhobosRadio_FittingMarine</defName>
    <label>marine radio</label>
    <description>A boat's radio for the marine band, by FM voice, with a whip on the cabin roof.</description>
    <radio>
      <bands>
        <li>PhobosRadio_Marine</li>
      </bands>
      <mode>PhobosRadio_VoiceFM</mode>
      <transmitPowerWatts>25</transmitPowerWatts>
      <noiseFigureDb>8</noiseFigureDb>
      <antennaGainDbi>0</antennaGainDbi>
      <antennaHeightMetres>3</antennaHeightMetres>
      <engageSound>PhobosRadio_SquelchVehicle</engageSound>
    </radio>
  </Phobos.Radio.RadioFittingDef>
</Defs>
