<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The Osprey's guns with Combat Extended (D'thorga Vehicles 0.74.0; docs/development/vehicle-osprey.md, "Guns"): each fires
       Combat Extended's ball round by default and reaches as far as Combat Extended's own guns of that calibre do (62 cells
       for 7.62x51 mm, as its minigun; 75 for .50 [A]). Loaded only while Combat Extended is active (LoadFolders.xml). The turrets' own
       Combat Extended figures (speed, sway, spread, recoil) are in their Defs. Their cartridges are Combat Extended's own doing: while its
       ammunition system is on, its vehicle compatibility reads each turret's ammunition set and sets the cartridges, one a round; with
       that system off the guns keep their steel. Until 0.82.0 this file forced cartridges either way (fault-read W1). Not yet tested in
       game. -->

  <!-- The two 7.62x51 mm guns. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleTurretDef[defName="Phobos_Osprey_RampM240" or defName="Phobos_Osprey_BellyGun"]/projectile</xpath>
    <value>
      <projectile>Bullet_762x51mmNATO_FMJ</projectile>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleTurretDef[defName="Phobos_Osprey_RampM240" or defName="Phobos_Osprey_BellyGun"]/maxRange</xpath>
    <value>
      <maxRange>62</maxRange>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleTurretDef[defName="Phobos_Osprey_RampM240" or defName="Phobos_Osprey_BellyGun"]/shotSound</xpath>
    <value>
      <shotSound>MediumMG</shotSound>
    </value>
  </Operation>

  <!-- The .50. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleTurretDef[defName="Phobos_Osprey_RampM2HB"]/projectile</xpath>
    <value>
      <projectile>Bullet_50BMG_FMJ</projectile>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleTurretDef[defName="Phobos_Osprey_RampM2HB"]/maxRange</xpath>
    <value>
      <maxRange>75</maxRange>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleTurretDef[defName="Phobos_Osprey_RampM2HB"]/shotSound</xpath>
    <value>
      <shotSound>HeavyMG</shotSound>
    </value>
  </Operation>
</Patch>
