<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Dubs Rimatomics (Dubwise.Rimatomics, Workshop 1127530465): potassium iodide, 1.7/Defs/Drug/Iodine.xml,
    3 neutroamine and 500 work per unit at the lab. Lab recipe x 4.
    Every figure is a port of the source recipe unless the comment or the README says
    it is authored. Loaded only while the source mod is active (LoadFolders.xml). Not yet tested in game.
  -->

  <PipeSystem.ProcessDef>
    <defName>PhobosFactory_SynthesizePotassiumIodide</defName>
    <label>Synthesize a batch of potassium iodide</label>
    <labelOverride>Synthesize a batch of potassium iodide</labelOverride>
    <description>Synthesize a batch of potassium iodide (Dubs Rimatomics) from neutroamine.</description>
    <priorityInBillList>51</priorityInBillList>
    <spawnOnInteractionCell>true</spawnOnInteractionCell>
    <autoGrabFromHoppers>true</autoGrabFromHoppers>
    <autoInputSlots>
      <li>(-1,0,2)</li>
      <li>(0,0,2)</li>
      <li>(1,0,2)</li>
    </autoInputSlots>
    <ticks>8000</ticks>
    <ingredients>
      <li>
        <thing>Neutroamine</thing>
        <countNeeded>12</countNeeded>
      </li>
    </ingredients>
    <results>
      <li>
        <thing>PotassiumIodide</thing>
        <count>4</count>
      </li>
    </results>
    <researchPrerequisites>
      <li>PenoxycylineProduction</li>
      <li>VFE_ComplexFactories</li>
    </researchPrerequisites>
    <isFactoryProcess>true</isFactoryProcess>
    <autoExtract>true</autoExtract>
    <onlyGrabAndOutputToFactoryHoppers>true</onlyGrabAndOutputToFactoryHoppers>
    <sustainerWhenWorking>true</sustainerWhenWorking>
    <sustainerDef>VFEFactory_AutomatedDrugsSustainer</sustainerDef>
    <effecterWhenWorking>true</effecterWhenWorking>
    <effecterDef>VFEFactory_Cook</effecterDef>
    <maxOutputCount>75</maxOutputCount>
  </PipeSystem.ProcessDef>

</Defs>
