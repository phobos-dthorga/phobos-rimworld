<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The Hind (Hind_Helicopter): two turboshafts, bound by their own parts (EngineStarboard as the first engine, EnginePort as the second),
    with the helicopter flight profile (docs/development/vehicle-turbine-design.md). With one engine out the other carries the load
    on its contingency rating and runs hot; a hover may then be beyond it. Not yet tested in game. Since Framework 0.250.0 its engines are
    the Klimov TV3-117VMA's own ladder (below); before, the Framework's authored helicopter turboshaft.
    Its main gearbox (the VR-24) is appended (Framework 0.12.0). No published limit for it was found (8 Nov 2026), so the drive
    limit, 0.9 of both engines' maximum continuous, is authored.
  -->
  <!--
    The Klimov TV3-117VMA (Framework 0.250.0, per-engine realism round two; the owner's card of 23 Nov 2026). Take-off 2,200 hp, and 2,400 shp
    for 2.5 minutes with one engine out (primary: Motor Sich's product page, read through search excerpts as the page refuses fetching).
    Its maximum continuous was not found: authored at 0.9 of take-off, so take-off is 1.111 and the one-engine-out rating 1.212. Its
    30-minute one-engine-out rating of 2,200 shp equals take-off and is left out (the ladder needs rising steps). The Mi-24V's own TV3-117V
    had no ladder found; the VMA is its later build. Temperature limits, rated speed and the take-off time are the Framework's authored
    helicopter turboshaft's (its turbine inlet temperature is given as 920 to 990 degrees C, rating not named: secondary, Wikipedia).
  -->
  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_TV3117</defName>
    <label>turboshafts</label>
    <engine>
      <kind>Turboshaft</kind>
      <ratedRpm>20000</ratedRpm>
      <kilowattsPerTonne>250</kilowattsPerTonne>
      <idleFuelShare>0.2</idleFuelShare>
      <turbine>
        <idleSpeedPercent>60</idleSpeedPercent>
        <ratings>
          <li><name>maxContinuous</name><label>maximum continuous</label><share>1</share><speedPercent>100</speedPercent><temperatureLimit>775</temperatureLimit></li>
          <li><name>takeoff</name><label>take-off</label><share>1.111</share><speedPercent>102</speedPercent><temperatureLimit>815</temperatureLimit><minutes>5</minutes></li>
          <li><name>contingency</name><label>one engine out</label><share>1.212</share><speedPercent>104</speedPercent><temperatureLimit>850</temperatureLimit><minutes>2.5</minutes><engineOutOnly>true</engineOutOnly></li>
        </ratings>
      </turbine>
    </engine>
    <transmission>
      <kind>None</kind>
    </transmission>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_Hind</defName>
    <label>attack helicopter (twin turboshaft)</label>
    <priority>Vehicle</priority>
    <!-- Framework 0.252.0 (per-engine realism round two): stones and grit thrown into the intakes on rough ground, 0.3 (authored: its intakes carry dust protection devices). A tank each side, each feeding its own engine, with a cross-feed (authored layout). -->
    <intakeDebris>0.3</intakeDebris>
    <sideTanks>true</sideTanks>
    <selector>
      <vehicleDefs>
        <li>Hind_Helicopter</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_TV3117</def>
      <set>
        <transmissionLimit>0.9</transmissionLimit>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_Helicopter</flightProfile>
    <!-- The cruising height between tiles (Framework 0.141.0). Service ceiling 4,500 m for the Mi-24D (secondary: aerospaceweb.org and
         airvectors.net; other sources give 4,900 to 5,750 m by variant). Built to cruise at 1,000 m (authored, as every helicopter of ours). -->
    <cruise>
      <designMetres>1000</designMetres>
      <ceilingMetres>4500</ceilingMetres>
      <lift>Rotor</lift>
    </cruise>
    <!-- Avionics (Framework 0.110.0): the Mi-24's fit as the record gives it (agent defaults; secondary sources): full navigation, an
         autopilot, a full sight, a warning receiver and countermeasures. Its instruments go in an appended avionics bay (owner, 13 Nov 2026). -->
    <avionics>
      <navigation>Full</navigation>
      <autopilot>true</autopilot>
      <sight>Full</sight>
      <warning>true</warning>
      <countermeasures>true</countermeasures>
      <!-- The dispensers' magazine (Framework 0.180.0): 128 cartridges, four ASO-2V dispensers of 32 each. Secondary: weaponsystems.net's
           Mi-24V page gives four to six ASO-2V-02 of 32 each; we take the low end. One of our cartridges stands for one real one. -->
      <countermeasureCartridges>128</countermeasureCartridges>
          <!-- How it looks to another mod's air defence in flight (Framework 0.119.0, AD3): on DMS Expedition's scales, authored. -->
      <airTrack>
        <speed>10</speed>
        <cruiseMetres>1000</cruiseMetres>
        <lowCruiseMetres>1000</lowCruiseMetres>
        <size>2.0</size>
      </airTrack>
    </avionics>
    <!-- Sling loads (owner, 12 Nov 2026: the Hind and the Louie join the Cherokee): the Mi-24's external sling load, 2,400 kg. Approximate,
         from secondary sources (warriorlodge.com, "Russian Mil Mi-24"; militarymachine.com, "Mil Mi-24"), which give the airframe's
         figure; the hook's own rating was not found, and the usable load is the lower of the two. The Hind is a VTOL Vehicle aircraft,
         which flies on the map by itself: the sling takes the load as it sets off and sets it down once it has landed (Framework 0.102.0,
         OnMapFlight). The same sources give 8 troops or 4 stretchers, which the litter kit's four litters match. -->
    <sling>
      <ratedKilograms>2400</ratedKilograms>
    </sling>
    <partRoles>
      <li>
        <!-- The main rotor gearbox: neither mod gives the helicopter one, so it is appended among the engines (owner, 8 Nov 2026:
             rotor drives for every helicopter). -->
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Gearbox</li>
              <li>Transmission</li>
              <li>RotorMast</li>
            </keyContainsAny>
          </li>
        </find>
        <add>
          <key>PhobosMainGearbox</key>
          <label>main rotor gearbox</label>
          <health>40</health>
          <hitWeight>0.3</hitWeight>
          <cellsOf>Engine1</cellsOf>
        </add>
      </li>
      <li>
        <!-- A hook mount under the belly for the cargo hook fitting: appended, so a hook is lost with its mount. Its health and place, with the
             main rotor gearbox, are authored, as on the Cherokee and the Louie. -->
        <role>HookMount</role>
        <add>
          <key>PhobosHookMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>hook mount</label>
          <health>40</health>
          <cellsOf>RotorDrive</cellsOf>
        </add>
      </li>
      <li>
        <!-- The cabin for the litter kit: the Hind has no cabin part of its own, and its troop cabin is in the fuselage (Body), so the kit is
             fitted there. -->
        <role>Cabin</role>
        <find>
          <li>
            <key>Body</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <keyContains>EngineStarboard</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <keyContains>EnginePort</keyContains>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
