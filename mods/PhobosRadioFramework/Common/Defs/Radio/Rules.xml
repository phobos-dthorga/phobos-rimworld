<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The starting values the design says to tune in play. Every figure here is authored unless the
       comment beside it names a source. Player preferences (display mode, metres per cell, the mood
       thought) are mod settings, not rules. -->
  <Phobos.Radio.RadioRulesDef>
    <defName>PhobosRadio_Rules</defName>
    <label>radio rules</label>

    <!-- Margin bands from the design's outcome table. -->
    <marginalDb>0</marginalDb>
    <workableDb>6</workableDb>
    <cleanDb>15</cleanDb>

    <!-- A roof over an antenna. Overhead mountain is near-total, as the design says. -->
    <roofConstructedLossDb>6</roofConstructedLossDb>
    <roofThinNaturalLossDb>20</roofThinNaturalLossDb>
    <roofThickLossDb>60</roofThickLossDb>

    <!-- On the line between two antennas. Rock counts per cell crossed, whatever the antenna height. -->
    <rockLossDb>30</rockLossDb>
    <defaultStuffLossDb>10</defaultStuffLossDb>
    <wallHeightMetres>2.5</wallHeightMetres>

    <!-- Channels (Radio 0.7.0): each 25 kHz wide, as on a trunked radio system (the owner, 24 Nov 2026). A mode takes as many as
         its bandwidth needs, and radios share one by taking turns, as many as the mode's duty cycle allows. -->
    <channelWidthHz>25000</channelWidthHz>
    <!-- The remote control of vehicles (Radio 0.12.0): one colonist working a station drives this many vehicles at once; a station
         takes one operator. Authored, an agent default for the owner to revise. -->
    <vehiclesPerOperator>2</vehiclesPerOperator>

    <noiseRadiusDefaultCells>12</noiseRadiusDefaultCells>
    <!-- A source's noise fades smoothly to nothing over the last third of its radius, so its edge is a glow, not a ring (the
         owner's choice, 23 Nov 2026). An authored simplification: real noise has no radius. 1 keeps the old hard edge. -->
    <noiseFadeStartFraction>0.67</noiseFadeStartFraction>
    <!-- Radio 0.45.0 (docs/development/electronic-warfare.md, EW1): a link is said to be jammed when jamming raises its receiver's floor by
         more than this over what it hears anyway; the same 6 dB the plain reason uses for local noise. Authored. Jamming itself has no
         radius here: a jammer's noise falls off by free space across the whole map. -->
    <jammingRaisesFloorDb>6</jammingRaisesFloorDb>
    <!-- Radio 0.46.0 (EW18): a call sent off the map by another mod's building (The Dead Man's Switch's uplinks) is a data link on VHF
         whose reply arrives at -90 dBm, heard through a 0 dBi antenna and an 8 dB noise figure. Jamming at the building that drowns the
         reply stops the call. All authored. -->
    <callOutBand>PhobosRadio_VHF</callOutBand>
    <callOutMode>PhobosRadio_ControlData</callOutMode>
    <callOutReplyDbm>-90</callOutReplyDbm>
    <callOutNoiseFigureDb>8</callOutNoiseFigureDb>
    <!-- The radio jamming pod for any aircraft (Radio 0.75.0; docs/development/electronic-warfare.md, EW10), all authored: 150 W sent out
         over 30 to 512 MHz (low military VHF, the air band, 2 m, military UHF and 70 cm; never HF, whose wavelengths a pod's aerial is far
         too short for), its place over a map rounded to an 8-cell grid. Jammers in flight over the world map are read again every 250 ticks
         (EW3). -->
    <jamPodRadiatedWatts>150</jamPodRadiatedWatts>
    <jamPodMHz>
      <li>30~512</li>
    </jamPodMHz>
    <jamPodGridCells>8</jamPodGridCells>
    <worldJammerRefreshTicks>250</worldJammerRefreshTicks>

    <!-- The coverage overlay shown while a base station or an antenna is selected. Performance is this mod's first concern, so
         these bound its cost: real time per frame, the quick first pass's block size. All authored; measure and tune. -->
    <coverageFullScaleDb>130</coverageFullScaleDb>
    <coverageBudgetMsPerFrame>1.5</coverageBudgetMsPerFrame>
    <!-- Calling other factions by radio (Radio 0.53.0; docs/development/radio-comms-console.md): the owner chose the benefits and downsides
         by card; every figure is authored, an agent default. A clean line's goodwill against the console's 15 and 25; one request in four
         misheard on a marginal line (the owner's card); a check-in's goodwill, days apart, and the goodwill it stops at; each hostile
         listener's chance to ambush a requested trader, and the share of ambushes it is lost in; an ally's raid warning, in hours; the
         factor on a walking caravan's pace for the ground. -->
    <radioTraderGoodwillClean>10</radioTraderGoodwillClean>
    <radioAidGoodwillClean>20</radioAidGoodwillClean>
    <!-- Radio 0.54.0: an allied supply drop over a clean line, against the console's 15 (authored). -->
    <radioSupplyGoodwillClean>10</radioSupplyGoodwillClean>
    <radioMishearChance>0.25</radioMishearChance>
    <radioCheckInGoodwill>2</radioCheckInGoodwill>
    <radioCheckInDays>5</radioCheckInDays>
    <radioCheckInGoodwillCap>75</radioCheckInGoodwillCap>
    <radioCheckInSocialXp>200</radioCheckInSocialXp>
    <radioListenerAmbushChance>0.25</radioListenerAmbushChance>
    <radioAmbushLostShare>0.5</radioAmbushLostShare>
    <radioRaidWarningHours>3</radioRaidWarningHours>
    <radioTraderTravelFactor>1.5</radioTraderTravelFactor>
    <!-- Radio 0.44.1: the last picture shown finishes its pass after it is deselected, at this smaller budget a frame. -->
    <coverageBackgroundBudgetMsPerFrame>0.5</coverageBackgroundBudgetMsPerFrame>
    <coverageCoarseBlockCells>4</coverageCoarseBlockCells>
    <coverageOpacity>0.45</coverageOpacity>
    <!-- Keeping to radio cover (Radio 0.14.0; autonomous-vehicles.md, step 8): where a vehicle's control radio keeps its link, one sample per
         block of the overlay's quick pass, worked out only while a vehicle on the map is asked to be driven from afar (and for this many
         ticks after), at most this much real time a tick, and looked at again for changes this often. All authored; measure and tune. -->
    <remoteCoverBudgetMsPerTick>0.5</remoteCoverBudgetMsPerTick>
    <remoteCoverWantedTicks>1000</remoteCoverWantedTicks>
    <remoteCoverLookTicks>250</remoteCoverLookTicks>
    <recomputeIntervalTicks>60</recomputeIntervalTicks>
    <!-- Advice by radio (Radio 0.23.0). The shares of the skill gap closed are the owner's card of 26 Nov 2026 ("Half": a half on a workable
         or clean link, a quarter on a marginal one); the work speed while talked through and the intervals are agent defaults, authored. -->
    <adviceShareSolid>0.5</adviceShareSolid>
    <adviceShareMarginal>0.25</adviceShareMarginal>
    <adviceWorkSpeedFactor>0.77</adviceWorkSpeedFactor>
    <adviceLookTicks>60</adviceLookTicks>
    <adviceRetryTicks>250</adviceRetryTicks>
    <adviceOfferKeepTicks>250</adviceOfferKeepTicks>
    <!-- The Elmer and another faction's doctor (Radio 0.26.0). The owner's cards of 27 Nov 2026: half again faster learning while talked
         through, a little Social for the adviser, allies free once a day, neutral factions for goodwill. The Social rate, the doctors'
         Medicine, the goodwill cost and floor, the call window and the search's reach and keeping are agent defaults, authored. -->
    <adviceLearnFactor>1.5</adviceLearnFactor>
    <adviceTeachSocialPerTick>0.05</adviceTeachSocialPerTick>
    <factionDoctorIndustrial>10</factionDoctorIndustrial>
    <factionDoctorSpacer>14</factionDoctorSpacer>
    <factionDoctorUltra>16</factionDoctorUltra>
    <factionAllyEveryTicks>60000</factionAllyEveryTicks>
    <factionNeutralGoodwillCost>3</factionNeutralGoodwillCost>
    <factionGoodwillFloor>0</factionGoodwillFloor>
    <factionCallWindowTicks>2500</factionCallWindowTicks>
    <factionReachKeepTicks>2500</factionReachKeepTicks>
    <factionSearchTiles>100</factionSearchTiles>
    <!-- A radio friend (Radio 0.29.0; the owner's card of 27 Nov 2026: mood, and a little goodwill). All agent defaults, authored. -->
    <friendHours>10</friendHours>
    <friendCloseHours>30</friendCloseHours>
    <friendGoodwill>1</friendGoodwill>
    <friendGoodwillChatTicks>2500</friendGoodwillChatTicks>
    <friendGoodwillPerQuadrum>3</friendGoodwillPerQuadrum>
    <!-- School of the Air (Radio 0.31.0): a lesson by radio at three quarters of the game's lesson rate. An agent default, authored. -->
    <schoolLessonFactor>0.75</schoolLessonFactor>
    <!-- Radio 0.56.0 (the owner's answer of 28 Nov 2026, "The full lesson rate"): a teacher beside the child at the desk teaches at the game's own
         lesson rate, face to face. -->
    <schoolInPersonFactor>1</schoolInPersonFactor>
    <!-- Neighbours ask for yours (Radio 0.32.0). The goodwill is the owner's card of 27 Nov 2026; the rest are agent defaults, authored:
         about once a fortnight, a colonist with Medicine or Construction 6 or more, an hour on the radio, a request that waits 6 hours. -->
    <neighbourMtbDays>15</neighbourMtbDays>
    <neighbourMinSkill>6</neighbourMinSkill>
    <neighbourGoodwill>5</neighbourGoodwill>
    <neighbourCallTicks>2500</neighbourCallTicks>
    <neighbourExpiryTicks>15000</neighbourExpiryTicks>
    <neighbourSkillXpPerTick>0.025</neighbourSkillXpPerTick>
    <!-- Life on the air (Radio 0.63.0; docs/development/radio-life-on-the-air.md, slice 1). "Lone workers chat often" is the owner's card
         of 28 Nov 2026; every figure is an agent default, authored: a look every tenth of an hour at eight colonists of a map; a lone worker
         chats about every three hours, one with others near every twelve; calls home in the evening, 19:00 to 21:00; company on the radio
         at night, 22:00 to 06:00, once a night each. -->
    <talkLookTicks>250</talkLookTicks>
    <talkPeoplePerLook>8</talkPeoplePerLook>
    <talkChatGapLoneHours>3</talkChatGapLoneHours>
    <talkChatGapHours>12</talkChatGapHours>
    <talkLoneCells>12</talkLoneCells>
    <talkMinCells>15</talkMinCells>
    <talkFloorOpinion>-20</talkFloorOpinion>
    <talkFriendOpinion>20</talkFriendOpinion>
    <talkChatJoy>0.02</talkChatJoy>
    <talkChatTicks>300</talkChatTicks>
    <talkEveningCallTicks>1250</talkEveningCallTicks>
    <talkCompanyTicks>2500</talkCompanyTicks>
    <talkTurnTicks>60</talkTurnTicks>
    <talkEveningFrom>19</talkEveningFrom>
    <talkEveningTo>21</talkEveningTo>
    <talkNightFrom>22</talkNightFrom>
    <talkNightTo>6</talkNightTo>
    <talkCompanyGapTicks>30000</talkCompanyGapTicks>

    <!-- The vanilla heater turns 175 W into 21 heat per second (Core, Buildings_Temperature.xml). -->
    <heatPerWattSecond>0.12</heatPerWattSecond>

    <!-- Radar (Radio 0.74.0; docs/development/radar-and-air-defence.md, slices 1 and 2). Authored unless a source is named. A world tile is
         30 km for radar (the owner's card of 28 Nov 2026). The approach speed is tuned so an air-search radar warns of a ten-pod drop about
         an hour and a half ahead (the owner's card: "by the sum, at play speed"); a long-range radar's warning stops at four hours. An
         unknown raid is identified 60 % of the way through its warning with nobody on watch, 4 % sooner a skill level, 15 % at the soonest. -->
    <radarMetresPerWorldTile>30000</radarMetresPerWorldTile>
    <radarLookTicks>30</radarLookTicks>
    <radarDropPodSquareMetres>2</radarDropPodSquareMetres>
    <radarPersonSquareMetres>1</radarPersonSquareMetres>
    <radarAircraftSquareMetresPerBodySize>2</radarAircraftSquareMetresPerBodySize>
    <radarDropCarrierMetres>5000</radarDropCarrierMetres>
    <radarAirRaidMetres>300</radarAirRaidMetres>
    <radarApproachKmPerGameHour>45</radarApproachKmPerGameHour>
    <radarMinimumWarningHours>0.25</radarMinimumWarningHours>
    <radarMaximumWarningHours>4</radarMaximumWarningHours>
    <radarPointsPerRaider>90</radarPointsPerRaider>
    <radarCountBlur>0.3</radarCountBlur>
    <radarIdentifyShareUnmanned>0.6</radarIdentifyShareUnmanned>
    <radarIdentifySharePerSkill>0.04</radarIdentifySharePerSkill>
    <radarIdentifyShareBest>0.15</radarIdentifyShareBest>
    <radarIdentifyBaseTicks>2500</radarIdentifyBaseTicks>
    <radarPlotExtractorSkill>8</radarPlotExtractorSkill>
    <radarWatchKeepTicks>2500</radarWatchKeepTicks>
    <radarDataLinkKeepTicks>2500</radarDataLinkKeepTicks>
  </Phobos.Radio.RadioRulesDef>
</Defs>
