<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Add the bills in this folder to VFEFactory_MedicineGranulator. Loaded only while the source mod is active. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEFactory_MedicineGranulator"]/comps/li[@Class="PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
    <value>
      <li>PhobosFactory_SynthesizeAniracetam</li>
      <li>PhobosFactory_SynthesizeAntiTox</li>
      <li>PhobosFactory_SynthesizeClozapine</li>
      <li>PhobosFactory_SynthesizeCyanide</li>
      <li>PhobosFactory_SynthesizeHeroin</li>
      <li>PhobosFactory_SynthesizeHydra</li>
      <li>PhobosFactory_SynthesizeJoy</li>
      <li>PhobosFactory_SynthesizeAddictol</li>
      <li>PhobosFactory_SynthesizeMorphine</li>
      <li>PhobosFactory_SynthesizePenicillin</li>
      <li>PhobosFactory_SynthesizePenicillinFromFungus</li>
      <li>PhobosFactory_SynthesizeSmellingSalts</li>
      <li>PhobosFactory_SynthesizeThornWeedSerum</li>
      <li>PhobosFactory_SynthesizeTyrox</li>
      <li>PhobosFactory_SynthesizeUpper</li>
      <li MayRequire="ODs.DeepPills">PhobosFactory_InfusePeyote</li>
      <li MayRequire="ODs.DeepPills">PhobosFactory_InfuseOpium</li>
      <li MayRequire="ODs.DeepPills">PhobosFactory_InfuseThornWeed</li>
    </value>
  </Operation>

</Patch>
