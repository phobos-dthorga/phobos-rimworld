      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(0, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
        <li>Phobos_GeneratorOutput</li>
      </categories>
    </li>
    <li>
      <key>Radiator</key>
      <label>radiator</label>
      <health>30</health>
      <depth>Internal</depth>
