    <costList>
      <Steel>110</Steel>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
  </Vehicles.VehicleBuildDef>

  <Vehicles.VehicleBuildDef ParentName="PhobosFarming_ImplementBuildBase">
    <defName>Phobos_PloughSillion_Blueprint</defName>
    <label>Sillion turnover plough</label>
    <description>Sillion S3: a three-furrow reversible plough for a tractor's three-point linkage.</description>
    <graphicData>
      <texPath>Phobos/Farming/Plough/Plough</texPath>
    </graphicData>
    <thingToSpawn>Phobos_PloughSillion</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <Vehicles.VehicleBuildDef ParentName="PhobosFarming_ImplementBuildBase">
    <defName>Phobos_CultivatorTillman_Blueprint</defName>
    <label>Tillman cultivator</label>
    <description>Tillman C4: a four-cell field cultivator for a tractor's three-point linkage.</description>
    <graphicData>
      <texPath>Phobos/Farming/Cultivator/Cultivator</texPath>
    </graphicData>
    <thingToSpawn>Phobos_CultivatorTillman</thingToSpawn>
    <designatorDropdown>PhobosFarming_TillmanModels</designatorDropdown>
