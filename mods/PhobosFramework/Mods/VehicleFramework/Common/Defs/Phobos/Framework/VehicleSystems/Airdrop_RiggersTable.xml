      <Phobos_GuidedCargoParachute>1</Phobos_GuidedCargoParachute>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- Framework 0.293.0: a spent cargo parachute repacked as a guided one, with a new guidance unit (2 components) and 10 fabric, 3,500
       work (authored). -->
  <RecipeDef ParentName="PhobosRiggerRecipeBase">
    <defName>Phobos_RepackGuidedCargoParachute</defName>
    <label>repack as guided cargo parachute</label>
    <description>Lay out a spent cargo parachute, renew its ties and padding, fit a guidance unit and pack it again.</description>
    <jobString>Repacking a guided cargo parachute.</jobString>
    <workAmount>3500</workAmount>
    <researchPrerequisite>MicroelectronicsBasics</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Phobos_SpentCargoParachute</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
            <li>Synthread</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
