<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Vehicle Patches' assembly. It lives in the Harrier's load folder (Mods/HarrierVtol/<version>), so it loads only
       while the Harrier is active, and the Harrier requires Vehicle Framework. Built for RimWorld 1.7 (net10.0, Harmony 3)
       and 1.6 (net472, Harmony 2); Directory.Build.targets turns the target into the game version, the output folder, the
       references and the Vehicle Framework folder (1.6 only: it ships no 1.7 build yet). -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Phobos.VehiclePatches</RootNamespace>
    <AssemblyName>PhobosVehiclePatches</AssemblyName>
    <ModFolder>PhobosVehiclePatches</ModFolder>
    <TieInFolder>Mods/HarrierVtol/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.5.0</Version>
    <!-- Vehicle Framework targets .NET Framework 4.8 and our 1.6 build 4.7.2. The game loads both whatever they declare, so
         the mismatch only matters to the compiler's reference check. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <!-- Vehicle Framework's assemblies (MIT), referenced from the installed mod and never copied. -->
    <Reference Include="Vehicles">
      <HintPath>$(VehicleFrameworkAssemblies)\Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VehicleFrameworkAssemblies)\SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UpdateLogTool">
      <HintPath>$(VehicleFrameworkAssemblies)\UpdateLogTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
