          <li>(2, 1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>Transmission</key>
      <label>transmission</label>
      <health>70</health>
      <depth>Internal</depth>
