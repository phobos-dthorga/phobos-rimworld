<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Radio Framework's assembly, built for RimWorld 1.7 (net10.0) and 1.6 (net472); Directory.Build.targets turns
       the target into the game version, the output folder, the game reference and the Vanilla Expanded Framework folder
       (VefAssemblies, one per game version). Shared options come from Directory.Build.props at the repository root. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Phobos.Radio</RootNamespace>
    <AssemblyName>PhobosRadio</AssemblyName>
    <ModFolder>PhobosRadioFramework</ModFolder>
    <Version>0.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Vanilla Expanded Framework's PipeSystem.dll, referenced from the installed mod and never copied: its licence
         (CC BY-NC-ND 4.0) permits depending on it, not redistributing it. -->
    <Reference Include="PipeSystem">
      <HintPath>$(VefAssemblies)\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
