<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The starting values the design says to tune in play. One Def; the first loaded wins. Every figure is authored unless
       the comment beside it names a source. Player preferences (the toggles, the care level, the display mode) are settings. -->
  <Phobos.Dosing.Defs.PhobosDosingRulesDef>
    <defName>PhobosDosing_Rules</defName>
    <label>dosing rules</label>

    <!-- How often the list of patients who need a dose is rebuilt per map, when a doctor asks. -->
    <recomputeIntervalTicks>250</recomputeIntervalTicks>

    <!-- The game labels pain severe from 0.4 and extreme from 0.8 (HealthCardUtility.GetPainLabel). 0.4, where severe starts and where
         a pawn on their feet looks for relief, is the owner's choice (7 Nov 2026; it was 0.6, which left 40 to 60% untreated in bed). -->
    <painThreshold>0.4</painThreshold>
    <sedationPainThreshold>0.8</sedationPainThreshold>

    <!-- A painkiller waits while the patient bleeds this fast or faster: 0.3 is 30% a day on the health tab. Authored. -->
    <bleedHoldRate>0.3</bleedHoldRate>

    <!-- Doctors' drugs for fighting disease: the least they must add to immunity gain speed, and how many days of margin make a disease
         count as winning the race against immunity. The gain is authored; two days of margin is the owner's choice (7 Nov 2026; it was
         one, and a patient was lost by under one point of immunity). -->
    <minImmunityGain>0.1</minImmunityGain>
    <immunityRaceMarginDays>2</immunityRaceMarginDays>

    <!-- Self-medication: the pain from which a pawn who is up and about looks for a painkiller (the owner's choice), and how much
         lower that is with chemical interest and chemical fascination (authored). Teetotalers never do. -->
    <selfPainThreshold>0.4</selfPainThreshold>
    <selfInterestOffset>0.1</selfInterestOffset>
    <selfFascinationOffset>0.2</selfFascinationOffset>
    <!-- Consciousness and breathing must stay at or above this after a dose taken on one's own feet: the game drops a pawn below 0.3
         consciousness (PawnCapacitiesHandler.CanBeAwake). The margin is authored. -->
    <selfCapacityFloor>0.4</selfCapacityFloor>

    <!-- An item must take away at least this share of the pain to count as a painkiller at all. It keeps out drugs whose relief is
         a side effect (an adrenaline shot, a beer). Authored. -->
    <minPainRelief>0.3</minPainRelief>

    <!-- Safety: no new dose while the last is still at a quarter of a dose; none during an overdose of 0.3 or more; a dose's
         offsets must leave consciousness and breathing at 0.15 or more (the game kills at zero). -->
    <redoseBelowFraction>0.25</redoseBelowFraction>
    <overdoseLimit>0.3</overdoseLimit>
    <capacityFloor>0.15</capacityFloor>

    <!-- What makes a dose a sedative: a consciousness ceiling at or below 0.1. An offset is a cost, never a sedation. -->
    <sedativeConsciousnessCeiling>0.1</sedativeConsciousnessCeiling>

    <!-- How much each side effect counts against relief when choosing between items, and the share of the bleed weight that
         counts while the patient is not bleeding. -->
    <consciousnessWeight>0.5</consciousnessWeight>
    <breathingWeight>0.5</breathingWeight>
    <bleedWeight>1</bleedWeight>
    <bleedWeightWhenNotBleeding>0.25</bleedWeightWhenNotBleeding>
    <addictionWeight>0.5</addictionWeight>
    <!-- Fussing (D'thorga Medical 0.7.0): an awake patient in extreme pain (from 0.8, the game's label) is tended 10% worse, falling to 25%
         worse at full pain (authored). Pain relief keeps patients below it. -->
    <fussingPainThreshold>0.8</fussingPainThreshold>
    <fussingFactorAtThreshold>0.9</fussingFactorAtThreshold>
    <fussingFactorAtFullPain>0.75</fussingFactorAtFullPain>

    <!-- Care needs (D'thorga Medical 0.28.0). What one vomit a day counts against a cure or a preventive: four a day cancel the
         whole benefit, which keeps an emetic off both lists (authored). -->
    <vomitWeight>0.25</vomitWeight>
    <!-- A breathing rescue (D'thorga Medical 0.29.0): breathing at or under 0.3, where triage calls a vital capacity immediate (the
         owner's choice, 26 Nov 2026), and an item that adds at least 0.1 to breathing after anything it costs (authored). The mark
         from which a medicine is rare is a setting since 0.29.0, 300 silver by default. -->
    <breathingRescueLevel>0.3</breathingRescueLevel>
    <minBreathingGain>0.1</minBreathingGain>
    <!-- Protection while exposed (D'thorga Medical 0.30.0), all authored: toxic exposure counts as under way from a toxic buildup of
         0.04, where the game's first stage begins; an item must keep out a quarter of the buildup, or add a quarter to vacuum resistance,
         to count as protection. -->
    <toxicExposureFrom>0.04</toxicExposureFrom>
    <minToxicCut>0.25</minToxicCut>
    <minVacuumGain>0.25</minVacuumGain>
    <!-- The long-term needs (D'thorga Medical 0.31.0). An item must lower the mental break threshold by 0.03 or more to count as steadying
         someone (authored; Medicines+' clozapine lowers it 0.05 at a dose). -->
    <minBreakThresholdDrop>0.03</minBreakThresholdDrop>
    <!-- Conditions that ease an addiction, by their class or a comp's class, read from the mods' code on 26 Nov 2026: Medicines+'
         addictol takes an addiction down 0.005 an hour while it lasts (its Hediff_Addictol); Ushanka's Glittertech Expansion's addiction
         remover removes every addiction but luciferium when it is taken (its HediffCompProperties_AddictionRemoval). A class no loaded mod
         has is skipped. -->
    <addictionTreatments>
      <li>AT_MedicinesPlus.Hediff_Addictol</li>
      <li>USH_GE.HediffCompProperties_AddictionRemoval</li>
    </addictionTreatments>
    <!-- Comps that regrow missing body parts: The Dead Man's Switch's combat regeneration serum. -->
    <regrowthClasses>
      <li>DMS.HediffCompProperties_RegrowMissingParts</li>
    </regrowthClasses>
    <!-- The Dead Man's Switch's biogel, which its bionics draw on (its Synthriada part, DMSSR, read 26 Nov 2026): 100 units at most, Neuroglue adds 25. -->
    <reservoirs>
      <li>
        <hediffClass>DMSSR.Hediffs.Hediff_BiogelReservoir</hediffClass>
        <levelMember>Fuel</levelMember>
        <capacity>100</capacity>
        <refillDoerClass>DMSSR.Hediffs.IngestionOutcomeDoer_RefillBiogel</refillDoerClass>
        <amountField>amount</amountField>
      </li>
    </reservoirs>
    <!-- Prevention is for someone whose chance of catching the disease is at least half what an unprotected person's is: the game's
         own chance factor, which falls as immunity left over from an earlier bout rises (authored). -->
    <preventionMinRisk>0.5</preventionMinRisk>
    <!-- Conditions that count as an outbreak besides those found by what they are (a disease one of the game's events brings to a
         group, or one that spreads between people). Empty: a mod whose disease arrives another way adds its own with a patch. -->
    <outbreakDiseases />
    <!-- How to read "this item removes these conditions" from another mod's own outcome class: its full name and the field that
         holds them. A class no loaded mod has is skipped, so a reader needs no MayRequire. Ushanka's Biological Warfare's antiserums
         keep theirs in hediffDefsToRemove (its public source, read 26 Nov 2026). -->
    <removalReaders>
      <li>
        <doerClass>USH_BW.IngestionOutcomeDoerRemoveHediffs</doerClass>
        <field>hediffDefsToRemove</field>
      </li>
    </removalReaders>
    <!-- How to read "this item gives this condition" from another mod's own class (D'thorga Medical 0.32.0), read from their public
         source on 27 Nov 2026. Vanilla Races Expanded - Genie gives its antibiotics' condition, and their tolerance, through two outcome
         classes of its own; the stronger conditions it gives people with weak-immunity genes are not read, so the index reads the
         ordinary dose. Vanilla Factions Expanded - Medieval 2's draughts are swallowed and work through use effects: its own comp gives a
         condition at a severity, takes some away when the figure is negative (the antitox draught clears toxic buildup), and gives
         nothing to someone without the gene it names. The game's own use-effect comp needs no reader. A class no loaded mod has is
         skipped. -->
    <givenConditionReaders>
      <li>
        <className>VanillaRacesExpandedGenies.IngestionOutcomeDoer_GiveHediff_Discriminating</className>
        <severityField>severity</severityField>
      </li>
      <li>
        <className>VanillaRacesExpandedGenies.IngestionOutcomeDoer_GiveHediff_Weighted</className>
        <severityField>severity</severityField>
      </li>
      <li>
        <className>VFEMedieval.CompProperties_UseEffectAddHediffWithSeverity</className>
        <severityField>severity</severityField>
        <negativeTakesAway>true</negativeTakesAway>
        <skipWhenSetField>neededGene</skipWhenSetField>
      </li>
    </givenConditionReaders>
  </Phobos.Dosing.Defs.PhobosDosingRulesDef>
</Defs>
