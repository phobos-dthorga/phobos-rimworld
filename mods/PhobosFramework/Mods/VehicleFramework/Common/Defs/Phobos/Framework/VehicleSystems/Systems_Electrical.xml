<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The electrical system: a lead-acid starting battery, charged by the alternator while the engine runs and drained by the loads
    the alternator cannot cover and by each start. Design: docs/development/vehicle-systems-design.md. Not yet tested in game.

    Sources and labels (every figure below is one of these):
    - A typical car battery is 12 V and about 40 to 45 Ah; heavy vehicles put two in series for 24 V. Secondary: Wikipedia,
      "Automotive battery".
    - A battery gives about 80 % of its capacity at 0 degrees C and about 50 % at -18 degrees C against 27 degrees C. Secondary:
      Battery University BU-502; Midtronics. The curve between and beyond those points is our interpolation (authored).
    - A discharged lead-acid battery can freeze and crack. Secondary: Battery University BU-502. The thresholds are authored.
    - Light vehicles' alternators give about 50 to 70 A. Secondary: Wikipedia, "Alternator (automotive)".
    - An alternator gives nothing below its cut-in speed and its full output only well above idle; it turns about 2.5 to 3 times
      engine speed through its pulley (secondary: the drivetrain record's sources, docs/development/vehicle-drivetrain-design.md).
      The output curve on rotor speed (nothing below 1,200 rpm, half at 1,800, 70% at 2,400, full from 6,000) is shaped from
      those sources and authored; an idling engine gives roughly half, so lights left on at idle slowly drain the battery. Since
      Framework 0.130.0 the curve lives once in the rules Def (alternatorOutput, Rules_VehicleSystems.xml), with the pulley ratio on
      each engine's Def (alternatorRatio).
    - A start of about 150 A for about 6 s is 0.25 Ah (our inference from typical starter currents; authored); a cold start draws
      more (authored factor).
    - The charging taper (a full battery accepts little) and the self-discharge are authored.
    Charge is a fraction of the battery's capacity, so every flow below is amperes divided by ampere-hours: a fraction per hour.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef Name="PhobosVehicleSystemElectricalBase">
    <defName>PhobosVehicleSystem_Electrical</defName>
    <label>electrical system</label>
    <description>The starting battery, the alternator that charges it while the engine runs, and the lights and heater it powers. A flat battery cannot start the engine; a cold one has less to give.</description>
    <roles>
      <li>Battery</li>
      <li>Alternator</li>
      <li>Starter</li>
    </roles>
    <parameters>
      <batteryAmpHours>45</batteryAmpHours>
      <alternatorAmps>65</alternatorAmps>
      <starterAmpHours>0.25</starterAmpHours>
      <shoreChargeAmps>10</shoreChargeAmps>
      <!-- The system's voltage, so a load's amperes become watts (crosslink 5, Framework 0.70.0: the alternator takes about 1.6 shaft
           watts for each watt the loads draw; AccessoryRules). 12 here; heavy vehicles set 24, the voltage their loads' amperes were
           authored for (Loadouts_Default.xml). -->
      <systemVolts>12</systemVolts>
      <!-- Framework 0.123.0, the cold-weather fittings (cross-links round two T8 and F4): 1 until a battery warmer is fitted, whose fitting makes
           it 0 (the block heater's pattern); and how well the starter turns a cold engine on what the battery gives, which a gear-reduction
           starter raises to 1.3 (authored). -->
      <batteryWarmerAbsent>1</batteryWarmerAbsent>
      <starterAssist>1</starterAssist>
    </parameters>
    <quantities>
      <li>
        <name>charge</name>
        <description>What the battery holds. It fills while the engine runs and the belt turns; lights, heaters and starting drain it, and it slowly drains by itself.</description>
        <telltale>Phobos/VehicleSystems/Dash/Battery</telltale>
        <showOnDashboard>true</showOnDashboard>
        <label>battery</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.3</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgBatteryLow</message>
              </li>
            </effects>
          </li>
          <li>
            <from>0.3</from>
            <label>charged</label>
          </li>
        </stages>
      </li>
      <li>
        <!-- What the battery can give a starter now: its charge times its capacity at this temperature. -->
        <name>startingPower</name>
        <description>What the battery can give the starter now. Too little, and the engine will not start.</description>
        <telltale>Phobos/VehicleSystems/Dash/Battery</telltale>
        <label>starting power</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Parameter">
            <!-- Framework 0.123.0 (F4): a gear-reduction starter turns the engine on less of the battery. -->
            <parameter>starterAssist</parameter>
          </li>
          <li Class="Phobos.VehicleSystems.Input_BatteryTemperature">
            <!-- The battery's own temperature since Framework 0.123.0 (T8): the air's, or warmed by a battery warmer on shore power. -->
            <curve>
              <points>
                <li>(-40, 0.3)</li>
                <li>(-18, 0.5)</li>
                <li>(0, 0.8)</li>
                <li>(27, 1)</li>
                <li>(60, 1)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <!-- Crosslink 7 (Framework 0.70.0): cold oil is thick, so the starter needs more of the battery to turn the engine; to the
                 player that is less starting power (0.6 at -20 degrees C oil, full from 10; authored, the same sources as the cold
                 start's draw). A night or block heater keeps the oil warm. A vehicle without oil reads as warm. -->
            <quantity>oilTemperature</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant"><value>100</value></fallback>
            <curve>
              <points>
                <li>(-20, 0.6)</li>
                <li>(10, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.1</to>
            <label>too weak to start</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseFlatBattery</reason>
                <sound>PhobosVehicleSystems_FlatBattery</sound>
              </li>
            </effects>
          </li>
          <li>
            <!-- Framework 0.104.0 (owner, 12 Nov 2026: a warning before a vehicle is stranded): twice the no-start line. Starting power is the
                 charge times the battery's cold factor times the cold-oil factor, so at -18 degrees C with cold oil an engine fails near 33%
                 charge (the owner's figure) while in mild weather 30% still starts: a warning on starting power, not on charge, always comes
                 before being stranded. The 30% charge message stays. The threshold is authored. -->
            <from>0.1</from>
            <to>0.2</to>
            <label>barely enough to start</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgStartingPowerLow</message>
                <!-- Framework 0.137.3: not on a turbine, which cannot light below 0.25 and so is already stranded here; its own warning is
                     the turbine-start stage's (Systems_Turbine.xml). -->
                <!-- Framework 0.383.1 (the owner's card of 28 Nov 2026, "Warn only on the way down"): and not when a flat battery warms
                     back up into this stage. -->
                <when Class="Phobos.VehicleSystems.When_All">
                  <conditions>
                    <li Class="Phobos.VehicleSystems.When_HasQuantity">
                      <quantity>turbineStart</quantity>
                      <invert>true</invert>
                    </li>
                    <li Class="Phobos.VehicleSystems.When_Falling" />
                  </conditions>
                </when>
              </li>
            </effects>
          </li>
          <li>
            <from>0.2</from>
            <label>enough to start</label>
          </li>
        </stages>
      </li>
      <li>
        <name>starter</name>
        <description>The state of the starter motor. Broken, the engine cannot be started with the key.</description>
        <telltale>Phobos/VehicleSystems/Dash/Starter</telltale>
        <label>starter motor</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Starter</role>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.2</to>
            <label>broken</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseStarter</reason>
                <sound>PhobosVehicleSystems_FlatBattery</sound>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- A discharged battery in deep cold: 1 when it is empty below -40 degrees C, 0 above -10 degrees C or above 40 % charge. -->
        <name>frost</name>
        <description>How cold-soaked the battery is. A frozen battery gives the starter little.</description>
        <telltale>Phobos/VehicleSystems/Dash/Frost</telltale>
        <label>battery frost</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_BatteryTemperature">
            <!-- Framework 0.123.0 (T8): a battery warmer on shore power keeps it from freezing. -->
            <curve>
              <points>
                <li>(-40, 1)</li>
                <li>(-10, 0)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.4, 0)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <from>0.05</from>
            <label>freezing</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Battery</role>
                <perHour>2</perHour>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgBatteryFreezing</message>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- G16 and avionics A6 (Framework 0.106.0): the electrics are shedding loads to save the battery (ElectricsRule.ShedDepth), so
             the Dashboard shows a lamp. The loads, their order and the battery clock are on the inspect line. -->
        <name>loadShedding</name>
        <description>Whether the electrics are switching loads off to save the battery, because the charging has failed or cannot keep up.</description>
        <telltale>Phobos/VehicleSystems/Dash/Battery</telltale>
        <label>saving the battery</label>
        <unit>OnOff</unit>
        <min>0</min>
        <max>1</max>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_LoadShedding" />
        </derivedFrom>
        <stages>
          <li>
            <from>0.5</from>
            <label>saving the battery</label>
            <notable>true</notable>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <!-- What the alternator gives beyond the loads, less as the battery fills (authored taper). -->
        <name>charging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Surplus</side>
            <!-- Framework 0.73.0: the drive belt turns the alternator; a slipping or snapped one charges little or nothing. -->
            <drivenByRole>Belt</drivenByRole>
            <!-- Framework 0.106.0 (avionics A5): a piston engine's alternator follows its rotor speed as before; a turbine's generator
                 follows the spool speed instead (about half at ground idle, full from cruise, authored), shared among the engines still
                 working. Before, a turbine's spool read through the piston curve as an rpm far past its top: full output at idle. -->
            <!-- Framework 0.130.0 (step S5): the rules Def's one alternator curve on its own speed (the engine's times its alternator
                 ratio), or a turbine's spool curve; it was written out here three times. -->
            <supplyFactor Class="Phobos.VehicleSystems.Input_AlternatorOutput" />
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <!-- What the loads draw beyond the alternator: all of it with the engine off. -->
        <name>drain</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Deficit</side>
            <!-- Framework 0.73.0: the drive belt turns the alternator; a slipping or snapped one charges little or nothing. -->
            <drivenByRole>Belt</drivenByRole>
            <!-- Framework 0.106.0 (avionics A5): a piston engine's alternator follows its rotor speed as before; a turbine's generator
                 follows the spool speed instead (about half at ground idle, full from cruise, authored), shared among the engines still
                 working. Before, a turbine's spool read through the piston curve as an rpm far past its top: full output at idle. -->
            <!-- Framework 0.130.0 (step S5): the rules Def's one alternator curve on its own speed (the engine's times its alternator
                 ratio), or a turbine's spool curve; it was written out here three times. -->
            <supplyFactor Class="Phobos.VehicleSystems.Input_AlternatorOutput" />
          </li>
        </inputs>
      </li>
      <li>
        <!-- A parked vehicle beside a powered grid trickle-charges; since Framework 0.120.0 the grid pays for it through the vehicle's hook-up, and also carries its loads (Input_ElectricalBalance). -->
        <name>shoreCharging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <factorParameter>shoreChargeAmps</factorParameter>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <when Class="Phobos.VehicleSystems.When_EngineRunning">
          <invert>true</invert>
        </when>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ShorePower" />
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <!-- About 5 % a month (authored; Battery University gives a few per cent a month at room temperature). -->
        <name>selfDischarge</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <factor>0.00007</factor>
      </li>
      <li>
        <!-- Framework 0.344.0 (the owner's card of 27 Nov 2026, "Solar panel"): with no house battery, a solar panel charges the starting
             battery in daylight while the engine is off. With one, the house battery takes it all (Systems_HouseBattery*.xml). -->
        <name>solarCharging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_EngineRunning"><invert>true</invert></li>
            <li Class="Phobos.VehicleSystems.When_FittingGrants"><ability>HouseBattery</ability><invert>true</invert></li>
          </conditions>
        </when>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_SolarAmps" />
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
    </flows>
    <onEvents>
      <li>
        <!-- Each start draws on the battery, more in the cold: from the oil's temperature since crosslink 7 (Framework 0.70.0), as it is
             the thick oil the starter fights, so a warmed engine starts cheaply on a cold day; the air's for a vehicle without oil. -->
        <eventDef>IgnitionOn</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_AddQuantity">
            <quantity>charge</quantity>
            <amount>-1</amount>
            <scaleByParameter>starterAmpHours</scaleByParameter>
            <divideByParameter>batteryAmpHours</divideByParameter>
            <scaleBy Class="Phobos.VehicleSystems.Input_Quantity">
              <quantity>oilTemperature</quantity>
              <fallback Class="Phobos.VehicleSystems.Input_Ambient" />
              <curve>
                <points>
                  <li>(-30, 3)</li>
                  <li>(-18, 2.5)</li>
                  <li>(0, 1.5)</li>
                  <li>(20, 1)</li>
                </points>
              </curve>
            </scaleBy>
          </li>
        </effects>
      </li>
    </onEvents>
    <!-- A jump-start from another of the player's vehicles within 8 cells raises a battery below 30 % to 30 %. The donor loses the
         same ampere-hours unless its engine runs (its alternator covers it). Figures authored. -->
    <jumpStart>
      <quantity>charge</quantity>
      <capacityParameter>batteryAmpHours</capacityParameter>
      <raiseTo>0.3</raiseTo>
      <donorMinimum>0.5</donorMinimum>
      <reach>8</reach>
      <work>300</work>
    </jumpStart>
    <onPartHit>
      <li>
        <role>Battery</role>
        <quantity>charge</quantity>
        <perHealthLost>-0.01</perHealthLost>
      </li>
      <li>
        <!-- Framework 0.109.0 (SD9): an EMP surge empties the battery as well as harming it. Vehicle Framework's EMP costs a rated part
             2.5 % of its health (Moderate, civilian) or 1 % (Minor, military), so this takes about 40 % or 16 % of the charge. Authored. -->
        <role>Battery</role>
        <quantity>charge</quantity>
        <perShareLost>-16</perShareLost>
        <damageDefs>
          <li>EMP</li>
        </damageDefs>
      </li>
      <li>
        <!-- Framework 0.29.0: damaged cells go on draining (Conditions.xml). Authored. -->
        <role>Battery</role>
        <condition>PhobosVehicleCondition_ShortedBattery</condition>
        <perHealthLost>0.03</perHealthLost>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <!-- Not an animal's scratch or bite, and not the scratch Vehicle Framework's hand brakes give wheels. -->
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
      <li>
        <!-- Framework 0.123.0, cross-links round three G12: a hit on the battery or the alternator cuts into the wiring beside it, and the
             switched loads on the cut circuits stop working (Conditions.xml). 0.03 severity per hit point, as the shorted battery's; a small
             nick (below 0.1) does nothing. Authored. -->
        <role>Battery</role>
        <condition>PhobosVehicleCondition_ShortedWiring</condition>
        <perHealthLost>0.03</perHealthLost>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
      <li>
        <role>Alternator</role>
        <condition>PhobosVehicleCondition_ShortedWiring</condition>
        <perHealthLost>0.03</perHealthLost>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
    </onPartHit>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    An electric vehicle's low-voltage electrics (Framework 0.20.0; docs/development/vehicle-electric-design.md): the same 12 V battery,
    jump-starts and loads, but charged by a DC-DC converter from the traction battery whenever the vehicle is switched on, at any
    speed, instead of by an alternator turning with the engine. Real electric cars keep a 12 V battery for the computers and the
    contactors that connect the traction battery, so a flat one still stops the car (general, approximate). Inherits the rest from
    the system above; only the flows differ.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef ParentName="PhobosVehicleSystemElectricalBase">
    <defName>PhobosVehicleSystem_AuxiliaryElectrical</defName>
    <label>low-voltage electrics</label>
    <description>The 12 V battery that wakes the vehicle's computers and connects its traction battery, and the lights and fans it powers. The converter keeps it charged from the traction battery while the vehicle is switched on; a flat one still stops the vehicle starting.</description>
    <flows Inherit="False">
      <li>
        <name>charging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Surplus</side>
            <supplyFactor Class="Phobos.VehicleSystems.Input_EngineRunning" />
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <name>drain</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Deficit</side>
            <supplyFactor Class="Phobos.VehicleSystems.Input_EngineRunning" />
          </li>
        </inputs>
      </li>
      <li>
        <name>shoreCharging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <factorParameter>shoreChargeAmps</factorParameter>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <when Class="Phobos.VehicleSystems.When_EngineRunning">
          <invert>true</invert>
        </when>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ShorePower" />
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <name>selfDischarge</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <factor>0.00007</factor>
      </li>
    </flows>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    A steam locomotive's turbo-generator (Framework 0.376.0; the owner's answer of 28 Nov 2026, "A steam turbo-generator"): a small steam turbine
    on the boiler turning a generator for the headlamp and the cab's lights. Big American steam engines carried one, commonly a 32-volt set of
    about a kilowatt (general knowledge, unverified). No battery and no starter: its loads have power only while the locomotive is in steam
    and the generator works (generatorOnly, ElectricsRule.LoadsPowered), and nothing here can ever stop the engine. Its part is the
    loadout's alternator role, so a hit on it puts the lights out. Figures authored.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_TurboGenerator</defName>
    <label>turbo-generator</label>
    <description>A small steam turbine on the boiler turning a generator for the lamps and the cab's loads. There is no battery: they have power only while the locomotive is in steam, and go dark with the fire out.</description>
    <roles>
      <li>Alternator</li>
    </roles>
    <parameters>
      <!-- Read by the systems comp: loads run only while the engine turns a working generator. -->
      <generatorOnly>1</generatorOnly>
      <!-- 32 V, the common turbo-generator voltage, and about 1.2 kW, so 38 A (authored). -->
      <systemVolts>32</systemVolts>
      <alternatorAmps>38</alternatorAmps>
    </parameters>
    <quantities>
      <li>
        <name>turboGenerator</name>
        <description>How well the turbo-generator turns: its part's state. Ruined, the lamps and the cab's loads are dark even in steam.</description>
        <label>turbo-generator</label>
