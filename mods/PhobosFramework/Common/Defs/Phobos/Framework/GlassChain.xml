    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Chemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <PhobosPlasticFilm>2</PhobosPlasticFilm>
    </products>
  </RecipeDef>

  <RecipeDef>
    <defName>PhobosMake_LaminatedPane</defName>
    <label>make a laminated pane</label>
    <description>Bonds two glass panes to a plastic film between them: a windscreen.</description>
    <jobString>Laminating glass.</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
