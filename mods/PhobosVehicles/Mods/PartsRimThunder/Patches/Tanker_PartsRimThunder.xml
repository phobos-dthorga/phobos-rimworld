<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- RimThunder only: its running gear, with extra components for the electrics. Steel stays first: Vehicle Framework reads the first cost item for the destruction sound. Counts are authored. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="Phobos_Tanker_Blueprint"]/costList</xpath>
    <value>
      <costList>
              <Steel>280</Steel>
              <EngineHeavy>1</EngineHeavy>
              <ComponentTransmission>1</ComponentTransmission>
              <ComponentFuelTank>1</ComponentFuelTank>
              <ComponentWheelTire>6</ComponentWheelTire>
              <ComponentIndustrial>14</ComponentIndustrial>
      </costList>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="Phobos_Tanker_Blueprint"]/researchPrerequisites</xpath>
    <value>
      <li>EnginePlus</li>
    </value>
  </Operation>
</Patch>
