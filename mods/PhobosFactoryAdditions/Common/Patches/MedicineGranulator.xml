<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Offer the synthread medicine bill on VFE Factory's medicine granulator, beside the stock cotton one. Same
       xpath shape as the drug-lab bills in Mods/, so all of them add side by side. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEFactory_MedicineGranulator"]/comps/li[@Class="PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
    <value>
      <li>PhobosFactory_MakeMedicineFromSynthread</li>
    </value>
  </Operation>

</Patch>
