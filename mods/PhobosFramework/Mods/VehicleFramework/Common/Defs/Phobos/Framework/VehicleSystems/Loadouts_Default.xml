      </li>
      <li>
        <!-- Added in Framework 0.21.2: boats had no cab heater, so a closed cabin could only cool. Amps authored, as a land vehicle's fan. -->
        <name>cabHeater</name>
        <label>cab heater</label>
        <description>The cabin heater runs below 5 °C while the engine runs, on the engine's heat: it warms the cabin only once the engine has warmed up, and not at all with the coolant gone.</description>
        <amps>12</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <!-- Automatic climate control (Framework 0.22.0): only on vehicles fitted with it (When_ClimateControl), or every closed cab
             with the player's setting. It runs the heater and air conditioner itself to hold the cab near 21 degrees C, so the manual
             ones stand down while it runs. The draw is an average of the fans, blower and controls (authored). -->
        <name>climateControl</name>
        <label>climate control</label>
        <description>Holds the cab near 21 °C by itself while the engine runs, heating or cooling as needed. Switch it off to use the heater and air conditioner by hand.</description>
        <amps>8</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/ClimateControl</iconPath>
        <available Class="Phobos.VehicleSystems.When_ClimateControl" />
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>airConditioner</name>
        <label>air conditioner</label>
        <description>The air conditioner cools the cab above 26 °C while the engine runs.</description>
        <amps>20</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/AirConditioner</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientAbove">
              <celsius>26</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <name>nightHeater</name>
        <label>night heater</label>
        <description>A fuel-burning heater that keeps the cab and the engine warm while the caravan camps for the night with the engine off, so it starts easily in the morning. Switch it on before you leave; it needs the night heater setting.</description>
        <amps>2</amps>
        <toggle>true</toggle>
        <defaultOn>false</defaultOn>
        <iconPath>Phobos/VehicleSystems/NightHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_CaravanResting" />
            <li Class="Phobos.VehicleSystems.When_Setting">
              <setting>nightHeater</setting>
            </li>
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <!--
    Aircraft: the electrical system, the engine's hours and service, and a gas turbine (docs/development/vehicle-turbine-design.md)
    with the stock flight profile, which reads Vehicle Framework's launch state. A jet's or a rotor's engine cools and lubricates
    unlike a car's, so there is no coolant or radiator; no oil pump, gearbox, tyres or brakes are appended. Named loadouts give a
    jump jet or a helicopter its own engine and flight profile.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef Name="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_Aircraft</defName>
    <label>aircraft</label>
    <kind>Aircraft</kind>
    <priority>Effect</priority>
    <selector>
      <fuelled>Yes</fuelled>
      <electricPowered>No</electricPowered>
      <flies>Yes</flies>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_Electrical</def></li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Turbine</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AeroTurbofan</def>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockAircraft</flightProfile>
    <partRoles>
      <li>
        <role>Engine</role>
        <find>
          <li>
            <categories>
              <li>FlightSpeed</li>
            </categories>
            <depth>Internal</depth>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
          </li>
          <li>
            <keyContains>engine</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>Alternator</role>
        <find>
          <li>
            <tag>Alternator</tag>
          </li>
          <li>
            <keyContains>alternator</keyContains>
          </li>
          <li>
            <keyContains>generator</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosAlternator</key>
          <label>generator</label>
          <health>25</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Battery</role>
        <find>
          <li>
            <keyContains>battery</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosBattery</key>
          <label>battery</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Starter</role>
        <find>
          <li>
            <keyContains>starter</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosStarter</key>
          <label>starter</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
    </partRoles>
    <loads>
      <li>
        <name>avionics</name>
        <label>avionics</label>
        <amps>15</amps>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>navigationLights</name>
        <label>navigation lights</label>
        <description>The navigation lights burn at night while the engine runs.</description>
        <amps>5</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Night" />
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
          </conditions>
        </when>
      </li>
      <li>
        <!-- Added in Framework 0.21.2: aircraft had no cab heater, so a closed cockpit could only cool. Real aircraft heat it with bleed air from the engines (general); the amps, for the valves and fan, are authored. -->
        <name>cabHeater</name>
        <label>cab heater</label>
        <description>The cockpit and cabin are heated below 5 °C while the engines run, with hot air bled from them.</description>
        <amps>4</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <!-- Automatic climate control (Framework 0.22.0): only on vehicles fitted with it (When_ClimateControl), or every closed cab
             with the player's setting. It runs the heater and air conditioner itself to hold the cab near 21 degrees C, so the manual
             ones stand down while it runs. The draw is an average of the fans, blower and controls (authored). -->
        <name>climateControl</name>
        <label>climate control</label>
        <description>Holds the cab near 21 °C by itself while the engine runs, heating or cooling as needed. Switch it off to use the heater and air conditioner by hand.</description>
        <amps>4</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/ClimateControl</iconPath>
        <available Class="Phobos.VehicleSystems.When_ClimateControl" />
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>airConditioner</name>
        <label>air conditioner</label>
        <description>The air conditioner cools the cab above 26 °C while the engine runs.</description>
        <amps>20</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/AirConditioner</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientAbove">
              <celsius>26</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <name>nightHeater</name>
        <label>night heater</label>
        <description>A fuel-burning heater that keeps the cab and the engine warm while the caravan camps for the night with the engine off, so it starts easily in the morning. Switch it on before you leave; it needs the night heater setting.</description>
        <amps>2</amps>
        <toggle>true</toggle>
        <defaultOn>false</defaultOn>
        <iconPath>Phobos/VehicleSystems/NightHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_CaravanResting" />
            <li Class="Phobos.VehicleSystems.When_Setting">
              <setting>nightHeater</setting>
            </li>
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
