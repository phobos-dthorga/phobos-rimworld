<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The Hind (Hind_Helicopter): two turboshafts, bound by their own parts (EngineStarboard as the first engine, EnginePort as the second),
    with the helicopter flight profile (docs/development/vehicle-turbine-design.md). With one engine out the other carries the load
    on its contingency rating and runs hot; a hover may then be beyond it. Not yet tested in game. Ratings and limits are the
    Framework's authored helicopter turboshaft (Drivetrains.xml).
    Its main gearbox (the VR-24) is appended (Framework 0.12.0). No published limit for it was found (9 Nov 2026), so the drive
    limit, 0.9 of both engines' maximum continuous, is authored.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_Hind</defName>
    <label>attack helicopter (twin turboshaft)</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Hind_Helicopter</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AeroTurboshaft</def>
      <set>
        <transmissionLimit>0.9</transmissionLimit>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_Helicopter</flightProfile>
    <partRoles>
      <li>
        <!-- The main rotor gearbox: neither mod gives the helicopter one, so it is appended among the engines (owner, 9 Nov 2026:
             rotor drives for every helicopter). -->
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Gearbox</li>
              <li>Transmission</li>
              <li>RotorMast</li>
            </keyContainsAny>
          </li>
        </find>
        <add>
          <key>PhobosMainGearbox</key>
          <label>main rotor gearbox</label>
          <health>40</health>
          <hitWeight>0.3</hitWeight>
          <cellsOf>Engine1</cellsOf>
        </add>
      </li>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <keyContains>EngineStarboard</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <keyContains>EnginePort</keyContains>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
