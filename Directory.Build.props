<Project>
  <!-- Shared by every C# project under src/. Every project builds net10.0 for RimWorld 1.7 (which leads) and net472 for
       1.6; Directory.Build.targets turns the target into the game version, the output folder and the game references
       (docs/development/building.md). The intermediate folder is split per target (the default); the output folder is
       set per game version in Directory.Build.targets, which wins over the SDK's appended one. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <!-- RimWorld 1.6 compiles against Unity's .NET Framework 4.7.2 libraries, which lack the types newer
       C# needs (records, init, required) or hide them as internal (MemberNotNull). PolySharp generates
       them as internal types at compile time and ships nothing. .NET 10 builds for 1.7 don't need it.
       The condition sits on an ItemGroup, which MSBuild evaluates after the project sets its target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
