<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- One assembly per game version (1.7 leads, 1.6 stays until it is retired), shared XML in Common, and one folder per optional
       mod, loaded only while it is active; the Dubs Bad Hygiene tie-in's assembly sits in a version folder below it. Five mods were
       merged into this one on 7 November 2026; their optional folders share these, with no two files on the same path. -->
  <v1.6>
    <li>/</li>
    <li>Common</li>
    <li>1.6</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="Th3Fr3d.ExtendedInjuries">Mods/MoreInjuries</li>
    <li IfModActive="vanillaexpanded.gravship">Mods/VanillaGravshipExpanded</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene/1.6</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li>Common</li>
    <li>1.7</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="Th3Fr3d.ExtendedInjuries">Mods/MoreInjuries</li>
    <li IfModActive="vanillaexpanded.gravship">Mods/VanillaGravshipExpanded</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene/1.7</li>
  </v1.7>
</loadFolders>
