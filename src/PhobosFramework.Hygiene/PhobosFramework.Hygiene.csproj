<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Framework's Dubs Bad Hygiene tie-in: the one way Phobos mods draw water from Dubs' plumbing. Its own assembly, so the
       framework's core never references an optional mod; LoadFolders.xml loads Mods/DubsBadHygiene/<version> only while Dubs Bad
       Hygiene is active. Built for 1.7 only, like the core. Dubs' assembly is referenced from the installed mod, never copied. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Framework.Hygiene</RootNamespace>
    <AssemblyName>PhobosFramework.Hygiene</AssemblyName>
    <ModFolder>PhobosFramework</ModFolder>
    <TieInFolder>Mods/DubsBadHygiene/</TieInFolder>
    <Version>0.57.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BadHygiene">
      <HintPath>$(DbhAssemblies)\BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
