<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Any bed that takes a vitals monitor takes our machines too, so modded hospital beds are covered without naming them. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities[li="VitalsMonitor"]</xpath>
    <value>
      <li>PhobosMedical_OxygenConcentrator</li>
      <li>PhobosMedical_Ventilator</li>
    </value>
  </Operation>
</Patch>
