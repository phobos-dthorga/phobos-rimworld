<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    A hull for trying out D'thorga Framework's submersibles, and the framework's first consumer (docs/development/submarine-framework.md). NOT a vehicle players build: it has no place in
    the Architect and appears only through the dev action "Vehicle systems: spawn a submersible". It borrows the bulk tanker's picture (owner's rule of 9 Nov 2026: no stand-in bodies), so it
    looks like a truck on the water, and has no upgrade tree because it is not a design. All figures authored. Parts are saved by position: append only. Not yet tested in game.
    4 x 9 cells, drawn 5 x 10, in step with the Seabed Crawler (owner, 11 Nov 2026); the columns run x -1 to 2, z -4 to 4, as the game lays an even width out.
  -->
  <Vehicles.VehicleDef ParentName="BaseSeaVehicle">
    <defName>Phobos_SubmarineTestHull</defName>
    <label>submarine test hull</label>
    <description>A bare hull for trying out diving. It is not a finished design.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(5, 10)</drawSize>
      <color>(70, 78, 86)</color>
      <colorTwo>(40, 44, 50)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <nameable>false</nameable>
    <buildDef>Phobos_SubmarineTestHull_Blueprint</buildDef>
    <size>(4, 9)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Sea</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.2</Flammability>
      <MarketValue>4000</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>400</Mass>
      <MoveSpeed>7</MoveSpeed>
      <CargoCapacity>1500</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
      <Phobos_DiveEndurance>12</Phobos_DiveEndurance>
      <Phobos_DiveControl>1</Phobos_DiveControl>
    </vehicleStats>
    <race>
      <baseBodySize>7</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1</winterSpeedMultiplier>
      <riverCost>1</riverCost>
      <visibilityWeight>6</visibilityWeight>
      <roles>
        <li>
          <key>driver</key>
          <label>helmsman</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 2)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>crew</key>
          <label>crew</label>
          <slots>4</slots>
          <hitbox>
            <cells>
              <li>(0, 0)</li>
              <li>(1, 0)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
      <li>
        <key>Hull</key>
        <label>outer hull</label>
        <health>220</health>
        <depth>External</depth>
        <hitWeight>3</hitWeight>
        <hitbox>
          <from>(-1, -4)</from>
          <to>(2, 4)</to>
        </hitbox>
        <categories>
          <li>BodyIntegrity</li>
        </categories>
      </li>
      <li>
        <key>Engine</key>
        <label>engine</label>
        <health>60</health>
        <depth>Internal</depth>
        <priorityStatEfficiency>true</priorityStatEfficiency>
        <hitbox>
          <cells>
            <li>(0, -3)</li>
            <li>(1, -3)</li>
          </cells>
        </hitbox>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>Propeller</key>
        <label>propeller</label>
        <health>40</health>
        <depth>External</depth>
        <hitbox>
          <cells>
            <li>(0, -4)</li>
            <li>(1, -4)</li>
          </cells>
        </hitbox>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>FuelTank</key>
        <label>fuel tank</label>
        <health>50</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(2, -2)</li>
          </cells>
        </hitbox>
      </li>
      <li>
        <key>BallastTanks</key>
        <label>ballast tanks</label>
        <health>70</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(-1, 0)</li>
            <li>(2, 0)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveControl</li>
        </categories>
      </li>
      <li>
        <key>PressureHull</key>
        <label>pressure hull</label>
        <health>120</health>
        <depth>Internal</depth>
        <hitbox>
          <from>(0, -2)</from>
          <to>(1, 3)</to>
        </hitbox>
        <categories>
          <li>Phobos_DiveControl</li>
        </categories>
      </li>
      <li>
        <key>AirPlant</key>
        <label>air plant</label>
        <health>40</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(0, 1)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveEndurance</li>
        </categories>
      </li>
      <li>
        <key>BatteryBank</key>
        <label>battery bank</label>
        <health>60</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(-1, -2)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveEndurance</li>
        </categories>
      </li>
    </components>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>24</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>200</fuelCapacity>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosSubmersible">
        <!-- The Crawler's ping: the test hull shares the Crawler's sounds (owner, 10 Nov 2026). -->
        <spottedSound>PhobosVehicles_SonarPing</spottedSound>
        <divesInChestDeepWater>true</divesInChestDeepWater> <!-- So one hull can try both depths: it dives in rivers as a midget boat would, and shallow water still brings it up. -->
      </li>
    </comps>
    <!-- Its own voice (the test hull shares the Crawler's: owner, 10 Nov 2026) in place of the inherited draft blips; the engine loops are played by D'thorga Framework from the
         extension below, so they follow rpm and load (docs/development/sound-catalogue.md). -->
    <soundOneShotsOnEvent Inherit="False">
      <li>
        <key>IgnitionOn</key>
        <value>PhobosVehicles_SeabedCrawlerEngineStart</value>
      </li>
      <li>
        <key>IgnitionOff</key>
        <value>PhobosVehicles_SeabedCrawlerEngineStop</value>
      </li>
      <li>
        <key>PawnEntered</key>
        <value>PhobosVehicles_SeabedCrawlerDoor</value>
      </li>
      <li>
        <key>PawnExited</key>
        <value>PhobosVehicles_SeabedCrawlerDoor</value>
      </li>
    </soundOneShotsOnEvent>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosVehicles_SeabedCrawlerEngineIdle</idleSound>
        <loadSound>PhobosVehicles_SeabedCrawlerEngineLoad</loadSound>
      </li>
    </modExtensions>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_SubmarineTestHull_Blueprint</defName>
    <label>submarine test hull</label>
    <description>A bare hull for trying out diving. It is not a finished design.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5, 10)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <size>(4, 9)</size>
    <costList>
      <Steel>400</Steel>
    </costList>
    <designationCategory Inherit="False" />
    <thingToSpawn>Phobos_SubmarineTestHull</thingToSpawn>
  </Vehicles.VehicleBuildDef>
</Defs>
