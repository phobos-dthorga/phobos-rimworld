<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    What replacing a destroyed part costs, by the role the part plays (vehicle health slice 3, docs/development/vehicle-health-consequences.md;
    Framework 0.36.0). The owner's decisions of 9 Nov 2026: engines and transmissions cost the whole part by default, everything else
    a share of its materials, both settable in the mod settings; our parts always exist, and another mod's are accepted only where they
    make sense. Every figure and the mass classes are authored, held for the owner's review. The first Def that fits a part wins.

    The substitutes are named per role so each is only offered where it suits: a light engine does not go in a tank, and a piston
    engine never replaces a turbine.

    Framework 0.95.0 (owner, 11 Nov 2026): the same table now fills a vehicle's parts bill when it is built
    (docs/development/parts-bills.md), so a build and a repair agree on which part suits a vehicle. With that, Vanilla Vehicles
    Expanded's parts follow what its own heavy vehicles do, in place of the 6-tonne cap of 9 Nov: one engine block under 6 tonnes, two
    to 15, three above (its Wisent takes three); its transmission, wheels and suspension up to 15 tonnes; its electrics, radiator, fuel
    tank and exhaust on anything. All authored, held for the owner's review. The order of a role's substitutes is the order of
    preference for a build: RimThunder's part, then Vanilla Vehicles Expanded's.
  -->
  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_PistonEngine</defName>
    <label>piston engine</label>
    <roles>
      <li>Engine</li>
      <li>Engine1</li>
      <li>Engine2</li>
      <li>Engine3</li>
      <li>Engine4</li>
    </roles>
    <turbine>No</turbine>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_EngineAssembly</item>
    <!-- Framework 0.95.0: we make one engine where RimThunder makes three classes, so a heavier vehicle takes more of ours, at the same
         weights (420, 840 and 1,260 silver beside RimThunder's 400, 800 and 1,350). A build and a repair both read this. Authored. -->
    <itemCountBySize>
      <li><minKilograms>4000</minKilograms><count>2</count></li>
      <li><minKilograms>15000</minKilograms><count>3</count></li>
    </itemCountBySize>
    <work>4000</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>EngineLight</thing><maxKilograms>4000</maxKilograms></li>
      <li MayRequire="rimthunder.core"><thing>EngineMedium</thing><minKilograms>4000</minKilograms><maxKilograms>15000</maxKilograms></li>
      <li MayRequire="rimthunder.core"><thing>EngineHeavy</thing><minKilograms>15000</minKilograms></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_EngineBlock</thing><maxKilograms>6000</maxKilograms></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_EngineBlock</thing><count>2</count><minKilograms>6000</minKilograms><maxKilograms>15000</maxKilograms></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_EngineBlock</thing><count>3</count><minKilograms>15000</minKilograms></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_TurbineEngine</defName>
    <label>gas turbine</label>
    <roles>
      <li>Engine</li>
      <li>Engine1</li>
      <li>Engine2</li>
      <li>Engine3</li>
      <li>Engine4</li>
    </roles>
    <turbine>Yes</turbine>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_TurbineAssembly</item>
    <work>5000</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>EngineTurbine</thing></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Transmission</defName>
    <label>transmission</label>
    <roles>
      <li>Transmission</li>
    </roles>
    <wholePart>true</wholePart>
    <item>PhobosVehicles_Transmission</item>
    <work>3000</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>ComponentTransmission</thing></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarTransmission</thing><maxKilograms>15000</maxKilograms></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

  <Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>
    <defName>PhobosPartSupply_Wheels</defName>
    <label>running gear</label>
    <roles>
      <li>Wheels</li>
    </roles>
    <!-- For a build, ours is the drivetrain kit for the whole vehicle (Framework 0.95.0); a repair still charges the materials below. -->
    <item>PhobosVehicles_DrivetrainKit</item>
    <coversWholeBuild>true</coversWholeBuild>
    <materials>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </materials>
    <work>800</work>
    <substitutes>
      <li MayRequire="rimthunder.core"><thing>ComponentWheelTire</thing></li>
      <li MayRequire="oskarpotocki.vanillavehiclesexpanded"><thing>VVE_CarWheel</thing><maxKilograms>15000</maxKilograms></li>
    </substitutes>
  </Phobos.VehicleSystems.PhobosVehiclePartSupplyDef>

