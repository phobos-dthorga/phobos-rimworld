  <!-- Plugs a set-up vehicle into a grid: wires to a conduit or generator within 6 cells, as any building does. A plain power user, because the game only connects those. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Phobos_PowerPoint</defName>
    <label>power point</label>
    <description>A junction box run out from a working vehicle. Wired to a powered grid, it takes the vehicle's load off the engine.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Stations/PowerPoint</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <clearBuildingArea>false</clearBuildingArea>
    <tickerType>Never</tickerType>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1</basePowerConsumption>
      </li>
    </comps>
  </ThingDef>

  <JobDef>
