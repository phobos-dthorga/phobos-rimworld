          <thingDefs>
            <li>PhobosGlassPane</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>PhobosPlasticFilm</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>PhobosGlassPane</li>
        <li>PhobosPlasticFilm</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <PhobosLaminatedPane>1</PhobosLaminatedPane>
    </products>
  </RecipeDef>

  <RecipeDef>
    <defName>PhobosMake_ArmouredPane</defName>
    <label>make an armoured pane</label>
    <description>Bonds four glass panes and three films into one block of armoured glass.</description>
    <jobString>Making armoured glass.</jobString>
    <workAmount>3500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>PhobosGlassPane</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>PhobosPlasticFilm</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>PhobosGlassPane</li>
        <li>PhobosPlasticFilm</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <PhobosArmouredPane>1</PhobosArmouredPane>
    </products>
  </RecipeDef>

  <RecipeDef>
    <defName>PhobosMake_VisionBlock</defName>
    <label>make a vision block</label>
    <description>Casts a thick prism of clear plastic and sets it in a steel mount.</description>
    <jobString>Making a vision block.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>PhobosPlasticFilm</li>
          </thingDefs>
        </filter>
        <count>4</count>
