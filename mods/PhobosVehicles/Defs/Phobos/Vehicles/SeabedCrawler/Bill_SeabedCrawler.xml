       vehicle's weight, and by ours otherwise. Counts authored, held for the owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_SeabedCrawler</defName>
    <label>seabed crawler parts</label>
    <target>Phobos_SeabedCrawler_Blueprint</target>
    <parts>
      <Engine>1</Engine>
      <FuelTank>1</FuelTank>
      <Battery>2</Battery>
      <Wiring>1</Wiring>
    </parts>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
