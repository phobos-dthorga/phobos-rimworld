    </components>
    <modExtensions>
      <!-- A flat deck (D'thorga Framework 0.217.0, Vehicles 0.98.0; the owner, 22 Nov 2026): it takes a deck tent, a walk-in room with two beds. -->
      <li Class="Phobos.VehicleSystems.PhobosFlatDeckExtension" />
      <!-- Armour by class (D'thorga Framework 0.154.0; docs/development/vehicle-armour.md): Combat Extended shoots at the truck's full
           width, and the parts our systems append go inside, so each cell keeps the one outer part above. -->
      <li Class="Phobos.VehicleSystems.PhobosArmourExtension">
        <hitWidthCells>3</hitWidthCells>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>10000</emptyKilograms>
        <ratedKilowatts>220</ratedKilowatts>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosVehicles_TipperEngineIdle</idleSound>
        <loadSound>PhobosVehicles_TipperEngineLoad</loadSound>
      </li>
      <!-- Its work: the rams while tipping, the load sliding out by body (the first that applies plays), the tailgate. -->
      <li Class="Phobos.VehicleSystems.PhobosVehicleSoundsExtension">
        <sounds>
          <li><key>Rams</key><sound>PhobosVehicles_TipperRams</sound></li>
          <li><key>Slide</key><sound>PhobosVehicles_TipperSlideRock</sound><node>RockBody</node></li>
          <li><key>Slide</key><sound>PhobosVehicles_TipperSlideBulk</sound><node>BulkBody</node></li>
          <li><key>Slide</key><sound>PhobosVehicles_TipperSlide</sound></li>
          <li><key>Tailgate</key><sound>PhobosVehicles_TipperTailgate</sound></li>
        </sounds>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>28</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>120</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_Tipper_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTipper" />
      <!-- The gathering run (D'thorga Framework 0.143.0; docs/development/vehicle-gathering-runs.md): with its loading grab fitted and someone
           aboard to drive, it fetches loose things the player chose about the map. Chunks and raw resources to start (the owner's "raw
           materials"); anything but corpses may be chosen (agent default). Not yet tested in game. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosGatherRun">
        <!-- Owner, 19 Nov 2026: with the armoured cab fitted it may keep working while enemies are about, behind a switch in
             Gather what that starts off. -->
        <keepWorkingNode>PhobosArmouredCab</keepWorkingNode>
        <defaultFilter>
          <categories>
            <li>Chunks</li>
            <li>ResourcesRaw</li>
          </categories>
        </defaultFilter>
        <choosableFilter>
          <categories>
            <li>Root</li>
          </categories>
          <disallowedCategories>
            <li>Corpses</li>
          </disallowedCategories>
        </choosableFilter>
      </li>
      <!-- The tipping body is a picture of its own over the chassis, so it can slide when it tips; the rock and bulk bodies replace the
           plain one when fitted (D'thorga Framework's node looks, 12 Nov 2026). -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>body</key>
            <looks>
              <li>
                <node>RockBody</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_RockBody</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <node>BulkBody</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_BulkBody</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_Body</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        <!-- The loading grab (PhobosLoadingGrab), folded behind the cab (owner's pick, 12 Nov 2026). -->
          <li>
            <key>grab</key>
            <looks>
              <li>
                <node>PhobosLoadingGrab</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_LoadingGrab</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        <!-- Framework 0.105.0, Vehicles 0.49.0 (12 Nov 2026, the owner's picks): the recovery winch on the front bumper and the auxiliary
             fuel tank between the wheels, shown while each fitting is fitted. Agent placement (assets/phobos-vehicles/export_round_three.py). -->
          <li>
            <key>winch</key>
            <looks>
              <li>
                <fitting>PhobosFitting_RecoveryWinch</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_Winch</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <li>
            <key>auxTank</key>
            <looks>
              <li>
                <fitting>PhobosFitting_AuxFuelTank</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_AuxFuelTank</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        <!-- The drawn armour kits (D'thorga Vehicles 0.86.0, the owner's picks of 19 Nov 2026): the heavy plates show in
             place of the armoured cab (they need it), the ram bar over the front bumper and the body plates along both sides. -->
          <li>
            <key>cabArmour</key>
            <looks>
              <li>
                <node>PhobosHeavyCabPlates</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_HeavyCabPlates</texPath>
