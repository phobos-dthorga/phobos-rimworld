<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The survey truck's upgrades (docs/development/vehicle-survey-truck.md). Figures and costs authored, except the uranium (owner, 9 Nov 2026). Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_SurveyTruck_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>GeophoneArray</key>
      <label>Geophone array</label>
      <displayLabel>true</displayLabel>
      <description>Spikes along the boom that listen to the ground. Heavy deposits, steel above all, are found more often, and the survey runs a little faster.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/GeophoneArray</icon>
      <work>2500</work>
      <gridCoordinate>(3, 4)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>GroundPenetratingScanner</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>RadiometricProbe</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SensorGeophone</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_ScanRate</def>
              <value>0.1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
        <ComponentIndustrial>3</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>RadiometricProbe</key>
      <label>Radiometric probe</label>
      <displayLabel>true</displayLabel>
      <description>A shielded gamma and neutron source on the boom. Uranium is found far more often, and the survey runs a little faster.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/RadiometricProbe</icon>
      <work>3000</work>
      <gridCoordinate>(10, 4)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>GroundPenetratingScanner</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>GeophoneArray</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SensorRadiometric</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_ScanRate</def>
              <value>0.1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <Plasteel>30</Plasteel>
        <ComponentIndustrial>3</ComponentIndustrial>
        <Uranium>40</Uranium>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_RadiometricProbe</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>LongRangeArray</key>
      <label>Long-range array</label>
      <displayLabel>true</displayLabel>
      <description>A dish on a mast. The survey can search nearby lands for one chosen ore, and a find becomes a place to travel to.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/LongRangeArray</icon>
      <work>4000</work>
      <gridCoordinate>(17, 4)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>LongRangeMineralScanner</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SurveyLongRange</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>6</ComponentIndustrial>
        <Plasteel>20</Plasteel>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_LongRangeArray</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>PoweredArray</key>
      <label>Powered array</label>
      <displayLabel>true</displayLabel>
      <description>A big transducer array. Switched on and supplied, the survey runs three times as fast. It needs a powered grid or the large battery.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/PoweredArray</icon>
      <work>6000</work>
      <gridCoordinate>(3, 9)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Fabrication</li>
        <li>LongRangeMineralScanner</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SurveyFastFactor</def>
              <value>2</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
        <ComponentIndustrial>10</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_PoweredArray</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>SurveyBattery</key>
      <label>Large battery</label>
      <displayLabel>true</displayLabel>
      <description>A 600 ampere-hour battery. It runs the survey with the engine off, and the engine starts itself to recharge it when it runs low, burning fuel with nobody at the wheel.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/SurveyBattery</icon>
      <work>3000</work>
      <gridCoordinate>(10, 9)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Batteries</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_BatteryCapacity</def>
              <value>600</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <!-- Beside two batteries, which the vehicle's parts bill adds (Bill_SurveyTruck.xml). -->
        <Steel>100</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_SurveyBattery</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>WorkLights</key>
      <label>Work lights</label>
      <displayLabel>true</displayLabel>
      <description>Lamps on the cabin roof for working through the night.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/WorkLights</icon>
      <work>1000</work>
      <gridCoordinate>(17, 9)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_WorkLights</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_WorkLights</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Armour kits without a picture of their own (D'thorga Vehicles 0.80.0; vehicle-militarised-service-vehicles.md, "The kits").
           Each raises named parts by class with Add (vehicle-armour.md; Combat Extended's figures in Mods/CombatExtended), and its real
           kilograms [A] load the engine as cargo would (owner, 19 Nov 2026), taking cargo room on the Talus only. Figures and costs authored.
           scripts/check-vehicle-armour.py holds each kit to its class on both scales. Not yet tested in game. -->
      <key>PhobosEngineGuards</key>
      <label>Engine and tank guards</label>
      <displayLabel>true</displayLabel>
      <description>Steel guards around the engine and the fuel tank, against rifle fire. A guarded tank still leaks and a guarded engine still burns once they are finally holed: it takes heavier fire to get there.</description>
      <upgradeExplanation>Engine and fuel tank: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 300 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Osprey/Upgrades/ArmourKit</icon>
      <work>2500</work>
      <gridCoordinate>(3, 19)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Engine</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>FuelTank</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>100</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRunFlatTyres</key>
      <label>Run-flat tyres</label>
      <displayLabel>true</displayLabel>
      <description>Steel-belted tyres with run-flat inserts, so the wheels shrug off shell fragments and pistol bullets.</description>
      <upgradeExplanation>Wheels: from skin to splinter armour, which stops shell fragments and pistol bullets.\nKit weight: 120 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/VehicleSystems/Fittings/AllTerrainTyres</icon>
      <work>1500</work>
      <gridCoordinate>(10, 19)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>FrontWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>RearWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>120</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>30</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosEmpHardening</key>
      <label>EMP hardening</label>
      <displayLabel>true</displayLabel>
      <description>Shielded wiring, filtered power and a spare engine control unit, so an electromagnetic pulse does the electrics less harm and stalls the engine less often, as it does on a military vehicle.</description>
      <upgradeExplanation>Electrics: an electromagnetic pulse harms them as it does a military vehicle's.\nKit weight: 60 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Parts/ElectricalKit</icon>
      <work>2000</work>
      <gridCoordinate>(17, 19)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_EmpHardening</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>60</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
