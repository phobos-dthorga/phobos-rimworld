<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Close Air Support's own bombs at The Dead Man's Switch's ammunition fabricator as well as the machining table, as the Harrier's are
    (owner, 21 Nov 2026: the Harrier's treatment). The fabricator runs an ordinary recipe, so naming it among each item's benches is all it
    takes. The A-10's 500 lb bomb is the fixed-wing framework's shared item, put there by Mods/AircraftMunitions with the Mk. 82's own
    patch (0.37.1). Their weights and recipes are set in Munitions_CloseAirSupport.xml (0.37.0, docs/development/aircraft-munitions.md).
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DMS_TableAmmoPrinter"]</xpath>
    <match Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>Defs/ThingDef[defName="Warthog_ClusterBomb" or defName="Warthog_HeavyClusterBomb" or defName="Frogfoot_FAB250Bomb"]/recipeMaker/recipeUsers</xpath>
      <value>
        <li>DMS_TableAmmoPrinter</li>
      </value>
    </match>
  </Operation>
</Patch>
