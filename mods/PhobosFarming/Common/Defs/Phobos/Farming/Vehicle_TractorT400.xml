  <Vehicles.VehicleDef ParentName="PhobosFarming_TractorT400RearBase">
    <defName>Phobos_TractorT400StandardRear</defName>
    <label>Thane T400 rear half</label>
    <description>The rear half of a Thane T400: its big rear axle, which drives, and its three-point linkage and drawbar. It is joined to the front half at the articulation pivot for good.</description>
    <graphicData>
      <texPath>Phobos/Farming/TractorT400/TractorT400Rear</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1400</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>830</Mass>
    </vehicleStats>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>10000</emptyKilograms>
      </li>
    </modExtensions>
    <comps>
      <!-- The pivot 1.69 cells ahead of the picture's middle, measured at the cut; the axle 1.6 behind the pivot [A]. It swings at most
           40 degrees, and its weight is driven grip. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTrailer">
        <hitchToAxle>1.6</hitchToAxle>
        <axleToCentre>0.09</axleToCentre>
        <jackKnifeDegrees>40</jackKnifeDegrees>
        <drawbarPart>Pivot</drawbarPart>
        <drivenAxle>true</drivenAxle>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleDef ParentName="PhobosFarming_TractorT400RearBase">
    <defName>Phobos_TractorT400BRear</defName>
    <label>Thane T400 B rear half</label>
    <description>The rear half of a Thane T400 B: its big rear axle, which drives, and its three-point linkage and drawbar. It is joined to the front half at the articulation pivot for good.</description>
    <graphicData>
      <texPath>Phobos/Farming/TractorT400B/TractorT400BRear</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1400</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>920</Mass>
    </vehicleStats>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>11000</emptyKilograms>
      </li>
    </modExtensions>
    <comps>
      <!-- The pivot 1.61 cells ahead of the picture's middle, measured at the cut; the axle 1.5 behind the pivot [A]. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTrailer">
        <hitchToAxle>1.5</hitchToAxle>
        <axleToCentre>0.11</axleToCentre>
        <jackKnifeDegrees>40</jackKnifeDegrees>
        <drawbarPart>Pivot</drawbarPart>
        <drivenAxle>true</drivenAxle>
      </li>
    </comps>
  </Vehicles.VehicleDef>

