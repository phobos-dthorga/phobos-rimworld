      <Alternator>1</Alternator>
      <Battery>2</Battery>
      <Wiring>1</Wiring>
      <Radiator>1</Radiator>
      <Exhaust>1</Exhaust>
      <HydraulicPump>1</HydraulicPump>
      <!-- The front and rear frames. -->
      <Frame>2</Frame>
