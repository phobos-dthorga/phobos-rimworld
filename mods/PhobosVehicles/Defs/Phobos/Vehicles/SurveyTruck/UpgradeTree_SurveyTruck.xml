<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The survey truck's upgrades (docs/development/vehicle-survey-truck.md). Figures and costs authored, except the uranium (owner, 9 Nov 2026). Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_SurveyTruck_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>GeophoneArray</key>
      <label>Geophone array</label>
      <displayLabel>true</displayLabel>
      <description>Spikes along the boom that listen to the ground. Heavy deposits, steel above all, are found more often, and the survey runs a little faster.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/GeophoneArray</icon>
      <work>2500</work>
      <gridCoordinate>(2, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>GroundPenetratingScanner</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>RadiometricProbe</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SensorGeophone</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_ScanRate</def>
              <value>0.1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
        <ComponentIndustrial>3</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>RadiometricProbe</key>
      <label>Radiometric probe</label>
      <displayLabel>true</displayLabel>
      <description>A shielded gamma and neutron source on the boom. Uranium is found far more often, and the survey runs a little faster.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/RadiometricProbe</icon>
      <work>3000</work>
      <gridCoordinate>(7, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>GroundPenetratingScanner</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>GeophoneArray</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SensorRadiometric</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_ScanRate</def>
              <value>0.1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <Plasteel>30</Plasteel>
        <ComponentIndustrial>3</ComponentIndustrial>
        <Uranium>40</Uranium>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_RadiometricProbe</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>LongRangeArray</key>
      <label>Long-range array</label>
      <displayLabel>true</displayLabel>
      <description>A dish on a mast. The survey can search nearby lands for one chosen ore, and a find becomes a place to travel to.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/LongRangeArray</icon>
      <work>4000</work>
      <gridCoordinate>(2, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>LongRangeMineralScanner</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SurveyLongRange</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>6</ComponentIndustrial>
        <Plasteel>20</Plasteel>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_LongRangeArray</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>PoweredArray</key>
      <label>Powered array</label>
      <displayLabel>true</displayLabel>
      <description>A big transducer array. Switched on and supplied, the survey runs three times as fast. It needs a powered grid or the large battery.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/PoweredArray</icon>
      <work>6000</work>
      <gridCoordinate>(7, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Fabrication</li>
        <li>LongRangeMineralScanner</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_SurveyFastFactor</def>
              <value>2</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
        <ComponentIndustrial>10</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_PoweredArray</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>SurveyBattery</key>
      <label>Large battery</label>
      <displayLabel>true</displayLabel>
      <description>A 600 ampere-hour battery. It runs the survey with the engine off, and the engine starts itself to recharge it when it runs low, burning fuel with nobody at the wheel.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/SurveyBattery</icon>
      <work>3000</work>
      <gridCoordinate>(12, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Batteries</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_BatteryCapacity</def>
              <value>600</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <!-- Beside two batteries, which the vehicle's parts bill adds (Bill_SurveyTruck.xml). -->
        <Steel>100</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_SurveyBattery</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>WorkLights</key>
      <label>Work lights</label>
      <displayLabel>true</displayLabel>
      <description>Lamps on the cabin roof for working through the night.</description>
      <icon>Phobos/Vehicles/SurveyTruck/Upgrades/WorkLights</icon>
      <work>1000</work>
      <gridCoordinate>(2, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_WorkLights</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/SurveyTruck/SurveyTruck_WorkLights</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 8)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Armour kits without a picture of their own (D'thorga Vehicles 0.80.0; vehicle-militarised-service-vehicles.md, "The kits").
           Each raises named parts by class with Add (vehicle-armour.md; Combat Extended's figures in Mods/CombatExtended), and its real
           kilograms [A] load the engine as cargo would (owner, 19 Nov 2026), taking cargo room on the Talus only. Figures and costs authored.
           scripts/check-vehicle-armour.py holds each kit to its class on both scales. Not yet tested in game. -->
      <key>PhobosEngineGuards</key>
      <label>Engine and tank guards</label>
      <displayLabel>true</displayLabel>
      <description>Steel guards around the engine and the fuel tank, against rifle fire. A guarded tank still leaks and a guarded engine still burns once they are finally holed: it takes heavier fire to get there.</description>
      <upgradeExplanation>Engine and fuel tank: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 300 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EngineGuards</icon>
      <work>2500</work>
      <gridCoordinate>(29, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Engine</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>FuelTank</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>100</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRunFlatTyres</key>
      <label>Run-flat tyres</label>
      <displayLabel>true</displayLabel>
      <description>Steel-belted tyres with run-flat inserts, so the wheels shrug off shell fragments and pistol bullets.</description>
      <upgradeExplanation>Wheels: from skin to splinter armour, which stops shell fragments and pistol bullets.\nKit weight: 120 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RunFlatTyres</icon>
      <work>1500</work>
      <gridCoordinate>(34, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>FrontWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>RearWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>120</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>30</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosEmpHardening</key>
      <label>EMP hardening</label>
      <displayLabel>true</displayLabel>
      <description>Shielded wiring, filtered power and a spare engine control unit, so an electromagnetic pulse does the electrics less harm and stalls the engine less often, as it does on a military vehicle.</description>
      <upgradeExplanation>Electrics: an electromagnetic pulse harms them as it does a military vehicle's.\nKit weight: 60 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EmpHardening</icon>
      <work>2000</work>
      <gridCoordinate>(39, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_EmpHardening</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>60</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- The drawn armour kits (D'thorga Vehicles 0.86.0; vehicle-militarised-service-vehicles.md, "The kits"), with their
           pictures from paid edits of the picked body (owner's picks of 19 Nov 2026). Armour by class with Add, Combat Extended's
           figures in Mods/CombatExtended; real kilograms [A] load the engine as cargo would, taking cargo room on the Talus only.
           Figures and costs authored. Not yet tested in game. -->
      <key>PhobosArmouredCab</key>
      <label>Armoured cab</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel plates over the cab's roof and doors and a steel frame round a narrowed windscreen, so ordinary rifle bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 1,000 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/ArmouredCab</icon>
      <work>4000</work>
      <gridCoordinate>(39, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1000</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>250</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRamBar</key>
      <label>Ram bar</label>
      <displayLabel>true</displayLabel>
      <description>A heavy steel beam across the front, braced back to the chassis. Driving into an animal, a raider or a wall harms the truck half as much, and what it hits more.</description>
      <upgradeExplanation>Damage the truck takes from running into people and animals: half (0.50 to 0.25).\nFrom running into buildings: half (0.10 to 0.05).\nDamage it does to people and animals it runs into: half as much again (0.50 to 0.75); to buildings, 2.5 to 3.0.\nKit weight: 150 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RamBar</icon>
      <work>1500</work>
      <gridCoordinate>(29, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <statCategories>
            <li>
              <def>PawnCollisionRecoilMultiplier</def>
              <value>-0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionRecoilMultiplier</def>
              <value>-0.05</value>
              <type>Add</type>
            </li>
            <li>
              <def>PawnCollisionMultiplier</def>
              <value>0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionMultiplier</def>
              <value>0.5</value>
              <type>Add</type>
            </li>
          </statCategories>
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosHeavyCabPlates</key>
      <label>Heavy cab plates</label>
      <displayLabel>true</displayLabel>
      <description>Thick steel slabs over the armoured cab and a steel visor over the windscreen with two vision slits, so armour-piercing rifle bullets and ordinary heavy machine-gun bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from rifle to armour-piercing rifle armour, which stops armour-piercing rifle bullets and ordinary heavy machine-gun bullets.\nKit weight: 850 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/HeavyCabPlates</icon>
      <work>5000</work>
      <gridCoordinate>(39, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_HeavyTruckArmour</li>
      </researchPrerequisites>
      <prerequisiteNodes>
        <li>PhobosArmouredCab</li>
      </prerequisiteNodes>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>850</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
      </ingredients>
    </li>
        <li>
          <!-- Framework 0.241.0, FR10(b) (the owner's answers of 23 Nov 2026): the engine bay's automatic system. -->
          <key>PhobosSuppressionEngine</key>
          <label>Engine fire suppression</label>
          <displayLabel>true</displayLabel>
          <description>A bottle of suppressant piped to nozzles round the engine, set off by heat sensors. When a fire takes hold in the engine bay it puts it out by itself, in moments, before it can reach the cab.</description>
          <upgradeExplanation>In the engine bay: puts out a fire there the moment it is sensed, before it spreads to the crew compartment.
Discharges once, by itself, and is spent until a mechanic recharges it with a suppressant bottle.
Cargo room: 30 kg less.
Kit weight: 30 kg more, carried as cargo.</upgradeExplanation>
          <icon>Phobos/VehicleSystems/Things/SuppressantBottle</icon>
          <work>1500</work>
          <gridCoordinate>(34, 17)</gridCoordinate>
          <drawSize>(80, 80)</drawSize>
          <researchPrerequisites>
            <li>Firefoam</li>
          </researchPrerequisites>
          <prerequisiteNodes>
            <li>PhobosArmouredCab</li>
          </prerequisiteNodes>
          <upgrades>
            <li Class="Vehicles.StatUpgrade">
              <vehicleStats>
              <li>
                <def>CargoCapacity</def>
                <value>-30</value>
              </li>
              <li>
                <def>Phobos_KitKilograms</def>
                <value>30</value>
              </li>
              </vehicleStats>
            </li>
            <li Class="Phobos.VehicleSystems.PhobosSuppressionUpgrade">
              <zone>EngineBay</zone>
            </li>
            <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
          </upgrades>
          <ingredients>
            <PhobosVehicleSystems_SuppressantBottle>1</PhobosVehicleSystems_SuppressantBottle>
            <Steel>15</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
          </ingredients>
        </li>
        <li>
          <!-- Framework 0.241.0, FR10(b) (the owner's answers of 23 Nov 2026): the crew compartment's automatic system. -->
          <key>PhobosSuppressionCrew</key>
          <label>Crew fire suppression</label>
          <displayLabel>true</displayLabel>
          <description>A bottle of suppressant piped to nozzles in the cab, set off by fast flame sensors, as armoured vehicles carry. When fire reaches the crew compartment it puts it out by itself in a fraction of a second; the suppressant is safe for the crew to breathe.</description>
          <upgradeExplanation>In the crew compartment: puts out a fire there the moment it is sensed, from a hit or from the engine bay.
Discharges once, by itself, and is spent until a mechanic recharges it with a suppressant bottle.
Cargo room: 30 kg less.
Kit weight: 30 kg more, carried as cargo.</upgradeExplanation>
          <icon>Phobos/VehicleSystems/Things/SuppressantBottle</icon>
          <work>1500</work>
          <gridCoordinate>(39, 17)</gridCoordinate>
          <drawSize>(80, 80)</drawSize>
          <researchPrerequisites>
            <li>Firefoam</li>
          </researchPrerequisites>
          <prerequisiteNodes>
            <li>PhobosArmouredCab</li>
          </prerequisiteNodes>
          <upgrades>
            <li Class="Vehicles.StatUpgrade">
              <vehicleStats>
              <li>
                <def>CargoCapacity</def>
                <value>-30</value>
              </li>
              <li>
                <def>Phobos_KitKilograms</def>
                <value>30</value>
              </li>
              </vehicleStats>
            </li>
            <li Class="Phobos.VehicleSystems.PhobosSuppressionUpgrade">
              <zone>CrewCompartment</zone>
            </li>
            <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
          </upgrades>
          <ingredients>
            <PhobosVehicleSystems_SuppressantBottle>1</PhobosVehicleSystems_SuppressantBottle>
            <Steel>15</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
          </ingredients>
        </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
