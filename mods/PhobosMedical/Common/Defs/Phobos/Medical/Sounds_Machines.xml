<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- D'thorga Medical's machines, devices and coughs (docs/development/sound-catalogue.md). Agent-made with Stable Audio 3 Small SFX, every one of the agent's shortlist
       leans taken by the owner (11 Nov 2026), levelled by scripts/art/export_sound.py against the game sound each comment names;
       the records beside the sound files say how. The volume extension lets D'thorga Framework's sound volume setting scale them.
       Coughs vary their pitch a little, so one patient never repeats the same cough. -->

  <!-- Ventilator breathing for a patient (S83): beside the game's Hemopump_Ambience, -3 dB. -->
  <SoundDef>
    <defName>PhobosMedical_Ventilator</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/Medical/Ventilator</clipPath>
          </li>
        </grains>
        <volumeRange>50</volumeRange>
        <distRange>5~20</distRange>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>
