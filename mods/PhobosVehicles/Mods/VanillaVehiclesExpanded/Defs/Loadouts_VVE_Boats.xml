<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vanilla Vehicles Expanded's boats (D'thorga Vehicles 0.132.0; docs/development/vehicle-standard.md, VS10). Not yet tested in game.

    - The Trawler is a working fishing boat, and a trawler carries a galley for a crew who live aboard (general knowledge of fishing vessels; a
      Danish-built trawler's deckhouse with "galley with provision room", Fiskerforum's review, secondary). It keeps D'thorga Framework's boat
      loadout and adds the land vehicles' fridge bay, water tank bay and outlet panel, and a galley bay with a galley from the factory (the
      owner's card of 28 Nov 2026: "Bays only, unless some have a kitchenette in real life? Which if so, they get that by default"). Each
      appended last, so a saved trawler keeps its parts where they were. The Dinghy, an open boat, keeps the plain boat loadout.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutBoat">
    <defName>PhobosVehicleLoadout_Boat_VVETrawler</defName>
    <label>trawler</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Trawler</li>
      </vehicleDefs>
    </selector>
    <partRoles>
      <li>
        <role>FridgeBay</role>
        <add>
          <key>PhobosFridgeBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>fridge bay</label>
          <health>20</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>WaterTankBay</role>
        <add>
          <key>PhobosWaterTankBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>water tank bay</label>
          <health>25</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>OutletPanel</role>
        <add>
          <key>PhobosOutletPanel</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>outlet panel</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.08</hitWeight>
          <hitWeightCE>3</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <!-- The galley's place, for the galley it leaves the factory with. Health and hit weights authored, a little more than a fridge bay's. -->
        <role>GalleyBay</role>
        <add>
          <key>PhobosGalleyBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>galley</label>
          <health>30</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <!-- D'thorga Vehicles 0.134.0 (the owner's answer of 28 Nov 2026, "Pump on both, clutch on the Trawler"; found by the partly bound audit): the
           raw-water pump that draws the sea through the engine's cooler, the part the cooling system names as its water pump, and the clutch
           in the trawler's marine gearbox, the transmission system's clutch (general knowledge of marine diesels, unverified). Here and not
           on the boat base, and after the galley, so a saved trawler keeps every part where it was. Health and hit weights the land base's. -->
      <li>
        <role>WaterPump</role>
        <add>
          <key>PhobosWaterPump</key>
          <label>raw-water pump</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>Clutch</role>
        <add>
          <key>PhobosClutch</key>
          <label>clutch</label>
          <health>25</health>
          <hitWeight>0.2</hitWeight>
          <hitWeightCE>5</hitWeightCE>
          <cellsOf>Transmission</cellsOf>
          <last>true</last>
        </add>
      </li>
    </partRoles>
    <factoryFittings>
      <li>PhobosFitting_Galley</li>
    </factoryFittings>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <!--
    The Dinghy (D'thorga Vehicles 0.134.0; the owner's answer of 28 Nov 2026, "Pump on both, clutch on the Trawler"): the plain boat loadout with
    the raw-water pump its cooling system names, an outboard's water pump (general knowledge, unverified). A loadout of its own, so the pump
    is added last on the Dinghy alone and no saved trawler's parts move. No clutch: an outboard is excused in the bindings audit.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutBoat">
    <defName>PhobosVehicleLoadout_Boat_VVEDinghy</defName>
    <label>dinghy</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Dinghy</li>
      </vehicleDefs>
    </selector>
    <partRoles>
      <li>
        <role>WaterPump</role>
        <add>
          <key>PhobosWaterPump</key>
          <label>raw-water pump</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
          <last>true</last>
        </add>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
