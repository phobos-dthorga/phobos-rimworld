<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What the water bowser is made of, by role (docs/development/parts-bills.md; D'thorga Vehicles 0.55.0). A tank trailer on two axles: four tyres,
       their springs, a frame, the wiring for its lights and its hose. Each role is filled at start-up by an installed mod's part where it suits and by
       ours otherwise. Counts authored, held for the owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef DBHLite="true">
    <defName>PhobosBill_WaterBowser</defName>
    <label>water bowser parts</label>
    <target>Phobos_WaterBowser_Blueprint</target>
    <parts>
      <Wheels>4</Wheels>
      <Suspension>2</Suspension>
      <Frame>1</Frame>
      <!-- D'thorga Vehicles 0.88.0: the lighting harness for the lights it runs from the truck, where it had been charged a whole electrical kit. -->
      <Lighting>1</Lighting>
      <Hose>1</Hose>
    </parts>
    <!-- D'thorga Vehicles 0.88.0: the second hose is a hose set; its node's own ingredients are the coupling and nozzle beside it. -->
    <nodes>
      <li>
        <key>PhobosBowserSecondHose</key>
        <parts>
          <Hose>1</Hose>
        </parts>
      </li>
    </nodes>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
