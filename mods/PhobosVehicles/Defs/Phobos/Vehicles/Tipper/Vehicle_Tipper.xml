          </li>
          <!-- Vehicles 0.102.0, camp gear drawn on our vehicles (the owner's "everything on ours", 22 Nov 2026): the light deck tent on the deck. -->
          <li>
            <key>campDeckTent</key>
            <looks>
              <li>
                <fitting>PhobosFitting_DeckTent</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_DeckTent</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <!-- Vehicles 0.102.0, camp gear drawn on our vehicles (the owner's "everything on ours", 22 Nov 2026): the roomy deck tent on the deck. -->
          <li>
            <key>campDeckTentRoomy</key>
            <looks>
              <li>
                <fitting>PhobosFitting_DeckTentRoomy</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_DeckTentRoomy</texPath>
