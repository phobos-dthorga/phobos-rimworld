<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    The Harrier's bombs and rockets at The Dead Man's Switch's ammunition fabricator, as well as at the machining table.
    Owner's request, 3 Nov 2026.

    The fabricator runs an ordinary recipe (Fortified.Building_WorkTableAutonomous, read 3 Nov 2026), so naming it among
    the bombs' benches is all it takes.

    The fabricator exists only with Combat Extended (Dead Man's Switch's 1.7/CE folder), the only setup where the jet
    loads these items. The guard needs no load order: the game combines every mod's Defs before it applies any patch
    (LoadedModManager).
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DMS_TableAmmoPrinter"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Mk. 82 -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="FWA_Bomb500lb"]/recipeMaker/recipeUsers</xpath>
          <value>
            <li>DMS_TableAmmoPrinter</li>
          </value>
        </li>
        <!-- Mk. 84s -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="Harrier_Mk84Bomb_Incendiary"]/recipeMaker/recipeUsers</xpath>
          <value>
            <li>DMS_TableAmmoPrinter</li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="Harrier_Mk84Bomb_EMP"]/recipeMaker/recipeUsers</xpath>
          <value>
            <li>DMS_TableAmmoPrinter</li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="Harrier_Mk84Bomb_Smoke"]/recipeMaker/recipeUsers</xpath>
          <value>
            <li>DMS_TableAmmoPrinter</li>
          </value>
        </li>
        <!-- Exists only with Biotech, hence success on each. -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="Harrier_Mk84Bomb_ToxGas"]/recipeMaker/recipeUsers</xpath>
          <value>
            <li>DMS_TableAmmoPrinter</li>
          </value>
        </li>
        <!--
          The 57 mm rockets the jet loads (AmmoSet_Harrier57mmRocket). These are RecipeDefs, not recipeMakers. CE's
          AmmoInjector may add the fabricator itself, but only for ammo it counts as used, and vehicle turrets aren't
          weapons with an ammo user. Naming it here makes sure, and AddDistinct and AllRecipes cope with it being there
          twice. Thermobaric isn't in the jet's set.
        -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="MakeAmmo_57mmRocket_HE"]/recipeUsers</xpath>
          <match Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/RecipeDef[defName="MakeAmmo_57mmRocket_HE"]/recipeUsers</xpath>
            <value>
              <li>DMS_TableAmmoPrinter</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/RecipeDef[defName="MakeAmmo_57mmRocket_HE"]</xpath>
            <value>
              <recipeUsers>
                <li>DMS_TableAmmoPrinter</li>
              </recipeUsers>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="MakeAmmo_57mmRocket_HEAT"]/recipeUsers</xpath>
          <match Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/RecipeDef[defName="MakeAmmo_57mmRocket_HEAT"]/recipeUsers</xpath>
            <value>
              <li>DMS_TableAmmoPrinter</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/RecipeDef[defName="MakeAmmo_57mmRocket_HEAT"]</xpath>
            <value>
              <recipeUsers>
                <li>DMS_TableAmmoPrinter</li>
              </recipeUsers>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/RecipeDef[defName="MakeAmmo_Mongoose57mmRocket_AP"]/recipeUsers</xpath>
          <match Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/RecipeDef[defName="MakeAmmo_Mongoose57mmRocket_AP"]/recipeUsers</xpath>
            <value>
              <li>DMS_TableAmmoPrinter</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/RecipeDef[defName="MakeAmmo_Mongoose57mmRocket_AP"]</xpath>
            <value>
              <recipeUsers>
                <li>DMS_TableAmmoPrinter</li>
              </recipeUsers>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
