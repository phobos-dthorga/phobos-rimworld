<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    The Osprey drops by parachute and carries a small vehicle in its hold (D'thorga Framework 0.288.0, D'thorga Vehicles 0.120.0;
    docs/development/airdrop.md). A patch file of its own, as its flight's is. Its jumpers go out of the ramp and the side door, two at a time
    (authored from the V-22's two exits); bundles two a second down the ramp (authored); one vehicle on a platform per pass.
    Its hold: the V-22's cabin was built to take the Internally Transportable Vehicle [S, Wikipedia: Growler]; authored here as one vehicle
    up to 2 by 3 cells and 2,500 kg, within its cargo.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_Osprey"]/modExtensions</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_Osprey"]</xpath>
      <value>
        <modExtensions />
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_Osprey"]/modExtensions</xpath>
    <value>
      <li Class="Phobos.VehicleSystems.PhobosAirdropExtension">
        <jumpDoors>2</jumpDoors>
        <bundlesPerSecond>2</bundlesPerSecond>
        <platforms>1</platforms>
        <heaviestPlatformKg>2500</heaviestPlatformKg>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_Osprey"]/comps</xpath>
    <value>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosHold">
        <maxSize>(2, 3)</maxSize>
        <maxKg>2500</maxKg>
        <slots>1</slots>
        <rampReachCells>6</rampReachCells>
      </li>
    </value>
  </Operation>
</Patch>
