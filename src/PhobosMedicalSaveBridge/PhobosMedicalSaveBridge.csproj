<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Medical Save Bridge's assembly, built for RimWorld 1.7 (net10.0, Harmony 3) and 1.6 (net472, Harmony 2);
       Directory.Build.targets turns the target into the game version, the output folder and the references. It references
       no other mod's assembly: More Injuries is reached by name through Harmony's AccessTools, and MSE2 not at all. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Phobos.MedicalSaveBridge</RootNamespace>
    <AssemblyName>PhobosMedicalSaveBridge</AssemblyName>
    <ModFolder>PhobosMedicalSaveBridge</ModFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.1.2</Version>
  </PropertyGroup>
</Project>
