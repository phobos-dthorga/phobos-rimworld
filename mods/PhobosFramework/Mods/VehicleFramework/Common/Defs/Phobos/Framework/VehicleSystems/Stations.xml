<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Our own Architect tab (owner, 9 Nov 2026), beside Vehicle Framework's: a large mod list buries anything in the shared tabs. The order sits
       just below its 24, so the two are neighbours. The label is an agent's choice. -->
  <DesignationCategoryDef>
    <defName>PhobosVehicles_MotorPool</defName>
    <label>motor pool</label>
    <description>Workshops for vehicle parts and tuning, and the vehicles themselves.</description>
    <order>23</order>
    <specialDesignatorClasses>
      <li>Designator_Cancel</li>
      <li>Designator_Deconstruct</li>
    </specialDesignatorClasses>
  </DesignationCategoryDef>

  <!-- Vehicle parts are made here and nowhere else (owner, 9 Nov 2026), so they stop adding to the machining table's list. Layout, cost and power are
       authored, a little under the machining table's (150 steel, 5 components, 350 W) because it makes only these. -->
  <ThingDef ParentName="BenchBase">
    <defName>PhobosVehicles_PartsBench</defName>
    <label>vehicle parts bench</label>
    <description>A bench laid out for one trade: engines, gearboxes, turbines, jump-start kits and booster packs. Everything it makes is for keeping vehicles running.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Stations/PartsBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-2</Cleanliness>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <uiOrder>100</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>PhobosResearch_VehicleParts</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
          <li>PhobosVehicles_InspectionPit</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Breakdownable" />
    </comps>
  </ThingDef>

  <!-- An inspection pit beside the parts bench speeds its work (owner, 10 Nov 2026: a production bonus, as Dead Man's Switch does with its
       workshop buildings): a part is offered up to a vehicle from below to check its fit before it leaves the bench. A facility the way
       the game's tool cabinet is: one counts, a 15% bonus (the tool cabinet gives 6% and two may count). Cost, size and bonus authored.
       The picture is the depot bay's, a placeholder until the owner asks for one of its own. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PhobosVehicles_InspectionPit</defName>
    <label>inspection pit</label>
    <description>A concrete-lined pit with a work light and a parts lift. Beside a vehicle parts bench, it lets each part be offered up from below and checked before it is finished, so the bench works faster.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Stations/DepotBay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>30</pathCost>
    <fillPercent>0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>4000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <uiOrder>105</uiOrder>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>PhobosResearch_VehicleParts</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <WorkTableWorkSpeedFactor>0.15</WorkTableWorkSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>
  </ThingDef>

  <!-- Sends colonists to the parts bench's bills. A bench without one of these is never worked, whatever its bills (fixed 10 Nov 2026: the bench
       had shipped without it). Smithing, the work type of the machining table the parts were once made at, with the same priority (agent's choice). -->
  <WorkGiverDef>
    <defName>PhobosVehicles_DoBillsPartsBench</defName>
    <label>make vehicle parts</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Smithing</workType>
    <priorityInType>75</priorityInType>
    <fixedBillGiverDefs>
      <li>PhobosVehicles_PartsBench</li>
    </fixedBillGiverDefs>
    <verb>work at</verb>
    <gerund>working at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- Tunes and changes of grade are done within reach of one of these (owner, 9 Nov 2026). Its size, reach, cost and power are authored. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PhobosVehicles_TuningRig</defName>
    <label>tuning rig</label>
    <description>Test instruments and a hoist on a heavy frame. An engine can only be tuned, and a working part only changed for one of another grade, with a vehicle parked close by and the rig powered.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Stations/TuningRig</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <fillPercent>0.4</fillPercent>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>30</Mass>
    </statBases>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <uiOrder>110</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>PhobosResearch_VehicleTuning</li>
    </researchPrerequisites>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <placeWorkers>
      <li>Phobos.VehicleSystems.PlaceWorker_PhobosTuningRigReach</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTuningRig">
        <reach>3</reach>
      </li>
    </comps>
  </ThingDef>

  <!-- A vehicle's home (owner, 9 Nov 2026; docs/development/vehicle-depot-bays.md). The bay itself is a fuel tank, a pump and a parts shelf; the pad in front of it is an outline, not a building, so it blocks nothing.
       Authored: its size, pad, pump, work speed, cost and power. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PhobosVehicles_DepotBay</defName>
    <label>depot bay</label>
    <description>A vehicle's home: a fuel tank with a pump, and a shelf for its spare parts, beside a marked parking pad. Give it one vehicle. Parked on the pad, that vehicle is refuelled with no one attending, and mechanics work on it faster.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Phobos/VehicleSystems/Stations/DepotBay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <tickerType>Rare</tickerType>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <uiOrder>120</uiOrder>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>PhobosResearch_VehicleDepot</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>3</maxItemsInCell>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Manufactured</li>
            <li>ResourcesRaw</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>PhobosVehicles_EngineAssembly</li>
            <li>PhobosVehicles_DrivetrainKit</li>
            <li>PhobosVehicles_ElectricalKit</li>
            <li>PhobosVehicles_Transmission</li>
            <li>PhobosVehicles_TurbineAssembly</li>
            <li>PhobosVehicles_TyreSet</li>
            <li>PhobosVehicles_BrakePadSet</li>
            <li>PhobosVehicles_ServiceKit</li>
            <li>PhobosVehicles_DriveBelt</li>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <placeWorkers>
      <li>Phobos.VehicleSystems.PlaceWorker_PhobosDepotBayPad</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>200</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>chemfuel in the tank</fuelLabel>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosDepotBay" />
    </comps>
  </ThingDef>

</Defs>
