<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The two figures a submersible's parts feed (docs/development/submarine-framework.md). Put them in a Sea vehicle's vehicleStats and in its parts'
       categories, beside a Phobos.VehicleSystems.CompProperties_PhobosSubmersible in its comps. Not yet tested in game. -->
  <Vehicles.VehicleStatDef>
    <defName>Phobos_DiveEndurance</defName>
    <label>time under</label>
    <description>How many hours of air and charge the boat can hold, sitting still. It goes three times as fast on the move, by default, and the surface refills it.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>FloatOne</toStringStyle>
    <formatString>{0} h</formatString>
    <operationType>Average</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_DiveControl</defName>
    <label>diving trim</label>
    <description>How well the ballast tanks and the hull hold the boat under control. Below a certain point it will not dive, and a boat already under comes up.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <formatString>{0}</formatString>
    <operationType>MinValue</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_DiveBottoming</defName>
    <label>bottoming gear</label>
    <description>Whether the boat has wheels or skids to rest on the bottom. Above nothing, it can settle there.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <formatString>{0}</formatString>
    <operationType>MinValue</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_DiveStaleAirRate</defName>
    <label>stale air rate</label>
    <description>How quickly the air turns bad for a crew that stays under after running out. Lower is better.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <formatString>{0}</formatString>
    <operationType>Average</operationType>
    <upgradeEffectType>Negative</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <!-- A laboratory carried by a vehicle (Phobos.VehicleSystems.CompProperties_PhobosFieldLab; docs/development/vehicle-seabed-crawler.md). Any vehicle may use them,
       not only boats. The factor multiplies each seated scientist's research speed, as a bench's research speed factor does; the grade says which projects it takes. -->
  <Vehicles.VehicleStatDef>
    <defName>Phobos_FieldLabFactor</defName>
    <label>laboratory speed</label>
    <description>How fast the scientists aboard can carry on research, compared with their speed at a bench. Damage to the laboratory slows it.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <formatString>{0}</formatString>
    <operationType>Average</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
  </Vehicles.VehicleStatDef>
  <Vehicles.VehicleStatDef>
    <defName>Phobos_FieldLabGrade</defName>
    <label>laboratory grade</label>
    <description>Which research the laboratory aboard can take on. At 1 it takes any project that needs no particular bench; at 2 it also stands in for a hi-tech research bench and its equipment.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0}</formatString>
    <operationType>MinValue</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
  </Vehicles.VehicleStatDef>
  <!-- A listening array (Phobos.VehicleSystems.CompProperties_PhobosListening; docs/development/vehicle-seabed-crawler.md). Any vehicle in the water may use it. Feed it from the array's part, so damage
       there shortens it; the best hearing aboard and the vehicle's own motion shorten it further. -->
  <Vehicles.VehicleStatDef>
    <defName>Phobos_ListeningRange</defName>
    <label>listening range</label>
    <description>How far the listening array hears things moving, at rest and with good ears aboard. It hears half as far on the move, and things on land at half the distance.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0} cells</formatString>
    <operationType>Average</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <!-- An active sonar set (Phobos.VehicleSystems.CompProperties_PhobosSonar; docs/development/vehicle-seabed-crawler.md). Any vehicle in the water may use it. Feed it from the set's part, so damage
       there shortens it. -->
  <Vehicles.VehicleStatDef>
    <defName>Phobos_SonarRange</defName>
    <label>sonar range</label>
    <description>How far a sonar ping finds things in the water, moving or still. The ping itself is heard twice as far away, and gives the boat away for a while.</description>
    <category>VehicleBasics</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
    <formatString>{0} cells</formatString>
    <operationType>Average</operationType>
    <upgradeEffectType>Positive</upgradeEffectType>
    <showOnVehicleTypes>
      <li>Sea</li>
      <li>Universal</li>
    </showOnVehicleTypes>
  </Vehicles.VehicleStatDef>
  <!-- What a crew breathes if ordered to stay under with nothing left: carbon dioxide building up in a sealed hull. The stages and rates are authored for play and are not a dose-response model. -->
  <HediffDef>
    <defName>Phobos_StaleAir</defName>
    <label>stale air</label>
    <description>Too long breathing air that has been used up. It causes headaches, gasping and confusion, then unconsciousness, and it can kill. Fresh air clears it within hours.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.7, 0.9)</defaultLabelColor>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>1</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>stuffy</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>headache</label>
        <minSeverity>0.1</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>gasping</label>
        <minSeverity>0.3</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>confused</label>
        <minSeverity>0.55</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>passing out</label>
        <minSeverity>0.8</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
