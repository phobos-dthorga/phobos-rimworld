<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vanilla Vehicles Expanded's aircraft with more than one engine part or a rotor drive (docs/development/vehicle-power-and-lift-design.md).
    Not yet tested in game.

    - The Frog and the Toad are thrust-lifted pods with three and four thrusters of their own (FirstThruster and so on), bound as
      their engines: each one lost takes its share of lift, and a pod whose thrusters cannot lift it will not launch (the player's
      hover-limit setting). Their lift-to-weight at maximum gross weight is authored for these fictional craft: the Frog 1.5 (one
      thruster out, it just lifts when full), the Toad 1.4 (one out, it still lifts; two out, only lightened).
    - The Mosquito is a light four-seat helicopter: one turboshaft (an agent's choice: the mod does not say what drives it) and its
      own RotorMast as the rotor drive. Its drive limit, 0.9 of maximum continuous, is authored: the mod names no real helicopter.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Frog</defName>
    <label>thrust-lifted pod (three thrusters)</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Frog</li>
      </vehicleDefs>
    </selector>
    <systems Inherit="False">
      <li><def>PhobosVehicleSystem_Electrical</def></li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
      <li><def>PhobosVehicleSystem_FlightControls</def></li>
      <li><def>PhobosVehicleSystem_Avionics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_Thrusters</def>
      <set>
        <liftToWeightAtMaxGross>1.5</liftToWeightAtMaxGross>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockThrustLift</flightProfile>
    <partRoles>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <key>FirstThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <key>SecondThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine3</role>
        <find>
          <li>
            <key>ThirdThruster</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Toad</defName>
    <label>thrust-lifted assault pod (four thrusters)</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Toad</li>
      </vehicleDefs>
    </selector>
    <systems Inherit="False">
      <li><def>PhobosVehicleSystem_Electrical</def></li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
      <li><def>PhobosVehicleSystem_FlightControls</def></li>
      <li><def>PhobosVehicleSystem_Avionics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_Thrusters</def>
      <set>
        <liftToWeightAtMaxGross>1.4</liftToWeightAtMaxGross>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockThrustLift</flightProfile>
    <partRoles>
      <li>
        <role>Engine1</role>
        <find>
          <li>
            <key>FirstThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li>
            <key>SecondThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine3</role>
        <find>
          <li>
            <key>ThirdThruster</key>
          </li>
        </find>
      </li>
      <li>
        <role>Engine4</role>
        <find>
          <li>
            <key>FourthThruster</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Mosquito</defName>
    <label>light helicopter</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Mosquito</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AeroTurboshaft</def>
      <set>
        <transmissionLimit>0.9</transmissionLimit>
      </set>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_StockRotorcraft</flightProfile>
    <partRoles>
      <li>
        <!-- Framework 0.110.0, avionics A7: the flight controls' hydraulic boost, on the aircraft's own servos. -->
        <role>HydraulicPump</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Servos</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>Servos</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>RotorMast</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <!--
    The Smuggler and the Warbird (Framework 0.110.0): until now both ran the generic aircraft loadout. They get loadouts of their own for their
    avionics and flight hydraulics (on their Servos part). Both still have the generic loadout's turbofan: a piston engine for an aircraft needs
    its own engine model, set aside (docs/development/vehicle-avionics.md, L5). Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Smuggler</defName>
    <label>light cargo plane</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Smuggler</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <partRoles>
      <li>
        <!-- Avionics A7: the flight controls' hydraulic boost, on the aircraft's own servos. -->
        <role>HydraulicPump</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_VVE_Warbird</defName>
    <label>fighter</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_Warbird</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <!-- A fighter in the P-51's mould carries a gunsight (agent default). -->
    <avionics>
      <sight>Basic</sight>
    </avionics>
    <partRoles>
      <li>
        <!-- Avionics A7: the flight controls' hydraulic boost, on the aircraft's own servos. -->
        <role>HydraulicPump</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li>
            <key>Servos</key>
          </li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
