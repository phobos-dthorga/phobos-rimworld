<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Medical's assembly, built for RimWorld 1.7 only (net10.0); Directory.Build.targets turns the target
       into the game version, the output folder and the game reference. Five mods were merged into it on 7 November 2026: each
       keeps its folder here and its namespace (Phobos.BurnsAndSmoke, Phobos.Dosing, Phobos.Triage, Phobos.Medical for the
       equipment, Phobos.MedicalSaveBridge), because saves name classes by namespace and must keep loading.
       It references the game and D'thorga Framework (Private=false: the framework's DLL ships only in its own mod). Vanilla
       Expanded Framework's PipeSystem.dll is referenced for the liquid oxygen store's boil-off, from the installed mod and never
       copied: its licence (CC BY-NC-ND 4.0) permits depending on it, not redistributing it. Harmony is compiled against, never
       shipped. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Medical</RootNamespace>
    <AssemblyName>PhobosMedical</AssemblyName>
    <ModFolder>PhobosMedical</ModFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.11.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
    <Reference Include="PipeSystem">
      <HintPath>$(VefAssemblies)\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
