<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The tipper hauler: a heavy truck that carries a yard's worth and puts it all down in one go (docs/development/vehicle-tipper-hauler.md). The 2,400 kg is the owner's; every other figure is authored and untuned. Part keys are saved by position: append only,
    never reorder. Cells run x -1 to 1, z -3 to 4. Its pictures were generated for it on 12 Nov 2026 (assets/phobos-vehicles/requests/night-2026-11-12-record.md). Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_Tipper</defName>
    <label>Talus tipper truck</label>
    <description>Talus T1: a heavy truck with a steel body that lifts to tip its whole load onto the ground behind it. Load it at the quarry or the drill, drive home, back it up to the yard, and tip: one drive instead of a hundred carries. It looks after nothing but the load: what lands is hauled away as from any pile.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Tipper/Tipper</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(4, 9)</drawSize>
      <color>(162, 156, 123)</color>
      <colorTwo>(195, 110, 36)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_Tipper_Blueprint</buildDef>
    <size>(3, 8)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <!-- Read only for collisions since D'thorga Vehicles 0.76.0: every part carries its own armour by class, which overrides these
           (vehicle-armour.md). Heat stays the whole truck's. -->
      <ArmorRating_Blunt>0.26</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.5</Flammability>
      <MarketValue>2800</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>360</Mass>
      <MoveSpeed>11</MoveSpeed>
      <CargoCapacity>2400</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
      <Phobos_TipRate>2</Phobos_TipRate>
      <Phobos_RigControl>1</Phobos_RigControl>
    </vehicleStats>
    <race>
      <baseBodySize>7</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>6</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
      <!-- Armour by class (D'thorga Vehicles 0.76.0; owner, 19 Nov 2026; docs/development/vehicle-armour.md): every part is Skin, as no
           source states that a civilian truck stops a bullet. Combat Extended's figures for the same class are in
           Mods/CombatExtended/Patches. One outer part to a cell (owner): the chassis is outer only where nothing else covers it, and the
           lights and the parts changed with them sit inside. Parts are saved by place: append only, never reorder. -->
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>160</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitWeight>3</hitWeight>
      <hitbox>
        <cells>
          <li>(0, 4)</li>
          <li>(-1, 2)</li>
          <li>(0, 2)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>50</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Engine</key>
      <label>engine</label>
      <health>60</health>
      <depth>Internal</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
