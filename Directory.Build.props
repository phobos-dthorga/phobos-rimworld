<Project>
  <!-- Shared by every C# project under src/. Every project builds net10.0 for RimWorld 1.7 only (owner, 8 November 2026);
       Directory.Build.targets turns the target into the game version, the output folder and the game references
       (docs/development/building.md). The output folder is set in Directory.Build.targets, which wins over the SDK's
       appended one. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
</Project>
