<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Part conditions: slice 2 of the vehicle health design (docs/development/vehicle-health-design.md), Framework 0.29.0. A condition
    belongs to one Vehicle Framework part, as an injury belongs to a body part, and adds what the part's health cannot say: a holed
    radiator goes on leaking after the shot. Each stage has the same effects a system's stage has. Not yet tested in game.

    Labels, descriptions and stage names are agent-authored (8 Nov 2026), held for the owner's review. Every rate is authored for
    play, not measured:
    - A holed radiator loses coolant at a rate that grows with the damage: a seep takes about 20 game hours to bring the coolant to
      its top-up level (60%), a bad leak about 5, and a radiator torn open under an hour and a half. Coolant loss then overheats the engine through
      the cooling system's own stages. Real radiators leak at every rate from drips to a gush; these three are a gameplay ladder.
    - A shorted battery discharges itself: a damaged lead-acid battery with an internal short self-discharges far faster than a
      sound one (secondary: battery makers' service notes on shorted cells). The rates (1% and 5% of charge an hour) are authored.
    - A warped cylinder head follows severe overheating (secondary: Wikipedia, "Head gasket" and "Cylinder head"): combustion gas
      reaches the coolant and the engine runs hotter, and a badly warped head loses compression and power. The extra heat (10 and 30
      degrees an hour while running, against 420 at full load) and the power loss (10%) are authored.
    All three clear when the part is repaired to full health (Vehicle Framework's own repair), but a badly warped head needs its own
    job (slice 3): a head that is badly warped is not put right by patching the engine. None fades by itself. A holed radiator and a
    shorted battery can be patched in the field; a warped head cannot.
  -->
  <Phobos.VehicleSystems.PhobosVehicleConditionDef>
    <defName>PhobosVehicleCondition_HoledRadiator</defName>
    <label>holed</label>
    <description>Shot or shrapnel has holed the radiator, and the coolant leaks away. Repair the radiator to stop it, and top the coolant up.</description>
    <fieldFixable>true</fieldFixable>
    <stages>
      <li>
        <to>0.3</to>
        <label>seeping</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>coolantLevel</quantity>
            <perHour>-0.02</perHour>
          </li>
        </effects>
      </li>
      <li>
        <from>0.3</from>
        <to>0.7</to>
        <label>leaking</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>coolantLevel</quantity>
            <perHour>-0.08</perHour>
          </li>
        </effects>
      </li>
      <li>
        <from>0.7</from>
        <label>pouring out</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>coolantLevel</quantity>
            <perHour>-0.3</perHour>
          </li>
        </effects>
      </li>
    </stages>
  </Phobos.VehicleSystems.PhobosVehicleConditionDef>

  <Phobos.VehicleSystems.PhobosVehicleConditionDef>
    <!-- Framework 0.53.0, agent-authored and held for the owner's review. A little slower than the radiator's ladder: a sump is not under pressure. The rates are
         authored; the oil then starves the engine through the lubrication system's own stages. -->
    <defName>PhobosVehicleCondition_CrackedSump</defName>
    <label>cracked sump</label>
    <description>A hit has cracked the engine's sump, and the oil leaks away even with the engine stopped. Repair the engine to stop it, and top the oil up.</description>
    <fieldFixable>true</fieldFixable>
    <stages>
      <li>
        <to>0.3</to>
        <label>seeping</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>oilLevel</quantity>
            <perHour>-0.01</perHour>
          </li>
        </effects>
      </li>
      <li>
        <from>0.3</from>
        <to>0.7</to>
        <label>leaking</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>oilLevel</quantity>
            <perHour>-0.05</perHour>
          </li>
        </effects>
      </li>
      <li>
        <from>0.7</from>
        <label>pouring out</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>oilLevel</quantity>
            <perHour>-0.2</perHour>
          </li>
        </effects>
      </li>
    </stages>
  </Phobos.VehicleSystems.PhobosVehicleConditionDef>

  <Phobos.VehicleSystems.PhobosVehicleConditionDef>
    <defName>PhobosVehicleCondition_ShortedBattery</defName>
    <label>shorted</label>
    <description>A hit has damaged the battery's cells, and it drains itself even when nothing draws on it. Repair the battery to stop it.</description>
    <fieldFixable>true</fieldFixable>
    <stages>
      <li>
        <to>0.4</to>
        <label>slow drain</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>charge</quantity>
            <perHour>-0.01</perHour>
          </li>
        </effects>
      </li>
      <li>
        <from>0.4</from>
        <label>draining fast</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>charge</quantity>
            <perHour>-0.05</perHour>
          </li>
        </effects>
      </li>
    </stages>
  </Phobos.VehicleSystems.PhobosVehicleConditionDef>

  <Phobos.VehicleSystems.PhobosVehicleConditionDef>
    <defName>PhobosVehicleCondition_WarpedHead</defName>
    <label>warped cylinder head</label>
    <description>Boiling over has warped the engine's cylinder head. Hot gas leaks into the coolant, so the engine runs hotter, and a badly warped head costs power. Repair the engine to fix a slight warp; a bad one needs the head taken off and machined flat.</description>
    <needsServiceFrom>0.4</needsServiceFrom>
    <service>
      <label>machining the cylinder head flat</label>
      <supplies>
        <Steel>15</Steel>
        <ComponentIndustrial>3</ComponentIndustrial>
      </supplies>
      <work>3000</work>
    </service>
    <stages>
      <li>
        <to>0.4</to>
        <label>slightly</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>coolantTemperature</quantity>
            <perHour>10</perHour>
            <when Class="Phobos.VehicleSystems.When_EngineRunning" />
          </li>
        </effects>
      </li>
      <li>
        <from>0.4</from>
        <label>badly</label>
        <notable>true</notable>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_RateQuantity">
            <quantity>coolantTemperature</quantity>
            <perHour>30</perHour>
            <when Class="Phobos.VehicleSystems.When_EngineRunning" />
          </li>
          <li Class="Phobos.VehicleSystems.Effect_StatFactor">
            <stat>MoveSpeed</stat>
            <factor>0.9</factor>
          </li>
        </effects>
      </li>
    </stages>
  </Phobos.VehicleSystems.PhobosVehicleConditionDef>
</Defs>
