<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The tipper hauler: a heavy truck that carries a yard's worth and puts it all down in one go (docs/development/vehicle-tipper-hauler.md). The 2,400 kg is the owner's; every other figure is authored and untuned. Part keys are saved by position: append only,
    never reorder. Cells run x -1 to 1, z -3 to 4. It borrows the bulk tanker's picture until it has its own (owner, 9 Nov 2026). Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_Tipper</defName>
    <label>Talus tipper truck</label>
    <description>Talus T1: a heavy truck with a steel body that lifts to tip its whole load onto the ground behind it. Load it at the quarry or the drill, drive home, back it up to the yard, and tip: one drive instead of a hundred carries. It looks after nothing but the load: what lands is hauled away as from any pile.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(4, 9)</drawSize>
      <color>(162, 156, 123)</color>
      <colorTwo>(195, 110, 36)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_Tipper_Blueprint</buildDef>
    <size>(3, 8)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.26</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.5</Flammability>
      <MarketValue>2800</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>360</Mass>
      <MoveSpeed>11</MoveSpeed>
      <CargoCapacity>2400</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
      <Phobos_TipRate>2</Phobos_TipRate>
      <Phobos_RigControl>1</Phobos_RigControl>
    </vehicleStats>
    <race>
      <baseBodySize>7</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>6</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>160</health>
      <depth>External</depth>
      <hitWeight>3</hitWeight>
      <hitbox>
        <from>(-1, -3)</from>
        <to>(1, 4)</to>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>50</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Engine</key>
      <label>engine</label>
      <health>60</health>
      <depth>Internal</depth>
      <priorityStatEfficiency>true</priorityStatEfficiency>
      <reactors>
        <li Class="Vehicles.Reactor_Explosive">
          <indicator>VF_Explosive</indicator>
          <chance>0.25</chance>
          <maxHealth>0.2</maxHealth>
          <radius>3</radius>
          <damageDef>Flame</damageDef>
        </li>
      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(0, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
        <li>Phobos_TipRate</li>
      </categories>
    </li>
    <li>
      <key>Transmission</key>
      <label>transmission</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FrontWheels</key>
      <label>front axle and wheels</label>
      <health>35</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>RearWheels</key>
      <label>rear axles and wheels</label>
      <health>55</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, -1)</li>
          <li>(1, -1)</li>
          <li>(-1, -2)</li>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FuelTank</key>
      <label>fuel tank</label>
      <health>35</health>
      <depth>Internal</depth>
      <reactors>
        <li Class="Vehicles.Reactor_FuelLeak" />
      </reactors>
      <hitbox>
        <cells>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>TipperBody</key>
      <label>tipper body</label>
      <health>90</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 1)</li>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
          <li>(-1, 0)</li>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
          <li>(-1, -1)</li>
          <li>(0, -1)</li>
          <li>(1, -1)</li>
          <li>(-1, -2)</li>
          <li>(0, -2)</li>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>CargoCapacity</li>
      </categories>
    </li>
    <li>
      <key>TippingRams</key>
      <label>tipping rams</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 1)</li>
          <li>(0, 0)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_TipRate</li>
      </categories>
    </li>
    <li>
      <key>HydraulicPump</key>
      <label>hydraulic pump and power take-off</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(-1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_TipRate</li>
      </categories>
    </li>
    <li>
      <key>Tailgate</key>
      <label>tailgate</label>
      <health>30</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, -3)</li>
          <li>(0, -3)</li>
          <li>(1, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>CargoCapacity</li>
      </categories>
    </li>
    <li>
      <key>TipControls</key>
      <label>tip controls and valve block</label>
      <health>25</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>Wiring</key>
      <label>wiring</label>
      <health>25</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>Lights</key>
      <label>lights</label>
      <health>15</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(1, 4)</li>
          <li>(-1, -3)</li>
          <li>(1, -3)</li>
        </cells>
      </hitbox>
    </li>
    </components>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>10000</emptyKilograms>
        <ratedKilowatts>220</ratedKilowatts>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosVehicles_TipperEngineIdle</idleSound>
        <loadSound>PhobosVehicles_TipperEngineLoad</loadSound>
      </li>
      <!-- Its work: the rams while tipping, the load sliding out by body (the first that applies plays), the tailgate. -->
      <li Class="Phobos.VehicleSystems.PhobosVehicleSoundsExtension">
        <sounds>
          <li><key>Rams</key><sound>PhobosVehicles_TipperRams</sound></li>
          <li><key>Slide</key><sound>PhobosVehicles_TipperSlideRock</sound><node>RockBody</node></li>
          <li><key>Slide</key><sound>PhobosVehicles_TipperSlideBulk</sound><node>BulkBody</node></li>
          <li><key>Slide</key><sound>PhobosVehicles_TipperSlide</sound></li>
          <li><key>Tailgate</key><sound>PhobosVehicles_TipperTailgate</sound></li>
        </sounds>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>28</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>120</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_Tipper_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosTipper" />
    </comps>
    <!-- Its own voice in place of the inherited draft blips; the engine loops are played by D'thorga Framework from the
         extension below, so they follow rpm and load (docs/development/sound-catalogue.md). -->
    <soundOneShotsOnEvent Inherit="False">
      <li>
        <key>IgnitionOn</key>
        <value>PhobosVehicles_TipperEngineStart</value>
      </li>
      <li>
        <key>IgnitionOff</key>
        <value>PhobosVehicles_TipperEngineStop</value>
      </li>
      <li>
        <key>PawnEntered</key>
        <value>PhobosVehicles_TipperDoor</value>
      </li>
      <li>
        <key>PawnExited</key>
        <value>PhobosVehicles_TipperDoor</value>
      </li>
      <li>
        <key>Braking</key>
        <value>PhobosVehicles_TipperAirBrake</value>
      </li>
      <li>
        <key>OutOfFuel</key>
        <value>PhobosVehicles_TipperSputter</value>
      </li>
    </soundOneShotsOnEvent>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_Tipper_Blueprint</defName>
    <label>Talus tipper truck</label>
    <description>Talus T1: a heavy truck that tips its whole load onto the ground behind it.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4, 9)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_Tipper</li>
    </researchPrerequisites>
    <size>(3, 8)</size>
    <!-- The shell only: its parts are in Bill_Tipper.xml, filled at start-up (docs/development/parts-bills.md). Steel stays first. -->
    <costList>
      <Steel>420</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_Tipper</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_Tipper</defName>
    <label>tipper truck</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Phobos_Tipper</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
    <!-- The body is raised by hydraulic rams (D'thorga Vehicles 0.33.0, Framework 0.73.0): the pump is bound, and the rams stand for the
         lines, since a hit on a ram is what bleeds the system. -->
    <systems>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
    </systems>
    <partRoles>
      <li>
        <role>HydraulicPump</role>
        <find>
          <li><keyContains>hydraulicpump</keyContains></li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li><keyContains>tippingrams</keyContains></li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
