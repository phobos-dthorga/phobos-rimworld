<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Clinical research (docs/development/research-tree.md). Costs, positions and soft requirements are authored, gameplay choices to tune in play. Names are stable once a save can hold them. -->

  <ResearchProjectDef Abstract="True" Name="PhobosResearchMedicalBase">
    <tab>PhobosDthorga</tab>
    <techLevel>Industrial</techLevel>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchMedicalBase">
    <defName>PhobosResearch_BasicClinicalKit</defName>
    <label>clinical equipment</label>
    <description>The tools of a working clinic: a steriliser, airway kits, resuscitators, drip sets and proper burn dressings.</description>
    <baseCost>1000</baseCost>
    <researchViewX>0</researchViewX>
    <researchViewY>4.0</researchViewY>
    <prerequisites>
      <li>MedicineProduction</li>
      <li MayRequire="th3fr3d.extendedinjuries">Cpr</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>MedicineProduction</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchMedicalBase">
    <defName>PhobosResearch_Respiratory</defName>
    <label>respiratory care</label>
    <description>Nebulisers, oxygen concentrators and ventilators, to keep someone breathing whose lungs cannot manage on their own.</description>
    <baseCost>2400</baseCost>
    <researchViewX>1</researchViewX>
    <researchViewY>4.0</researchViewY>
    <prerequisites>
      <li>PhobosResearch_BasicClinicalKit</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>MedicineProduction</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchMedicalBase">
    <defName>PhobosResearch_Bronchodilators</defName>
    <label>bronchodilators</label>
    <description>Drugs that open narrowed airways, made up in vials for use with a nebuliser.</description>
    <baseCost>600</baseCost>
    <researchViewX>0</researchViewX>
    <researchViewY>4.6</researchViewY>
    <prerequisites>
      <li>DrugProduction</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>DrugProduction</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchMedicalBase">
    <defName>PhobosResearch_Anaesthesia</defName>
    <label>anaesthesia</label>
    <description>A machine that gives measured gases through an operation, so that a patient stays under and comes back up again.</description>
    <baseCost>1800</baseCost>
    <researchViewX>1</researchViewX>
    <researchViewY>4.6</researchViewY>
    <prerequisites>
      <li>VitalsMonitor</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>VitalsMonitor</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef ParentName="PhobosResearchMedicalBase">
    <defName>PhobosResearch_BurnCare</defName>
    <label>burn care</label>
    <description>A bed built for burned skin, which keeps the wound clean and the patient from losing heat and fluid.</description>
    <baseCost>1200</baseCost>
    <researchViewX>0</researchViewX>
    <researchViewY>5.2</researchViewY>
    <prerequisites>
      <li>HospitalBed</li>
      <li MayRequire="th3fr3d.extendedinjuries">AdvancedFirstAid</li>
    </prerequisites>
    <modExtensions>
      <li Class="Phobos.Framework.Research.ResearchReplacesExtension">
        <replaces><li>HospitalBed</li></replaces>
      </li>
    </modExtensions>
  </ResearchProjectDef>
</Defs>
