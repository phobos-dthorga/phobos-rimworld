<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The C-27J's armour with Combat Extended (docs/development/vehicle-c27j.md; vehicle-armour.md). Its Def gives every part its class's
       Vehicle Framework rating; with Combat Extended the same classes are millimetres and megapascals: Skin 2 mm and 4 MPa, Splinter (the
       engines and propeller gearboxes) 5 mm and 20 MPa, as the Osprey's. Loaded only while Combat Extended is active.
       scripts/check-vehicle-armour.py holds each figure to its class. Not yet tested in game. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_C27J"]/components/li/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>2</ArmorRating_Sharp>
        <ArmorRating_Blunt>4</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_C27J"]/components/li[key="LeftEngine"]/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>5</ArmorRating_Sharp>
        <ArmorRating_Blunt>20</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_C27J"]/components/li[key="RightEngine"]/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>5</ArmorRating_Sharp>
        <ArmorRating_Blunt>20</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_C27J"]/components/li[key="LeftPropellerGearbox"]/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>5</ArmorRating_Sharp>
        <ArmorRating_Blunt>20</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_C27J"]/components/li[key="RightPropellerGearbox"]/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>5</ArmorRating_Sharp>
        <ArmorRating_Blunt>20</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
</Patch>
