<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The Seabed Crawler, the first real submarine (owner, 10 Nov 2026; docs/development/vehicle-seabed-crawler.md). The bare boat dives, hides and comes home; every other ability is an upgrade with its own research and part.
    It borrows the bulk tanker's picture until it has its own (owner's rule of 9 Nov 2026: no stand-in bodies). Biggest boat on the owner's list: Vanilla Vehicles Expanded's Trawler, 2 x 5 drawn 3 x 6, so this is the largest. All figures authored.
    4 x 9 cells, drawn 5 x 10 (owner, 11 Nov 2026: "I want the players to feel the weight and size of it"; it was 3 x 8). The game gives a 4-wide hull the columns x -1 to 2 and a 9-long one z -4 to 4,
    so the centreline runs between columns 0 and 1: internal parts sit on those two, flank parts on -1 and 2. The art plan is docs/development/vehicle-seabed-crawler-art.md.
    Parts are saved by position: append only. Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseSeaVehicle">
    <defName>Phobos_SeabedCrawler</defName>
    <label>seabed crawler</label>
    <description>A small research submarine. As built it can only dive, hide and come home; its abilities are fitted one by one as upgrades.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(5, 10)</drawSize>
      <color>(70, 78, 86)</color>
      <colorTwo>(40, 44, 50)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <nameable>true</nameable>
    <buildDef>Phobos_SeabedCrawler_Blueprint</buildDef>
    <size>(4, 9)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Sea</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.2</Flammability>
      <MarketValue>6500</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>400</Mass>
      <MoveSpeed>5</MoveSpeed>
      <CargoCapacity>800</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
      <Phobos_DiveEndurance>12</Phobos_DiveEndurance>
      <Phobos_DiveControl>1</Phobos_DiveControl>
      <Phobos_DiveBottoming>0</Phobos_DiveBottoming>
      <Phobos_DiveStaleAirRate>1</Phobos_DiveStaleAirRate>
      <Phobos_FieldLabFactor>0</Phobos_FieldLabFactor>
      <Phobos_FieldLabGrade>0</Phobos_FieldLabGrade>
      <Phobos_ListeningRange>0</Phobos_ListeningRange>
    </vehicleStats>
    <race>
      <baseBodySize>7</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1</winterSpeedMultiplier>
      <riverCost>1</riverCost>
      <visibilityWeight>5</visibilityWeight>
      <roles>
        <li>
          <key>driver</key>
          <label>helmsman</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 2)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>crew</key>
          <label>crew</label>
          <slots>4</slots>
          <hitbox>
            <cells>
              <li>(0, 0)</li>
              <li>(1, 0)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
      <li>
        <key>Hull</key>
        <label>outer hull</label>
        <health>220</health>
        <depth>External</depth>
        <hitWeight>3</hitWeight>
        <hitbox>
          <from>(-1, -4)</from>
          <to>(2, 4)</to>
        </hitbox>
        <categories>
          <li>BodyIntegrity</li>
        </categories>
      </li>
      <li>
        <key>Engine</key>
        <label>engine</label>
        <health>60</health>
        <depth>Internal</depth>
        <priorityStatEfficiency>true</priorityStatEfficiency>
        <hitbox>
          <cells>
            <li>(0, -3)</li>
            <li>(1, -3)</li>
          </cells>
        </hitbox>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>Propeller</key>
        <label>propeller</label>
        <health>40</health>
        <depth>External</depth>
        <hitbox>
          <cells>
            <li>(0, -4)</li>
            <li>(1, -4)</li>
          </cells>
        </hitbox>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>FuelTank</key>
        <label>fuel tank</label>
        <health>50</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(2, -2)</li>
          </cells>
        </hitbox>
      </li>
      <li>
        <key>BallastTanks</key>
        <label>ballast tanks</label>
        <health>70</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(-1, 0)</li>
            <li>(2, 0)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveControl</li>
        </categories>
      </li>
      <li>
        <key>PressureHull</key>
        <label>pressure hull</label>
        <health>120</health>
        <depth>Internal</depth>
        <hitbox>
          <from>(0, -2)</from>
          <to>(1, 3)</to>
        </hitbox>
        <categories>
          <li>Phobos_DiveControl</li>
        </categories>
      </li>
      <li>
        <key>AirPlant</key>
        <label>air plant</label>
        <health>40</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(0, 1)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveEndurance</li>
        </categories>
      </li>
      <li>
        <key>BatteryBank</key>
        <label>battery bank</label>
        <health>60</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(-1, -2)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveEndurance</li>
        </categories>
      </li>
      <li>
        <key>BottomingWheels</key>
        <label>bottoming wheels</label>
        <health>50</health>
        <depth>External</depth>
        <hitbox>
          <cells>
            <li>(-1, 2)</li>
            <li>(2, 2)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_DiveBottoming</li>
        </categories>
      </li>
      <li>
        <!-- The wet laboratory's space: empty until the upgrade is fitted, and damage to it slows the research done aboard. -->
        <key>Laboratory</key>
        <label>laboratory</label>
        <health>40</health>
        <depth>Internal</depth>
        <hitbox>
          <cells>
            <li>(1, 1)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_FieldLabFactor</li>
        </categories>
      </li>
      <li>
        <!-- The listening array's place at the bow, outside the pressure hull: silent until the upgrade is fitted, and damage to it shortens what the boat hears. -->
        <key>Hydrophones</key>
        <label>hydrophones</label>
        <health>30</health>
        <depth>External</depth>
        <hitbox>
          <cells>
            <li>(0, 4)</li>
            <li>(1, 4)</li>
          </cells>
        </hitbox>
        <categories>
          <li>Phobos_ListeningRange</li>
        </categories>
      </li>
    </components>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>20</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>200</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_SeabedCrawler_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosSubmersible">
        <spottedSound>PhobosVehicles_SonarPing</spottedSound>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosFieldLab" />
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosListening" />
    </comps>
    <!-- Its own voice in place of the inherited draft blips; the engine loops are played by D'thorga Framework from the
         extension below, so they follow rpm and load (docs/development/sound-catalogue.md). -->
    <soundOneShotsOnEvent Inherit="False">
      <li>
        <key>IgnitionOn</key>
        <value>PhobosVehicles_SeabedCrawlerEngineStart</value>
      </li>
      <li>
        <key>IgnitionOff</key>
        <value>PhobosVehicles_SeabedCrawlerEngineStop</value>
      </li>
      <li>
        <key>PawnEntered</key>
        <value>PhobosVehicles_SeabedCrawlerDoor</value>
      </li>
      <li>
        <key>PawnExited</key>
        <value>PhobosVehicles_SeabedCrawlerDoor</value>
      </li>
    </soundOneShotsOnEvent>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosVehicles_SeabedCrawlerEngineIdle</idleSound>
        <loadSound>PhobosVehicles_SeabedCrawlerEngineLoad</loadSound>
      </li>
    </modExtensions>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBoatBaseBuildable">
    <defName>Phobos_SeabedCrawler_Blueprint</defName>
    <label>seabed crawler</label>
    <description>A small research submarine. As built it can only dive, hide and come home; its abilities are fitted one by one as upgrades. It is built in shallow water.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/BulkTanker/BulkTanker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5, 10)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>20000</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_SubmersibleHull</li>
    </researchPrerequisites>
    <size>(4, 9)</size>
    <costList>
      <PhobosVehicles_EngineAssembly>1</PhobosVehicles_EngineAssembly>
      <PhobosVehicles_ElectricalKit>1</PhobosVehicles_ElectricalKit>
      <Steel>350</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <Plasteel>15</Plasteel>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_SeabedCrawler</thingToSpawn>
  </Vehicles.VehicleBuildDef>
</Defs>
