<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Patches' Vanilla Factions Expanded - Classical assembly (0.25.0): one temporary fix, so a save made during a scorpion raid loads
       with the raid's orders. It lives in Mods/Classical/<version>, loaded only while that mod is active, patches only the game's own method and
       references no assembly of the mod. RimWorld 1.7 only. To be removed when the fault is fixed (docs/development/temporary-patches.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.ClassicalPatches</RootNamespace>
    <AssemblyName>PhobosPatches.Classical</AssemblyName>
    <ModFolder>PhobosPatches</ModFolder>
    <TieInFolder>Mods/Classical/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.39.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
  </ItemGroup>
</Project>
