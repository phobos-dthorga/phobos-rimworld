<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Water in the tanker. It freezes at 0 C and spills as nothing worth drawing. -->
  <Phobos.VehicleSystems.PhobosTankContentsDef DBHLite="true">
    <defName>PhobosTank_Water</defName>
    <!-- Vehicles 0.124.0: the reverse-osmosis kit can treat it. -->
    <treatable>true</treatable>
    <label>water</label>
    <description>Water for the plumbing.</description>
    <phase>Liquid</phase>
    <foodStatus>Food</foodStatus>
    <unitLabel>litres</unitLabel>
    <kilogramsPerUnit>1</kilogramsPerUnit>
    <spillFilth>Filth_Water</spillFilth>
    <freezesBelow>0</freezesBelow>
    <!-- Vehicles 0.90.0 (with Framework 0.187.0; docs/development/vehicle-emergent-play.md, EM21): a helicopter's water bucket may fill
         from a tank of it, and the pump draws it straight from a river, lake or the sea beside the vehicle, untreated. -->
    <putsOutFires>true</putsOutFires>
    <ports>
      <li Class="Phobos.VehicleSystems.Hygiene.Port_DubsPlumbing" />
      <li Class="Phobos.VehicleSystems.Hygiene.Port_OpenWater" />
    </ports>
  </Phobos.VehicleSystems.PhobosTankContentsDef>
</Defs>
