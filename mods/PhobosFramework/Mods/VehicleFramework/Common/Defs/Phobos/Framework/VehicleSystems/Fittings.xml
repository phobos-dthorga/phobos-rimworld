<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fittings, tunes and enemy sets (docs/development/vehicle-tuning-and-upgrades.md). Every figure here is authored, a gameplay choice to be
    tuned in play. Costs raised about 2.5 times and times about tenfold in Framework 0.91.0 (owner, 11 Nov 2026: "I want these upgrades and
    tunes to feel earned"): a big job is a day's work or more for a builder of normal speed (2,500 work is an hour). These are the figures for a
    5-tonne vehicle at the Standard presets; the settings and the vehicle's weight move them (PhobosVehicleRulesDef). Materials are built into
    the vehicle: a fitting is not an item. A parameter factor names a system's parameter; a role is a
    loadout's role. Another mod adds its own with the same Def types.
  -->

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_UpratedRadiator</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/UpratedRadiator</iconPath>
    <label>uprated radiator</label>
    <description>A larger core with more fins. The engine sheds heat faster, so it is slower to boil on a long pull.</description>
    <roles><li>Radiator</li></roles>
    <materials><Steel>75</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>12500</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <parameterFactors><li><parameter>radiatorRate</parameter><factor>1.3</factor><label>radiator cooling</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_OilCooler</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/OilCooler</iconPath>
    <label>oil cooler</label>
    <description>A small radiator for the engine oil. Cooler oil burns away more slowly, so the engine goes further between services.</description>
    <roles><li>Engine</li><li>Engine1</li><li>Engine2</li><li>Engine3</li><li>Engine4</li><li>Engine5</li><li>Engine6</li><li>Engine7</li><li>Engine8</li></roles>
    <materials><Steel>50</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>10000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <parameterFactors><li><parameter>oilBurnPerHour</parameter><factor>0.6</factor><label>oil burned</label></li></parameterFactors>
    <piston>Yes</piston>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_Turbocharger</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/Turbocharger</iconPath>
    <label>turbocharger</label>
    <description>Exhaust gas spins a compressor that forces more air into the engine. More power, more heat and a thirstier engine. It is a part of its own, fed by the engine's oil: low oil, dust past a clogged air filter, high boost and stopping the engine hot all wear it, and a worn one smokes, burns oil and loses its boost.</description>
    <roles><li>Engine</li><li>Engine1</li><li>Engine2</li><li>Engine3</li><li>Engine4</li><li>Engine5</li><li>Engine6</li><li>Engine7</li><li>Engine8</li></roles>
    <materials><Steel>100</Steel><ComponentIndustrial>10</ComponentIndustrial></materials>
    <work>30000</work>
    <minSkill>8</minSkill>
    <researchPrerequisite>PhobosResearch_Turbines</researchPrerequisite>
    <powerFactor>1.2</powerFactor>
    <fuelFactor>1.1</fuelFactor>
    <parameterFactors><li><system>PhobosVehicleSystem_Cooling</system><parameter>heatAtFullLoad</parameter><factor>1.25</factor><label>engine heat at full load</label></li></parameterFactors>
    <piston>Yes</piston>
    <powerCounts>Yes</powerCounts>
    <!-- Framework 0.123.0: it opens the boost tune (the Boost axis, below). Framework 0.320.0: it puts the turbocharger part on the
         vehicle and wakes its system (Systems_Turbocharger.xml). -->
    <grants><li>Boost</li><li>Turbocharger</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_HeavyAlternator</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/HeavyAlternator</iconPath>
    <label>heavy-duty alternator</label>
    <description>Wound for a higher output. The battery charges faster and heavy electrical loads are easier to carry.</description>
    <roles><li>Alternator</li></roles>
    <materials><Steel>50</Steel><ComponentIndustrial>7</ComponentIndustrial></materials>
    <work>10000</work>
    <minSkill>5</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <parameterFactors><li><parameter>alternatorAmps</parameter><factor>1.5</factor><label>charging current</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_DeepCycleBattery</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/DeepCycleBattery</iconPath>
    <label>deep-cycle battery</label>
    <description>Thicker plates and more of them. It holds more charge, so the vehicle runs its loads longer with the engine off.</description>
    <roles><li>Battery</li></roles>
    <materials><Steel>60</Steel><ComponentIndustrial>7</ComponentIndustrial></materials>
    <work>5000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <parameterFactors><li><parameter>batteryAmpHours</parameter><factor>1.5</factor><label>battery capacity</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.70.0 (the owner's idea and agreed defaults, 10 Nov 2026): materials, skill and research authored. Systems_Cooling.xml
         holds the heating. Only engines with liquid cooling have the figure it moves, so it is offered to no other. -->
    <defName>PhobosFitting_BlockHeater</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/BlockHeater</iconPath>
    <label>block heater</label>
    <description>An electric heater in the engine block. Parked beside a powered building with the engine off, the engine stays warm, so it starts easily on a cold morning, wears less, and the cab heater works at once.</description>
    <roles><li>Engine</li><li>Engine1</li><li>Engine2</li><li>Engine3</li><li>Engine4</li><li>Engine5</li><li>Engine6</li><li>Engine7</li><li>Engine8</li></roles>
    <materials><Steel>40</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>7500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <parameterFactors><li><system>PhobosVehicleSystem_Cooling</system><parameter>blockHeaterAbsent</parameter><factor>0</factor></li></parameterFactors>
    <!-- Framework 0.334.0 (the fittings audit): the colony's grid pays for it, while it heats (the heating flow's thermostat, off at 40
         degrees C). 750 W is authored, within the usual run of plug-in block heaters, about 400 to 1,500 W (secondary, unverified). -->
    <gridWatts>750</gridWatts>
    <gridWhen Class="Phobos.VehicleSystems.When_QuantityBelow">
      <quantity>coolantTemperature</quantity>
      <value>40</value>
    </gridWhen>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_HeavySprings</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/HeavySprings</iconPath>
    <label>heavy-duty springs</label>
    <description>Stiffer springs carry a bigger load, at the cost of a harder, slightly slower ride. Both wheels of an axle are done together; fit every axle for the full effect.</description>
    <roles><li>Wheels</li></roles>
    <!-- Framework 0.247.0 (per-engine realism step 3; owner, 23 Nov 2026): matched on each axle, as mismatched tyres or springs pull a
         vehicle to one side. -->
    <matchedSet>true</matchedSet>
    <matchedPerAxle>true</matchedPerAxle>
    <materials><Steel>60</Steel></materials>
    <work>7500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <statFactors>
      <li><stat>CargoCapacity</stat><factor>1.15</factor></li>
      <li><stat>MoveSpeed</stat><factor>0.96</factor></li>
    </statFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_RoadTyres</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/RoadTyres</iconPath>
    <label>road tyres</label>
    <description>A softer, faster compound. Quicker on the move, and it wears out sooner. Both wheels of an axle are done together; fit every axle for the full effect.</description>
    <roles><li>Wheels</li></roles>
    <!-- Framework 0.247.0 (per-engine realism step 3; owner, 23 Nov 2026): matched on each axle, as mismatched tyres or springs pull a
         vehicle to one side. -->
    <matchedSet>true</matchedSet>
    <matchedPerAxle>true</matchedPerAxle>
    <!-- New tyres: each wheel fitted takes away its share of the tread wear (Framework 0.105.2; owner's test of 13 Nov 2026). -->
    <renews><li>treadWear</li></renews>
    <materials><Steel>25</Steel><Chemfuel>30</Chemfuel></materials>
    <work>5000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <statFactors><li><stat>MoveSpeed</stat><factor>1.05</factor></li></statFactors>
    <parameterFactors><li><parameter>wearPerHour</parameter><factor>1.4</factor><label>tyre wear</label></li></parameterFactors>
    <tracked>No</tracked>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.155.0, ropes and a hoist (docs/development/vehicle-flight-over-the-map.md, slice 6; owner, 19 Nov 2026: two fittings). On
         the rope mount an aircraft on our own flight offers (the Osprey's ramp). Two ropes, as the V-22 guide's two fast-rope points; 90 ft
         ropes, the Army's longest without a general's leave. Materials, weight, work and skill authored; cloth stands in for the ropes'
         nylon. No electrics: people slide down by themselves. -->
    <defName>PhobosFitting_FastRope</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/FastRope</iconPath>
    <label>fast-rope bar</label>
    <description>A bar over the ramp with two thick braided ropes, each long enough to reach the ground from a low hover. From a steady hover the aircraft comes down low and its passengers slide down the ropes two at a time, without it having to land.</description>
    <roles><li>RopeMount</li></roles>
    <materials><Steel>25</Steel><Cloth>80</Cloth></materials>
    <kilograms>30</kilograms>
    <work>3000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <grants><li>FastRope</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.155.0, ropes and a hoist (as above). On the hoist mount at the ramp, where the V-22 guide puts its 600 lb hoist with 250 ft
         of cable [P]. An electric hoist, drawing 200 A while its motor runs: lifting 272 kg at 0.7 m/s takes 1.9 kW at the drum, about 3.7 kW
         at an authored half efficiency, 310 A at the 12 V the model's aircraft use; the empty hook takes far less, so 200 A is authored as
         its running draw. Never shed: it stops only on a flat battery, with its brake holding the cable. Materials, weight, work and skill
         authored. -->
    <defName>PhobosFitting_RescueHoist</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/RescueHoist</iconPath>
    <label>rescue hoist</label>
    <description>An electric hoist over the ramp with a long steel cable and a stretcher. From a steady hover the aircraft comes down low and lowers the hook: it lifts one person aboard at a time, a downed one in the stretcher, onto a litter if one is fitted and free, or lowers someone from aboard. It lifts a person and everything they carry up to its rated load, draws heavily on the battery while it runs, and needs someone aboard to work it.</description>
    <roles><li>HoistMount</li></roles>
    <!-- Framework 0.179.0: left as materials, though a hoist has an electric motor: its research (vehicle electrics) can come before the
         vehicle parts research that makes one. -->
    <materials><Steel>70</Steel><ComponentIndustrial>6</ComponentIndustrial></materials>
    <kilograms>90</kilograms>
    <work>10000</work>
    <minSkill>6</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <grants><li>RescueHoist</li></grants>
    <feed>
      <load>rescueHoist</load>
    </feed>
    <loads>
      <li>
        <name>rescueHoist</name>
        <label>rescue hoist</label>
        <description>The rescue hoist's motor, drawing while the cable moves. A flat battery stops it with someone on the cable: keep the engines running.</description>
        <amps>200</amps>
        <shedOrder>0</shedOrder>
        <when Class="Phobos.VehicleSystems.When_Hoisting" />
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.92.0, sling loads (owner, 11 Nov 2026: any helicopter, by fitting; docs/development/vehicle-sling-design.md). It goes on the
         hook mount a helicopter's loadout appends, and lets it lift a vehicle on a sling; what it lifts is the loadout's rated load. Materials,
         work and skill authored, earned like the turbocharger. -->
    <defName>PhobosFitting_CargoHook</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/CargoHook</iconPath>
    <label>cargo hook</label>
    <description>A load-rated hook under the belly, with an electric release worked from the cockpit and a manual one beside it. With a sling set aboard, the helicopter can lift a vehicle and carry it hanging below.</description>
    <roles><li>HookMount</li></roles>
    <materials><Steel>120</Steel><ComponentIndustrial>8</ComponentIndustrial></materials>
    <work>20000</work>
    <minSkill>7</minSkill>
    <researchPrerequisite>PhobosResearch_Turbines</researchPrerequisite>
    <grants><li>CargoHook</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.101.0, batch 3's signatures (docs/development/vehicle-upgrades-round-two.md): litters in the cabin, an air ambulance. It goes on
         the part a loadout names as its cabin (the Cherokee's upholstery); the litters it brings are the rules Def's litterSlots. Its frames
         take a fifth of the cargo space. Materials, work and skill authored. -->
    <defName>PhobosFitting_LitterKit</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/LitterKit</iconPath>
    <label>litter kit</label>
    <!-- Vehicle tuning, as the other fittings (research-gates-audit-2026-11-17.md, R6; owner, 17 Nov 2026). -->
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <description>Stanchions and straps for stretchers along the cabin, with a first-aid locker. Downed people can be carried aboard and lie on the litters, and anyone in the crew who can doctor tends them while the vehicle stands. The frames take up cargo space.</description>
    <roles><li>Cabin</li></roles>
    <materials><Steel>60</Steel><Cloth>40</Cloth><ComponentIndustrial>2</ComponentIndustrial></materials>
    <work>8000</work>
    <minSkill>4</minSkill>
    <statFactors><li><stat>CargoCapacity</stat><factor>0.8</factor></li></statFactors>
    <grants><li>Litter</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.142.0, the cruising height between tiles (owner, 19 Nov 2026: passengers covered only with a cabin oxygen fitting). An
         oxygen concentrator with masks at every seat, as the V-22's cabin troops wear "on-board oxygen masks above 10,000 feet" (secondary,
         the modern military record). It runs only while the engine turns and draws 3 A (authored: half again the crew set's 2 A, for more
         masks). Working, nobody aboard keeps the aircraft below the oxygen line. Materials, weight, work and skill authored. Its picture
         is the owner's pick of 19 Nov 2026 (Framework 0.169.0); it has no switch of its own. -->
    <defName>PhobosFitting_CabinOxygen</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/CabinOxygen</iconPath>
    <label>cabin oxygen</label>
    <description>An oxygen concentrator in the cabin with a mask at every seat, crew and passengers alike. While the engine runs it lets the aircraft cruise high with people aboard who would otherwise need it to fly low. It draws a little power, and stops with the engine or a flat battery.</description>
    <roles><li>OxygenPanel</li></roles>
    <materials><Steel>20</Steel><ComponentIndustrial>3</ComponentIndustrial></materials>
    <kilograms>15</kilograms>
    <work>3000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <grants><li>CabinOxygen</li></grants>
    <feed>
      <load>cabinOxygen</load>
      <engineRunning>true</engineRunning>
    </feed>
    <loads>
      <li>
        <name>cabinOxygen</name>
        <label>cabin oxygen</label>
        <description>The cabin's oxygen concentrator and masks. It runs while the engine turns.</description>
        <amps>3</amps>
        <shedOrder>3</shedOrder>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the all-terrain tyres family (docs/development/vehicle-upgrades-round-two.md): the opposite of road tyres. Its soft-
         ground grip (TreadRules.SoftGroundFactor) is full on the softest going and nothing on a firm road; the speed and wear costs apply
         everywhere, a simplification. Every figure authored. -->
    <defName>PhobosFitting_AllTerrainTyres</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/AllTerrainTyres</iconPath>
    <label>all-terrain tyres</label>
    <description>A deep, open tread that bites into mud, sand and snow. It holds far better on soft ground, is a little slower everywhere, and wears faster on hard going. Both wheels of an axle are done together; fit every axle for the full effect.</description>
    <roles><li>Wheels</li></roles>
    <!-- Framework 0.247.0 (per-engine realism step 3; owner, 23 Nov 2026): matched on each axle, as mismatched tyres or springs pull a
         vehicle to one side. -->
    <matchedSet>true</matchedSet>
    <matchedPerAxle>true</matchedPerAxle>
    <!-- New tyres: each wheel fitted takes away its share of the tread wear (Framework 0.105.2; owner's test of 13 Nov 2026). -->
    <renews><li>treadWear</li></renews>
    <materials><Steel>30</Steel><Chemfuel>40</Chemfuel></materials>
    <work>5000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <statFactors><li><stat>MoveSpeed</stat><factor>0.95</factor></li></statFactors>
    <parameterFactors>
      <li><system>PhobosVehicleSystem_RunningGear</system><parameter>softGroundGrip</parameter><factor>1.35</factor><label>grip on soft ground</label></li>
      <li><parameter>wearPerHour</parameter><factor>1.15</factor><label>tyre wear</label></li>
    </parameterFactors>
    <tracked>No</tracked>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.113.0, cross-links round three G7 (owner, 13 Nov 2026: river fording with a snorkel fitting). A raised air intake up the
         windscreen pillar, as on expedition and military vehicles, so a light vehicle can cross rivers without drawing water into its
         engine. Only offered where the intake sits low (under 2,000 kg, as Input_Fording reads it). Materials, work and skill authored. -->
    <defName>PhobosFitting_Snorkel</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/Snorkel</iconPath>
    <label>snorkel</label>
    <description>A raised air intake that runs up beside the windscreen to above the roof. The engine breathes high and dry, so the vehicle can cross a river without drawing water into the engine.</description>
    <roles><li>Engine</li></roles>
    <materials><Steel>30</Steel><ComponentIndustrial>1</ComponentIndustrial></materials>
    <work>4000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <parameterFactors><li><system>PhobosVehicleSystem_Service</system><parameter>intakeExposure</parameter><factor>0</factor><label>water drawn into the intake</label></li></parameterFactors>
    <piston>Yes</piston>
    <maxKilograms>2000</maxKilograms>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the work lights family: on the lamp bracket every land vehicle has (Loadouts_Default.xml). It grants WorkLights,
         which shows the lamps' switch and counts as work lights for a drill rig; the light itself is the game's own (WorkLamps). Materials,
         work and skill authored. -->
    <defName>PhobosFitting_WorkLamps</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/WorkLamps</iconPath>
    <label>work lamps</label>
    <description>A pair of floodlights on a bracket, with their own switch. While the vehicle stands still at night they light the ground round it, so work there goes on at the pace of daylight. They draw on the battery.</description>
    <roles><li>LampMount</li></roles>
    <materials><Steel>30</Steel><ComponentIndustrial>4</ComponentIndustrial></materials>
    <work>4000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <grants><li>WorkLights</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the recovery family (owner, 12 Nov 2026: built as one piece with the hitch's recovery tow). On the winch mount every
         land vehicle has (Loadouts_Default.xml). It grants RecoveryWinch, which offers the winch order and lets the hitch take an ordinary
         vehicle as a recovery tow. Its pull is the rules Def's (RecoveryRule). Materials, work and skill authored. -->
    <defName>PhobosFitting_RecoveryWinch</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/RecoveryWinch</iconPath>
    <label>recovery winch</label>
    <description>A winch in the front bumper with a steel rope, recovery straps and a rigid tow bar. With someone aboard to work it, it drags a stuck, broken or empty vehicle towards this one, as far as this vehicle can hold it on its brakes; the tow bar then lets this vehicle tow an ordinary vehicle home, not only a trailer.</description>
    <roles><li>RecoveryMount</li></roles>
    <!-- Framework 0.179.0: an electric winch, built round an electric motor; the drum, cable and frame are what is left (was 90 steel, 5 components). -->
    <materials><PhobosVehicles_ElectricMotor>1</PhobosVehicles_ElectricMotor><Steel>65</Steel><ComponentIndustrial>1</ComponentIndustrial></materials>
    <work>7000</work>
    <minSkill>5</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <grants><li>RecoveryWinch</li></grants>
    <!-- Framework 0.115.0 (W1): an electric winch, the "winch" load in the land loadouts. It will not start, and stops, on a flat battery. -->
    <feed>
      <load>winch</load>
    </feed>
    <!-- Framework 0.326.0 (vehicle effects, slice 3): amber beacons on the cab roof, flashing in turn while the vehicle is at recovery work
         (When_Recovering: winching, or an ordinary vehicle on the tow bar), as a real recovery truck warns everyone near. Two LED beacons of
         about 12 W on 12 V, so 2 A (authored); lights are shed last. The glow is drawn with the Vehicle effects setting. -->
    <loads>
      <li>
        <name>recoveryBeacons</name>
        <label>recovery beacons</label>
        <description>Amber beacons on the roof that flash while the vehicle winches or tows another vehicle, to warn everyone near.</description>
        <amps>2</amps>
        <shedOrder>6</shedOrder>
        <when Class="Phobos.VehicleSystems.When_Recovering" />
        <lamps>
          <li><forward>0.3</forward><right>0.45</right><colour>(1, 0.62, 0.08, 1)</colour><size>0.9</size><pattern>Flash</pattern><periodSeconds>0.8</periodSeconds><litShare>0.35</litShare></li>
