<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The bulk tanker's upgrades (docs/development/vehicle-bulk-tanker.md). Only one tank at a time: each names the others in
    disableIfUpgradeNodesEnabled, so one must come off before another goes on.
    The compartments, the hose reel and the electric pump branch from the tanks (PhobosUpgradeAnyOf). Capacities and costs are authored. The gas vessels are
    added by a patch in Mods/TankerVessels, loaded only with a mod that gives them something to carry. Node keys are saved in the player's
    game: never rename or remove one. Not yet tested in game.
  -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_Tanker_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
      <!-- Framework 0.127.1 (owner, 17 Nov 2026: the tree should branch). The compartments sit inside a liquid tank, so they need one and hold
           it on until they come off. The hose reel and the electric pump are on the truck, so they need a tank to be worth fitting but stay
           when the tank is swapped. The gas vessels' keys count only when the tie-in adds them. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeAnyOf">
        <links>
          <li>
            <node>TwoCompartments</node>
            <holdsParent>true</holdsParent>
            <anyOf>
              <li>LiquidTank</li>
              <li>InsulatedLiquidTank</li>
              <li>HighVolumeLiquidTank</li>
            </anyOf>
          </li>
          <li>
            <node>ElectricPump</node>
            <anyOf>
              <li>LiquidTank</li>
              <li>InsulatedLiquidTank</li>
              <li>HighVolumeLiquidTank</li>
              <li>PressureVessel</li>
              <li>LightPressureVessel</li>
              <li>HeavyWallVessel</li>
            </anyOf>
          </li>
          <li>
            <node>HoseReel</node>
            <anyOf>
              <li>LiquidTank</li>
              <li>InsulatedLiquidTank</li>
              <li>HighVolumeLiquidTank</li>
              <li>PressureVessel</li>
              <li>LightPressureVessel</li>
              <li>HeavyWallVessel</li>
            </anyOf>
          </li>
        </links>
      </li>
    </modExtensions>
    <nodes>
    <li>
      <key>LiquidTank</key>
      <label>General tank</label>
      <displayLabel>true</displayLabel>
      <description>A plain baffled tank for liquids: 3,000 units.</description>
      <icon>Phobos/Vehicles/BulkTanker/Upgrades/LiquidTank</icon>
      <work>4000</work>
      <gridCoordinate>(2, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <disableIfUpgradeNodesEnabled>
        <li>InsulatedLiquidTank</li>
        <li>HighVolumeLiquidTank</li>
        <li>PressureVessel</li>
        <li>LightPressureVessel</li>
        <li>HeavyWallVessel</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_TankCapacity</def>
              <value>3000</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_LiquidTank</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>InsulatedLiquidTank</key>
      <label>Insulated tank</label>
      <displayLabel>true</displayLabel>
      <description>A lagged tank: 2,700 units. Its contents take about a day to reach the outside temperature, and food spoils half as fast.</description>
      <icon>Phobos/Vehicles/BulkTanker/Upgrades/InsulatedLiquidTank</icon>
      <work>4000</work>
      <gridCoordinate>(7, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <disableIfUpgradeNodesEnabled>
        <li>LiquidTank</li>
        <li>HighVolumeLiquidTank</li>
        <li>PressureVessel</li>
        <li>LightPressureVessel</li>
        <li>HeavyWallVessel</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_TankCapacity</def>
              <value>2700</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>150</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_LiquidTank_B</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>HighVolumeLiquidTank</key>
      <label>High-volume tank</label>
      <displayLabel>true</displayLabel>
      <description>A squarer tank that holds more: 3,300 units. A full load slows the truck more.</description>
      <icon>Phobos/Vehicles/BulkTanker/Upgrades/HighVolumeLiquidTank</icon>
      <work>4000</work>
      <gridCoordinate>(12, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <disableIfUpgradeNodesEnabled>
        <li>LiquidTank</li>
        <li>InsulatedLiquidTank</li>
        <li>PressureVessel</li>
        <li>LightPressureVessel</li>
        <li>HeavyWallVessel</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_TankCapacity</def>
              <value>3300</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>160</Steel>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_LiquidTank_C</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>HoseReel</key>
      <label>Second hose reel</label>
      <displayLabel>true</displayLabel>
      <description>A second hose: the pump moves half as much again.</description>
      <icon>Phobos/Vehicles/BulkTanker/Upgrades/HoseReel</icon>
      <work>1500</work>
      <gridCoordinate>(22, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_PumpRate</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <!-- D'thorga Vehicles 0.88.0: its hose comes from its parts bill (Bill_BulkTanker.xml): the reel is what is left. -->
      <ingredients>
        <Steel>25</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/BulkTanker/BulkTanker_HoseReel</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Vehicles 0.57.0 (W3; owner, 17 Nov 2026: "either", the engine by default and an electric pump as an upgrade). Nothing visible on
           the body, so no overlay; the picture is our deep-cycle battery fitting's, reused. Materials and work authored. -->
      <key>ElectricPump</key>
      <label>Electric pump</label>
      <displayLabel>true</displayLabel>
      <description>An electric motor on the pump: it can pump with the engine off, from the battery, until the battery is flat. Quieter, and no fuel burnt while it works.</description>
      <icon>Phobos/VehicleSystems/Fittings/DeepCycleBattery</icon>
      <work>2000</work>
      <gridCoordinate>(17, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_ElectricPump</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <!-- D'thorga Vehicles 0.88.0: its electric motor comes from its parts bill (Bill_BulkTanker.xml): the pump body is what is left. -->
      <ingredients>
        <Steel>15</Steel>
      </ingredients>
    </li>
    <li>
      <key>TwoCompartments</key>
      <label>Two compartments</label>
      <displayLabel>true</displayLabel>
      <description>A bulkhead divides a liquid tank in two, each half with its own fluid. Filled alike, they hold as much as the whole tank.</description>
      <icon>Phobos/VehicleSystems/Tank/TwoCompartments</icon>
      <work>2500</work>
      <gridCoordinate>(7, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <disableIfUpgradeNodesEnabled>
        <li>PressureVessel</li>
        <li>LightPressureVessel</li>
        <li>HeavyWallVessel</li>
      </disableIfUpgradeNodesEnabled>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>ThreeCompartments</key>
      <label>Three compartments</label>
      <displayLabel>true</displayLabel>
      <description>A second bulkhead: three fluids at once, one to each hatch.</description>
      <icon>Phobos/VehicleSystems/Tank/ThreeCompartments</icon>
      <work>2500</work>
      <gridCoordinate>(7, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <prerequisiteNodes>
        <li>TwoCompartments</li>
      </prerequisiteNodes>
      <disableIfUpgradeNodesEnabled>
        <li>PressureVessel</li>
        <li>LightPressureVessel</li>
        <li>HeavyWallVessel</li>
      </disableIfUpgradeNodesEnabled>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Armour kits without a picture of their own (D'thorga Vehicles 0.80.0; vehicle-militarised-service-vehicles.md, "The kits").
           Each raises named parts by class with Add (vehicle-armour.md; Combat Extended's figures in Mods/CombatExtended), and its real
           kilograms [A] load the engine as cargo would (owner, 19 Nov 2026), taking cargo room on the Talus only. Figures and costs authored.
           scripts/check-vehicle-armour.py holds each kit to its class on both scales. Not yet tested in game. -->
      <key>PhobosEngineGuards</key>
      <label>Engine and tank guards</label>
      <displayLabel>true</displayLabel>
      <description>Steel guards around the engine and the fuel tank, against rifle fire. A guarded tank still leaks and a guarded engine still burns once they are finally holed: it takes heavier fire to get there.</description>
      <upgradeExplanation>Engine and fuel tank: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 300 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EngineGuards</icon>
      <work>2500</work>
      <gridCoordinate>(29, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Engine</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>FuelTank</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>100</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRunFlatTyres</key>
      <label>Run-flat tyres</label>
      <displayLabel>true</displayLabel>
      <description>Steel-belted tyres with run-flat inserts, so the wheels shrug off shell fragments and pistol bullets.</description>
      <upgradeExplanation>Wheels: from skin to splinter armour, which stops shell fragments and pistol bullets.\nKit weight: 120 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RunFlatTyres</icon>
      <work>1500</work>
      <gridCoordinate>(34, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>FrontWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>RearWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>120</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>30</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosEmpHardening</key>
      <label>EMP hardening</label>
      <displayLabel>true</displayLabel>
      <description>Shielded wiring, filtered power and a spare engine control unit, so an electromagnetic pulse does the electrics less harm and stalls the engine less often, as it does on a military vehicle.</description>
      <upgradeExplanation>Electrics: an electromagnetic pulse harms them as it does a military vehicle's.\nKit weight: 60 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EmpHardening</icon>
      <work>2000</work>
      <gridCoordinate>(39, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_EmpHardening</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>60</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- The drawn armour kits (D'thorga Vehicles 0.86.0; vehicle-militarised-service-vehicles.md, "The kits"), with their
           pictures from paid edits of the picked body (owner's picks of 19 Nov 2026). Armour by class with Add, Combat Extended's
           figures in Mods/CombatExtended; real kilograms [A] load the engine as cargo would, taking cargo room on the Talus only.
           Figures and costs authored. Not yet tested in game. -->
      <key>PhobosArmouredCab</key>
      <label>Armoured cab</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel plates over the cab's roof and doors and a steel frame round a narrowed windscreen, so ordinary rifle bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 1,000 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/ArmouredCab</icon>
      <work>4000</work>
      <gridCoordinate>(39, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1000</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>250</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRamBar</key>
      <label>Ram bar</label>
      <displayLabel>true</displayLabel>
      <description>A heavy steel beam across the front, braced back to the chassis. Driving into an animal, a raider or a wall harms the truck half as much, and what it hits more.</description>
      <upgradeExplanation>Damage the truck takes from running into people and animals: half (0.50 to 0.25).\nFrom running into buildings: half (0.10 to 0.05).\nDamage it does to people and animals it runs into: half as much again (0.50 to 0.75); to buildings, 2.5 to 3.0.\nKit weight: 150 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RamBar</icon>
      <work>1500</work>
      <gridCoordinate>(29, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <statCategories>
            <li>
              <def>PawnCollisionRecoilMultiplier</def>
              <value>-0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionRecoilMultiplier</def>
              <value>-0.05</value>
              <type>Add</type>
            </li>
            <li>
              <def>PawnCollisionMultiplier</def>
              <value>0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionMultiplier</def>
              <value>0.5</value>
              <type>Add</type>
            </li>
          </statCategories>
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosBodyPlates</key>
      <label>Body plates</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel skirts along both sides, over the tank shell, so ordinary rifle bullets stop before they reach it. They show on the truck.</description>
      <upgradeExplanation>Tank shell: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 1,400 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/BodyPlates</icon>
      <work>4000</work>
      <gridCoordinate>(34, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>TankShell</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1400</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>350</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosHeavyCabPlates</key>
      <label>Heavy cab plates</label>
      <displayLabel>true</displayLabel>
      <description>Thick steel slabs over the armoured cab and a steel visor over the windscreen with two vision slits, so armour-piercing rifle bullets and ordinary heavy machine-gun bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from rifle to armour-piercing rifle armour, which stops armour-piercing rifle bullets and ordinary heavy machine-gun bullets.\nKit weight: 850 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/HeavyCabPlates</icon>
      <work>5000</work>
      <gridCoordinate>(39, 17)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_HeavyTruckArmour</li>
      </researchPrerequisites>
      <prerequisiteNodes>
        <li>PhobosArmouredCab</li>
      </prerequisiteNodes>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>850</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
