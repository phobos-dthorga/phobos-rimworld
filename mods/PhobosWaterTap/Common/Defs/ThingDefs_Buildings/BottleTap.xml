<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Built like Vanilla Chemfuel Expanded's chemfuel tap: one cell of storage that fills itself.

       DBHThirst is Dubs Bad Hygiene's own marker: its Harmony prefix on DirectXmlLoader.DefFromNode drops any Def carrying
       it while the thirst option is off, and DBHLite likewise in lite mode (code read 4 Nov 2026). DBH_WaterBottle is marked
       DBHThirst and the Plumbing research DBHLite, so without these two this Def would point at Defs that aren't there.

       The pipe comp is the plumbing mode DBH gives its fixtures, which it calls Sewage: one net carries water and waste.

       Authored values, gameplay choices, free to tune: the cost, the work, and one bottle per rare tick (240 a day at most;
       on my estimate of about 2 bottles a day per pawn in mild weather, one tap can serve about 100 colonists).
       waterPerBottle 0.5 is DBH's own charge for packing a bottle (SanitationToils.FillBottleFromThing), and it matches the
       bottle's 0.5 kg, since half a kilogram of water is about half a litre. -->
  <ThingDef ParentName="FurnitureBase" DBHThirst="true" DBHLite="true">
    <defName>PhobosWaterTap_BottleTap</defName>
    <label>water bottle tap</label>
    <description>A tap on your plumbing with a rack beneath it, which keeps a stack of bottled water ready and refills it by itself from your water towers. Colonists drink from it and pack bottles from it, and caravans can load from it. It needs a pipe and a water tower, and it won't bottle contaminated water. Each bottle holds whatever water filled it, so untreated water makes untreated bottles.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Phobos/WaterTap/BottleTap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <pathCost>50</pathCost>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>20</Steel>
    </costList>
    <building>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <ai_chillDestination>false</ai_chillDestination>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>DBH_WaterBottle</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>DBH_WaterBottle</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Hygiene</designationCategory>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <comps>
      <li Class="DubsBadHygiene.CompProperties_Pipe">
        <mode>Sewage</mode>
      </li>
      <li Class="Phobos.WaterTap.CompProperties_BottleTap">
        <bottle>DBH_WaterBottle</bottle>
        <waterPerBottle>0.5</waterPerBottle>
        <bottlesPerFill>1</bottlesPerFill>
        <startingTarget>10</startingTarget>
      </li>
    </comps>
    <researchPrerequisites>
      <li>Plumbing</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
