<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The drill rig: a heavy truck carrying a deep drill (docs/development/vehicle-drill-rig.md). It runs the game deep drill's own figures, 10,000 work a portion and the game's portion sizes; the bare rig is at ten times a deep drill and the bits take it to twenty (owner, 9 Nov 2026). Every other figure
    is authored and untuned. Part keys are saved by position: append only, never reorder. Cells run x -1 to 1, z -4 to 5. Its pictures were generated for it on 12 Nov 2026 (assets/phobos-vehicles/requests/night-2026-11-12-record.md). Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_DrillRig</defName>
    <label>Kelly drill rig</label>
    <description>Kelly K1: a heavy truck carrying a deep drill with a folding mast. Park it over a deposit a scanner has found, set it up, and a colonist can drill as at a deep drill, with what comes up landing beside the hole. When the ore is gone it brings up stone. Active drilling can break into insect tunnels, as with any deep drill. It cannot move while set up.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/DrillRig/DrillRig</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(4, 11)</drawSize>
      <color>(162, 156, 123)</color>
      <colorTwo>(195, 110, 36)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_DrillRig_Blueprint</buildDef>
    <size>(3, 10)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.26</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.5</Flammability>
      <MarketValue>4200</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>400</Mass>
      <MoveSpeed>10</MoveSpeed>
      <CargoCapacity>40</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
      <Phobos_DrillRate>10</Phobos_DrillRate>
      <Phobos_DrillReach>2.6</Phobos_DrillReach>
      <Phobos_RigControl>1</Phobos_RigControl>
      <Phobos_RigStability>1</Phobos_RigStability>
    </vehicleStats>
    <race>
      <baseBodySize>8</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>1</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>8</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 3)</li>
            </cells>
          </hitbox>
        </li>
        <li>
          <key>passenger</key>
          <label>passenger</label>
          <slots>1</slots>
          <hitbox>
            <cells>
              <li>(1, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>190</health>
      <depth>External</depth>
      <hitWeight>3</hitWeight>
      <hitbox>
        <from>(-1, -4)</from>
        <to>(1, 5)</to>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>50</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Engine</key>
      <label>engine</label>
      <health>60</health>
      <depth>Internal</depth>
      <priorityStatEfficiency>true</priorityStatEfficiency>
      <reactors>
        <li Class="Vehicles.Reactor_Explosive">
          <indicator>VF_Explosive</indicator>
          <chance>0.25</chance>
          <maxHealth>0.2</maxHealth>
          <radius>3</radius>
          <damageDef>Flame</damageDef>
        </li>
      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(0, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>Transmission</key>
      <label>transmission</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FrontWheels</key>
      <label>front axle and wheels</label>
      <health>35</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>RearWheels</key>
      <label>rear axles and wheels</label>
      <health>50</health>
      <depth>External</depth>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, -1)</li>
          <li>(1, -1)</li>
          <li>(-1, -2)</li>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>FuelTank</key>
      <label>fuel tank</label>
      <health>40</health>
      <depth>Internal</depth>
      <reactors>
        <li Class="Vehicles.Reactor_FuelLeak" />
      </reactors>
      <hitbox>
        <cells>
          <li>(-1, 1)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>HydraulicPack</key>
      <label>hydraulic power pack</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigStability</li>
      </categories>
    </li>
    <li>
      <key>HydraulicLines</key>
      <label>hydraulic lines</label>
      <health>25</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, 1)</li>
          <li>(0, 0)</li>
          <li>(0, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigStability</li>
      </categories>
    </li>
    <li>
      <key>Outriggers</key>
      <label>outriggers</label>
      <health>50</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 2)</li>
          <li>(1, 2)</li>
          <li>(-1, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigStability</li>
      </categories>
    </li>
    <li>
      <key>Mast</key>
      <label>mast</label>
      <health>70</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -2)</li>
          <li>(0, -3)</li>
          <li>(0, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigStability</li>
      </categories>
    </li>
    <li>
      <key>RotaryHead</key>
      <label>rotary head</label>
      <health>45</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>DrillString</key>
      <label>drill string and rod rack</label>
      <health>40</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 0)</li>
          <li>(-1, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>DrillBit</key>
      <label>drill bit</label>
      <health>25</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(0, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>Drawworks</key>
      <label>draw-works and winch</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(0, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>Compressor</key>
      <label>compressor</label>
      <health>40</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 0)</li>
          <li>(1, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>FlushingPump</key>
      <label>flushing pump</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(-1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_DrillRate</li>
      </categories>
    </li>
    <li>
      <key>ControlConsole</key>
      <label>control console</label>
      <health>35</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>Wiring</key>
      <label>wiring</label>
      <health>30</health>
      <depth>Internal</depth>
      <hitbox>
        <cells>
          <li>(1, 3)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>Phobos_RigControl</li>
      </categories>
    </li>
    <li>
      <key>CuttingsChute</key>
      <label>cuttings chute</label>
      <health>20</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(1, -3)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Lights</key>
      <label>lights</label>
      <health>15</health>
      <depth>External</depth>
      <hitbox>
        <cells>
          <li>(-1, 5)</li>
          <li>(1, 5)</li>
          <li>(-1, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
    </li>
    </components>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>20000</emptyKilograms>
        <ratedKilowatts>300</ratedKilowatts>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosVehicles_DrillRigEngineIdle</idleSound>
        <loadSound>PhobosVehicles_DrillRigEngineLoad</loadSound>
      </li>
      <!-- Its work: setting up (packing up plays it too), drilling (the hammer bit by upgrade, on shore power its own), a portion, spent ground. -->
      <li Class="Phobos.VehicleSystems.PhobosVehicleSoundsExtension">
        <sounds>
          <li><key>SetUp</key><sound>PhobosVehicles_DrillRigSetUp</sound></li>
          <li><key>Work</key><sound>PhobosVehicles_DrillRigHammer</sound><node>RcHammer</node></li>
          <li><key>Work</key><sound>PhobosVehicles_DrillRigDrill</sound></li>
          <li><key>WorkElectric</key><sound>PhobosVehicles_DrillRigElectric</sound></li>
          <li><key>Portion</key><sound>PhobosVehicles_DrillRigChute</sound></li>
          <li><key>Spent</key><sound>PhobosVehicles_DrillRigWindDown</sound></li>
        </sounds>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>30</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>160</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_DrillRig_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosDrillRig">
        <powerPointDef>Phobos_PowerPoint</powerPointDef>
        <powerPointLargeDef>Phobos_PowerPointLarge</powerPointLargeDef>
        <vitalParts>
          <li>Mast</li>
          <li>RotaryHead</li>
          <li>DrillBit</li>
        </vitalParts>
        <pipedResources>
          <li MayRequire="vanillaexpanded.vchemfuele">VCHE_Deepchem</li>
        </pipedResources>
        <!-- Outriggers down while set up (12 Nov 2026). The mast stays folded in its cradle: how it should move is still the owner's question. -->
        <setUpOverlay>
          <graphicData>
            <texPath>Phobos/Vehicles/DrillRig/DrillRig_SetUp</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 11)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </setUpOverlay>
      </li>
      <!-- The mast and the rotary head are pictures of their own over the body, so they can move later; the tall mast replaces the
           stock one when its upgrade is fitted (D'thorga Framework's node looks, 12 Nov 2026). -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>mast</key>
            <looks>
              <li>
                <node>TallMast</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/DrillRig/DrillRig_MastTall</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 11)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/DrillRig/DrillRig_Mast</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 11)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <li>
            <key>head</key>
            <looks>
              <li>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/DrillRig/DrillRig_RotaryHead</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 11)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        </slots>
      </li>
      <!-- Damage pictures while a part is below 60% health (12 Nov 2026): the bulk tanker's marks, cropped and fitted here by
           assets/phobos-vehicles/export_damage.py. Placements are the agent's. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosDamageLooks">
        <looks>
          <li>
            <part>Cab</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/DrillRig/DrillRig_DamageCab</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 11)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>HydraulicPack</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/DrillRig/DrillRig_DamagePowerUnit</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 11)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>Chassis</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/DrillRig/DrillRig_DamageDeck</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 11)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
        </looks>
      </li>
    </comps>
    <!-- Its own voice in place of the inherited draft blips; the engine loops are played by D'thorga Framework from the
         extension below, so they follow rpm and load (docs/development/sound-catalogue.md). -->
    <soundOneShotsOnEvent Inherit="False">
      <li>
        <key>IgnitionOn</key>
        <value>PhobosVehicles_DrillRigEngineStart</value>
      </li>
      <li>
        <key>IgnitionOff</key>
        <value>PhobosVehicles_DrillRigEngineStop</value>
      </li>
      <li>
        <key>PawnEntered</key>
        <value>PhobosVehicles_DrillRigDoor</value>
      </li>
      <li>
        <key>PawnExited</key>
        <value>PhobosVehicles_DrillRigDoor</value>
      </li>
      <li>
        <key>Braking</key>
        <value>PhobosVehicles_DrillRigAirBrake</value>
      </li>
      <li>
        <key>OutOfFuel</key>
        <value>PhobosVehicles_DrillRigSputter</value>
      </li>
    </soundOneShotsOnEvent>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_DrillRig_Blueprint</defName>
    <label>Kelly drill rig</label>
    <description>Kelly K1: a heavy truck carrying a deep drill, for working deposits wherever you can drive it.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/DrillRig/DrillRig</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4, 11)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>20000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_DrillRig</li>
    </researchPrerequisites>
    <size>(3, 10)</size>
    <!-- The shell only: its parts are in Bill_DrillRig.xml, filled at start-up (docs/development/parts-bills.md). Steel stays first. -->
    <costList>
      <Steel>560</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_DrillRig</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_DrillRig</defName>
    <label>drill rig</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Phobos_DrillRig</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
    <!-- The mast, the rotary head and the outriggers are hydraulic (D'thorga Vehicles 0.33.0, Framework 0.73.0): the rig's own power pack
         and lines are bound to the hydraulics system, so a cut line bleeds the fluid and the drilling slows, then stops. -->
    <systems>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
    </systems>
    <partRoles>
      <li>
        <role>HydraulicPump</role>
        <find>
          <li><keyContains>hydraulicpack</keyContains></li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li><keyContains>hydrauliclines</keyContains></li>
        </find>
      </li>
    </partRoles>
    <loads>
      <li>
        <name>workLights</name>
        <label>work lights</label>
        <description>Lamps over the work, on at night while it is set up.</description>
        <amps>6</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <available Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_WorkLights</stat>
          <value>0</value>
        </available>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_SetUp" />
            <li Class="Phobos.VehicleSystems.When_Night" />
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
