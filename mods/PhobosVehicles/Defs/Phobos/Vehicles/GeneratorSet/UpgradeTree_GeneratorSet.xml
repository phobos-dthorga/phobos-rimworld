<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The generator set's upgrades (docs/development/vehicle-generator-set.md). Figures and costs authored. Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_GeneratorSet_UpgradeTree</defName>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEnforceUpgradeResearch" />
    </modExtensions>
    <nodes>
    <li>
      <key>BiggerAlternator</key>
      <label>uprated alternator</label>
      <displayLabel>true</displayLabel>
      <description>A bigger alternator behind the cab: 400 W more at full output, and fuel burned at the same watts per unit.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/BiggerAlternator</icon>
      <work>3000</work>
      <gridCoordinate>(2, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_GeneratorOutput</def>
              <value>400</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <!-- Beside one alternator, which the vehicle's parts bill adds (Bill_GeneratorSet.xml). -->
        <Steel>50</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_BiggerGenerator</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(3, 7)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>CableReel</key>
      <label>cable reel</label>
      <displayLabel>true</displayLabel>
      <description>A long cable on a drum. You choose where the cable end goes, up to 12 cells from the truck, so the truck can stand somewhere safe.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/CableReel</icon>
      <work>1500</work>
      <gridCoordinate>(7, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_CableReach</def>
              <value>12</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_Reel</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(3, 7)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>BatteryBuffer</key>
      <label>battery buffer</label>
      <displayLabel>true</displayLabel>
      <description>A battery box under the deck. It fills from spare power and keeps the grid alive for a time when the tank runs dry or the engine is hurt.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/BatteryBuffer</icon>
      <work>2000</work>
      <gridCoordinate>(12, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Batteries</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_GeneratorBuffer</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <!-- Beside two batteries, which the vehicle's parts bill adds (Bill_GeneratorSet.xml): the buffer's own electronics. -->
        <ComponentIndustrial>6</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_Battery</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(3, 7)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Owner, 11 Nov 2026 (docs/development/vehicle-upgrades-round-two.md, the generator set's signature). The share and the output
           cost are authored; the heat rate and the 21 C target come from the game's own heater (CompPhobosGeneratorSet). Its icon and
           overlay are the owner's pick of 12 Nov 2026. -->
      <key>HeatRecovery</key>
      <label>exhaust heat exchanger</label>
      <displayLabel>true</displayLabel>
      <description>A heat exchanger on the exhaust. While the set makes power, it warms the room the cable end stands in, more as more power is drawn, until the room reaches 21 C. Outdoors the heat goes to waste. The exchanger's back pressure costs 25 W of output.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/HeatExchanger</icon>
      <work>1500</work>
      <gridCoordinate>(7, 11)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_HeatRecovery</def>
              <value>0.6</value>
            </li>
            <li>
              <def>Phobos_GeneratorOutput</def>
              <value>-25</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_HeatExchanger</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(3, 7)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Owner, 12 Nov 2026: the heavy-duty fan, fan picture 2 as the upgrade of the stock fan. What it is for (agent proposal, owner to
           revise; docs/development/vehicle-generator-set.md): a parked radiator cools at 0.7 of its moving rate, and the fan's 0.3 brings
           it to the full rate, so a set left working hard in summer heat keeps its coolant in hand. Cost authored. -->
      <key>HeavyFan</key>
      <label>heavy-duty fan</label>
      <displayLabel>true</displayLabel>
      <description>A bigger cooling fan with a heavier guard. A parked engine's radiator gets no air from driving; this fan moves as much air through it as the road would, so the set stays cool working hard in hot weather.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/HeavyFan</icon>
      <work>1200</work>
      <gridCoordinate>(12, 11)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_StoppedAirflow</def>
              <value>0.3</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Owner, 12 Nov 2026: the service lead, batch 3 signature (docs/development/vehicle-upgrades-round-two.md). Reach and cost authored;
           the lead's 300 W is in the rules Def. No picture on the body: the lead is drawn as a line while the set is selected. -->
      <key>PhobosServiceLead</key>
      <label>service lead</label>
      <displayLabel>true</displayLabel>
      <description>A heavy cable on a small reel, with clamps and a charger. While the set is set up and running, the lead reaches one of your vehicles within 6 cells, charges its battery, and gives it a start if it is too flat to start. It takes 300 W before the camp's grid does.</description>
      <icon>Phobos/VehicleSystems/ServiceLead</icon>
      <work>1200</work>
      <gridCoordinate>(2, 11)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_ServiceLeadReach</def>
              <value>6</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
