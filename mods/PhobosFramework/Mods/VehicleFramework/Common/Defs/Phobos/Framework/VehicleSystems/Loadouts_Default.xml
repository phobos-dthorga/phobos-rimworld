<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The default loadouts: which vehicles get which systems, matched by what a vehicle does (its fuel, whether it flies or floats,
    its mass), never by its name. A named loadout in another mod (priority Mod or Vehicle) beats these. Design:
    docs/development/vehicle-systems-design.md; how to write one: docs/vehicle-systems-modding.md. Not yet tested in game.

    Part roles are found on the vehicle's own parts first: the engine by its effect (an internal part that decides move speed; then a part that carries it
    and is named engine, wherever it sits; then any internal part that carries it); the alternator, gearbox and the rest by tag, then by a hint in the part's key, because nothing else
    marks them (Vanilla Vehicles Expanded's alternator carries no stat). A role nothing plays gets an appended part that takes the
    engine's cells and armour, so Combat Extended can reach it. Parts are only ever appended, never reordered. Hit weights: Vehicle
    Framework hits a bigger weight more often, Combat Extended a smaller one, so each added part's hitWeight is inverted under CE
    unless it gives a hitWeightCE (the radiator 2: outside the hull it is hit before the armour plate about a quarter of the time;
    the clutch 5; both authored).

    Electrical figures (secondary unless said): a light vehicle's 12 V, 45 Ah battery and 65 A alternator (Wikipedia, "Automotive
    battery" and "Alternator (automotive)"); a heavy vehicle's two 12 V batteries in series for 24 V (100 Ah, authored) and a 24 V,
    100 A alternator (Delco Remy 28SI product listing). Loads: two 55 W headlamps at 12 V draw about 9 A (Ohm's law, our
    inference); the heater blower and the instruments are authored. Heavy vehicles' loads are halved in amperes at 24 V.
    The 120 and 350 mass lines between light, medium and heavy are authored, in Vehicle Framework's mass units.

    Drivetrains (docs/development/vehicle-drivetrain-design.md, figures in Drivetrains.xml): a light vehicle gets a petrol engine,
    medium and heavy ones a diesel, a tracked one (a part key ending in Track, as Vanilla Vehicles Expanded's tracks are named) a
    tracked diesel and wins a tie through its rank; boats a propeller, aircraft a turbofan with the stock flight profile.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef Name="PhobosVehicleLoadoutCombustionBase" Abstract="True">
    <priority>Effect</priority>
    <selector>
      <fuelled>Yes</fuelled>
      <electricPowered>No</electricPowered>
      <flies>No</flies>
    </selector>
    <partRoles>
      <li>
        <role>Engine</role>
        <find>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
            <priority>Yes</priority>
          </li>
          <li>
            <!-- Before the next one: some designs mark their engine External (Vanilla Vehicles Expanded's Traveller, Bang Bus, Highwayman,
                 Bunsen, Roadkill and Scytheman), and an internal part that carries move speed would then be a suspension or a gearbox. -->
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <keyContains>engine</keyContains>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
          </li>
          <li>
            <keyContains>engine</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>Alternator</role>
        <find>
          <li>
            <tag>Alternator</tag>
          </li>
          <li>
            <keyContains>alternator</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosAlternator</key>
          <label>alternator</label>
          <health>25</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Battery</role>
        <find>
          <li>
            <tag>Battery</tag>
          </li>
          <li>
            <keyContains>battery</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosBattery</key>
          <label>battery</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Starter</role>
        <find>
          <li>
            <keyContains>starter</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosStarter</key>
          <label>starter motor</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>OilPump</role>
        <find>
          <li>
            <keyContains>oilpump</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosOilPump</key>
          <label>oil pump</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <!-- Framework 0.55.0: fuel system, feed to the engine (the owner's parts refresh, 9 Nov 2026). -->
        <role>FuelPump</role>
        <find>
          <li>
            <keyContains>fuelpump</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosFuelPump</key>
          <label>fuel pump</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Transmission</role>
        <find>
          <li>
            <keyContains>gearbox</keyContains>
          </li>
          <li>
            <keyContains>transmission</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosTransmission</key>
          <label>gearbox</label>
          <health>40</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef Name="PhobosVehicleLoadoutLandBase" ParentName="PhobosVehicleLoadoutCombustionBase" Abstract="True">
    <selector>
      <vehicleTypes>
        <li>Land</li>
      </vehicleTypes>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_Electrical</def></li>
      <li><def>PhobosVehicleSystem_Cooling</def></li>
      <li><def>PhobosVehicleSystem_Lubrication</def></li>
      <li><def>PhobosVehicleSystem_Fuel</def></li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_RunningGear</def></li>
      <li><def>PhobosVehicleSystem_Brakes</def></li>
      <li><def>PhobosVehicleSystem_Transmission</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Radiator</role>
        <find>
          <li>
            <keyContains>radiator</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosRadiator</key>
          <label>radiator</label>
          <health>30</health>
          <depth>External</depth>
          <hitWeight>0.5</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <!-- Framework 0.55.0: it moves the coolant, so a dead one leaves the radiator nothing to cool (the owner's parts refresh, 9 Nov 2026). -->
        <role>WaterPump</role>
        <find>
          <li>
            <keyContains>waterpump</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosWaterPump</key>
          <label>water pump</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <!-- Framework 0.73.0 (T2 of docs/development/vehicle-crosslinks-round-two.md): one belt turns the water pump and the alternator on
             most engines (secondary: Wikipedia, "Serpentine belt"). A worn or snapped one starves both: the coolant climbs and the battery
             drains together. Health and hit weights authored. -->
        <role>Belt</role>
        <find>
          <li>
            <keyContains>belt</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosDriveBelt</key>
          <label>drive belt</label>
          <health>10</health>
          <hitWeight>0.3</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Wheels</role>
        <all>true</all>
        <find>
          <li>
            <tag>Wheel</tag>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>External</depth>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <keyContains>brake</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosBrakes</key>
          <label>brakes</label>
          <health>30</health>
          <cellsOf>Wheels</cellsOf>
        </add>
      </li>
      <li>
        <!-- The clutch or torque converter: a damaged one slips under high load (drivetrain design). -->
        <role>Clutch</role>
        <find>
          <li>
            <keyContains>clutch</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosClutch</key>
          <label>clutch</label>
          <health>25</health>
          <hitWeight>0.2</hitWeight>
          <hitWeightCE>5</hitWeightCE>
          <cellsOf>Transmission</cellsOf>
        </add>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef Name="PhobosVehicleLoadoutLandLight" ParentName="PhobosVehicleLoadoutLandBase">
    <defName>PhobosVehicleLoadout_LandLight</defName>
    <label>light land vehicle</label>
    <kind>CombustionLand</kind>
    <selector>
      <massMax>119.99</massMax>
    </selector>
    <drivetrain>
      <def>PhobosDrivetrain_LightPetrol</def>
    </drivetrain>
    <loads>
      <li>
        <name>headlights</name>
        <label>headlights</label>
        <description>The headlights come on at night while the engine runs.</description>
        <amps>9</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Night" />
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
          </conditions>
        </when>
      </li>
      <li>
        <name>cabHeater</name>
        <label>cab heater</label>
        <description>The cab heater runs below 5 °C while the engine runs, on the engine's own heat: it warms the cab only once the engine has warmed up, and not at all with the coolant gone.</description>
        <amps>12</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <name>instruments</name>
        <label>ignition and instruments</label>
        <amps>4</amps>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <!-- Automatic climate control (Framework 0.22.0): only on vehicles fitted with it (When_ClimateControl), or every closed cab
             with the player's setting. It runs the heater and air conditioner itself to hold the cab near 21 degrees C, so the manual
             ones stand down while it runs. The draw is an average of the fans, blower and controls (authored). -->
        <name>climateControl</name>
        <label>climate control</label>
        <description>Holds the cab near 21 °C by itself while the engine runs, heating or cooling as needed. Switch it off to use the heater and air conditioner by hand.</description>
        <amps>8</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/ClimateControl</iconPath>
        <available Class="Phobos.VehicleSystems.When_ClimateControl" />
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>airConditioner</name>
        <label>air conditioner</label>
        <description>The air conditioner cools the cab above 26 °C while the engine runs.</description>
        <amps>30</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/AirConditioner</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientAbove">
              <celsius>26</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <name>nightHeater</name>
        <label>night heater</label>
        <description>A fuel-burning heater that keeps the cab and the engine warm while the caravan camps for the night with the engine off, so it starts easily in the morning. Switch it on before you leave; it needs the night heater setting.</description>
        <amps>2</amps>
        <toggle>true</toggle>
        <defaultOn>false</defaultOn>
        <iconPath>Phobos/VehicleSystems/NightHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_CaravanResting" />
            <li Class="Phobos.VehicleSystems.When_Setting">
              <setting>nightHeater</setting>
            </li>
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

