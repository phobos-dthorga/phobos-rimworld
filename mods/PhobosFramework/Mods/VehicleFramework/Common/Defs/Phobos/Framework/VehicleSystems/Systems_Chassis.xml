<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The chassis systems (phase C of the design): running gear (tyres or tracks), brakes and the transmission. Design:
    docs/development/vehicle-systems-design.md. Not yet tested in game. Every rate, threshold and factor here is authored; the
    supplies are gameplay stand-ins, said so in the README: the game has no rubber, so tyres and track pads take chemfuel for it (synthetic
    rubber is a petrochemical), with steel for the beads and rims and components for the valves (owner, 8 Nov 2026).
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_RunningGear</defName>
    <label>tyres and tracks</label>
    <description>Tyres and track pads wear as the vehicle drives. Worn ones make drivers go slower; worn through, they fail on the road. A mechanic renews them with steel, components and chemfuel loaded aboard.</description>
    <roles>
      <li>Wheels</li>
    </roles>
    <parameters>
      <wearPerHour>0.0025</wearPerHour>
    </parameters>
    <quantities>
      <li>
        <name>treadWear</name>
        <description>How much tread is gone. It wears as the vehicle moves, faster on rough ground. Worn through, it is slower and a tyre or track can fail.</description>
        <wearTrend>true</wearTrend>
        <telltale>Phobos/VehicleSystems/Dash/Tyre</telltale>
        <showOnDashboard>true</showOnDashboard>
        <remainingLabel>tread</remainingLabel>
        <label>tread wear</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Empty</startsAt>
        <stages>
          <li>
            <from>0.6</from>
            <to>0.9</to>
            <label>worn</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>MoveSpeed</stat>
                <factor>0.93</factor>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgTyresWorn</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
          <li>
            <from>0.9</from>
            <label>worn through</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>MoveSpeed</stat>
                <factor>0.8</factor>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Breakdown">
                <role>Wheels</role>
                <mtbHours>30</mtbHours>
                <healthFraction>0.5</healthFraction>
                <message>PhobosVehicleSystems_MsgTyreFailed</message>
                <sound>PhobosVehicleSystems_TyreBurst</sound>
                <when Class="Phobos.VehicleSystems.When_Moving" />
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- Crosslink 6: driving over mud, marsh, soft sand or deep snow (path cost 8 and up) knocks the running gear about, 1% of its
             health an hour on the move (authored), so a long drive off the roads shows on the Health tab and a repair follows. -->
        <name>groundRoughness</name>
        <description>How rough the ground under it is. Rough ground wears tread faster and knocks the running gear about.</description>
        <label>ground</label>
        <unit>Plain</unit>
        <min>0</min>
        <max>100</max>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_GroundPathCost">
            <setting>roughGroundWear</setting>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <from>8</from>
            <label>rough</label>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Wheels</role>
                <sharePerHour>0.01</sharePerHour>
                <when Class="Phobos.VehicleSystems.When_Moving" />
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>wear</name>
        <quantity>treadWear</quantity>
        <kind>Into</kind>
        <factorParameter>wearPerHour</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_Moving" />
          <li Class="Phobos.VehicleSystems.Input_GroundPathCost">
            <!-- Crosslink 6 (Framework 0.70.0): rough ground wears tread faster than a road (common knowledge; no figure claimed).
                 By the ground's path cost (authored): a road or floor 1, soil 1.2, mud, marsh or soft sand 2.5, the worst 3. The
                 player's "rough ground wears tyres and suspension" setting (on) makes all ground a road. -->
            <setting>roughGroundWear</setting>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(2, 1.2)</li>
                <li>(14, 2.5)</li>
                <li>(30, 3)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
    </flows>
    <service>
      <label>new tyres or track pads</label>
      <dueQuantity>treadWear</dueQuantity>
      <dueAbove>0.6</dueAbove>
      <restores>
        <li>
          <quantity>treadWear</quantity>
          <value>0</value>
        </li>
      </restores>
      <!-- Framework 0.74.0 (S4): a tyre set made at the parts bench; a colony that still accepts raw materials pays what it is made of. -->
      <supplies>
        <PhobosVehicles_TyreSet>1</PhobosVehicles_TyreSet>
      </supplies>
      <rawSupplies>
        <Steel>15</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
        <Chemfuel>10</Chemfuel>
      </rawSupplies>
      <work>2000</work>
    </service>
    <onEvents>
      <li>
        <!-- A stack put aboard (owner, 10 Nov 2026: soft, one at a time). -->
        <eventDef>CargoAdded</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_Sound">
            <sound>PhobosVehicleSystems_CargoSetDown</sound>
          </li>
        </effects>
      </li>
      <li>
        <!-- A stack taken off. -->
        <eventDef>CargoRemoved</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_Sound">
            <sound>PhobosVehicleSystems_CargoTakenOff</sound>
          </li>
        </effects>
      </li>
    </onEvents>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Brakes</defName>
    <label>brakes</label>
    <description>The brakes wear with every stop. Worn brakes make drivers take it gently; worn through, or with the brake part wrecked, the vehicle will not drive until a mechanic fits new pads.</description>
    <roles>
      <li>Brakes</li>
    </roles>
    <!-- Wear on the move and at each stop (authored). An electric vehicle slows mostly on its motor (regenerative braking), so its
         loadout lowers both. -->
    <parameters>
      <wearPerHourMoving>0.0005</wearPerHourMoving>
      <wearPerStop>0.0008</wearPerStop>
    </parameters>
    <quantities>
      <li>
        <name>brakeWear</name>
        <description>How much of the pads is gone. They wear as the vehicle moves. Worn through, it cannot be driven until they are renewed.</description>
        <wearTrend>true</wearTrend>
        <telltale>Phobos/VehicleSystems/Dash/Brake</telltale>
        <showOnDashboard>true</showOnDashboard>
        <remainingLabel>brakes</remainingLabel>
        <label>brake wear</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Empty</startsAt>
        <stages>
          <li>
            <from>0.7</from>
            <to>0.95</to>
            <label>worn</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>MoveSpeed</stat>
                <factor>0.9</factor>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgBrakesWorn</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
          <li>
            <from>0.95</from>
            <label>worn through</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseMove">
                <reason>PhobosVehicleSystems_RefuseBrakesWorn</reason>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>brakeParts</name>
        <description>The state of the brakes themselves. Wrecked, the vehicle cannot be driven.</description>
        <telltale>Phobos/VehicleSystems/Dash/Brake</telltale>
        <label>brakes</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Brakes</role>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.2</to>
            <label>wrecked</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseMove">
                <reason>PhobosVehicleSystems_RefuseBrakesWrecked</reason>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>drivingWear</name>
        <quantity>brakeWear</quantity>
        <kind>Into</kind>
        <factorParameter>wearPerHourMoving</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_Moving" />
        </inputs>
      </li>
    </flows>
    <onEvents>
      <li>
        <eventDef>MoveStop</eventDef>
        <effects>
          <!-- Worn brakes squeal as it stops (the worn stage starts at 0.7). -->
          <li Class="Phobos.VehicleSystems.Effect_Sound">
            <sound>PhobosVehicleSystems_BrakeSqueal</sound>
            <when Class="Phobos.VehicleSystems.When_QuantityAbove"><quantity>brakeWear</quantity><value>0.7</value></when>
          </li>
          <li Class="Phobos.VehicleSystems.Effect_AddQuantity">
            <quantity>brakeWear</quantity>
            <amount>1</amount>
            <scaleByParameter>wearPerStop</scaleByParameter>
          </li>
        </effects>
      </li>
    </onEvents>
    <onPartHit>
      <li>
        <role>Brakes</role>
        <quantity>brakeWear</quantity>
        <perHealthLost>0.02</perHealthLost>
      </li>
    </onPartHit>
    <service>
      <label>new brake pads</label>
      <dueQuantity>brakeWear</dueQuantity>
      <dueAbove>0.7</dueAbove>
      <restores>
        <li>
          <quantity>brakeWear</quantity>
          <value>0</value>
        </li>
      </restores>
      <!-- Framework 0.74.0 (S4): a brake pad set; raw, the component it is made of. -->
      <supplies>
        <PhobosVehicles_BrakePadSet>1</PhobosVehicles_BrakePadSet>
      </supplies>
      <rawSupplies>
        <ComponentIndustrial>1</ComponentIndustrial>
      </rawSupplies>
      <work>800</work>
    </service>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    The transmission's oil heats with work on the move, more in a damaged gearbox, and cools toward the air (authored: settles near
    90 degrees C at full work, past 120 once the gearbox is badly worn). Most of a gearbox's heat at ordinary loads comes from churning
    its oil, so a light cruise still warms it (Input_GearboxWork: authored shares, 70% at no load on the move, 10% standing; Framework
    0.29.1, after the drivetrain model's real loads left a driven tank's gearbox at the air's temperature).
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Transmission</defName>
    <label>transmission</label>
    <description>The gearbox's oil heats with hard driving, faster in a damaged gearbox. Too hot, the gearbox wears while the vehicle moves.</description>
    <roles>
      <li>Transmission</li>
    </roles>
    <parameters>
      <heatAtFullLoad>180</heatAtFullLoad>
      <coolRate>2</coolRate>
      <soakRate>0.5</soakRate>
    </parameters>
    <quantities>
      <li>
        <name>transmissionTemperature</name>
        <description>The gearbox's heat. Hard pulling warms it and moving air cools it.</description>
        <telltale>Phobos/VehicleSystems/Dash/Gearbox</telltale>
        <label>gearbox</label>
        <unit>Celsius</unit>
        <min>-60</min>
        <max>200</max>
        <startsAt>Ambient</startsAt>
        <stages>
          <li>
            <from>120</from>
            <label>overheating</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Transmission</role>
                <perHour>1</perHour>
                <when Class="Phobos.VehicleSystems.When_Moving" />
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgTransmissionHot</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>work</name>
        <quantity>transmissionTemperature</quantity>
        <kind>Into</kind>
        <factorParameter>heatAtFullLoad</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_GearboxWork" />
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Transmission</role>
            <curve>
              <points>
                <li>(0, 3)</li>
                <li>(0.5, 1.6)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <name>airflow</name>
        <quantity>transmissionTemperature</quantity>
        <kind>Toward</kind>
        <target Class="Phobos.VehicleSystems.Input_Ambient" />
        <factorParameter>coolRate</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_Moving">
            <stopped>0.5</stopped>
            <moving>1</moving>
          </li>
        </inputs>
      </li>
      <li>
        <name>soak</name>
        <quantity>transmissionTemperature</quantity>
        <kind>Toward</kind>
        <target Class="Phobos.VehicleSystems.Input_Ambient" />
        <factorParameter>soakRate</factorParameter>
      </li>
    </flows>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
