        <hitch>
          <li>PhobosCoupling_ArticulatedPivot</li>
        </hitch>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosFarming_TractorT400EngineIdle</idleSound>
        <loadSound>PhobosFarming_TractorT400EngineLoad</loadSound>
      </li>
    </modExtensions>
    <comps>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosFieldRun" />
    </comps>
    <soundOneShotsOnEvent Inherit="False">
      <li>
        <key>IgnitionOn</key>
        <value>PhobosFarming_TractorT400EngineStart</value>
      </li>
      <li>
        <key>IgnitionOff</key>
        <value>PhobosFarming_TractorT400EngineStop</value>
      </li>
    </soundOneShotsOnEvent>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleDef ParentName="PhobosFarming_TractorT400FrontBase">
    <defName>Phobos_TractorT400Standard</defName>
    <label>Thane T400 tractor</label>
    <description>Thane T400: a very large articulated farm tractor that bends in the middle to steer. All its wheels drive and all its weight grips, so it pulls the widest implements through the heaviest ground; its rear half carries the three-point linkage and the drawbar. A large fuel deck lets it work long days.</description>
    <graphicData>
      <texPath>Phobos/Farming/TractorT400/TractorT400Front</texPath>
      <color>(141, 165, 106)</color>
      <colorTwo>(255, 227, 115)</colorTwo>
    </graphicData>
    <buildDef>Phobos_TractorT400Standard_Blueprint</buildDef>
    <statBases>
      <!-- Authored [A]: the front and rear halves together sell for less than their parts bill (AG6). -->
      <MarketValue>2200</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>1000</Mass>
    </vehicleStats>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>12000</emptyKilograms>
        <ratedKilowatts>400</ratedKilowatts>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosHitchPointExtension">
        <behindCentre>2.31</behindCentre>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>65</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>480</fuelCapacity>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosArticulated">
        <rearHalf>Phobos_TractorT400StandardRear</rearHalf>
      </li>
    
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_TractorT400_UpgradeTree</def>
      </li>
      <!-- Its upgrades' pictures (D'thorga Framework's node looks): parts drawn alone and fitted onto the body (export_farming.py). -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>weights</key>
            <looks>
              <li>
                <node>PhobosTractorFrontWeights</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Farming/TractorT400/TractorT400Front_Weights</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <shaderType>CutoutComplexPattern</shaderType>
                    <drawSize>(5, 6)</drawSize>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <li>
            <key>tank</key>
            <looks>
              <li>
                <fitting>PhobosFitting_AuxFuelTank</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Farming/TractorT400/TractorT400Front_Tank</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <shaderType>CutoutComplexPattern</shaderType>
                    <drawSize>(5, 5)</drawSize>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        </slots>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleDef ParentName="PhobosFarming_TractorT400FrontBase">
    <defName>Phobos_TractorT400B</defName>
    <label>Thane T400 B tractor</label>
    <description>Thane T400 B: the ballasted large articulated farm tractor. Heavier than the standard T400, it grips harder under the heaviest draught and burns a little more fuel, with a smaller fuel deck. It bends in the middle to steer; its rear half carries the three-point linkage and the drawbar.</description>
    <graphicData>
      <texPath>Phobos/Farming/TractorT400B/TractorT400BFront</texPath>
      <color>(141, 165, 106)</color>
      <colorTwo>(255, 227, 115)</colorTwo>
    </graphicData>
    <buildDef>Phobos_TractorT400B_Blueprint</buildDef>
    <statBases>
      <MarketValue>2300</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>1080</Mass>
    </vehicleStats>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>13000</emptyKilograms>
        <ratedKilowatts>400</ratedKilowatts>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosHitchPointExtension">
        <behindCentre>2.39</behindCentre>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>70</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>400</fuelCapacity>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosArticulated">
        <rearHalf>Phobos_TractorT400BRear</rearHalf>
      </li>
    
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_TractorT400B_UpgradeTree</def>
      </li>
      <!-- Its upgrades' pictures (D'thorga Framework's node looks): parts drawn alone and fitted onto the body (export_farming.py). -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>tank</key>
            <looks>
              <li>
                <fitting>PhobosFitting_AuxFuelTank</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Farming/TractorT400B/TractorT400BFront_Tank</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <shaderType>CutoutComplexPattern</shaderType>
