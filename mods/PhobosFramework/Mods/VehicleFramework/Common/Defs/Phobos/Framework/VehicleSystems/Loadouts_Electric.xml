<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Electric land vehicles (owner, 8 Nov 2026; Framework 0.20.0; docs/development/vehicle-electric-design.md): any land vehicle Vehicle
    Framework runs on electricity, matched by that and never by name. The traction battery and electric drive systems, the 12 V
    electrics charged by a DC-DC converter, the electric drivetrain (one fixed reduction), tyres and brakes, and the cab. No coolant,
    oil, gearbox or fuel-in-the-cold: an electric vehicle has none of them. Its night heater (Framework 0.104.0; owner, 12 Nov 2026) is
    its own: an electric heater that keeps the cab and the traction pack warm at a night camp from the pack's charge (Systems_Electric.xml,
    nightHeaterShare), never the combustion heater's chemfuel. Not yet tested in game.

    Figures: a 12 V, 45 Ah battery as the combustion loadouts (Wikipedia, "Automotive battery", secondary); a DC-DC converter of about
    1.5 kW, so 100 A at 12 V (general, approximate); the computers' and contactors' draw at switch-on 0.02 Ah (authored). Brake wear
    a third of a combustion vehicle's: most slowing is regenerative (authored; electric cars' brake pads are commonly reported to last
    two to three times as long, general).
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
    <defName>PhobosVehicleLoadout_LandElectric</defName>
    <label>electric land vehicle</label>
    <kind>Electric</kind>
    <priority>Effect</priority>
    <selector>
      <fuelled>Yes</fuelled>
      <electricPowered>Yes</electricPowered>
      <flies>No</flies>
      <vehicleTypes>
        <li>Land</li>
      </vehicleTypes>
    </selector>
    <drivetrain>
      <def>PhobosDrivetrain_Electric</def>
    </drivetrain>
    <systems>
      <li>
        <def>PhobosVehicleSystem_AuxiliaryElectrical</def>
        <set>
          <alternatorAmps>100</alternatorAmps>
          <starterAmpHours>0.02</starterAmpHours>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_TractionBattery</def></li>
      <li><def>PhobosVehicleSystem_ElectricDrive</def></li>
      <li><def>PhobosVehicleSystem_ElectricService</def></li>
      <li><def>PhobosVehicleSystem_RunningGear</def></li>
      <li>
        <def>PhobosVehicleSystem_Brakes</def>
        <set>
          <wearPerHourMoving>0.00017</wearPerHourMoving>
          <wearPerStop>0.00027</wearPerStop>
        </set>
      </li>
      <li>
        <!-- The cab's night heater flow warms the cab as on a combustion vehicle; its fuel figure is in units of chemfuel, and Vehicle
             Framework keeps an electric vehicle's charge as its fuel, so that burn is set to nothing here and the traction battery's own
             nightHeaterDraw pays for the night in charge (Framework 0.104.0). -->
        <def>PhobosVehicleSystem_Cabin</def>
        <set>
          <nightHeaterFuelPerHour>0</nightHeaterFuelPerHour>
        </set>
      </li>
    </systems>
    <partRoles>
      <li>
        <role>Engine</role>
        <find>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
            <priority>Yes</priority>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>Internal</depth>
          </li>
          <li>
            <keyContains>motor</keyContains>
          </li>
          <li>
            <keyContains>engine</keyContains>
          </li>
        </find>
      </li>
      <li>
        <role>TractionBattery</role>
        <find>
          <li>
            <keyContains>traction</keyContains>
          </li>
          <li>
            <keyContains>batterypack</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosTractionBattery</key>
          <label>traction battery</label>
          <health>60</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Alternator</role>
        <find>
          <li>
            <keyContains>converter</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosDcDcConverter</key>
          <label>DC-DC converter</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Battery</role>
        <find>
          <li>
            <tag>Battery</tag>
          </li>
        </find>
        <add>
          <key>PhobosBattery</key>
          <label>12 V battery</label>
          <health>20</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
      <li>
        <role>Wheels</role>
        <all>true</all>
        <find>
          <li>
            <tag>Wheel</tag>
          </li>
          <li>
            <categories>
              <li>MoveSpeed</li>
            </categories>
            <depth>External</depth>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <keyContains>brake</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosBrakes</key>
          <label>brakes</label>
          <health>30</health>
          <cellsOf>Wheels</cellsOf>
        </add>
      </li>
    </partRoles>
    <loads>
      <li>
        <name>headlights</name>
        <label>headlights</label>
        <description>Switched on, the headlights light the ground ahead of the vehicle at night. With the engine off they run the battery down.</description>
        <amps>9</amps>
        <shedOrder>6</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <!-- Framework 0.104.0 (owner, 12 Nov 2026: "make this a rule"): switched on, the headlights burn at night whether or not the engine
             runs, so with the engine off they run the battery down and can flatten it. Off by default, so a parked fleet is not flat by
             morning (agent's choice: a light vehicle's 45 Ah battery feeds 9 A of headlights for about five hours). -->
        <defaultOn>false</defaultOn>
        <when Class="Phobos.VehicleSystems.When_Night" />
        <!-- Framework 0.104.0: an electric vehicle's beam, a cool LED white (authored); the same reach as the diesels'. -->
        <beam>
          <radius>6</radius>
          <ahead>5</ahead>
          <colour>(235,240,255,0)</colour>
        </beam>
      </li>
      <li>
        <name>cabHeater</name>
        <label>cab heater</label>
        <description>The cab heater runs below 5 °C while the vehicle is switched on. It draws on the traction battery, so it costs range.</description>
        <amps>12</amps>
        <shedOrder>3</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <!-- The electric night heater (Framework 0.104.0; owner, 12 Nov 2026). Same name, switch, icon and setting as the combustion one, so
             the player meets one night heater and the cold-weather family turns it on; it runs at a caravan's night camp, as that one does.
             It draws on the traction battery (Systems_Electric.xml), so a cold night costs range. -->
        <name>nightHeater</name>
        <label>night heater</label>
        <description>An electric heater that keeps the cab and the drive battery warm while the caravan camps for the night, so the battery gives its full power and takes charge well in the morning. It runs on the drive battery, so a cold night costs some range. Switch it on before you leave; it needs the night heater setting.</description>
        <amps>2</amps>
        <shedOrder>4</shedOrder>
        <toggle>true</toggle>
        <defaultOn>false</defaultOn>
        <iconPath>Phobos/VehicleSystems/NightHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_CaravanResting" />
            <li Class="Phobos.VehicleSystems.When_Setting">
              <setting>nightHeater</setting>
            </li>
          </conditions>
        </when>
      </li>
      <li>
        <name>instruments</name>
        <label>computers and instruments</label>
        <amps>6</amps>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <!-- Automatic climate control (Framework 0.22.0): only on vehicles fitted with it (When_ClimateControl), or every closed cab
             with the player's setting. It runs the heater and air conditioner itself to hold the cab near 21 degrees C, so the manual
             ones stand down while it runs. The draw is an average of the fans, blower and controls (authored). -->
        <name>climateControl</name>
        <label>climate control</label>
        <description>Holds the cab near 21 °C by itself while the engine runs, heating or cooling as needed. Switch it off to use the heater and air conditioner by hand.</description>
        <amps>8</amps>
        <shedOrder>2</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/ClimateControl</iconPath>
        <available Class="Phobos.VehicleSystems.When_ClimateControl" />
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
      <li>
        <name>airConditioner</name>
        <label>air conditioner</label>
        <description>The air conditioner cools the cab above 26 °C while the vehicle is switched on. It draws on the traction battery, so it costs range.</description>
        <amps>10</amps>
        <shedOrder>1</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/AirConditioner</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientAbove">
              <celsius>26</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
            <li Class="Phobos.VehicleSystems.When_LoadActive">
              <load>climateControl</load>
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
