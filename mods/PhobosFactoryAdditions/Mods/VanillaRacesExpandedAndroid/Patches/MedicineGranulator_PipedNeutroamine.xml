<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    With Vanilla Races Expanded - Android active, let these bills draw neutroamine from the machine's pipe comp as
    well as from hoppers, as VFE Factory's own patch does for its stock bills. Each bill exists only while its
    source mod is active, so each group is wrapped in a PatchOperationFindMod on that mod's display name
    (the way VFE Factory gates its own optional patches). Not yet tested in game.
  -->

  <!-- The synthread medicine bill (0.8.0) is always loaded, so it needs no gate. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/PipeSystem.ProcessDef[defName="PhobosFactory_MakeMedicineFromSynthread"]</xpath>
    <value>
      <considerBuildingCompResource>true</considerBuildingCompResource>
    </value>
  </Operation>

