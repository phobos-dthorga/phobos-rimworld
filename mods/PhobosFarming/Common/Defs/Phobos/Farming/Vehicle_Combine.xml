<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The combine harvester (D'thorga Farming 0.1.0; docs/development/farming-batch-one.md). It cuts a paddock row by row with a front
    fitted by upgrade, threshes as it goes, and holds the grain in its tank until it empties into a chaser bin or bin. A 4 x 9 footprint,
    its picture 8 x 14 so the 8-cell front fits ahead of it (the owner's widths of 20 Nov 2026). Its picture is the owner's pick of
    19 Nov 2026 (assets/phobos-vehicles/requests/combine-pilot-record.md). The 16 tonnes empty, 250 kW, 9 tonnes of grain and every
    other figure are authored [A], labelled approximate: real mid-size combines run about 15 to 20 tonnes, 250 to 350 kW and 9,000 to
    12,000 litres of tank (general knowledge, not read from a source). Part keys are saved by position: append only, never reorder.
    Cells run x -1 to 2, z -4 to 4, the front north. Not yet tested in game.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>Phobos_Combine</defName>
    <label>Reaper combine harvester</label>
    <description>Reaper R1: a self-propelled combine. Fit it with a grain front, mark a growing zone as a paddock, and it drives the paddock row by row by itself, cutting and threshing every ripe plant its front takes into its grain tank. Its driver's harvesting skill sets the yield, as it does by hand. When the tank is full it drives to a chaser bin or a field bin with room and empties it through its auger. It is slow on the road and thirsty in the field: threshing takes a large share of its engine.</description>
    <graphicData>
      <texPath>Phobos/Farming/Combine/Combine</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>CutoutComplexPattern</shaderType>
      <drawSize>(8, 14)</drawSize>
      <color>(171, 202, 135)</color>
      <colorTwo>(252, 230, 157)</colorTwo>
    </graphicData>
    <fillPercent>1</fillPercent>
    <buildDef>Phobos_Combine_Blueprint</buildDef>
    <size>(4, 9)</size>
    <vehicleCategory>Transport</vehicleCategory>
    <techLevel>Industrial</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.26</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.7</Flammability>
      <MarketValue>4200</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>420</Mass>
      <MoveSpeed>7</MoveSpeed>
      <CargoCapacity>150</CargoCapacity>
      <RepairRate>0.5</RepairRate>
      <AccelerationRate>0.015</AccelerationRate>
    </vehicleStats>
    <race>
      <baseBodySize>9</baseBodySize>
    </race>
    <properties>
      <worldSpeedMultiplier>0.6</worldSpeedMultiplier>
      <winterSpeedMultiplier>1.5</winterSpeedMultiplier>
      <visibilityWeight>7</visibilityWeight>
      <customRoadCosts AssignDefaults="0.3" />
      <customTerrainCosts DisallowTerrainWithTag="Water" />
      <roles>
        <li>
          <key>driver</key>
          <label>driver</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
          <hitbox>
            <cells>
              <li>(0, 3)</li>
            </cells>
          </hitbox>
        </li>
      </roles>
    </properties>
    <components>
    <li>
      <key>Chassis</key>
      <label>chassis</label>
      <health>220</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitWeight>3</hitWeight>
      <hitbox>
        <cells>
          <li>(2, 0)</li>
          <li>(2, 1)</li>
          <li>(2, 2)</li>
          <li>(-1, -1)</li>
          <li>(0, -1)</li>
          <li>(1, -1)</li>
          <li>(2, -1)</li>
          <li>(-1, -2)</li>
          <li>(0, -2)</li>
          <li>(1, -2)</li>
          <li>(0, -3)</li>
          <li>(1, -3)</li>
          <li>(-1, -4)</li>
          <li>(2, -4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>BodyIntegrity</li>
      </categories>
    </li>
    <li>
      <key>Cab</key>
      <label>cab</label>
      <health>60</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(0, 3)</li>
          <li>(1, 3)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Feeder</key>
      <label>feeder house</label>
      <health>70</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(0, 4)</li>
          <li>(1, 4)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>FrontWheels</key>
      <label>drive wheels</label>
      <health>90</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, 3)</li>
          <li>(-1, 4)</li>
          <li>(2, 3)</li>
          <li>(2, 4)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>GrainTank</key>
      <label>grain tank</label>
      <health>120</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(0, 2)</li>
          <li>(1, 2)</li>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>UnloadingAuger</key>
      <label>unloading auger</label>
      <health>45</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(-1, 0)</li>
          <li>(-1, 1)</li>
          <li>(-1, 2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Engine</key>
      <label>engine</label>
      <health>80</health>
      <depth>Internal</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <priorityStatEfficiency>true</priorityStatEfficiency>
      <hitbox>
        <cells>
          <li>(0, -2)</li>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>Transmission</key>
      <label>transmission</label>
      <health>50</health>
      <depth>Internal</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(0, -1)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>Thresher</key>
      <label>threshing drum and sieves</label>
      <health>90</health>
      <depth>Internal</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(1, -1)</li>
          <li>(0, 0)</li>
          <li>(1, 0)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>FuelTank</key>
      <label>fuel tank</label>
      <health>40</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <reactors>
        <li Class="Vehicles.Reactor_FuelLeak" />
      </reactors>
      <hitbox>
        <cells>
          <li>(2, -2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>RearWheels</key>
      <label>steering wheels</label>
      <health>60</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <tags>
        <li>Wheel</li>
      </tags>
      <hitbox>
        <cells>
          <li>(-1, -3)</li>
          <li>(2, -3)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
      </categories>
    </li>
    <li>
      <key>Wiring</key>
      <label>wiring</label>
      <health>30</health>
      <depth>Internal</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(1, -2)</li>
        </cells>
      </hitbox>
    </li>
    <li>
      <key>Lights</key>
      <label>lights</label>
      <health>10</health>
      <depth>External</depth>
      <armor>
        <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      </armor>
      <hitbox>
        <cells>
          <li>(0, -4)</li>
          <li>(1, -4)</li>
        </cells>
      </hitbox>
    </li>
    </components>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosArmourExtension">
        <hitWidthCells>4</hitWidthCells>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>16000</emptyKilograms>
        <ratedKilowatts>250</ratedKilowatts>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>40</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>200</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_Combine_UpgradeTree</def>
      </li>
      <!-- Drives a paddock row by row (D'thorga Framework's field run); the harvester below cuts what its strip covers. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosFieldRun" />
      <!-- The grain tank: one product at a time, as a real combine's; 9 tonnes, a third more with the tank extension. Its auger pours
           100 kg a second and reaches two cells beyond the body. Authored [A]. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosBulkHold">
        <capacityKg>9000</capacityKg>
        <mixesProducts>false</mixesProducts>
        <pourKgPerSecond>100</pourKgPerSecond>
        <reachCells>2</reachCells>
        <capacityUpgrades>
          <li>
            <node>PhobosCombineTankExtension</node>
            <factor>1.33</factor>
          </li>
        </capacityUpgrades>
      </li>
      <li Class="Phobos.Farming.CompProperties_PhobosHarvester">
        <strawChopperNode>PhobosCombineStrawChopper</strawChopperNode>
        <fronts>
          <li>
            <node>PhobosCombineFrontStandard</node>
            <label>standard grain front</label>
            <width>6</width>
            <takes>
              <li>PhobosCrop_Cereal</li>
              <li>PhobosCrop_Pulse</li>
              <li>PhobosCrop_Oilseed</li>
            </takes>
          </li>
          <li>
            <node>PhobosCombineFrontWide</node>
            <label>wide grain front</label>
            <width>8</width>
            <takes>
              <li>PhobosCrop_Cereal</li>
              <li>PhobosCrop_Pulse</li>
              <li>PhobosCrop_Oilseed</li>
            </takes>
          </li>
        </fronts>
      </li>
      <!-- The fitted front, drawn ahead of the body (D'thorga Framework's node looks): the owner's picks of 20 Nov 2026. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>front</key>
            <looks>
              <li>
                <node>PhobosCombineFrontStandard</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Farming/Combine/Combine_FrontStandard</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(8, 14)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <node>PhobosCombineFrontWide</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Farming/Combine/Combine_FrontWide</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(8, 14)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        </slots>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_Combine_Blueprint</defName>
    <label>Reaper combine harvester</label>
    <description>Reaper R1: a self-propelled combine that harvests a paddock row by row once a front is fitted.</description>
    <graphicData>
      <texPath>Phobos/Farming/Combine/Combine</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(8, 14)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>22000</WorkToBuild>
      <Flammability>0.7</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_MechanisedHarvesting</li>
    </researchPrerequisites>
    <size>(4, 9)</size>
    <!-- The shell only: its parts are in Bill_Combine.xml, filled at start-up (docs/development/parts-bills.md). Steel stays first. -->
    <costList>
      <Steel>420</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_Combine</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_Combine</defName>
    <label>combine harvester</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>Phobos_Combine</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
