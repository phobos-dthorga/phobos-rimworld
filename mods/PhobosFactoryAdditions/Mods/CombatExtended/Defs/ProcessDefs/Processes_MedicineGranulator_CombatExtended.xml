<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Combat Extended (CETeam.CombatExtended, Workshop 2890901044): Psycho, Defs/Drugs/Psychite_Psycho.xml,
    16 psychoid leaves and 600 work per unit at the lab, no research. Lab recipe x 4.
    Every figure is a port of the source recipe unless the comment or the README says
    it is authored. Loaded only while the source mod is active (LoadFolders.xml). Not yet tested in game.
  -->

  <PipeSystem.ProcessDef>
    <defName>PhobosFactory_SynthesizePsycho</defName>
    <label>Synthesize a batch of psycho</label>
    <labelOverride>Synthesize a batch of psycho</labelOverride>
    <description>Synthesize a batch of psycho (Combat Extended) from psychoid leaves.</description>
    <priorityInBillList>50</priorityInBillList>
    <spawnOnInteractionCell>true</spawnOnInteractionCell>
    <autoGrabFromHoppers>true</autoGrabFromHoppers>
    <autoInputSlots>
      <li>(-1,0,2)</li>
      <li>(0,0,2)</li>
      <li>(1,0,2)</li>
    </autoInputSlots>
    <ticks>9600</ticks>
    <ingredients>
      <li>
        <thing>PsychoidLeaves</thing>
        <countNeeded>64</countNeeded>
      </li>
    </ingredients>
    <results>
      <li>
        <thing>Psycho</thing>
        <count>4</count>
      </li>
    </results>
    <researchPrerequisites>
      <li>VFE_ComplexFactories</li>
    </researchPrerequisites>
    <isFactoryProcess>true</isFactoryProcess>
    <autoExtract>true</autoExtract>
    <onlyGrabAndOutputToFactoryHoppers>true</onlyGrabAndOutputToFactoryHoppers>
    <sustainerWhenWorking>true</sustainerWhenWorking>
    <sustainerDef>VFEFactory_AutomatedDrugsSustainer</sustainerDef>
    <effecterWhenWorking>true</effecterWhenWorking>
    <effecterDef>VFEFactory_Cook</effecterDef>
    <maxOutputCount>75</maxOutputCount>
  </PipeSystem.ProcessDef>

</Defs>
