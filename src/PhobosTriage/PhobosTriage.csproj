<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Triage's assembly, built for RimWorld 1.7 (net10.0) and 1.6 (net472); Directory.Build.targets turns the target
       into the game version, the output folder and the game reference. It references the game and D'thorga Framework
       (Private=false: the framework's DLL ships only in its own mod). No other mod's assembly and no Harmony: operations are
       found by the condition they remove, and the doctors' order of work is a prioritised copy of the game's own giver. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Phobos.Triage</RootNamespace>
    <AssemblyName>PhobosTriage</AssemblyName>
    <ModFolder>PhobosTriage</ModFolder>
    <Version>0.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
  </ItemGroup>
</Project>
