<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The Comms system (Radio 0.49.0, D'thorga Framework 0.356.0; docs/development/vehicle-standard.md, VS1; the owner's card of 27 Nov 2026:
       "Every powered vehicle"). It comes with the Electrical system (Patches/Comms.xml), so every vehicle with a battery shows it, whatever
       its loadout writes. Its two readings ask the radio, through D'thorga Framework's Input_Comms (Phobos.Radio.Vehicles.VehicleComms
       answers): whether a radio is fitted and working, and how its link home stands. It names no part roles, so a vehicle without radio
       bays (a steam locomotive) is not flagged for it; the radios' bays are on its Fittings and Health tabs. It ships with the radio, so a
       game without the radio has no Comms system. -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Comms</defName>
    <label>comms</label>
    <description>The vehicle's radios: whether one is fitted and working, and whether it is in touch with a radio station. Radios go in the radio bays on the Fittings tab; aircraft, military vehicles and boats leave the factory with one.</description>
    <quantities>
      <li>
        <name>commsRadio</name>
        <label>radio</label>
        <description>Whether the vehicle carries a radio that works: none fitted, fitted but dead (no power, or its bay shot away), or working.</description>
        <unit>Plain</unit>
        <min>0</min>
        <max>2</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Comms">
            <reading>Radio</reading>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.5</to>
            <label>none fitted</label>
          </li>
          <li>
            <from>0.5</from>
            <to>1.5</to>
            <label>fitted, not working</label>
            <notable>true</notable>
          </li>
          <li>
            <from>1.5</from>
            <label>working</label>
          </li>
        </stages>
      </li>
      <li>
        <name>commsLink</name>
        <label>link home</label>
        <description>How the radio's best link to a radio station on the same map stands: in touch, faint, out of touch, or jammed by radio noise. Away from home's map, its convoy's own radio button says how it reaches home.</description>
        <unit>Plain</unit>
        <min>0</min>
        <max>5</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Comms">
            <reading>Link</reading>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.5</to>
            <label>no radio</label>
          </li>
          <li>
            <from>0.5</from>
            <to>1.5</to>
            <label>jammed</label>
            <notable>true</notable>
          </li>
          <li>
            <from>1.5</from>
            <to>2.5</to>
            <label>out of touch</label>
          </li>
          <li>
            <from>2.5</from>
            <to>3.5</to>
            <label>faint</label>
          </li>
          <li>
            <from>3.5</from>
            <to>4.5</to>
            <label>in touch</label>
          </li>
          <li>
            <from>4.5</from>
            <label>away from home's map</label>
          </li>
        </stages>
      </li>
    </quantities>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
