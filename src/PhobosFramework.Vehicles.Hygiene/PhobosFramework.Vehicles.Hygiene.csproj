<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Framework's vehicle water from Dubs Bad Hygiene's plumbing (owner, 8 Nov 2026: Dubs plumbing when present, otherwise
       free). Its own assembly in Mods/VehiclesHygiene/1.7, which LoadFolders.xml loads only while both Vehicle Framework and Dubs Bad
       Hygiene are active (IfModActiveAll). RimWorld 1.7 only. Other mods' assemblies are referenced from the installed mods, never
       copied. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.VehicleSystems.Hygiene</RootNamespace>
    <AssemblyName>PhobosFramework.Vehicles.Hygiene</AssemblyName>
    <ModFolder>PhobosFramework</ModFolder>
    <TieInFolder>Mods/VehiclesHygiene/</TieInFolder>
    <Version>0.105.1</Version>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
    <ProjectReference Include="../PhobosFramework.Hygiene/PhobosFramework.Hygiene.csproj" Private="false" />
    <ProjectReference Include="../PhobosFramework.Vehicles/PhobosFramework.Vehicles.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Vehicles">
      <HintPath>$(VehicleFrameworkAssemblies)\Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BadHygiene">
      <HintPath>$(DbhAssemblies)\BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
