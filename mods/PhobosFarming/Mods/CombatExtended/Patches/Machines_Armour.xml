<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The combine's and chaser bin's armour with Combat Extended (D'thorga Farming 0.1.0; docs/development/vehicle-armour.md). Their Defs
       give every part the Skin class's Vehicle Framework rating; with Combat Extended the same class is 2 mm of steel and 4 MPa
       (Mods/CombatExtended loads only while Combat Extended is active). Every part is Skin: farm machines stop no bullet.
       scripts/check-vehicle-armour.py holds each part here to its class in the Def. Not yet tested in game. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_Combine"]/components/li/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>2</ArmorRating_Sharp>
        <ArmorRating_Blunt>4</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
</Patch>
