<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Knocked out, not destroyed (Framework 0.115.0; owner, 16 and 17 Nov 2026; docs/development/vehicle-knocked-out-systems.md): what a
    vehicle loses before it is a wreck. The first loaded instance wins; another mod may patch it in XML. Figures are authored unless a
    comment names the owner.
  -->
  <Phobos.VehicleSystems.PhobosKnockOutRulesDef>
    <defName>PhobosKnockOutRules</defName>

    <!-- Step 1 (T1, T9, T10): a weapon stops while its mount is at or under a tenth of its health (the owner's figure) and works again
         once repaired. Vehicle Framework's own part requirement, so it acts on every faction's vehicles; an author's own always stands. -->
    <weaponMounts>true</weaponMounts>
    <stopsAtOrBelow>0.1</stopsAtOrBelow>
    <!-- A vehicle's own parts to use as the mount, the first found wins: RimThunder's and others' turret part, and the pylons D'thorga
         Patches gives the Harrier. Matched by key, as a hint: nothing else marks a part as a weapon's mount. -->
    <authorMountKeys>
      <li>MainTurret</li>
      <li>PhobosPylons</li>
    </authorMountKeys>
    <!-- Authored: about the health of the vehicles' other working parts of that size (a gearbox 40 to 45, an engine 75). -->
    <turretRingHealth>60</turretRingHealth>
    <pylonHealth>40</pylonHealth>
    <turretRingLabel>turret ring</turretRingLabel>
    <pylonLabel>weapon pylons</pylonLabel>

    <!-- Step 2 (M1, M2): a destroyed track stops a tracked vehicle; Vehicle Framework averages the parts that feed speed, so a tank with one
         track gone drove on at about three quarters. Wheels stay averaged: a truck limps on three. A track is a part feeding speed whose key
         ends as below, the hint the tracked loadout already uses. -->
    <thrownTracks>true</thrownTracks>
    <trackKeySuffixes>
      <li>Track</li>
    </trackKeySuffixes>
    <trackThrownAtOrBelow>0</trackThrownAtOrBelow>

    <!-- Step 4 (T2, C4): damage and a hurt gunner slow a weapon before it stops. A mount at the stop line gives 0.55 of the weapon's own
         pace (authored), rising in a straight line to full at full health. The gunner's sight paces the aim and their manipulation the
         traverse and reload, never below half (authored), never faster than a healthy gunner, as the driver system (G1) does for driving. -->
    <damageSlowsWeapons>true</damageSlowsWeapons>
    <damagedMountPace>0.55</damagedMountPace>
    <gunnerConditionSlowsWeapons>true</gunnerConditionSlowsWeapons>
    <hurtGunnerPaceFloor>0.5</hurtGunnerPaceFloor>

    <!-- Step 5 (T3, T4): a powered turret is an electrical load, "turret drive", drawing while someone mans a powered weapon (the loadouts'
         loads). With the load shed or the battery flat, the turret is cranked by hand (the owner's choice: never dead): turning at a fifth of
         its speed and laying its gun twice as slowly (both authored). The US Army's Bradley course OD1609 says each of its turret drives can
         be worked by handwheels; that hand cranking is the rule for every powered turret here is our assumption. The player's vehicles only:
         other factions' batteries do not evolve (the owner's choice). Pintle and ring-mounted machine guns are swung by hand anyway and lose
         nothing; they are found by these parts of their keys (authored, from the weapons in the owner's game). -->
    <turretPower>true</turretPower>
    <turretDriveLoad>turretDrive</turretDriveLoad>
    <batteryFlatBelow>0.05</batteryFlatBelow>
    <handCrankTraversePace>0.2</handCrankTraversePace>
    <handCrankAimPace>0.5</handCrankAimPace>
    <handSwungTurretKeys>
      <li>M2HB</li>
      <li>M240</li>
      <li>topMG</li>
      <li>supportMG</li>
      <li>MountedTurret</li>
      <li>pintle</li>
    </handSwungTurretKeys>

    <!-- 0.116.0 (M3; owner, 17 Nov 2026: back to a quarter): a mechanic re-fits a destroyed track or wheel in the field with the field-patch
         supplies, through the Field repairs button. It stays waiting for a proper replacement, so free repair cannot heal it further. Twice
         a patch's work (authored). -->
    <fieldRefitHealth>0.25</fieldRefitHealth>
    <fieldRefitWorkFactor>2</fieldRefitWorkFactor>

    <!-- 0.116.0 (T8; owner, 17 Nov 2026: "yes, with cook-off"): Vehicle Framework's own turret-blown-off reaction on a tank's ammunition
         rack, aimed at its main weapon. It follows the ammunition cook-off setting (off wherever that is off). A hit on the rack at or under
         a quarter of its health sets it off one time in four, and a cook-off blast in the vehicle three times in ten (all authored). It
         kills the crew more often than not. Only tanks with a rack part, by key: RimThunder's. -->
    <turretPopping>true</turretPopping>
    <ammoRackKeys>
      <li>AmmoRack</li>
    </ammoRackKeys>
    <popChanceOnHit>0.25</popChanceOnHit>
    <popAtOrBelowRackHealth>0.25</popAtOrBelowRackHealth>
    <popChanceOnCookOff>0.3</popChanceOnCookOff>
    <popRadius>2</popRadius>

    <!-- Step 3 (C2): a crew in a burning vehicle, or one that can neither move nor fire, gets out. The owner's choice: other factions' crews
         leave by themselves; the player's are never ordered out, and the player gets an alert. -->
    <crewsBailOut>true</crewsBailOut>
  </Phobos.VehicleSystems.PhobosKnockOutRulesDef>
</Defs>
