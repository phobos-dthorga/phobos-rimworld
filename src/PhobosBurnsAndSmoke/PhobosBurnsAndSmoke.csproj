<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Burns and Smoke's assembly, built for RimWorld 1.7 (net10.0) and 1.6 (net472); Directory.Build.targets turns
       the target into the game version, the output folder and the game reference. It references the game and D'thorga
       Framework (Private=false: the framework's DLL ships only in its own mod); More Injuries and Combat Extended are
       reached by name through the framework. Harmony (compile-only, from the Harmony mod at run time) for the one postfix
       that adds the heat around fires in the open to the game's cell temperature. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Phobos.BurnsAndSmoke</RootNamespace>
    <AssemblyName>PhobosBurnsAndSmoke</AssemblyName>
    <ModFolder>PhobosBurnsAndSmoke</ModFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
  </ItemGroup>
</Project>
