<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fittings, tunes and enemy sets (docs/development/vehicle-tuning-and-upgrades.md). Every figure here is authored, a gameplay choice to be
    tuned in play. Costs raised about 2.5 times and times about tenfold in Framework 0.91.0 (owner, 11 Nov 2026: "I want these upgrades and
    tunes to feel earned"): a big job is a day's work or more for a builder of normal speed (2,500 work is an hour). These are the figures for a
    5-tonne vehicle at the Standard presets; the settings and the vehicle's weight move them (PhobosVehicleRulesDef). Materials are built into
    the vehicle: a fitting is not an item. A parameter factor names a system's parameter; a role is a
    loadout's role. Another mod adds its own with the same Def types.
  -->

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_UpratedRadiator</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/UpratedRadiator</iconPath>
    <label>uprated radiator</label>
    <description>A larger core with more fins. The engine sheds heat faster, so it is slower to boil on a long pull.</description>
    <roles><li>Radiator</li></roles>
    <materials><Steel>75</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>12500</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <parameterFactors><li><parameter>radiatorRate</parameter><factor>1.3</factor><label>radiator cooling</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_OilCooler</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/OilCooler</iconPath>
    <label>oil cooler</label>
    <description>A small radiator for the engine oil. Cooler oil burns away more slowly, so the engine goes further between services.</description>
    <roles><li>Engine</li><li>Engine1</li><li>Engine2</li><li>Engine3</li><li>Engine4</li><li>Engine5</li><li>Engine6</li><li>Engine7</li><li>Engine8</li></roles>
    <materials><Steel>50</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>10000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <parameterFactors><li><parameter>oilBurnPerHour</parameter><factor>0.6</factor><label>oil burned</label></li></parameterFactors>
    <piston>Yes</piston>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_Turbocharger</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/Turbocharger</iconPath>
    <label>turbocharger</label>
    <description>Exhaust gas spins a compressor that forces more air into the engine. More power, more heat and a thirstier engine.</description>
    <roles><li>Engine</li><li>Engine1</li><li>Engine2</li><li>Engine3</li><li>Engine4</li><li>Engine5</li><li>Engine6</li><li>Engine7</li><li>Engine8</li></roles>
    <materials><Steel>100</Steel><ComponentIndustrial>10</ComponentIndustrial></materials>
    <work>30000</work>
    <minSkill>8</minSkill>
    <researchPrerequisite>PhobosResearch_Turbines</researchPrerequisite>
    <powerFactor>1.2</powerFactor>
    <fuelFactor>1.1</fuelFactor>
    <parameterFactors><li><system>PhobosVehicleSystem_Cooling</system><parameter>heatAtFullLoad</parameter><factor>1.25</factor><label>engine heat at full load</label></li></parameterFactors>
    <piston>Yes</piston>
    <powerCounts>Yes</powerCounts>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_HeavyAlternator</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/HeavyAlternator</iconPath>
    <label>heavy-duty alternator</label>
    <description>Wound for a higher output. The battery charges faster and heavy electrical loads are easier to carry.</description>
    <roles><li>Alternator</li></roles>
    <materials><Steel>50</Steel><ComponentIndustrial>7</ComponentIndustrial></materials>
    <work>10000</work>
    <minSkill>5</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <parameterFactors><li><parameter>alternatorAmps</parameter><factor>1.5</factor><label>charging current</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_DeepCycleBattery</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/DeepCycleBattery</iconPath>
    <label>deep-cycle battery</label>
    <description>Thicker plates and more of them. It holds more charge, so the vehicle runs its loads longer with the engine off.</description>
    <roles><li>Battery</li></roles>
    <materials><Steel>60</Steel><ComponentIndustrial>7</ComponentIndustrial></materials>
    <work>5000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <parameterFactors><li><parameter>batteryAmpHours</parameter><factor>1.5</factor><label>battery capacity</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.70.0 (the owner's idea and agreed defaults, 10 Nov 2026): materials, skill and research authored. Systems_Cooling.xml
         holds the heating. Only engines with liquid cooling have the figure it moves, so it is offered to no other. -->
    <defName>PhobosFitting_BlockHeater</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/BlockHeater</iconPath>
    <label>block heater</label>
    <description>An electric heater in the engine block. Parked beside a powered building with the engine off, the engine stays warm, so it starts easily on a cold morning, wears less, and the cab heater works at once.</description>
    <roles><li>Engine</li><li>Engine1</li><li>Engine2</li><li>Engine3</li><li>Engine4</li><li>Engine5</li><li>Engine6</li><li>Engine7</li><li>Engine8</li></roles>
    <materials><Steel>40</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>7500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <parameterFactors><li><system>PhobosVehicleSystem_Cooling</system><parameter>blockHeaterAbsent</parameter><factor>0</factor></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_HeavySprings</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/HeavySprings</iconPath>
    <label>heavy-duty springs</label>
    <description>Stiffer springs carry a bigger load, at the cost of a harder, slightly slower ride. Fit every axle for the full effect.</description>
    <roles><li>Wheels</li></roles>
    <materials><Steel>60</Steel></materials>
    <work>7500</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <statFactors>
      <li><stat>CargoCapacity</stat><factor>1.15</factor></li>
      <li><stat>MoveSpeed</stat><factor>0.96</factor></li>
    </statFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <defName>PhobosFitting_RoadTyres</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/RoadTyres</iconPath>
    <label>road tyres</label>
    <description>A softer, faster compound. Quicker on the move, and it wears out sooner. Fit every axle for the full effect.</description>
    <roles><li>Wheels</li></roles>
    <materials><Steel>25</Steel><Chemfuel>30</Chemfuel></materials>
    <work>5000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <statFactors><li><stat>MoveSpeed</stat><factor>1.05</factor></li></statFactors>
    <parameterFactors><li><parameter>wearPerHour</parameter><factor>1.4</factor><label>tyre wear</label></li></parameterFactors>
    <tracked>No</tracked>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.92.0, sling loads (owner, 11 Nov 2026: any helicopter, by fitting; docs/development/vehicle-sling-design.md). It goes on the
         hook mount a helicopter's loadout appends, and lets it lift a vehicle on a sling; what it lifts is the loadout's rated load. Materials,
         work and skill authored, earned like the turbocharger. -->
    <defName>PhobosFitting_CargoHook</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/CargoHook</iconPath>
    <label>cargo hook</label>
    <description>A load-rated hook under the belly, with an electric release worked from the cockpit and a manual one beside it. With a sling set aboard, the helicopter can lift a vehicle and carry it hanging below.</description>
    <roles><li>HookMount</li></roles>
    <materials><Steel>120</Steel><ComponentIndustrial>8</ComponentIndustrial></materials>
    <work>20000</work>
    <minSkill>7</minSkill>
    <researchPrerequisite>PhobosResearch_Turbines</researchPrerequisite>
    <grants><li>CargoHook</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.101.0, batch 3's signatures (docs/development/vehicle-upgrades-round-two.md): litters in the cabin, an air ambulance. It goes on
         the part a loadout names as its cabin (the Cherokee's upholstery); the litters it brings are the rules Def's litterSlots. Its frames
         take a fifth of the cargo space. Materials, work and skill authored. -->
    <defName>PhobosFitting_LitterKit</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/LitterKit</iconPath>
    <label>litter kit</label>
    <description>Stanchions and straps for stretchers along the cabin, with a first-aid locker. Downed people can be carried aboard and lie on the litters, and anyone in the crew who can doctor tends them while the vehicle stands. The frames take up cargo space.</description>
    <roles><li>Cabin</li></roles>
    <materials><Steel>60</Steel><Cloth>40</Cloth><ComponentIndustrial>2</ComponentIndustrial></materials>
    <work>8000</work>
    <minSkill>4</minSkill>
    <statFactors><li><stat>CargoCapacity</stat><factor>0.8</factor></li></statFactors>
    <grants><li>Litter</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the all-terrain tyres family (docs/development/vehicle-upgrade-families.md): the opposite of road tyres. Its soft-
         ground grip (TreadRules.SoftGroundFactor) is full on the softest going and nothing on a firm road; the speed and wear costs apply
         everywhere, a simplification. Every figure authored. -->
    <defName>PhobosFitting_AllTerrainTyres</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/AllTerrainTyres</iconPath>
    <label>all-terrain tyres</label>
    <description>A deep, open tread that bites into mud, sand and snow. It holds far better on soft ground, is a little slower everywhere, and wears faster on hard going. Fit every axle for the full effect.</description>
    <roles><li>Wheels</li></roles>
    <materials><Steel>30</Steel><Chemfuel>40</Chemfuel></materials>
    <work>5000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <statFactors><li><stat>MoveSpeed</stat><factor>0.95</factor></li></statFactors>
    <parameterFactors>
      <li><system>PhobosVehicleSystem_RunningGear</system><parameter>softGroundGrip</parameter><factor>1.35</factor><label>grip on soft ground</label></li>
      <li><parameter>wearPerHour</parameter><factor>1.15</factor><label>tyre wear</label></li>
    </parameterFactors>
    <tracked>No</tracked>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the work lights family: on the lamp bracket every land vehicle has (Loadouts_Default.xml). It grants WorkLights,
         which shows the lamps' switch and counts as work lights for a drill rig; the light itself is the game's own (WorkLamps). Materials,
         work and skill authored. -->
    <defName>PhobosFitting_WorkLamps</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/WorkLamps</iconPath>
    <label>work lamps</label>
    <description>A pair of floodlights on a bracket, with their own switch. While the vehicle stands still at night they light the ground round it, so work there goes on at the pace of daylight. They draw on the battery.</description>
    <roles><li>LampMount</li></roles>
    <materials><Steel>30</Steel><ComponentIndustrial>4</ComponentIndustrial></materials>
    <work>4000</work>
    <minSkill>3</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleElectrics</researchPrerequisite>
    <grants><li>WorkLights</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the recovery family (owner, 12 Nov 2026: built as one piece with the hitch's recovery tow). On the winch mount every
         land vehicle has (Loadouts_Default.xml). It grants RecoveryWinch, which offers the winch order and lets the hitch take an ordinary
         vehicle as a recovery tow. Its pull is the rules Def's (RecoveryRule). Materials, work and skill authored. -->
    <defName>PhobosFitting_RecoveryWinch</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/RecoveryWinch</iconPath>
    <label>recovery winch</label>
    <description>A winch in the front bumper with a steel rope, recovery straps and a rigid tow bar. With someone aboard to work it, it drags a stuck, broken or empty vehicle towards this one, as far as this vehicle can hold it on its brakes; the tow bar then lets this vehicle tow an ordinary vehicle home, not only a trailer.</description>
    <roles><li>RecoveryMount</li></roles>
    <materials><Steel>90</Steel><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>7000</work>
    <minSkill>5</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <grants><li>RecoveryWinch</li></grants>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the long range family (owner, 12 Nov 2026). Half as much fuel again, paid for in cargo space; the tank's own weight
         and the fuel's are left to that cargo cost (a simplification). Factors, materials, work and skill authored. -->
    <defName>PhobosFitting_AuxFuelTank</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/AuxFuelTank</iconPath>
    <label>auxiliary fuel tank</label>
    <description>A second tank in a cradle, plumbed to the first. It holds half as much fuel again, so the vehicle goes further between refuels, but it takes up cargo space. Taken off, any fuel it held above what the main tank takes is drained into containers beside the vehicle.</description>
    <roles><li>AuxTankMount</li></roles>
    <materials><Steel>70</Steel><ComponentIndustrial>3</ComponentIndustrial></materials>
    <work>6000</work>
    <minSkill>4</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <fuelCapacityFactor>1.5</fuelCapacityFactor>
    <statFactors><li><stat>CargoCapacity</stat><factor>0.85</factor></li></statFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <Phobos.VehicleSystems.PhobosVehicleFittingDef>
    <!-- Framework 0.103.0, the long range family on aircraft (owner, 12 Nov 2026: ferry tanks). Real ferry tanks can more than double an
         aircraft's fuel; three quarters as much again here, paid for in a large share of the cabin. Figures authored. -->
    <defName>PhobosFitting_FerryTank</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/FerryTank</iconPath>
    <label>ferry tank</label>
    <description>A large tank strapped into the cabin and plumbed to the aircraft's own. It holds three quarters as much fuel again, for a long ferry flight, but takes much of the room for cargo. Taken off, any fuel it held above what the aircraft's own tanks take is drained into containers beside it.</description>
    <roles><li>FerryTankMount</li></roles>
    <materials><Steel>90</Steel><ComponentIndustrial>4</ComponentIndustrial></materials>
    <work>8000</work>
    <minSkill>6</minSkill>
    <researchPrerequisite>PhobosResearch_VehicleTuning</researchPrerequisite>
    <fuelCapacityFactor>1.75</fuelCapacityFactor>
    <statFactors><li><stat>CargoCapacity</stat><factor>0.7</factor></li></statFactors>
  </Phobos.VehicleSystems.PhobosVehicleFittingDef>

  <!-- Tunes: three named settings to an axis (owner), the default being the engine as built. -->

  <Phobos.VehicleSystems.PhobosVehicleTuneDef>
    <defName>PhobosTune_EngineEconomy</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/TuneEngineEconomy</iconPath>
    <label>economy tune</label>
    <description>Leaner and gentler. A little less power, less heat and less fuel.</description>
    <axis>Engine</axis>
    <order>0</order>
    <materials><ComponentIndustrial>3</ComponentIndustrial></materials>
    <work>20000</work>
    <minSkill>5</minSkill>
    <powerFactor>0.9</powerFactor>
    <fuelFactor>0.92</fuelFactor>
    <parameterFactors><li><system>PhobosVehicleSystem_Cooling</system><parameter>heatAtFullLoad</parameter><factor>0.9</factor><label>engine heat at full load</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleTuneDef>

  <Phobos.VehicleSystems.PhobosVehicleTuneDef>
    <defName>PhobosTune_EngineBalanced</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/TuneEngineStock</iconPath>
    <label>stock tune</label>
    <description>The engine as it was built.</description>
    <axis>Engine</axis>
    <isDefault>true</isDefault>
    <order>1</order>
    <work>10000</work>
    <minSkill>3</minSkill>
  </Phobos.VehicleSystems.PhobosVehicleTuneDef>

  <Phobos.VehicleSystems.PhobosVehicleTuneDef>
    <defName>PhobosTune_EnginePower</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/TuneEnginePower</iconPath>
    <label>power tune</label>
    <description>Richer and harder. More power, paid for in heat and fuel.</description>
    <axis>Engine</axis>
    <order>2</order>
    <materials><ComponentIndustrial>5</ComponentIndustrial></materials>
    <work>25000</work>
    <minSkill>8</minSkill>
    <powerFactor>1.15</powerFactor>
    <fuelFactor>1.15</fuelFactor>
    <parameterFactors><li><system>PhobosVehicleSystem_Cooling</system><parameter>heatAtFullLoad</parameter><factor>1.2</factor><label>engine heat at full load</label></li></parameterFactors>
  </Phobos.VehicleSystems.PhobosVehicleTuneDef>

  <Phobos.VehicleSystems.PhobosVehicleTuneDef>
    <defName>PhobosTune_GearingLong</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/TuneGearingLong</iconPath>
    <label>tall final drive</label>
    <description>Taller ratios. Lower revs and less strain at a cruise, weaker on a heavy pull. It cannot make the vehicle faster than it was built to go.</description>
    <axis>Gearing</axis>
    <order>0</order>
    <materials><Steel>50</Steel><ComponentIndustrial>2</ComponentIndustrial></materials>
    <work>25000</work>
    <minSkill>5</minSkill>
    <finalDriveFactor>0.85</finalDriveFactor>
    <flatFuelFactor>0.95</flatFuelFactor>
  </Phobos.VehicleSystems.PhobosVehicleTuneDef>

  <Phobos.VehicleSystems.PhobosVehicleTuneDef>
    <defName>PhobosTune_GearingStandard</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/TuneGearingStock</iconPath>
    <label>stock final drive</label>
    <description>The gearing as it was built.</description>
    <axis>Gearing</axis>
    <isDefault>true</isDefault>
    <order>1</order>
    <work>15000</work>
    <minSkill>3</minSkill>
  </Phobos.VehicleSystems.PhobosVehicleTuneDef>

  <Phobos.VehicleSystems.PhobosVehicleTuneDef>
    <defName>PhobosTune_GearingShort</defName>
    <iconPath>Phobos/VehicleSystems/Fittings/TuneGearingShort</iconPath>
    <label>short final drive</label>
    <description>Lower ratios. It pulls harder with a heavy load and tops out sooner.</description>
    <axis>Gearing</axis>
    <order>2</order>
    <materials><Steel>50</Steel><ComponentIndustrial>2</ComponentIndustrial></materials>
    <work>25000</work>
    <minSkill>5</minSkill>
    <finalDriveFactor>1.2</finalDriveFactor>
    <flatFuelFactor>1.05</flatFuelFactor>
  </Phobos.VehicleSystems.PhobosVehicleTuneDef>

  <!-- Enemy sets, by faction tech level (owner, 9 Nov 2026). Stat fittings act at once; power and tunes matter once the vehicle is captured. -->

  <Phobos.VehicleSystems.PhobosVehicleFitSetDef>
    <defName>PhobosFitSet_IndustrialHauler</defName>
    <minTech>Medieval</minTech>
    <maxTech>Industrial</maxTech>
    <weight>2</weight>
    <fittings>
      <li>PhobosFitting_HeavySprings</li>
      <li>PhobosFitting_UpratedRadiator</li>
    </fittings>
  </Phobos.VehicleSystems.PhobosVehicleFitSetDef>

  <Phobos.VehicleSystems.PhobosVehicleFitSetDef>
    <defName>PhobosFitSet_IndustrialRunner</defName>
    <minTech>Medieval</minTech>
    <maxTech>Industrial</maxTech>
    <fittings>
      <li>PhobosFitting_RoadTyres</li>
    </fittings>
    <tunes>
      <li>PhobosTune_EnginePower</li>
    </tunes>
  </Phobos.VehicleSystems.PhobosVehicleFitSetDef>

  <Phobos.VehicleSystems.PhobosVehicleFitSetDef>
    <defName>PhobosFitSet_SpacerAssault</defName>
    <minTech>Spacer</minTech>
    <maxTech>Archotech</maxTech>
    <fittings>
      <li>PhobosFitting_Turbocharger</li>
      <li>PhobosFitting_RoadTyres</li>
      <li>PhobosFitting_HeavyAlternator</li>
    </fittings>
    <tunes>
      <li>PhobosTune_EnginePower</li>
      <li>PhobosTune_GearingShort</li>
    </tunes>
  </Phobos.VehicleSystems.PhobosVehicleFitSetDef>

  <Phobos.VehicleSystems.PhobosVehicleFitSetDef>
    <defName>PhobosFitSet_SpacerLogistics</defName>
    <minTech>Spacer</minTech>
    <maxTech>Archotech</maxTech>
    <weight>2</weight>
    <fittings>
      <li>PhobosFitting_HeavySprings</li>
      <li>PhobosFitting_OilCooler</li>
      <li>PhobosFitting_DeepCycleBattery</li>
    </fittings>
  </Phobos.VehicleSystems.PhobosVehicleFitSetDef>
</Defs>
