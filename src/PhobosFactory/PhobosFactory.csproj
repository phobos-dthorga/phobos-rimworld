<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Factory Additions' assembly, built for RimWorld 1.7 only (net10.0, Harmony 3);
       Directory.Build.targets turns the target into the game version, the output folder, the references and the Workshop
       folders below. Shared options (C# version, nullable, PolySharp, no deps.json) come from Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.Factory</RootNamespace>
    <AssemblyName>PhobosFactory</AssemblyName>
    <ModFolder>PhobosFactoryAdditions</ModFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.13.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Vanilla Expanded Framework's PipeSystem.dll (one folder per game version), referenced from the installed mod and
         never copied: its licence (CC BY-NC-ND 4.0) permits depending on it, not redistributing it. -->
    <Reference Include="PipeSystem">
      <HintPath>$(VefAssemblies)\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VFE Factory's own assembly (for its conveyor belt), likewise referenced and never copied: the mod publishes no
         licence, so nothing of it may be redistributed. Its 1.6 folder is the only one; the game loads it on 1.7 too. -->
    <Reference Include="VanillaFurnitureExpandedFactory">
      <HintPath>$(VfeFactoryAssemblies)\VanillaFurnitureExpandedFactory.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
