<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vanilla Vehicles Expanded - Tier 3's Big Rig is a semi-trailer truck; real ones brake with air, held on by springs until the
    compressor's pressure releases them (general principle: e.g. US patent 8,249,789, "Spring brake valve"; not checked against a
    particular truck). It keeps everything a heavy land vehicle gets and adds the air brakes and an air compressor beside the
    engine. massMin is reset so the named truck gets the loadout whatever its mass. Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_VVE_BigRig</defName>
    <label>semi-trailer truck with air brakes</label>
    <priority>Vehicle</priority>
    <selector>
      <vehicleDefs>
        <li>VVE_BigRig</li>
      </vehicleDefs>
      <massMin>-1</massMin>
    </selector>
    <systems>
      <li><def>PhobosVehicleSystem_AirBrakes</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Compressor</role>
        <find>
          <li>
            <keyContains>compressor</keyContains>
          </li>
        </find>
        <add>
          <key>PhobosAirCompressor</key>
          <label>air compressor</label>
          <health>25</health>
          <cellsOf>Engine</cellsOf>
        </add>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
