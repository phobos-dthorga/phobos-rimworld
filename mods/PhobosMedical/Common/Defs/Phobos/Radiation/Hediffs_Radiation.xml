<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The radiation model (D'thorga Medical 0.21.0; docs/development/radiation-model.md; owner, 22 Nov 2026). Three conditions: the dose
    itself, the early sickness and the illness. Danger is told only through stages (lifeThreatening, and death at the illness's severity
    1), never a kill in code, so triage, Search and Rescue and doctors read it. Every capacity figure is authored, a gameplay
    simplification of the sources' clinical course. Not yet tested in game.
  -->
  <HediffDef>
    <defName>PhobosRadiation_Dose</defName>
    <label>radiation exposure</label>
    <description>Radiation this person has taken. The body repairs most of a dose over weeks, a tenth never. A large enough dose brings radiation sickness: first nausea and vomiting, then a deceptive spell of feeling well, then the illness itself, days or weeks later. How soon someone vomits tells a doctor roughly how much they took; a radiation counter tells it exactly.</description>
    <hediffClass>Phobos.Radiation.Hediff_PhobosRadiationDose</hediffClass>
    <defaultLabelColor>(0.75, 0.85, 0.35)</defaultLabelColor>
    <maxSeverity>1000</maxSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <!-- Hidden until the effective dose reaches the radiation rules Def's smallestShown (0.05 Gy): the condition's own code shows it
         from there (the owner's card of 28 Nov 2026; until then a second stage at 0.05 did it). -->
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>PhobosRadiation_EarlySickness</defName>
    <label>radiation sickness, early</label>
    <description>The first sign of a large radiation dose: nausea and vomiting, then tiredness and a poor appetite for a day or two. The sooner it began after the dose, the larger the dose. It passes, and the person may feel well for days or weeks before the illness itself.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.85, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <!-- Eased by anti-sickness tablets (Medical 0.24.0): the code sets severity 0.5 while they work, 1 otherwise. -->
      <li>
        <label>eased</label>
        <hungerRateFactor>0.9</hungerRateFactor>
        <restFallFactor>1.15</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <vomitMtbDays>0.15</vomitMtbDays>
        <hungerRateFactor>0.6</hungerRateFactor>
        <restFallFactor>1.3</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>PhobosRadiation_Illness</defName>
    <label>radiation sickness</label>
    <description>The illness after a large radiation dose. The bone marrow stops making blood cells, so infections take hold and the body bleeds and tires; after larger doses the gut fails too, with diarrhoea and loss of fluid; after the largest, the brain and circulation fail within days. Care changes who lives: a doctor's tending, bed rest in a clean room, fluids and medicine against infection all help.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.85, 0.35)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <lethalSeverity>1</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>0</severityPerDayTended>
      </li>
    </comps>
    <stages>
      <li>
        <label>mild</label>
        <restFallFactor>1.2</restFallFactor>
        <statOffsets>
          <ImmunityGainSpeed>-0.1</ImmunityGainSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>moderate</label>
        <restFallFactor>1.4</restFallFactor>
        <hungerRateFactor>0.7</hungerRateFactor>
        <statOffsets>
          <ImmunityGainSpeed>-0.3</ImmunityGainSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.55</minSeverity>
        <label>severe</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.15</painOffset>
        <restFallFactor>1.6</restFallFactor>
        <hungerRateFactor>0.5</hungerRateFactor>
        <statOffsets>
          <ImmunityGainSpeed>-0.5</ImmunityGainSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>critical</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.25</painOffset>
        <restFallFactor>2</restFallFactor>
        <hungerRateFactor>0.3</hungerRateFactor>
        <statOffsets>
          <ImmunityGainSpeed>-0.7</ImmunityGainSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
