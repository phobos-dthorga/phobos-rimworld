  <!-- Tracked vehicles of any mass: the heavy set with a tracked diesel. Rank 1 beats the light, medium and heavy loadouts. -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutLandHeavy">
    <defName>PhobosVehicleLoadout_LandTracked</defName>
    <label>tracked vehicle</label>
    <kind>CombustionTracked</kind>
    <rank>1</rank>
    <selector>
      <massMin>-1</massMin>
      <partKeySuffixes>
        <li>Track</li>
      </partKeySuffixes>
    </selector>
    <drivetrain>
      <def>PhobosDrivetrain_TrackedDiesel</def>
    </drivetrain>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

  <!--
    Boats: raw-water cooling, so the cooling system runs without a radiator part (the role stays unbound and reads as sound) and
    with a stronger cooling rate (authored: the sea is a large, cold radiator). No tyres or brakes.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutCombustionBase">
    <defName>PhobosVehicleLoadout_Boat</defName>
    <label>boat</label>
    <kind>Boat</kind>
    <selector>
      <vehicleTypes>
        <li>Sea</li>
      </vehicleTypes>
    </selector>
    <drivetrain>
      <def>PhobosDrivetrain_Boat</def>
    </drivetrain>
    <systems>
      <li><def>PhobosVehicleSystem_Electrical</def></li>
      <li>
        <def>PhobosVehicleSystem_Cooling</def>
        <set>
          <radiatorRate>9</radiatorRate>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_Lubrication</def></li>
      <li><def>PhobosVehicleSystem_Fuel</def></li>
      <li><def>PhobosVehicleSystem_Service</def></li>
      <li><def>PhobosVehicleSystem_Transmission</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
    </systems>
    <loads>
      <li>
        <name>navigationLights</name>
        <label>navigation lights</label>
        <description>The navigation lights burn at night while the engine runs.</description>
        <amps>4</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Headlights</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Night" />
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
          </conditions>
        </when>
      </li>
      <li>
        <name>instruments</name>
        <label>ignition and instruments</label>
        <amps>3</amps>
