<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Water Tap's assembly, built for RimWorld 1.7 (net10.0) and 1.6 (net472); Directory.Build.targets turns the
       target into the game version, the output folder, the game reference and the Dubs Bad Hygiene folder (DbhAssemblies,
       one per game version). It has no Harmony patches: the tap and the bottle's water quality are ordinary comps. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Phobos.WaterTap</RootNamespace>
    <AssemblyName>PhobosWaterTap</AssemblyName>
    <ModFolder>PhobosWaterTap</ModFolder>
    <Version>0.2.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dubs Bad Hygiene's assembly, referenced from the installed mod and never copied. -->
    <!-- D'thorga Framework's Dubs Bad Hygiene tie-in, the one shared reader of its water (7 Nov 2026). Its DLL ships only in the
         framework's own Mods/DubsBadHygiene folder, which loads whenever Dubs Bad Hygiene does, as this mod requires. -->
    <ProjectReference Include="../PhobosFramework.Hygiene/PhobosFramework.Hygiene.csproj" />
    <Reference Include="BadHygiene">
      <HintPath>$(DbhAssemblies)\BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
