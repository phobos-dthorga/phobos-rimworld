<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Give VFE Factory's automated machining bay a Name, so this mod's automated fabrication bay can inherit it
    (ParentName) instead of copying its XML: the fabrication bay then keeps the machining bay's size, input and
    output cells, power, heat, overclocking, facilities, piped chemfuel and graphics, and follows VFE Factory's
    updates. The game resolves inheritance after every patch has run, so a Name added here is seen.
    PatchOperationAttributeAdd does nothing if the Def already has a Name; check-factory-patches.py reports
    that case, since the ParentName would then break.
  -->
  <Operation Class="PatchOperationAttributeAdd">
    <xpath>Defs/ThingDef[defName="VFEFactory_AutomatedMachiningBay"]</xpath>
    <attribute>Name</attribute>
    <value>PhobosFactory_AutomatedMachiningBayParent</value>
  </Operation>

</Patch>
