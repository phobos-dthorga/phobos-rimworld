<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the game-free vehicle systems rules straight from src/, so these tests need neither RimWorld nor Vehicle Framework
       and run on GitHub. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Phobos.Framework.Vehicles.Rules.Tests</RootNamespace>
    <OutputPath>bin/</OutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/PhobosFramework.Vehicles/Rules/*.cs" Link="Rules/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
