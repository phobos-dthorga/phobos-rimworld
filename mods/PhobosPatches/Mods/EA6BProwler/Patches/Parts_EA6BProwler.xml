<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    A fuller parts list for the EA-6B Prowler (owner, 22 Nov 2026: the A-10's treatment; docs/development/ea6b-prowler.md). The jet keeps
    its own six parts (airframe, cockpits, two engines, jammer pods, self-sealing tanks) with their keys, health and order: Vehicle Framework
    saves a vehicle's parts by position, so new ones are only ever appended, and D'thorga Framework gives a saved jet the new parts at full
    health when it loads.

    Five parts, as few as will do: the Prowler's own rule moves a share of hits onto a part other than the airframe, chosen evenly among every
    part with cells of its own (its HitSpread, read 22 Nov 2026, the Harrier's and the A-10's rule), so every part added takes hits away from
    the cockpits, engines and pods. What each does: avionics, hydraulics and wiring carry flight control, which D'thorga Framework's rule
    turns into slower flight and, below 35 %, a refused take-off; the landing gear carries move speed on the ground; the receivers in the
    fin-top pod are where the ICAP upgrades are fitted (D'thorga Vehicles' fittings) and take hits. The hydraulics part stands for all of the
    jet's hydraulic systems (a simplification). Health and armour are authored, scaled to the jet's own parts; its pods are not touched, so
    its jamming still follows them as its author made it. Cells are the jet's own, facing north: x across, z along, the nose at the top.
    Not yet tested in game.
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/Vehicles.VehicleDef[defName="Prowler_Jet"]/components</xpath>
    <value>
      <li>
        <key>PhobosAvionics</key>
        <label>avionics</label>
        <health>50</health>
        <depth>Internal</depth>
        <armor>
          <ArmorRating_Blunt>0.22</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.44</ArmorRating_Sharp>
        </armor>
        <hitbox>
          <cells>
            <li>(0, 5)</li>
          </cells>
        </hitbox>
        <categories>
          <li>FlightControl</li>
        </categories>
      </li>
      <li>
        <key>PhobosHydraulics</key>
        <label>hydraulics</label>
        <health>60</health>
        <depth>Internal</depth>
        <armor>
          <ArmorRating_Blunt>0.22</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.44</ArmorRating_Sharp>
        </armor>
        <hitbox>
          <cells>
            <li>(0, -2)</li>
          </cells>
        </hitbox>
        <categories>
          <li>FlightControl</li>
        </categories>
      </li>
      <li>
        <key>PhobosWiring</key>
        <label>wiring and electrics</label>
        <health>40</health>
        <depth>Internal</depth>
        <armor>
          <ArmorRating_Blunt>0.22</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.44</ArmorRating_Sharp>
        </armor>
        <hitbox>
          <cells>
            <li>(0, -3)</li>
          </cells>
        </hitbox>
        <categories>
          <li>FlightControl</li>
        </categories>
      </li>
      <li>
        <key>PhobosLandingGear</key>
        <label>landing gear</label>
        <health>80</health>
        <depth>External</depth>
        <armor>
          <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
        </armor>
        <hitbox>
          <cells>
            <li>(-1, -1)</li>
            <li>(1, -1)</li>
          </cells>
        </hitbox>
        <categories>
          <li>MoveSpeed</li>
        </categories>
      </li>
      <li>
        <key>PhobosEwReceivers</key>
        <label>fin-top receivers</label>
        <health>50</health>
        <depth>External</depth>
        <armor>
          <ArmorRating_Blunt>0.16</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.38</ArmorRating_Sharp>
        </armor>
        <hitbox>
          <cells>
            <li>(0, -4)</li>
            <li>(0, -5)</li>
          </cells>
        </hitbox>
      </li>
    </value>
  </Operation>
</Patch>
