      <label>engine</label>
      <health>100</health>
      <depth>Internal</depth>
      <priorityStatEfficiency>true</priorityStatEfficiency>
      <hitbox>
        <cells>
          <li>(0, 1)</li>
          <li>(1, 1)</li>
          <li>(0, 2)</li>
          <li>(1, 2)</li>
        </cells>
      </hitbox>
      <categories>
        <li>MoveSpeed</li>
