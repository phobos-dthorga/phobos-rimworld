<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fluid power (phase C of the design): air brakes for heavy trucks, and hydraulics for working vehicles. Design:
    docs/development/vehicle-systems-design.md. Not yet tested in game.

    Air brakes. Heavy trucks hold their brakes on with springs that only air pressure releases, so a truck parked long enough to
    lose its air cannot move until the engine's compressor builds pressure again (secondary: the general description of spring
    brakes in truck air-brake systems, e.g. Wikipedia, "Air brake (road vehicle)"; unverified against a maker's manual). The
    compressor's rate, the leak and the 55 % release threshold are authored. Used by named loadouts for real air-braked trucks
    (D'thorga Vehicles), never by default.

    Hydraulics. A pump driven by the engine, fluid that leaks when its lines are hit, and the pressure that results. Since Framework
    0.73.0 the drill rig, the survey truck and the tipper carry it (D'thorga Vehicles 0.33.0) and pace their work by its supply: a mast,
    a boom and a tipping body are hydraulic, pumped off the engine, and a cut line bleeds them (general; Wikipedia, "Hydraulic
    machinery", secondary). All figures authored.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_AirBrakes</defName>
    <label>air brakes</label>
    <description>Heavy trucks' brakes stay on until the engine's compressor builds enough air to release them. A truck that stood long enough to lose its air must idle a few minutes before it can drive.</description>
    <roles>
      <li>Compressor</li>
    </roles>
    <parameters>
      <compressorRate>12</compressorRate>
      <leakPerHour>0.05</leakPerHour>
    </parameters>
    <quantities>
      <li>
        <name>airPressure</name>
        <description>Air for the brakes, pumped by the compressor while the engine runs. Until it builds, the brakes stay on and the vehicle cannot move.</description>
        <label>air</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.55</to>
            <label>brakes held on</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseMove">
                <reason>PhobosVehicleSystems_RefuseAirBrakes</reason>
              </li>
            </effects>
          </li>
          <li>
            <!-- G18 (cross-links round three; Framework 0.106.0): a low-air warning before the spring brakes come on. Real air-braked
                 trucks must warn the driver before tank pressure falls below 60 psi, about half of a 120 psi system (the US commercial
                 driver's licence manuals, from 49 CFR 393.51; secondary, unverified against the regulation's text). Ours locks at 0.55,
                 so the warning band from 0.55 to 0.7 is authored to sit just above it. -->
            <from>0.55</from>
            <to>0.7</to>
            <label>low air</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgAirLow</message>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <name>compressor</name>
        <quantity>airPressure</quantity>
        <kind>Into</kind>
        <factorParameter>compressorRate</factorParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_EngineRunning" />
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Compressor</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>airPressure</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.95, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <name>leak</name>
        <quantity>airPressure</quantity>
        <kind>From</kind>
        <factorParameter>leakPerHour</factorParameter>
      </li>
    </flows>
    <onEvents>
      <li>
        <!-- Each stop spends air on the brakes, and the compressor charges it again. -->
        <eventDef>MoveStop</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_Sound">
            <sound>PhobosVehicleSystems_AirCompressor</sound>
          </li>
          <li Class="Phobos.VehicleSystems.Effect_AddQuantity">
            <quantity>airPressure</quantity>
            <amount>-0.03</amount>
          </li>
        </effects>
      </li>
    </onEvents>
    <onPartHit>
      <li>
        <role>Compressor</role>
        <quantity>airPressure</quantity>
        <perHealthLost>-0.02</perHealthLost>
      </li>
    </onPartHit>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_Hydraulics</defName>
    <label>hydraulics</label>
    <description>An engine-driven pump and the fluid it moves. Hit lines leak; low fluid or a damaged pump means low pressure for whatever the vehicle lifts or drives with it.</description>
    <roles>
      <li>HydraulicPump</li>
      <li>HydraulicLines</li>
    </roles>
    <quantities>
      <li>
        <name>hydraulicFluid</name>
        <description>Oil for the rams and motors. Low fluid weakens everything it drives.</description>
        <label>hydraulic fluid</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.5</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgHydraulicsLow</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>hydraulicPressure</name>
        <description>What the hydraulic pump is holding for the working gear.</description>
        <label>hydraulic pressure</label>
        <unit>Fraction</unit>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_EngineRunning" />
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>HydraulicPump</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>hydraulicFluid</quantity>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.4, 0.5)</li>
                <li>(0.7, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
      </li>
      <li>
        <!-- What the fluid can give the work (Framework 0.73.0, T1 of docs/development/vehicle-crosslinks.md): the same curve on the
             fluid alone. The drill rig, the survey truck and the tipper read it to pace their hydraulic work, and stop below a fifth (the rules
             Def). The pump's health is left out on purpose: a damaged pump already slows the work through the vehicle's own work stat, and
             counting it here as well would count it twice. -->
        <name>hydraulicSupply</name>
        <description>Whether the hydraulics can do their work now: fluid, pump and lines together.</description>
        <label>hydraulic supply</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>hydraulicFluid</quantity>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.4, 0.5)</li>
                <li>(0.7, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.2</to>
            <label>too low to work</label>
            <notable>true</notable>
          </li>
        </stages>
      </li>
    </quantities>
    <onPartHit>
      <li>
        <role>HydraulicLines</role>
        <quantity>hydraulicFluid</quantity>
        <perHealthLost>-0.02</perHealthLost>
      </li>
      <li>
        <role>HydraulicPump</role>
        <quantity>hydraulicFluid</quantity>
        <perHealthLost>-0.01</perHealthLost>
      </li>
    </onPartHit>
    <service>
      <label>a hydraulic top-up</label>
      <dueQuantity>hydraulicFluid</dueQuantity>
      <dueBelow>0.6</dueBelow>
      <restores>
        <li>
          <quantity>hydraulicFluid</quantity>
          <value>1</value>
        </li>
      </restores>
      <supplies>
        <Chemfuel>8</Chemfuel>
      </supplies>
      <work>600</work>
    </service>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    Power steering (cross-links round three G17, Framework 0.123.0; owner, 17 Nov 2026), on heavy vehicles. A pump driven by the engine and a
    small reservoir of its own, apart from any working hydraulics, as on real trucks. Without it a vehicle still steers, but with "much more effort,
    especially in sharp turns and at low speeds" (Nissan's and Mazda's owner's manuals, cited in docs/development/vehicle-crosslinks.md); on a
    heavy vehicle that is a crawl, x0.6 of speed (authored). The assist is the pump's health and the fluid, not the engine: a parked truck does
    not show heavy steering. A towed vehicle with its engine off is moved by the vehicle towing it, so its own steering is not read (a limit).
    Figures authored. Not yet tested in game.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef>
    <defName>PhobosVehicleSystem_PowerSteering</defName>
    <label>power steering</label>
    <description>An engine-driven pump that takes the weight off a heavy vehicle's steering. With its fluid low or the pump shot through, the steering is heavy and the driver crawls.</description>
    <roles>
      <li>SteeringPump</li>
    </roles>
    <quantities>
      <li>
        <name>steeringFluid</name>
        <description>The power steering's fluid. A hit on the pump spills it; low fluid weakens the assist.</description>
        <label>steering fluid</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.5</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgSteeringFluidLow</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <name>steeringAssist</name>
        <description>How much help the steering has: the pump and its fluid together.</description>
        <label>steering assist</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>SteeringPump</role>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>steeringFluid</quantity>
            <curve>
              <points>
                <li>(0, 0)</li>
                <li>(0.4, 0.5)</li>
                <li>(0.7, 1)</li>
                <li>(1, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.4</to>
            <label>steering heavy</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_StatFactor">
                <stat>MoveSpeed</stat>
                <factor>0.6</factor>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgSteeringHeavy</message>
                <type>CautionInput</type>
              </li>
            </effects>
          </li>
          <li>
            <from>0.4</from>
            <label>assisted</label>
          </li>
        </stages>
      </li>
    </quantities>
    <onPartHit>
      <li>
        <!-- A hit on the pump or its hoses spills the fluid (authored, the working hydraulics' figure). -->
        <role>SteeringPump</role>
        <quantity>steeringFluid</quantity>
        <perHealthLost>-0.03</perHealthLost>
      </li>
    </onPartHit>
    <service>
      <label>a power steering top-up</label>
      <dueQuantity>steeringFluid</dueQuantity>
      <dueBelow>0.6</dueBelow>
      <restores>
        <li>
          <quantity>steeringFluid</quantity>
          <value>1</value>
        </li>
      </restores>
      <!-- A litre or two of hydraulic oil, the chemfuel stand-in the working hydraulics use (authored). -->
      <supplies>
        <Chemfuel>2</Chemfuel>
      </supplies>
      <work>300</work>
    </service>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
