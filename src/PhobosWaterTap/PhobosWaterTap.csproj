<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Water Tap's assembly. Built for RimWorld 1.6 and loaded on 1.7 too (LoadFolders.xml). It has no Harmony
       patches: the tap and the bottle's water quality are ordinary comps. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Phobos.WaterTap</RootNamespace>
    <AssemblyName>PhobosWaterTap</AssemblyName>
    <OutputPath>../../mods/PhobosWaterTap/1.6/Assemblies/</OutputPath>
    <DebugType>none</DebugType>
    <Version>0.2.0</Version>
    <!-- Dubs Bad Hygiene's assembly, referenced from the installed mod and never copied. Override with
         -p:DbhAssemblies=... or the environment variable of that name. -->
    <DbhAssemblies Condition="'$(DbhAssemblies)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\836308268\1.6\Assemblies</DbhAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <Reference Include="BadHygiene">
      <HintPath>$(DbhAssemblies)\BadHygiene.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
