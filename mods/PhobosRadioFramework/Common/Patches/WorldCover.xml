<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The cover picture on the world map (Radio 0.42.0): its draw layer joins the planet surface's own, as other mods' layers do.
       It draws nothing, and is never rebuilt, while the picture is off. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/PlanetLayerDef[defName="Surface"]/worldDrawLayers</xpath>
    <value>
      <li>Phobos.Radio.UI.WorldDrawLayer_PhobosRadioCover</li>
    </value>
  </Operation>
</Patch>
