      <!-- Its two six-blade propellers, 4.115 m across [P6] (4.8 cells), seen edge-on from above as bars across the nacelles' noses (the owner's
           card of 26 Nov 2026: "Edge-on bar"), still while they stand and a see-through blur while they turn, after our flight's spin-up.
           Measured off the picked art at export (export_c27j.py, C27J.layout.json): each hub is the blade plane at its spinner's base,
           on the nacelle's centre line, 5.26 cells either side and 7.12 ahead of the picture's middle (measured 5.260 and 5.267: the
           average, so the two stay mirror images). The pictures are 5 x 2.5 cells centred on the hub: the 4.84-cell blades across, the
           black spinner forward of them. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosPropellers">
        <stillPath>Phobos/Vehicles/C27J/C27J_Propeller</stillPath>
        <spinPath>Phobos/Vehicles/C27J/C27J_PropellerSpin</spinPath>
        <drawSize>(5, 2.5)</drawSize>
        <hubs>
          <li>(-5.26, 7.12)</li>
          <li>(5.26, 7.12)</li>
        </hubs>
      </li>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <!-- In the Osprey's units, 4.3 L a unit [A]: 9,734 kg [P1] at 0.80 kg a litre [A] is 12,168 L, 2,830 units. It burns 153 a day, so a
             full tank lasts 18.5 days against the Osprey's 7.5: the real fuel lasts 2.5 times as long (9.4 hours at 0.6 of both engines'
             3,458 kW and the AE2100's 0.25 kg a kWh [S, Wikipedia], against the Osprey's 3.8) [I]. By Vehicle Framework's formula its range is
             3.1 times the Osprey's, as 9.4 hours at 602 km/h (5,650 km) is 3.2 times the 1,770 km the Osprey's figures give [I]. -->
        <fuelConsumptionRate>153</fuelConsumptionRate>
        <fuelCapacity>2830</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_VehicleLauncher">
        <!-- Vehicle Framework's launcher carries it between places. On a map our own flight takes off along a strip, flies off the edge and
             hands over, and arrives in flight, so Vehicle Framework's animation is skipped (D'thorga Framework's Patch_Launch_Flight); its
             default take-off, a straight climb away rather than the VTOL's lift, stands where it is still drawn. Curves authored, the Osprey's
             climb-away half: the picture rises up the screen as it climbs, and its shadow fades. No runway restriction of Vehicle Framework's:
             our flight checks the strip itself. -->
        <launchProtocol Class="Vehicles.DefaultTakeoff">
          <launchProperties>
            <maxTicks>240</maxTicks>
            <zPositionCurve>
              <points>
                <li>(0, 0)</li>
                <li>(0.4, 8)</li>
                <li>(1, 40)</li>
              </points>
            </zPositionCurve>
            <shadowAlphaCurve>
              <points>
                <li>(0, 0.9)</li>
                <li>(1, 0)</li>
              </points>
            </shadowAlphaCurve>
          </launchProperties>
          <landingProperties>
            <maxTicks>240</maxTicks>
            <zPositionCurve>
              <points>
                <li>(0, 40)</li>
                <li>(0.6, 8)</li>
                <li>(1, 0)</li>
              </points>
            </zPositionCurve>
            <shadowAlphaCurve>
              <points>
                <li>(0, 0)</li>
                <li>(1, 0.9)</li>
              </points>
            </shadowAlphaCurve>
          </landingProperties>
        </launchProtocol>
      </li>
      <!-- Its upgrades: UpgradeTree_C27J.xml. -->
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_C27J_UpgradeTree</def>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_C27J_Blueprint</defName>
    <label>C-27J Spartan</label>
    <description>Leonardo C-27J Spartan: a twin-turboprop transport aeroplane for two pilots, a loadmaster and 40 passengers, or one small vehicle in its hold. It needs a strip to take off and land.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/C27J/C27J</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(34, 27)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>650</MaxHitPoints>
      <!-- 55,000 [A]: a little below the Osprey's 60,000, as a conventional aeroplane is simpler to build than a tiltrotor. -->
      <WorkToBuild>55000</WorkToBuild>
      <Flammability>0.8</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_C27J</li>
    </researchPrerequisites>
    <size>(5, 11)</size>
    <!-- The shell only [A]: steel stands for its aluminium airframe, a little plasteel for its composite parts. Its engines, gearboxes,
         propellers, flight computers, actuators, tanks, landing gear and electrics are in Bill_C27J.xml, filled at start-up
         (docs/development/parts-bills.md). -->
    <costList>
      <Steel>1300</Steel>
      <Plasteel>60</Plasteel>
      <ComponentIndustrial>24</ComponentIndustrial>
    </costList>
    <designationCategory>PhobosVehicles_MotorPool</designationCategory>
    <thingToSpawn>Phobos_C27J</thingToSpawn>
  </Vehicles.VehicleBuildDef>

  <!-- Two Rolls-Royce AE2100-D2A turboprops, 3,458 kW each, take-off and maximum continuous alike [P6]: one rating. Our engine model has no
       turboprop kind, so they are turboshafts driving propellers through the rotor drive [I], as the design record says. Turbine temperature
       limit, rated speed and idle share authored, the turboshaft class's figures (no AE2100 limit was looked up). ratedKilowatts is the whole
       aircraft's; the count of working engines is read from its Engine1 and Engine2 parts. Full fuel 9,734 kg [P1]. -->
  <Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>
    <defName>PhobosDrivetrain_AE2100</defName>
    <label>twin AE2100 turboprops</label>
    <engine>
      <kind>Turboshaft</kind>
      <ratedRpm>15000</ratedRpm>
      <ratedKilowatts>6916</ratedKilowatts>
      <idleFuelShare>0.2</idleFuelShare>
      <turbine>
        <idleSpeedPercent>60</idleSpeedPercent>
        <ratings>
          <li><name>maxContinuous</name><label>maximum continuous</label><share>1</share><speedPercent>100</speedPercent><temperatureLimit>800</temperatureLimit></li>
        </ratings>
      </turbine>
    </engine>
    <transmission>
      <kind>None</kind>
    </transmission>
    <mass>
      <emptyKilograms>17000</emptyKilograms>
      <fuelKilogramsFull>9734</fuelKilogramsFull>
    </mass>
  </Phobos.VehicleSystems.PhobosVehicleDrivetrainDef>

  <!-- An aeroplane on our own flight: no phase is a hover (so nothing judges it for one: it never hovers), and every demand is authored as a
       share of maximum continuous. The reader's hover phase is what our flight calls its climbs and descents onto a spot. -->
  <Phobos.VehicleSystems.PhobosVehicleFlightProfileDef>
    <defName>PhobosFlightProfile_C27J</defName>
    <label>turboprop transport</label>
    <cabinBleed>0.005</cabinBleed>
    <reader Class="Phobos.VehicleSystems.PhaseReader_OwnFlight" />
    <phases>
      <li><phase>Idle</phase><label>engines turning</label><demand>0.15</demand><moving>false</moving></li>
      <li><phase>Hover</phase><label>climbing or coming down</label><demand>0.8</demand></li>
      <li><phase>Forward</phase><label>flying over the map</label><demand>0.6</demand></li>
      <li><phase>WorldFlight</phase><label>cruising</label><demand>0.6</demand></li>
      <!-- A take-off roll runs the engines flat out; a rolling landing asks less as it slows (both authored, as the Osprey's). -->
      <li><phase>TakeoffRoll</phase><label>rolling to take off</label><demand>1.0</demand></li>
      <li><phase>RunwayLanding</phase><label>landing on a strip</label><demand>0.4</demand></li>
    </phases>
    <mapFuelPhase>Forward</mapFuelPhase>
  </Phobos.VehicleSystems.PhobosVehicleFlightProfileDef>

  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef ParentName="PhobosVehicleLoadoutAircraft">
    <defName>PhobosVehicleLoadout_C27J</defName>
    <label>turboprop transport</label>
    <priority>Vehicle</priority>
    <!-- Grit in the intakes on rough ground: 0.4 (authored: built for gravel strips, its intakes under high-mounted engines, but its propellers
         throw grit as they bite). A tank in each wing feeds its own engine, with a cross-feed (authored layout). -->
    <intakeDebris>0.4</intakeDebris>
    <sideTanks>true</sideTanks>
    <!-- Lopsided thrust with one engine out: 0.2 (authored), as the C-17's: its propellers sit 4.5 m out on the wing [I], further from the
         centre line than the jets' 0.15. -->
    <engineOutYaw>0.2</engineOutYaw>
    <selector>
      <vehicleDefs>
        <li>Phobos_C27J</li>
      </vehicleDefs>
    </selector>
    <systems>
      <!-- The rotor drive stands in for the propeller gearboxes [I]: our engine model has no turboprop kind. -->
      <li><def>PhobosVehicleSystem_RotorDrive</def></li>
      <li><def>PhobosVehicleSystem_Hydraulics</def></li>
      <li><def>PhobosVehicleSystem_FlightHydraulics</def></li>
    </systems>
    <drivetrain>
      <def>PhobosDrivetrain_AE2100</def>
    </drivetrain>
    <flightProfile>PhobosFlightProfile_C27J</flightProfile>
    <!-- Its 9,144 m ceiling [P1]; a design cruise height of 6,100 m (20,000 ft, authored); a pressurised cabin [I]; lift as a propeller
         aircraft between places. -->
    <cruise>
      <designMetres>6100</designMetres>
      <ceilingMetres>9144</ceilingMetres>
      <lift>Propeller</lift>
      <pressurised>true</pressurised>
    </cruise>
    <!-- Its fit (the record's "Our systems"): full instruments and navigation, an autopilot, weather radar, and the missile warning receiver
         that cues its defensive aids, built in as on the Osprey [I]. The defensive aids themselves are its upgrade (UpgradeTree_C27J.xml): its
         chaff and flare dispensers come only with that node (countermeasuresByUpgrade, Framework 0.316.0; the owner's card of 26 Nov 2026), a
         magazine of 60 cartridges (authored, two of the framework's default 30).
         Crew oxygen for a loss of pressure. Air track on Dead Man's Switch's scales (authored): its 325-knot cruise a little faster than the
         A-10's 12, its 28.7 m span between the A-10's and the C-17's. -->
    <avionics>
      <navigation>Full</navigation>
      <autopilot>true</autopilot>
      <radar>true</radar>
      <warning>true</warning>
      <countermeasures>true</countermeasures>
      <countermeasuresByUpgrade>true</countermeasuresByUpgrade>
      <countermeasureCartridges>60</countermeasureCartridges>
      <oxygen>true</oxygen>
      <cruisesHigh>true</cruisesHigh>
      <airTrack>
        <speed>12.5</speed>
        <cruiseMetres>6100</cruiseMetres>
        <lowCruiseMetres>3050</lowCruiseMetres>
        <size>2.4</size>
      </airTrack>
    </avionics>
    <!-- The defensive aids' draw (UpgradeTree_C27J.xml), only while that node is fitted and the engines run: 40 A authored, the Osprey's
         infrared jammer's. -->
    <loads>
      <li>
        <name>infraredJammer</name>
        <label>defensive aids</label>
        <description>The turrets that blind heat-seeking missiles, ready to act on the missile warning receiver's cue.</description>
        <amps>40</amps>
        <available Class="Phobos.VehicleSystems.When_StatAbove">
          <stat>Phobos_InfraredJammer</stat>
          <value>0</value>
        </available>
        <when Class="Phobos.VehicleSystems.When_EngineRunning" />
      </li>
    </loads>
    <!-- The aircraft loadout puts its generator, battery, starter, avionics bay, ferry tank tie-downs and cabin oxygen panel on the engine's
         cells, which here is the left nacelle out on the wing. They go in the forward hold's cells instead [A], as on the Osprey (fault-read
         A2): the batteries, avionics and cabin fittings are in the real fuselage [I], and one place keeps both nacelles alike. -->
    <cellsOfRemap>
      <li>
        <from>Engine</from>
        <to>Cabin</to>
      </li>
    </cellsOfRemap>
    <partRoles>
      <li>
        <role>Engine1</role>
        <find>
          <li><key>LeftEngine</key></li>
        </find>
      </li>
      <li>
        <role>Engine2</role>
        <find>
          <li><key>RightEngine</key></li>
        </find>
      </li>
      <li>
        <role>RotorDrive</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>PropellerGearbox</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>FlightControl</role>
        <all>true</all>
        <find>
          <li>
            <keyContainsAny>
              <li>FlightControl</li>
            </keyContainsAny>
          </li>
        </find>
      </li>
      <li>
        <role>HydraulicPump</role>
        <find>
          <li><key>Hydraulics</key></li>
        </find>
      </li>
      <li>
        <role>HydraulicLines</role>
        <find>
          <li><key>Hydraulics</key></li>
        </find>
      </li>
      <li>
        <role>Cabin</role>
        <find>
          <li><key>ForwardHold</key></li>
        </find>
      </li>
    </partRoles>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
</Defs>
