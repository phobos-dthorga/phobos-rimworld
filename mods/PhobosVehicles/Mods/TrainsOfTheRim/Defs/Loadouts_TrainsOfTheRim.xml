<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Trains of the Rim's steam locomotives get a boiler (docs/development/vehicle-steam-design.md; figures from
    docs/development/steam-and-diesel-electric-research.md). The fire is lit while one is drafted with fuel aboard; the mod's own
    fuel (wood or chemfuel) and rates stand. Not yet tested in game.

    - The Frisco 4-8-4 is the St. Louis-San Francisco 4500 class (secondary: Wikipedia): an 18,000 US gallon tender (68,000 L).
      Nos. 4500 to 4502 were built to burn oil, the rest coal (secondary); the mod's chemfuel and wood versions both get the same
      boiler. A big engine: firing and steam use set so it takes about 3 1/3 hours from cold to move and 8 to full pressure (inside
      the 6 to 10 hours quoted for big engines, secondary and anecdotal; authored).
    - The Tommy 0-6-0T follows the LB&SCR E2, the class Thomas was drawn from (secondary: Wikipedia): 1,090 imperial gallons of
      water in its side tanks (4,955 L). About 1 1/3 hours from cold to move and 2 3/4 to full pressure (inside the Great Central
      Railway's 3 to 7 hours to be ready for service, primary; authored).
    - Feed water lasts about 3 hours of hard work in the Frisco's tender (at 100 to 200 US gallons a mile, secondary: Union Pacific
      844's figures) and about 1 2/3 hours in the tank engine's tanks (at about 30 imperial gallons a mile, secondary: the LMS
      Society's monograph), our inference turned into the feedShare figures.
    - Their brake pipes are their brakes.
    - Water stops draw a tenth of the real figures (6,800 and 496 L) unless the player turns on realistic feed water (owner, 8 Nov
      2026). The Frisco has no fusible plug, as US rules never required one (we found no record either way for the 4500 class;
      authored), so with the boiler explosions setting on, letting its crown sheet run dry explodes the boiler. The tank engine
      follows British practice and carries a plug.
  -->
  <Phobos.VehicleSystems.PhobosVehicleLoadoutDef>
    <defName>PhobosVehicleLoadout_TOTR_Steam</defName>
    <label>steam locomotive (4-8-4)</label>
    <kind>Steam</kind>
    <priority>Vehicle</priority>
    <!-- Nothing electronic keeps a steam engine running: an EMP never stalls it, though its electrics are still hit (Framework 0.109.0). -->
    <empHardening>Mechanical</empHardening>
    <selector>
      <vehicleDefs>
        <li>TOTR_Steam_Locomotive_Frisco_Chemfuel</li>
        <li>TOTR_Steam_Locomotive_Frisco_Wood</li>
      </vehicleDefs>
    </selector>
    <systems>
      <li>
        <def>PhobosVehicleSystem_Boiler</def>
        <set>
          <firingRate>0.17</firingRate>
          <steamUse>0.19</steamUse>
          <coolingRate>0.08</coolingRate>
          <feedShare>0.11</feedShare>
          <feedWaterLitres>68000</feedWaterLitres>
          <feedWaterLitresScaled>6800</feedWaterLitresScaled>
          <fusiblePlugFitted>0</fusiblePlugFitted>
        </set>
      </li>
      <li><def>PhobosVehicleSystem_FusiblePlug</def></li>
      <li><def>PhobosVehicleSystem_Brakes</def></li>
      <li><def>PhobosVehicleSystem_Cabin</def></li>
      <li><def>PhobosVehicleSystem_Driver</def></li>
      <!-- Vehicles 0.134.0 (the owner's answer of 28 Nov 2026, "A steam turbo-generator"): the lamps and cab loads, in steam only. -->
      <li><def>PhobosVehicleSystem_TurboGenerator</def></li>
    </systems>
    <partRoles>
      <li>
        <role>Boiler</role>
        <find>
          <li>
            <key>Boiler</key>
          </li>
        </find>
      </li>
      <li>
        <role>Brakes</role>
        <find>
          <li>
            <key>BrakePipe</key>
          </li>
        </find>
      </li>
      <li>
        <!-- Vehicles 0.133.0 (the owner's card of 28 Nov 2026, "Railway-sensible set"): a bay for the crew water tank, which needs no
             electrics. The lamps, cab light, fridge and outlet came with the turbo-generator in 0.134.0, below. Added last, so a saved
             locomotive keeps every existing part's wear. -->
        <role>WaterTankBay</role>
        <add>
          <key>PhobosWaterTankBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>water tank bay</label>
          <health>25</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Boiler</cellsOf>
          <last>true</last>
        </add>
      </li>
      <!-- Vehicles 0.134.0: the turbo-generator (the loadout's alternator role, which the turbo-generator system reads), and the bays its power
           serves: lamps, a cab light, a fridge and an outlet. After the water tank bay, so a saved locomotive keeps every part where it was.
           Health and hit weights the land base's; the generator's a land alternator's. -->
      <li>
        <role>Alternator</role>
        <add>
          <key>PhobosTurboGenerator</key>
          <label>turbo-generator</label>
          <health>25</health>
          <cellsOf>Boiler</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>LampMount</role>
        <add>
          <key>PhobosLampMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>lamp bracket</label>
          <health>15</health>
          <depth>External</depth>
          <hitWeight>0.15</hitWeight>
          <hitWeightCE>6</hitWeightCE>
          <cellsOf>Boiler</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>CabLightMount</role>
        <add>
          <key>PhobosCabLightMount</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>cab light mount</label>
          <health>10</health>
          <depth>Internal</depth>
          <hitWeight>0.05</hitWeight>
          <hitWeightCE>2</hitWeightCE>
          <cellsOf>Boiler</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>FridgeBay</role>
        <add>
          <key>PhobosFridgeBay</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>fridge bay</label>
          <health>20</health>
          <depth>Internal</depth>
          <hitWeight>0.1</hitWeight>
          <hitWeightCE>4</hitWeightCE>
          <cellsOf>Boiler</cellsOf>
          <last>true</last>
        </add>
      </li>
      <li>
        <role>OutletPanel</role>
        <add>
          <key>PhobosOutletPanel</key>
          <countsTowardDestruction>false</countsTowardDestruction>
          <label>outlet panel</label>
          <health>15</health>
          <depth>Internal</depth>
          <hitWeight>0.08</hitWeight>
          <hitWeightCE>3</hitWeightCE>
          <cellsOf>Boiler</cellsOf>
          <last>true</last>
        </add>
      </li>
    </partRoles>
    <loads>
      <li>
        <!-- Added in D'thorga Vehicles 0.9.1: the cab had no heater, so it only ever followed the weather. On a steam locomotive the
             firebox warms the footplate (general); it needs no current, so 0 amps. -->
        <name>cabHeater</name>
        <label>firebox warmth</label>
        <description>The firebox keeps the cab warm below 5 °C while the fire is lit and the locomotive is in steam.</description>
        <amps>0</amps>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/CabHeater</iconPath>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_AmbientBelow">
              <celsius>5</celsius>
            </li>
            <li Class="Phobos.VehicleSystems.When_EngineRunning" />
          </conditions>
        </when>
      </li>
      <li>
        <!-- Vehicles 0.134.0: the work lamps' draw on the turbo-generator, two 60 W floodlights on 32 V, about 4 A (authored). They light the
             ground round a standing locomotive at night while it is in steam: with no battery they are dark with the fire out. -->
        <name>workLamps</name>
        <label>work lamps</label>
        <description>Floodlights that light the ground round the locomotive while it stands at night, so work nearby goes on at the pace of daylight. They run off the turbo-generator, so only while the locomotive is in steam.</description>
        <amps>4</amps>
        <shedOrder>5</shedOrder>
        <toggle>true</toggle>
        <iconPath>Phobos/VehicleSystems/Fittings/WorkLamps</iconPath>
        <defaultOn>false</defaultOn>
        <available Class="Phobos.VehicleSystems.When_Granted">
          <ability>WorkLights</ability>
        </available>
        <when Class="Phobos.VehicleSystems.When_All">
          <conditions>
            <li Class="Phobos.VehicleSystems.When_Dark" />
            <li Class="Phobos.VehicleSystems.When_Moving">
              <invert>true</invert>
            </li>
          </conditions>
        </when>
      </li>
    </loads>
  </Phobos.VehicleSystems.PhobosVehicleLoadoutDef>

