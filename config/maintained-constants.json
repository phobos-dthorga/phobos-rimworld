  "constants": {
    "PhobosFactoryAdditions.version": {
      "type": "version",
      "parts": 3,
      "value": "0.12.2",
      "description": "D'thorga Factory Additions's version: About.xml, every project of the mod, its ModVersion constants and both READMEs",
      "targets": [
        {
          "path": "mods/PhobosFactoryAdditions/About/About.xml",
          "pattern": "<modVersion>(?P<value>[0-9.]+)</modVersion>"
        },
        {
          "path": "src/PhobosFactory/PhobosFactory.csproj",
          "pattern": "<Version>(?P<value>[0-9.]+)</Version>"
        },
        {
          "path": "src/PhobosFactory.Hygiene/PhobosFactory.Hygiene.csproj",
          "pattern": "<Version>(?P<value>[0-9.]+)</Version>"
        },
        {
          "path": "docs/README.md",
          "pattern": "\\| \\*\\*D'thorga\\ Factory\\ Additions\\*\\* \\| (?P<value>[0-9.]+) \\|"
        },
        {
          "path": "mods/PhobosFactoryAdditions/README.md",
          "pattern": "^Version (?P<value>[0-9.]+), built"
        }
      ],
      "review": [
        "Write the version's entry in mods/PhobosFactoryAdditions/CHANGELOG.md (an Unreleased section, then a dated Draft entry).",
        "Change the built date on the Version line of mods/PhobosFactoryAdditions/README.md."
      ]
    },
