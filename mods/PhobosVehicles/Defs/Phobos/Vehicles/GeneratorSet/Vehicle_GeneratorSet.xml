    </components>
    <modExtensions>
      <!-- Armour by class (D'thorga Framework 0.154.0; docs/development/vehicle-armour.md): Combat Extended shoots at the truck's full
           width, and the parts our systems append go inside, so each cell keeps the one outer part above. -->
      <li Class="Phobos.VehicleSystems.PhobosArmourExtension">
        <hitWidthCells>3</hitWidthCells>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <!-- 8,000 kg and 130 kW since Vehicles 0.51.0 (owner, 13 Nov 2026: a bigger truck), keeping about the same power per tonne (authored). -->
        <emptyKilograms>8000</emptyKilograms>
        <ratedKilowatts>130</ratedKilowatts>
      </li>
      <li Class="Phobos.VehicleSystems.PhobosEngineSoundExtension">
        <idleSound>PhobosVehicles_GeneratorSetEngineIdle</idleSound>
        <loadSound>PhobosVehicles_GeneratorSetEngineLoad</loadSound>
        <!-- Set up, its engine is the generator, which has its own running sound. -->
        <silentWhileWorking>true</silentWhileWorking>
      </li>
      <!-- Setting up and packing up: outriggers and the cable reel. Its running sound is its own comp's. -->
      <li Class="Phobos.VehicleSystems.PhobosVehicleSoundsExtension">
        <sounds>
          <li><key>SetUp</key><sound>PhobosVehicles_GeneratorSetSetUp</sound></li>
        </sounds>
      </li>
    </modExtensions>
    <comps>
      <li Class="Vehicles.CompProperties_FueledTravel">
        <fuelType>Chemfuel</fuelType>
        <leakDef>Filth_Fuel</leakDef>
        <fuelConsumptionRate>17</fuelConsumptionRate>
        <fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
        <fuelCapacity>200</fuelCapacity>
      </li>
      <li Class="Vehicles.CompProperties_UpgradeTree">
        <def>Phobos_GeneratorSet_UpgradeTree</def>
      </li>
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosGeneratorSet">
        <cableEndDef>Phobos_GeneratorStub</cableEndDef>
        <!-- Vehicles 0.51.0 (owner, 13 Nov 2026: a bigger generator): 2,000 W for 15 chemfuel a day at full output, 133 W per chemfuel a day,
             as before and 60% of the game's own chemfuel generator (1,000 W for 4.5 a day, 222 W); idle 2 a day. Authored
             (docs/development/vehicle-generator-set.md). -->
        <baseWatts>2000</baseWatts>
        <outputFloorWatts>400</outputFloorWatts>
        <idleFuelPerDay>2</idleFuelPerDay>
        <fullFuelPerDay>15</fullFuelPerDay>
        <runningSound>PhobosVehicles_GeneratorSetRunning</runningSound>
        <vitalParts>
          <li>Engine</li>
          <li>TractionGenerator</li>
        </vitalParts>
        <setUpOverlay>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_SetUp</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 9)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </setUpOverlay>
      </li>
      <!-- The cooling fan in the housing's fan well: the stock fan, or the heavy-duty one once that upgrade is fitted (owner, 12 Nov
           2026: "#1 is the default, #2 is the upgrade"). Its own picture, so it can spin later. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosNodeLooks">
        <slots>
          <li>
            <key>fan</key>
            <looks>
              <li>
                <node>HeavyFan</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_FanHeavy</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_Fan</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        <!-- The drawn armour kits (D'thorga Vehicles 0.86.0, the owner's picks of 19 Nov 2026): the heavy plates show in
             place of the armoured cab (they need it), the ram bar over the front bumper and the body plates along both sides. -->
          <li>
            <key>cabArmour</key>
            <looks>
              <li>
                <node>PhobosHeavyCabPlates</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_HeavyCabPlates</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <node>PhobosArmouredCab</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_ArmouredCab</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>1</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <li>
            <key>ramBar</key>
            <looks>
              <li>
                <node>PhobosRamBar</node>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_RamBar</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>3</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <!-- Vehicles 0.102.0, camp gear drawn on our vehicles (the owner's "everything on ours", 22 Nov 2026): the roof tent, closed, where it is fitted. -->
          <li>
            <key>campRoofTent</key>
            <looks>
              <li>
                <fitting>PhobosFitting_RoofTent</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_RoofTent</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>3</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <!-- Vehicles 0.102.0, camp gear drawn on our vehicles (the owner's "everything on ours", 22 Nov 2026): a rolled awning, side fly or awning walls on the left side rail. -->
          <li>
            <key>campSideRoll</key>
            <looks>
              <li>
                <fitting>PhobosFitting_Awning</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_SideRoll</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <fitting>PhobosFitting_SideFly</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_SideRoll</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
              <li>
                <fitting>PhobosFitting_AwningRoom</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_SideRoll</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
                    <shaderType>Cutout</shaderType>
                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
        </slots>
      </li>
      <!-- Damage pictures while a part is below 60% health (12 Nov 2026): the bulk tanker's marks, cropped and fitted here by
           assets/phobos-vehicles/export_damage.py. Placements are the agent's. -->
      <li Class="Phobos.VehicleSystems.CompProperties_PhobosDamageLooks">
        <looks>
          <li>
            <part>Cab</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_DamageCab</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 9)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
          <li>
            <part>TractionGenerator</part>
            <overlay>
              <graphicData>
                <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_DamageHousing</texPath>
                <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                <drawSize>(4, 9)</drawSize>
                <shaderType>Cutout</shaderType>
                <layer>2</layer>
              </graphicData>
            </overlay>
          </li>
        </looks>
      </li>
    </comps>
    <!-- Its own voice in place of the inherited draft blips; the engine loops are played by D'thorga Framework from the
         extension below, so they follow rpm and load (docs/development/sound-catalogue.md). -->
    <soundOneShotsOnEvent Inherit="False">
      <li>
        <key>IgnitionOn</key>
        <value>PhobosVehicles_GeneratorSetEngineStart</value>
      </li>
      <li>
        <key>IgnitionOff</key>
        <value>PhobosVehicles_GeneratorSetEngineStop</value>
      </li>
      <li>
        <key>PawnEntered</key>
        <value>PhobosVehicles_GeneratorSetDoor</value>
      </li>
      <li>
        <key>PawnExited</key>
        <value>PhobosVehicles_GeneratorSetDoor</value>
      </li>
      <li>
        <key>OutOfFuel</key>
        <value>PhobosVehicles_GeneratorSetSputter</value>
      </li>
    </soundOneShotsOnEvent>
  </Vehicles.VehicleDef>

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>Phobos_GeneratorSet_Blueprint</defName>
    <label>Busbar generator set</label>
    <description>Busbar B1: a diesel-electric truck that can park and feed your grid.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4, 9)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>230</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>PhobosResearch_GeneratorSet</li>
    </researchPrerequisites>
    <size>(3, 8)</size>
    <!-- The shell only: its parts are in Bill_GeneratorSet.xml, filled at start-up (docs/development/parts-bills.md). Steel stays first. -->
