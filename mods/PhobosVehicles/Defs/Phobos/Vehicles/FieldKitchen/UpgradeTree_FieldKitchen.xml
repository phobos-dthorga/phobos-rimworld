<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Billy's upgrades (D'thorga Vehicles 0.59.0; docs/development/vehicle-field-kitchen.md). Each sets out more at the next set-up, or offers bigger
       batches. Figures and costs authored. Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_FieldKitchen_UpgradeTree</defName>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEnforceUpgradeResearch" />
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>PhobosBillySecondRange</key>
      <label>Second range</label>
      <displayLabel>true</displayLabel>
      <description>A second field range in the kitchen tent, so two cooks can work at once. It is set out at the next set-up.</description>
      <icon>Phobos/Vehicles/FieldKitchen/BillyRange</icon>
      <work>2000</work>
      <gridCoordinate>(2, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_FieldCatering</li>
      </researchPrerequisites>
      <ingredients>
        <Steel>60</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosBillyBigKettle</key>
      <label>Big kettle</label>
      <displayLabel>true</displayLabel>
      <description>A bigger pot for the kettle: it can cook meals twenty at a time.</description>
      <icon>Phobos/Vehicles/FieldKitchen/BillyKettle</icon>
      <work>1200</work>
      <gridCoordinate>(7, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_FieldCatering</li>
      </researchPrerequisites>
      <ingredients>
        <Steel>40</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosBillyInsulatedTent</key>
      <label>Insulated tent</label>
      <displayLabel>true</displayLabel>
      <description>A lined tent and a small chemfuel heater, set out at the next set-up: the heater keeps the tent at 15 °C or so in the cold, burning about two chemfuel a day.</description>
      <icon>Phobos/Vehicles/FieldKitchen/BillyTentHeater</icon>
      <work>1800</work>
      <gridCoordinate>(12, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <ingredients>
        <Cloth>80</Cloth>
        <Steel>25</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosBillyDiningAnnex</key>
      <label>Dining annex</label>
      <displayLabel>true</displayLabel>
      <description>A second canvas room pitched against the kitchen tent's front, with a table and four chairs, so the crew eat at a table. It is set out at the next set-up and needs a patch 6 cells longer in front of the trailer.</description>
      <icon>Things/Building/Linked/WallSmooth_MenuIcon</icon>
      <work>2000</work>
      <gridCoordinate>(2, 10)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <ingredients>
        <Cloth>100</Cloth>
        <Steel>60</Steel>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
