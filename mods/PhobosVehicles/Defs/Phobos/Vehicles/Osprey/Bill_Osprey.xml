<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What the Osprey is made of, by role (docs/development/parts-bills.md; the record's "Cost and research"). Its blueprint's cost list
       is its shell; each role is filled at start-up by an installed mod's part where it suits the aircraft's weight, and by ours
       otherwise. Two turbine engines; three parts of the rotor drive (both proprotor gearboxes and the shaft between them; the record
       names three gearboxes); its fuel tanks (the sponson tanks and both wing tanks: the record's four counted the sponsons as two);
       three wheels (nose and two main gear); two alternators and two batteries; wiring; hydraulics. Counts authored, held for the
       owner's review. -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_Osprey</defName>
    <label>V-22 Osprey parts</label>
    <target>Phobos_Osprey_Blueprint</target>
    <parts>
      <Engine1>1</Engine1>
      <Engine2>1</Engine2>
      <RotorDrive>3</RotorDrive>
      <FuelTank>4</FuelTank>
      <Wheels>3</Wheels>
      <Alternator>2</Alternator>
      <Battery>2</Battery>
      <Wiring>1</Wiring>
      <HydraulicPump>1</HydraulicPump>
      <HydraulicLines>1</HydraulicLines>
    </parts>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
