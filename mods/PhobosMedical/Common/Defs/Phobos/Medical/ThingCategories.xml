<?xml version="1.0" encoding="utf-8"?>
<!-- Storage categories of our own inside the game's, named for what is in them (owner, 10 Nov 2026), as Dubs Bad Hygiene files its buildings
     under "hygiene". A shelf set to Manufactured or Buildings still takes them; existing storage keeps what it allowed, because a filter
     remembers items, not categories. The icons are two of our own item pictures, placeholders until the owner asks for ones of their own. -->
<Defs>
  <ThingCategoryDef>
    <defName>PhobosCategory_ClinicalSupplies</defName>
    <label>clinical supplies</label>
    <description>Kits and medicines a doctor carries to a patient: resuscitators, intubation and fluids kits, bronchodilators and field oxygen.</description>
    <parent>Manufactured</parent>
    <iconPath>Phobos/Medical/Things/FluidsKit</iconPath>
  </ThingCategoryDef>

  <ThingCategoryDef>
    <defName>PhobosCategory_MedicalEquipment</defName>
    <label>medical equipment</label>
    <description>Hospital and safety equipment, packed up to be carried or stored.</description>
    <parent>Buildings</parent>
    <iconPath>Phobos/Medical/Things/OxygenConcentrator</iconPath>
  </ThingCategoryDef>
</Defs>
