<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    The C-17's blueprint cost cut to its shell (Patches 0.40.0); its parts bill (Defs/Bill_C17.xml) adds the engines, generators, hydraulics,
    actuators, landing gear, tanks, electrics and avionics at start-up. Stock: 2,250 steel, 600 plasteel, 120 components, 300 silver and
    450 chemfuel, with no engine or other part. The shell keeps the airframe's steel and plasteel, the silver of its wiring looms and the
    components no part carries; the chemfuel goes, as fuel is no building material (the tanks are filled as for any aircraft). All
    authored. Steel stays first: Vehicle Framework reads a vehicle's first cost for its destruction sound.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="C17_Globemaster_Blueprint"]/costList</xpath>
    <value>
      <costList>
        <Steel>2000</Steel>
        <Plasteel>500</Plasteel>
        <Silver>300</Silver>
        <ComponentIndustrial>40</ComponentIndustrial>
      </costList>
    </value>
  </Operation>
</Patch>
