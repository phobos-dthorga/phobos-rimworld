<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The generator set's upgrades (docs/development/vehicle-generator-set.md). Figures and costs authored. Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_GeneratorSet_UpgradeTree</defName>
    <modExtensions>
      <!-- Priced like our fittings and tunes (Framework 0.106.0; owner, 13 Nov 2026): the figures below are the base. -->
      <li Class="Phobos.VehicleSystems.PhobosUpgradeCostsLikeTunes" />
    </modExtensions>
    <nodes>
    <li>
      <key>BiggerAlternator</key>
      <label>Uprated alternator</label>
      <displayLabel>true</displayLabel>
      <description>A bigger alternator behind the cab: 650 W more at full output, and fuel burned at the same watts per unit.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/BiggerAlternator</icon>
      <work>3000</work>
      <gridCoordinate>(2, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_GeneratorOutput</def>
              <!-- 650 W since Vehicles 0.51.0, in proportion to the 2,000 W set (was 400 on 1,200; authored). -->
              <value>650</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <!-- Beside one alternator, which the vehicle's parts bill adds (Bill_GeneratorSet.xml). -->
        <Steel>50</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_BiggerGenerator</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 9)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>CableReel</key>
      <label>Cable reel</label>
      <displayLabel>true</displayLabel>
      <description>A long cable on a drum. You choose where the cable end goes, up to 12 cells from the truck, so the truck can stand somewhere safe.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/CableReel</icon>
      <work>1500</work>
      <gridCoordinate>(7, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_CableReach</def>
              <value>12</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_Reel</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 9)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <key>BatteryBuffer</key>
      <label>Battery buffer</label>
      <displayLabel>true</displayLabel>
      <description>A battery box under the deck. It fills from spare power and keeps the grid alive for a time when the tank runs dry or the engine is hurt.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/BatteryBuffer</icon>
      <work>2000</work>
      <gridCoordinate>(12, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Batteries</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_GeneratorBuffer</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <!-- Beside two batteries, which the vehicle's parts bill adds (Bill_GeneratorSet.xml): the buffer's own electronics. -->
        <ComponentIndustrial>6</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_Battery</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 9)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Vehicles 0.100.0 (owner, 22 Nov 2026: the jamming truck on the Busbar; docs/development/ea6b-prowler.md, step 4). A mast of antennas
           that jams within 18 cells while the set is set up and running, taking 800 W off the top of its output (the rules Def's figures,
           authored; D'thorga Framework's CompPhobosGeneratorSet and JamFields). Inside the field, other factions' vehicles lose their radar and
           warning receiver. Its icon and overlay are still to be drawn (the art backlog); the node works without them showing. -->
      <key>GroundJammer</key>
      <label>Jammer mast</label>
      <displayLabel>true</displayLabel>
      <description>A folding mast of jamming antennas, powered from the generator. While the set is set up and running, it floods the air with noise for 18 cells around: enemy aircraft and vehicles inside lose their radar and their warning of attack. It takes 800 W of the set's output, so less reaches the grid.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/GroundJammer</icon>
      <work>4000</work>
      <gridCoordinate>(17, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>MicroelectronicsBasics</li>
      </researchPrerequisites>
      <ingredients>
        <Steel>60</Steel>
        <ComponentIndustrial>6</ComponentIndustrial>
        <ComponentSpacer>2</ComponentSpacer>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_JammerMast</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 9)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Owner, 11 Nov 2026 (docs/development/vehicle-upgrades-round-two.md, the generator set's signature). The share and the output
           cost are authored; the heat rate and the 21 C target come from the game's own heater (CompPhobosGeneratorSet). Its icon and
           overlay are the owner's pick of 12 Nov 2026. -->
      <key>HeatRecovery</key>
      <label>Exhaust heat exchanger</label>
      <displayLabel>true</displayLabel>
      <description>A heat exchanger on the exhaust. While the set makes power, it warms the room the cable end stands in, more as more power is drawn, until the room reaches 21 C. Outdoors the heat goes to waste. The exchanger's back pressure costs 25 W of output.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/HeatExchanger</icon>
      <work>1500</work>
      <gridCoordinate>(7, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_HeatRecovery</def>
              <value>0.6</value>
            </li>
            <li>
              <def>Phobos_GeneratorOutput</def>
              <value>-25</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>40</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
      <graphicOverlays>
        <li>
          <graphicData>
            <texPath>Phobos/Vehicles/GeneratorSet/GeneratorSet_HeatExchanger</texPath>
            <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
            <drawSize>(4, 9)</drawSize>
            <shaderType>Cutout</shaderType>
            <layer>1</layer>
          </graphicData>
        </li>
      </graphicOverlays>
    </li>
    <li>
      <!-- Owner, 12 Nov 2026: the heavy-duty fan, fan picture 2 as the upgrade of the stock fan. What it is for (agent proposal, owner to
           revise; docs/development/vehicle-generator-set.md): a parked radiator cools at 0.7 of its moving rate, and the fan's 0.3 brings
           it to the full rate, so a set left working hard in summer heat keeps its coolant in hand. Cost authored. -->
      <key>HeavyFan</key>
      <label>Heavy-duty fan</label>
      <displayLabel>true</displayLabel>
      <description>A bigger cooling fan with a heavier guard. A parked engine's radiator gets no air from driving; this fan moves as much air through it as the road would, so the set stays cool working hard in hot weather.</description>
      <icon>Phobos/Vehicles/GeneratorSet/Upgrades/HeavyFan</icon>
      <work>1200</work>
      <gridCoordinate>(12, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_StoppedAirflow</def>
              <value>0.3</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Owner, 12 Nov 2026: the service lead, batch 3 signature (docs/development/vehicle-upgrades-round-two.md). Reach and cost authored;
           the lead's 300 W is in the rules Def. No picture on the body: the lead is drawn as a line while the set is selected. -->
      <key>PhobosServiceLead</key>
      <label>Service lead</label>
      <displayLabel>true</displayLabel>
      <description>A heavy cable on a small reel, with clamps and a charger. While the set is set up and running, the lead reaches one of your vehicles within 6 cells, charges its battery, and gives it a start if it is too flat to start. It takes 300 W before the camp's grid does.</description>
      <icon>Phobos/VehicleSystems/ServiceLead</icon>
      <work>1200</work>
      <gridCoordinate>(2, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Electricity</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_ServiceLeadReach</def>
              <value>6</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Armour kits without a picture of their own (D'thorga Vehicles 0.80.0; vehicle-militarised-service-vehicles.md, "The kits").
           Each raises named parts by class with Add (vehicle-armour.md; Combat Extended's figures in Mods/CombatExtended), and its real
           kilograms [A] load the engine as cargo would (owner, 19 Nov 2026), taking cargo room on the Talus only. Figures and costs authored.
           scripts/check-vehicle-armour.py holds each kit to its class on both scales. Not yet tested in game. -->
      <key>PhobosEngineGuards</key>
      <label>Engine and tank guards</label>
      <displayLabel>true</displayLabel>
      <description>Steel guards around the engine and the fuel tank, against rifle fire. A guarded tank still leaks and a guarded engine still burns once they are finally holed: it takes heavier fire to get there.</description>
      <upgradeExplanation>Engine and fuel tank: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 300 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EngineGuards</icon>
      <work>2500</work>
      <gridCoordinate>(29, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Engine</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>FuelTank</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>300</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>100</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRunFlatTyres</key>
      <label>Run-flat tyres</label>
      <displayLabel>true</displayLabel>
      <description>Steel-belted tyres with run-flat inserts, so the wheels shrug off shell fragments and pistol bullets.</description>
      <upgradeExplanation>Wheels: from skin to splinter armour, which stops shell fragments and pistol bullets.\nKit weight: 120 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RunFlatTyres</icon>
      <work>1500</work>
      <gridCoordinate>(34, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>FrontWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
            <li>
              <key>RearWheels</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>120</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>30</Steel>
        <Cloth>30</Cloth>
      </ingredients>
    </li>
    <li>
      <key>PhobosEmpHardening</key>
      <label>EMP hardening</label>
      <displayLabel>true</displayLabel>
      <description>Shielded wiring, filtered power and a spare engine control unit, so an electromagnetic pulse does the electrics less harm and stalls the engine less often, as it does on a military vehicle.</description>
      <upgradeExplanation>Electrics: an electromagnetic pulse harms them as it does a military vehicle's.\nKit weight: 60 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/EmpHardening</icon>
      <work>2000</work>
      <gridCoordinate>(39, 2)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_EmpHardening</def>
              <value>1</value>
            </li>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>60</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>15</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- The drawn armour kits (D'thorga Vehicles 0.86.0; vehicle-militarised-service-vehicles.md, "The kits"), with their
           pictures from paid edits of the picked body (owner's picks of 19 Nov 2026). Armour by class with Add, Combat Extended's
           figures in Mods/CombatExtended; real kilograms [A] load the engine as cargo would, taking cargo room on the Talus only.
           Figures and costs authored. Not yet tested in game. -->
      <key>PhobosArmouredCab</key>
      <label>Armoured cab</label>
      <displayLabel>true</displayLabel>
      <description>Bolted steel plates over the cab's roof and doors and a steel frame round a narrowed windscreen, so ordinary rifle bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from skin to rifle armour, which stops ordinary rifle bullets.\nKit weight: 1,000 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/ArmouredCab</icon>
      <work>4000</work>
      <gridCoordinate>(39, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>1000</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>250</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>PhobosRamBar</key>
      <label>Ram bar</label>
      <displayLabel>true</displayLabel>
      <description>A heavy steel beam across the front, braced back to the chassis. Driving into an animal, a raider or a wall harms the truck half as much, and what it hits more.</description>
      <upgradeExplanation>Damage the truck takes from running into people and animals: half (0.50 to 0.25).\nFrom running into buildings: half (0.10 to 0.05).\nDamage it does to people and animals it runs into: half as much again (0.50 to 0.75); to buildings, 2.5 to 3.0.\nKit weight: 150 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/RamBar</icon>
      <work>1500</work>
      <gridCoordinate>(29, 7)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_TruckArmour</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <statCategories>
            <li>
              <def>PawnCollisionRecoilMultiplier</def>
              <value>-0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionRecoilMultiplier</def>
              <value>-0.05</value>
              <type>Add</type>
            </li>
            <li>
              <def>PawnCollisionMultiplier</def>
              <value>0.25</value>
              <type>Add</type>
            </li>
            <li>
              <def>BuildingCollisionMultiplier</def>
              <value>0.5</value>
              <type>Add</type>
            </li>
          </statCategories>
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>150</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>PhobosHeavyCabPlates</key>
      <label>Heavy cab plates</label>
      <displayLabel>true</displayLabel>
      <description>Thick steel slabs over the armoured cab and a steel visor over the windscreen with two vision slits, so armour-piercing rifle bullets and ordinary heavy machine-gun bullets stop at the cab. It shows on the truck.</description>
      <upgradeExplanation>Cab: from rifle to armour-piercing rifle armour, which stops armour-piercing rifle bullets and ordinary heavy machine-gun bullets.\nKit weight: 850 kg more, carried as cargo.</upgradeExplanation>
      <icon>Phobos/Vehicles/Upgrades/HeavyCabPlates</icon>
      <work>5000</work>
      <gridCoordinate>(39, 12)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>PhobosResearch_HeavyTruckArmour</li>
      </researchPrerequisites>
      <prerequisiteNodes>
        <li>PhobosArmouredCab</li>
      </prerequisiteNodes>
      <upgrades>
        <li Class="Vehicles.VehicleUpgrade">
          <armor>
            <li>
              <key>Cab</key>
              <type>Add</type>
              <statModifiers>
                <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
                <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
              </statModifiers>
            </li>
          </armor>
        </li>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_KitKilograms</def>
              <value>850</value>
            </li>
          </vehicleStats>
        </li>
        <li Class="Phobos.VehicleSystems.PhobosSystemsUpgrade" />
      </upgrades>
      <ingredients>
        <Steel>200</Steel>
        <Plasteel>40</Plasteel>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
