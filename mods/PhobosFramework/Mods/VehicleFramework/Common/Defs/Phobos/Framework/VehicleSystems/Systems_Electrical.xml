<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The electrical system: a lead-acid starting battery, charged by the alternator while the engine runs and drained by the loads
    the alternator cannot cover and by each start. Design: docs/development/vehicle-systems-design.md. Not yet tested in game.

    Sources and labels (every figure below is one of these):
    - A typical car battery is 12 V and about 40 to 45 Ah; heavy vehicles put two in series for 24 V. Secondary: Wikipedia,
      "Automotive battery".
    - A battery gives about 80 % of its capacity at 0 degrees C and about 50 % at -18 degrees C against 27 degrees C. Secondary:
      Battery University BU-502; Midtronics. The curve between and beyond those points is our interpolation (authored).
    - A discharged lead-acid battery can freeze and crack. Secondary: Battery University BU-502. The thresholds are authored.
    - Light vehicles' alternators give about 50 to 70 A. Secondary: Wikipedia, "Alternator (automotive)".
    - An alternator gives nothing below its cut-in speed and its full output only well above idle; it turns about 2.5 to 3 times
      engine speed through its pulley (secondary: the drivetrain record's sources, docs/development/vehicle-drivetrain-design.md).
      The output curve on rotor speed (nothing below 1,200 rpm, half at 1,800, 70% at 2,400, full from 6,000) is shaped from
      those sources and authored; an idling engine gives roughly half, so lights left on at idle slowly drain the battery.
    - A start of about 150 A for about 6 s is 0.25 Ah (our inference from typical starter currents; authored); a cold start draws
      more (authored factor).
    - The charging taper (a full battery accepts little) and the self-discharge are authored.
    Charge is a fraction of the battery's capacity, so every flow below is amperes divided by ampere-hours: a fraction per hour.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef Name="PhobosVehicleSystemElectricalBase">
    <defName>PhobosVehicleSystem_Electrical</defName>
    <label>electrical system</label>
    <description>The starting battery, the alternator that charges it while the engine runs, and the lights and heater it powers. A flat battery cannot start the engine; a cold one has less to give.</description>
    <roles>
      <li>Battery</li>
      <li>Alternator</li>
      <li>Starter</li>
    </roles>
    <parameters>
      <batteryAmpHours>45</batteryAmpHours>
      <alternatorAmps>65</alternatorAmps>
      <starterAmpHours>0.25</starterAmpHours>
      <shoreChargeAmps>10</shoreChargeAmps>
      <!-- The system's voltage, so a load's amperes become watts (crosslink 5, Framework 0.70.0: the alternator takes about 1.6 shaft
           watts for each watt the loads draw; AccessoryRules). 12 here; heavy vehicles set 24, the voltage their loads' amperes were
           authored for (Loadouts_Default.xml). -->
      <systemVolts>12</systemVolts>
    </parameters>
    <quantities>
      <li>
        <name>charge</name>
        <telltale>Phobos/VehicleSystems/Dash/Battery</telltale>
        <showOnDashboard>true</showOnDashboard>
        <label>battery</label>
        <unit>Fraction</unit>
        <min>0</min>
        <max>1</max>
        <startsAt>Full</startsAt>
        <stages>
          <li>
            <to>0.3</to>
            <label>low</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgBatteryLow</message>
              </li>
            </effects>
          </li>
          <li>
            <from>0.3</from>
            <label>charged</label>
          </li>
        </stages>
      </li>
      <li>
        <!-- What the battery can give a starter now: its charge times its capacity at this temperature. -->
        <name>startingPower</name>
        <telltale>Phobos/VehicleSystems/Dash/Battery</telltale>
        <label>starting power</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Ambient">
            <curve>
              <points>
                <li>(-40, 0.3)</li>
                <li>(-18, 0.5)</li>
                <li>(0, 0.8)</li>
                <li>(27, 1)</li>
                <li>(60, 1)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <!-- Crosslink 7 (Framework 0.70.0): cold oil is thick, so the starter needs more of the battery to turn the engine; to the
                 player that is less starting power (0.6 at -20 degrees C oil, full from 10; authored, the same sources as the cold
                 start's draw). A night or block heater keeps the oil warm. A vehicle without oil reads as warm. -->
            <quantity>oilTemperature</quantity>
            <fallback Class="Phobos.VehicleSystems.Input_Constant"><value>100</value></fallback>
            <curve>
              <points>
                <li>(-20, 0.6)</li>
                <li>(10, 1)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.1</to>
            <label>too weak to start</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseFlatBattery</reason>
              </li>
            </effects>
          </li>
          <li>
            <from>0.1</from>
            <label>enough to start</label>
          </li>
        </stages>
      </li>
      <li>
        <name>starter</name>
        <telltale>Phobos/VehicleSystems/Dash/Starter</telltale>
        <label>starter motor</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_PartEfficiency">
            <role>Starter</role>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <to>0.2</to>
            <label>broken</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_RefuseDraft">
                <reason>PhobosVehicleSystems_RefuseStarter</reason>
              </li>
            </effects>
          </li>
        </stages>
      </li>
      <li>
        <!-- A discharged battery in deep cold: 1 when it is empty below -40 degrees C, 0 above -10 degrees C or above 40 % charge. -->
        <name>frost</name>
        <telltale>Phobos/VehicleSystems/Dash/Frost</telltale>
        <label>battery frost</label>
        <unit>Fraction</unit>
        <hidden>true</hidden>
        <derivedFrom>
          <li Class="Phobos.VehicleSystems.Input_Ambient">
            <curve>
              <points>
                <li>(-40, 1)</li>
                <li>(-10, 0)</li>
              </points>
            </curve>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.4, 0)</li>
              </points>
            </curve>
          </li>
        </derivedFrom>
        <stages>
          <li>
            <from>0.05</from>
            <label>freezing</label>
            <notable>true</notable>
            <effects>
              <li Class="Phobos.VehicleSystems.Effect_DamagePart">
                <role>Battery</role>
                <perHour>2</perHour>
              </li>
              <li Class="Phobos.VehicleSystems.Effect_Message">
                <message>PhobosVehicleSystems_MsgBatteryFreezing</message>
              </li>
            </effects>
          </li>
        </stages>
      </li>
    </quantities>
    <flows>
      <li>
        <!-- What the alternator gives beyond the loads, less as the battery fills (authored taper). -->
        <name>charging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Surplus</side>
            <!-- Framework 0.73.0: the drive belt turns the alternator; a slipping or snapped one charges little or nothing. -->
            <drivenByRole>Belt</drivenByRole>
            <supplyFactor Class="Phobos.VehicleSystems.Input_EngineRpm">
              <multiplier>2.5</multiplier>
              <curve>
                <points>
                  <li>(1200, 0)</li>
                  <li>(1800, 0.5)</li>
                  <li>(2400, 0.7)</li>
                  <li>(4000, 0.9)</li>
                  <li>(6000, 1)</li>
                </points>
              </curve>
            </supplyFactor>
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <!-- What the loads draw beyond the alternator: all of it with the engine off. -->
        <name>drain</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Deficit</side>
            <!-- Framework 0.73.0: the drive belt turns the alternator; a slipping or snapped one charges little or nothing. -->
            <drivenByRole>Belt</drivenByRole>
            <supplyFactor Class="Phobos.VehicleSystems.Input_EngineRpm">
              <multiplier>2.5</multiplier>
              <curve>
                <points>
                  <li>(1200, 0)</li>
                  <li>(1800, 0.5)</li>
                  <li>(2400, 0.7)</li>
                  <li>(4000, 0.9)</li>
                  <li>(6000, 1)</li>
                </points>
              </curve>
            </supplyFactor>
          </li>
        </inputs>
      </li>
      <li>
        <!-- A parked vehicle beside a powered grid trickle-charges (a gameplay simplification: the grid gives the charge free). -->
        <name>shoreCharging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <factorParameter>shoreChargeAmps</factorParameter>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <when Class="Phobos.VehicleSystems.When_EngineRunning">
          <invert>true</invert>
        </when>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ShorePower" />
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <!-- About 5 % a month (authored; Battery University gives a few per cent a month at room temperature). -->
        <name>selfDischarge</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <factor>0.00007</factor>
      </li>
    </flows>
    <onEvents>
      <li>
        <!-- Each start draws on the battery, more in the cold: from the oil's temperature since crosslink 7 (Framework 0.70.0), as it is
             the thick oil the starter fights, so a warmed engine starts cheaply on a cold day; the air's for a vehicle without oil. -->
        <eventDef>IgnitionOn</eventDef>
        <effects>
          <li Class="Phobos.VehicleSystems.Effect_AddQuantity">
            <quantity>charge</quantity>
            <amount>-1</amount>
            <scaleByParameter>starterAmpHours</scaleByParameter>
            <divideByParameter>batteryAmpHours</divideByParameter>
            <scaleBy Class="Phobos.VehicleSystems.Input_Quantity">
              <quantity>oilTemperature</quantity>
              <fallback Class="Phobos.VehicleSystems.Input_Ambient" />
              <curve>
                <points>
                  <li>(-30, 3)</li>
                  <li>(-18, 2.5)</li>
                  <li>(0, 1.5)</li>
                  <li>(20, 1)</li>
                </points>
              </curve>
            </scaleBy>
          </li>
        </effects>
      </li>
    </onEvents>
    <!-- A jump-start from another of the player's vehicles within 8 cells raises a battery below 30 % to 30 %. The donor loses the
         same ampere-hours unless its engine runs (its alternator covers it). Figures authored. -->
    <jumpStart>
      <quantity>charge</quantity>
      <capacityParameter>batteryAmpHours</capacityParameter>
      <raiseTo>0.3</raiseTo>
      <donorMinimum>0.5</donorMinimum>
      <reach>8</reach>
      <work>300</work>
    </jumpStart>
    <onPartHit>
      <li>
        <role>Battery</role>
        <quantity>charge</quantity>
        <perHealthLost>-0.01</perHealthLost>
      </li>
      <li>
        <!-- Framework 0.29.0: damaged cells go on draining (Conditions.xml). Authored. -->
        <role>Battery</role>
        <condition>PhobosVehicleCondition_ShortedBattery</condition>
        <perHealthLost>0.03</perHealthLost>
        <armorCategories>
          <li>Sharp</li>
          <li>Blunt</li>
        </armorCategories>
        <!-- Not an animal's scratch or bite, and not the scratch Vehicle Framework's hand brakes give wheels. -->
        <exceptDamageDefs>
          <li>Scratch</li>
          <li>Bite</li>
        </exceptDamageDefs>
      </li>
    </onPartHit>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>

  <!--
    An electric vehicle's low-voltage electrics (Framework 0.20.0; docs/development/vehicle-electric-design.md): the same 12 V battery,
    jump-starts and loads, but charged by a DC-DC converter from the traction battery whenever the vehicle is switched on, at any
    speed, instead of by an alternator turning with the engine. Real electric cars keep a 12 V battery for the computers and the
    contactors that connect the traction battery, so a flat one still stops the car (general, approximate). Inherits the rest from
    the system above; only the flows differ.
  -->
  <Phobos.VehicleSystems.PhobosVehicleSystemDef ParentName="PhobosVehicleSystemElectricalBase">
    <defName>PhobosVehicleSystem_AuxiliaryElectrical</defName>
    <label>low-voltage electrics</label>
    <description>The 12 V battery that wakes the vehicle's computers and connects its traction battery, and the lights and fans it powers. The converter keeps it charged from the traction battery while the vehicle is switched on; a flat one still stops the vehicle starting.</description>
    <flows Inherit="False">
      <li>
        <name>charging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Surplus</side>
            <supplyFactor Class="Phobos.VehicleSystems.Input_EngineRunning" />
          </li>
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <name>drain</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ElectricalBalance">
            <side>Deficit</side>
            <supplyFactor Class="Phobos.VehicleSystems.Input_EngineRunning" />
          </li>
        </inputs>
      </li>
      <li>
        <name>shoreCharging</name>
        <quantity>charge</quantity>
        <kind>Into</kind>
        <factorParameter>shoreChargeAmps</factorParameter>
        <divideByParameter>batteryAmpHours</divideByParameter>
        <when Class="Phobos.VehicleSystems.When_EngineRunning">
          <invert>true</invert>
        </when>
        <inputs>
          <li Class="Phobos.VehicleSystems.Input_ShorePower" />
          <li Class="Phobos.VehicleSystems.Input_Quantity">
            <quantity>charge</quantity>
            <curve>
              <points>
                <li>(0, 1)</li>
                <li>(0.8, 1)</li>
                <li>(1, 0)</li>
              </points>
            </curve>
          </li>
        </inputs>
      </li>
      <li>
        <name>selfDischarge</name>
        <quantity>charge</quantity>
        <kind>From</kind>
        <factor>0.00007</factor>
      </li>
    </flows>
  </Phobos.VehicleSystems.PhobosVehicleSystemDef>
</Defs>
