<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the game-free physics sources straight from src/, so these tests need neither RimWorld
       nor Vanilla Expanded Framework and run on GitHub. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Phobos.Radio.Physics.Tests</RootNamespace>
    <OutputPath>bin/</OutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/PhobosRadio/Physics/*.cs" Link="Physics/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
