  <!-- Our vehicles at work, phase 2 (docs/development/sound-catalogue.md). Agent-made with Stable Audio 3 Small SFX, every one of the agent's shortlist
       leans taken by the owner (11 Nov 2026), levelled by scripts/art/export_sound.py against the game sound each comment names;
       the records beside the sound files say how. The volume extension lets D'thorga Framework's sound volume setting scale them.
       Each VehicleDef names its own by key in PhobosVehicleSoundsExtension. -->

  <!-- Tanker: hoses coupled or uncoupled (S26): beside the game's Metal_Drop, -3 dB. -->
  <SoundDef>
    <defName>PhobosVehicles_TankerHoses</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Phobos/Vehicles/Tanker/Hoses</clipPath>
          </li>
        </grains>
        <volumeRange>25</volumeRange>
        <distRange>10~30</distRange>
      </li>
    </subSounds>
    <modExtensions>
      <li Class="Phobos.Framework.Sounds.PhobosSoundVolumeExtension" />
    </modExtensions>
  </SoundDef>
