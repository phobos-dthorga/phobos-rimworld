<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Our own vehicle parts, which always exist (owner, 9 Nov 2026): they set what a destroyed part costs to replace, whichever other mods are
       installed, and another mod's parts are accepted only where they make sense (PartSupplies.xml). Priced near Vanilla Vehicles Expanded's
       engine block; every figure is authored. Moved here from D'thorga Vehicles in Framework 0.36.0, so any Vehicle Framework vehicle can use them. -->
  <ThingDef ParentName="ResourceBase">
    <defName>PhobosVehicles_EngineAssembly</defName>
    <label>engine assembly</label>
    <description>A complete diesel engine for a heavy vehicle.</description>
    <graphicData>
      <texPath>Phobos/Vehicles/Parts/EngineAssembly</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>5</stackLimit>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <MarketValue>420</MarketValue>
      <Mass>40</Mass>
      <Flammability>0.2</Flammability>
      <WorkToMake>5000</WorkToMake>
    </statBases>
    <thingCategories>
      <li>PhobosCategory_VehicleParts</li>
    </thingCategories>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <workSkill>Crafting</workSkill>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <researchPrerequisite>PhobosResearch_VehicleParts</researchPrerequisite>
      <recipeUsers>
        <li>PhobosVehicles_PartsBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <smeltProducts>
      <Steel>30</Steel>
    </smeltProducts>
  </ThingDef>
