<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Empty masses for Vanilla Vehicles Expanded - Tier 3's vehicles (owner's choice, 9 Nov 2026: authored masses by the real class each description names;
    docs/development/vehicle-kerb-mass-check.md). Vehicle Framework's Mass figures are not comparable between mods, and on the
    framework's rule of 12 kg per Mass these came out with bikes three times too heavy and tanks a tenth of their weight.
    Every figure is AUTHORED: a round weight for a real vehicle of the class the description names, approximate, general. Three
    follow a real aircraft and say so (secondary sources, approximate). Engine power follows the drivetrain's power per tonne,
    except where a figure is given (motorcycles, whose power per tonne is far above a car's). Not yet tested in game.
  -->
  <!-- Lightning: a fast light van, about 1.8 t -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/Vehicles.VehicleDef[defName="VVE_Lightning"]</xpath>
    <value>
      <li Class="Phobos.VehicleSystems.PhobosVehicleFiguresExtension">
        <emptyKilograms>1800</emptyKilograms>
      </li>
    </value>
  </Operation>
