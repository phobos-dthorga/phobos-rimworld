          </li>
          <!-- Vehicles 0.105.0: a rear tent packed on the roof or tent mount, its bag across it. -->
          <li>
            <key>campRearTentRoof</key>
            <looks>
              <li>
                <when>campRearTentRoof</when>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_RearTentRoof</texPath>
                    <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
                    <drawSize>(4, 9)</drawSize>
