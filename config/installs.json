{
  "schemaVersion": 1,
  "description": "Where this repository's mods are installed and backed up, and how one is built and installed: phobos-modkit's installs tool and D'thorga Companion's Mods page read it (docs/development/mod-installs.md).",
  "game": "rimworld",
  "mods": "mods",
  "backups": ".local/deploy-backups",
  "settings": ".local/install-settings.json",
  "sharedSources": ["src", "external/phobos-log"],
  "installOnly": ["TestRows.tsv", "*.dds"],
  "install": ["{python}", "scripts/deploy.py", "--build", "--apply", "{mod}"],
  "build": {
    "projects": "src/*/*.csproj",
    "modProperty": "ModFolder",
    "shared": ["Directory.Build.props", "Directory.Build.targets"],
    "command": ["{python}", "scripts/deploy.py", "--build-only"]
  },
  "settingsChanges": ["{python}", "scripts/mod-settings.py", "changes", "--since", "{commit}", "--json"]
}
