<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    What the C-17 Globemaster III is built from, by role (Patches 0.40.0; docs/development/c17-globemaster.md; docs/development/parts-bills.md),
    as the Black Hawk and Close Air Support's jets are. Its blueprint's cost is cut to its shell (Cost_C17.xml); each role is filled at
    start-up by an installed mod's part where it suits the aircraft's weight, and by ours otherwise. Counts follow the real C-17's layout:
    four turbofans with a generator on each; four hydraulic systems (secondary: FAS) and their actuators; the mod's three landing wheels; a
    tank in each wing (authored, as its side tanks). The battery and wiring counts are authored; what each part costs is the shared table's,
    held for the owner's review.
  -->
  <Phobos.VehicleSystems.PhobosVehicleBillDef>
    <defName>PhobosBill_C17</defName>
    <label>C-17 parts</label>
    <target>C17_Globemaster_Blueprint</target>
    <tags>
      <li>Turbine</li>
    </tags>
    <parts>
      <Engine1>1</Engine1>
      <Engine2>1</Engine2>
      <Engine3>1</Engine3>
      <Engine4>1</Engine4>
      <Actuator>4</Actuator>
      <HydraulicPump>4</HydraulicPump>
      <HydraulicLines>1</HydraulicLines>
      <LandingGear>3</LandingGear>
      <FuelTank>2</FuelTank>
      <Alternator>4</Alternator>
      <Battery>1</Battery>
      <Wiring>1</Wiring>
      <Avionics>1</Avionics>
    </parts>
  </Phobos.VehicleSystems.PhobosVehicleBillDef>
</Defs>
