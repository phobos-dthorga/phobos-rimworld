<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The Ullage bulk tanker's armour with Combat Extended (D'thorga Vehicles 0.76.0; docs/development/vehicle-armour.md). Its Def gives
       every part the Skin class's Vehicle Framework rating; with Combat Extended the same class is 2 mm of steel and 4 MPa
       (Mods/CombatExtended loads only while Combat Extended is active). Every part is Skin (owner, 19 Nov 2026): no source states that a
       civilian truck stops a bullet. scripts/check-vehicle-armour.py holds each part here to its class in the Def. Not yet tested in game. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.VehicleDef[defName="Phobos_Tanker"]/components/li/armor</xpath>
    <value>
      <armor>
        <ArmorRating_Sharp>2</ArmorRating_Sharp>
        <ArmorRating_Blunt>4</ArmorRating_Blunt>
      </armor>
    </value>
  </Operation>
  <!-- The armour kits with Combat Extended (D'thorga Vehicles 0.80.0): engine and tank guards add Skin to Rifle (6 mm, 36 MPa), run-flat
       tyres Skin to Splinter (3 mm, 16 MPa). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.UpgradeTreeDef[defName="Phobos_Tanker_UpgradeTree"]/nodes/li[key="PhobosEngineGuards"]/upgrades/li[@Class="Vehicles.VehicleUpgrade"]/armor</xpath>
    <value>
      <armor>
          <li>
            <key>Engine</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>6</ArmorRating_Sharp>
              <ArmorRating_Blunt>36</ArmorRating_Blunt>
            </statModifiers>
          </li>
          <li>
            <key>FuelTank</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>6</ArmorRating_Sharp>
              <ArmorRating_Blunt>36</ArmorRating_Blunt>
            </statModifiers>
          </li>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.UpgradeTreeDef[defName="Phobos_Tanker_UpgradeTree"]/nodes/li[key="PhobosRunFlatTyres"]/upgrades/li[@Class="Vehicles.VehicleUpgrade"]/armor</xpath>
    <value>
      <armor>
          <li>
            <key>FrontWheels</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>3</ArmorRating_Sharp>
              <ArmorRating_Blunt>16</ArmorRating_Blunt>
            </statModifiers>
          </li>
          <li>
            <key>RearWheels</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>3</ArmorRating_Sharp>
              <ArmorRating_Blunt>16</ArmorRating_Blunt>
            </statModifiers>
          </li>
      </armor>
    </value>
  </Operation>
  <!-- The drawn armour kits with Combat Extended (D'thorga Vehicles 0.86.0): the armoured cab adds Skin to Rifle (6 mm, 36 MPa), the
       heavy plates Rifle to Armour-piercing rifle (7 mm, 80 MPa more), body plates Skin to Rifle. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.UpgradeTreeDef[defName="Phobos_Tanker_UpgradeTree"]/nodes/li[key="PhobosArmouredCab"]/upgrades/li[@Class="Vehicles.VehicleUpgrade"]/armor</xpath>
    <value>
      <armor>
          <li>
            <key>Cab</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>6</ArmorRating_Sharp>
              <ArmorRating_Blunt>36</ArmorRating_Blunt>
            </statModifiers>
          </li>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.UpgradeTreeDef[defName="Phobos_Tanker_UpgradeTree"]/nodes/li[key="PhobosBodyPlates"]/upgrades/li[@Class="Vehicles.VehicleUpgrade"]/armor</xpath>
    <value>
      <armor>
          <li>
            <key>TankShell</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>6</ArmorRating_Sharp>
              <ArmorRating_Blunt>36</ArmorRating_Blunt>
            </statModifiers>
          </li>
      </armor>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/Vehicles.UpgradeTreeDef[defName="Phobos_Tanker_UpgradeTree"]/nodes/li[key="PhobosHeavyCabPlates"]/upgrades/li[@Class="Vehicles.VehicleUpgrade"]/armor</xpath>
    <value>
      <armor>
          <li>
            <key>Cab</key>
            <type>Add</type>
            <statModifiers>
              <ArmorRating_Sharp>7</ArmorRating_Sharp>
              <ArmorRating_Blunt>80</ArmorRating_Blunt>
            </statModifiers>
          </li>
      </armor>
    </value>
  </Operation>
</Patch>
