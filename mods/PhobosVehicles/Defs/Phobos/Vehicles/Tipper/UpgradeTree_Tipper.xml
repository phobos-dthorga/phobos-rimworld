<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The tipper's upgrades (docs/development/vehicle-tipper-hauler.md). Figures and costs authored. Node keys are saved in the game: never rename or remove one. Not yet tested in game. -->
  <Vehicles.UpgradeTreeDef>
    <defName>Phobos_Tipper_UpgradeTree</defName>
    <modExtensions>
      <li Class="Phobos.VehicleSystems.PhobosEnforceUpgradeResearch" />
    </modExtensions>
    <nodes>
    <li>
      <key>HighSides</key>
      <label>greedy boards</label>
      <displayLabel>true</displayLabel>
      <description>Taller side boards, which drivers call greedy boards: 600 kg more of anything.</description>
      <icon>Phobos/Vehicles/Tipper/Upgrades/HighSides</icon>
      <work>1500</work>
      <gridCoordinate>(2, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>600</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>60</Steel>
      </ingredients>
    </li>
    <li>
      <key>RockBody</key>
      <label>rock body</label>
      <displayLabel>true</displayLabel>
      <description>A short, steep body with a thick floor. It carries the same, but sheds its load half as fast again.</description>
      <icon>Phobos/Vehicles/Tipper/Upgrades/RockBody</icon>
      <work>3000</work>
      <gridCoordinate>(7, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Machining</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>BulkBody</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_TipRate</def>
              <value>1</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <key>BulkBody</key>
      <label>bulk body</label>
      <displayLabel>true</displayLabel>
      <description>A long, shallow body: 3,600 kg before any greedy boards, for ore and steel, but it tips slower.</description>
      <icon>Phobos/Vehicles/Tipper/Upgrades/BulkBody</icon>
      <work>3000</work>
      <gridCoordinate>(12, 6)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Machining</li>
      </researchPrerequisites>
      <disableIfUpgradeNodesEnabled>
        <li>RockBody</li>
      </disableIfUpgradeNodesEnabled>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>CargoCapacity</def>
              <value>1200</value>
            </li>
            <li>
              <def>Phobos_TipRate</def>
              <value>-0.5</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>150</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    <li>
      <!-- Owner, 12 Nov 2026: the loading grab, batch 3 signature (docs/development/vehicle-upgrades-round-two.md). Lift and cost authored;
           reach and pace are in the rules Def. No picture on the body yet: no crane picture exists for the tipper. -->
      <key>PhobosLoadingGrab</key>
      <label>loading grab</label>
      <displayLabel>true</displayLabel>
      <description>A small hydraulic crane behind the cab with a two-jawed grab. With a driver aboard and the truck stopped, it lifts loose chunks and stacks lying within 4 cells into the cargo, up to 500 kg a lift, with no one else to carry them. The truck cannot tip while the grab is out.</description>
      <icon>Phobos/VehicleSystems/Stations/Grab</icon>
      <work>3000</work>
      <gridCoordinate>(7, 11)</gridCoordinate>
      <drawSize>(80, 80)</drawSize>
      <researchPrerequisites>
        <li>Machining</li>
      </researchPrerequisites>
      <upgrades>
        <li Class="Vehicles.StatUpgrade">
          <vehicleStats>
            <li>
              <def>Phobos_GrabLift</def>
              <value>500</value>
            </li>
          </vehicleStats>
        </li>
      </upgrades>
      <ingredients>
        <Steel>120</Steel>
        <ComponentIndustrial>4</ComponentIndustrial>
      </ingredients>
    </li>
    </nodes>
  </Vehicles.UpgradeTreeDef>
</Defs>
