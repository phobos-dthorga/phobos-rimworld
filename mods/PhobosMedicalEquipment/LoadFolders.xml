<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- One assembly per game version: 1.7 leads, 1.6 stays until it is retired (docs/development/building.md). Each Mods folder
       loads only while that mod is active. -->
  <v1.6>
    <li>/</li>
    <li>Common</li>
    <li>1.6</li>
    <li IfModActive="vanillaexpanded.gravship">Mods/VanillaGravshipExpanded</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="Th3Fr3d.ExtendedInjuries">Mods/MoreInjuries</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene/1.6</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li>Common</li>
    <li>1.7</li>
    <li IfModActive="vanillaexpanded.gravship">Mods/VanillaGravshipExpanded</li>
    <li IfModActive="CETeam.CombatExtended">Mods/CombatExtended</li>
    <li IfModActive="Th3Fr3d.ExtendedInjuries">Mods/MoreInjuries</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene/1.7</li>
  </v1.7>
</loadFolders>
