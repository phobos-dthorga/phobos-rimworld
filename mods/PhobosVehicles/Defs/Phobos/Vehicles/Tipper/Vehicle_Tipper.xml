                    <layer>2</layer>
                  </graphicData>
                </look>
              </li>
            </looks>
          </li>
          <!-- Vehicles 0.102.0, camp gear drawn on our vehicles (the owner's "everything on ours", 22 Nov 2026): the roof tent, closed, where it is fitted. -->
          <li>
            <key>campRoofTent</key>
            <looks>
              <li>
                <fitting>PhobosFitting_RoofTent</fitting>
                <look>
                  <graphicData>
                    <texPath>Phobos/Vehicles/Tipper/Tipper_RoofTent</texPath>
