<Project Sdk="Microsoft.NET.Sdk">
  <!-- D'thorga Patches' InterRim Ballistic Missile assembly (D'thorga Missile Patches until 7 November 2026). It lives in InterRim Ballistic Missile's load folder (Mods/IRBM/<version>), so it
       loads only while that mod is active. Built for RimWorld 1.7 only (net10.0, Harmony 3);
       Directory.Build.targets turns the target into the game version, the output folder, the references and the IRBM
       folder (1.6 only: IRBM ships no 1.7 build). It references D'thorga Framework for the shared helpers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Phobos.MissilePatches</RootNamespace>
    <AssemblyName>PhobosPatches.Irbm</AssemblyName>
    <ModFolder>PhobosPatches</ModFolder>
    <TieInFolder>Mods/IRBM/</TieInFolder>
    <UsesHarmony>true</UsesHarmony>
    <Version>0.16.2</Version>
    <!-- IRBM targets .NET Framework 4.8, and the game loads it whatever it declares, so the mismatch
         only matters to the compiler's reference check. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhobosFramework/PhobosFramework.csproj" Private="false" />
    <!-- InterRim Ballistic Missile's assembly, referenced from the installed mod and never copied (THIRD_PARTY_NOTICES.md). -->
    <Reference Include="IRBM">
      <HintPath>$(IrbmAssemblies)\IRBM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
