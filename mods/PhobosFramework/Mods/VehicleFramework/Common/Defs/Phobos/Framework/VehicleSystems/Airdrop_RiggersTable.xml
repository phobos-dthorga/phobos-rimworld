    <jobString>Repacking a cargo parachute.</jobString>
    <workAmount>2500</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Phobos_SpentCargoParachute</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
            <li>Synthread</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Phobos_SpentCargoParachute</li>
        <li>Cloth</li>
        <li>Synthread</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Phobos_CargoParachute>1</Phobos_CargoParachute>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- Framework 0.293.0: a guided cargo parachute, new: as a cargo parachute (200 fabric, 15 steel) with a guidance unit of 3 components and
       the square canopy's extra work, 8,000 work in all; after microelectronics (authored). -->
